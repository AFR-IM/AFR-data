r emojis...\" style=\"width: 100%; font-size: 120%; height: 100%; box-sizing: border-box;\" onkeydown=\"if(event.which === 13) {searchForEmojis(emojiSearchEl.value)}\"></div>\n        </div>\n        <button style=\"min-width:5rem; margin-left:0.25rem;\" onclick=\"searchForEmojis(emojiSearchEl.value)\" id=\"emojiSearchButton\">🔍 search</button>\n      </div>\n    </div>\n    <script>\n    async function searchForEmojis(keyphrase) {\n      if(keyphrase) {\n        emojiSearchButton.textContent = \"⌛ loading…\";\n        fetch(`https://emojicombos.com/api/search?keyphrase=${encodeURIComponent(keyphrase)}`).then(r => r.text()).then(url => window.location.href=url);\n      }\n    }\n    </script>\n    \n    \n    <!-- <div class=\"related-topics-area\" style=\"margin-top: 1rem;\">\n      <div class=\"related-topics-list\"></div>\n    </div> -->\n\n    <div style=\"margin: 0 auto;width:400px; max-width:90vw; margin-top: 3rem;color: grey;font-size: 80%;\">If you'd like to report a bug or suggest a feature, you can <a style=\"color:inherit;\" href=\"https://docs.google.com/forms/d/e/1FAIpQLSfdBn1bZTEhodqtWWdtu75GJkmmjNMtJ2_2hX2UajPMPMmnzQ/viewform?usp=sf_link\" target=\"_blank\">provide feedback here</a>. You can also read our <a style=\"color:inherit;\" href=\"/privacy.html\" rel=\"nofollow\" target=\"_blank\">privacy policy</a>.</div>\n      \n    \n    <!-- Global site tag (gtag.js) - Google Analytics -->\n    <script async src=\"https://www.googletagmanager.com/gtag/js?id=G-WF5V0J3NPY\"></script>\n    <script>\n      window.dataLayer = window.dataLayer || [];\n      function gtag(){dataLayer.push(arguments);}\n      gtag('js', new Date());\n\n      gtag('config', 'G-WF5V0J3NPY');\n    </script>\n\n\n\n  <script type=\"module\" src=\"https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092\" integrity=\"sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==\" data-cf-beacon='{\"version\":