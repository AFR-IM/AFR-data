       subscribe('off');\n                je.style.display = je.style.display == \"none\" ? \"block\" : \"none\";\n            }\n        }\n        function csokkentett(mit) {\n            var cs = document.getElementById(\"csokkentett\");\n            if (mit) {\n                cs.style.display = \"none\";\n            } else {\n                jelszoemlekezteto('off');\n                invite('off');\n                subscribe('off');\n                cs.style.display = cs.style.display == \"none\" ? \"block\" : \"none\";\n            }\n        }\n        function invite(mit) {\n            var inv = document.getElementById(\"invite\");\n            if (mit) {\n                inv.style.display = \"none\";\n            } else {\n                jelszoemlekezteto('off');\n                csokkentett('off');\n                subscribe('off');\n                inv.style.display = inv.style.display == \"none\" ? \"block\" : \"none\";\n            }\n        }\n        function subscribe(mit) {\n            var subscr = document.getElementById(\"subscribe\");\n            if (mit) {\n                subscr.style.display = \"none\";\n            } else {\n                jelszoemlekezteto('off');\n                csokkentett('off');\n                invite('off');\n                subscr.style.display = subscr.style.display == \"none\" ? \"block\" : \"none\";\n            }\n        }\n        function liEllenorzes() {\n            if (document.login.nev.value.length == 0 && document.login.pass.value.length == 0) {\n                alert(\"Belépéshez mindenképp kell név és jelszó is, ezek nélkül nem fog menni!\");\n                return false;\n            }\n            if (document.login.nev.value.length == 0) {\n                alert(\"Nem írtál be nevet!\");\n                return false;\n            }\n            if (document.login.pass.value.length == 0) {\n                alert(\"Nem írtál be jelszót!\");\n                return false;\n            }\n\n                            return true;\n                    }\n        function addHidden(theForm, key, value) {\n            // Create a hidden input element, and append it to the form:\n            var input = document.createElement('input');\n            input.type = 'hidden';\n            input.name = key;\n            input.value = value;\n            theForm.appendChild(input);\n        }\n        function onSubmit() {\n            if (window.which == \"recovery\") {\n                var form = document.getElementById(\"recovery\");\n                addHidden(form, 'g-recaptcha-response', grecaptcha.getResponse());\n                form.submit();\n            } else if (window.which == \"login\") {\n                var form = document.getElementById(\"loginform\");\n                addHidden(form, 'g-recaptcha-response', grecaptcha.getResponse());\n                form.submit();\n            }\n        }\n        function jeEllenorzes() {\n            window.which = \"recovery\";\n            if (document.getElementById('email_input').value == '') {\n                alert(\"Jelszó-emlékeztető kéréséhez add meg az email címed, és az email mező alatt található képről a betűket és/vagy számokat!\");\n                return false;\n            }\n\n            grecaptcha.execute();\n            return false;\n        }\n        function subscribeCheck() {\n            if (document.getElementById('sub_email_input').value == '') {\n                alert(\"Nem írtál be e-mail címet!\");\n                return false;\n            }\n            if (document.getElementById('sec_input').value == '') {\n                alert(\"Hibás ellenőrző kód!\");\n                return false;\n            }\n            return true;\n        }\n        function invEllenorzes() {\n            if (document.getElementById('inv_email_input').value == '' || document.getElementById('isp_input').value == '' || document.getElementById('speed_input').value == '' || document.getElementById('reason_input').value == '' || document.getElementById('security_inv_input').value == '') {\n                alert(\"Minden mezőt kötelező kitölteni!\");\n                return false;\n            }\n            return true;\n        }\n    </script>\n    <noscript>\n        JavaScript engedélyezése nélkül nem fogod tudni használni a jelszó-emlékeztetőt, és sok mást sem!    </noscript>\n</head>\n\n<body onLoad=\"document.getElementById('nev').focus();\">\n<div id=\"tartalom\">\n        <div id=\"login_all\">\n        <div id=\"login\">\n            <form method=\"post\" action=\"login.php\" name=\"login\" id=\"loginform\" onsubmit=\"return liEllenorzes()\">\n                <input type=\"hidden\" name=\"set_lang\" value=\"hu\">\n                <input type=\"hidden\" name=\"submitted\" value=\"1\">\n                <table>\n                    <tr>\n                        <td class=\"login_td\">Felhasználónév</td>\n                        <td><input tabindex=1 class=\"beviteliMezo\" type=\"text\" id=\"nev\" name=\"nev\" size=\"20\"></td>\n                        <td>\n                            <input tabindex=4 type=\"submit\" value=\"Belépés!\"\n                                   class=\"submit_btn\" />\n                        </td>\n                    </tr>\n                    <tr>\n                        <td class=\"login_td\">Jelszó</td>\n                        <td><input tabindex=2 class=\"beviteliMezo\" type=\"password\" name=\"pass\" size=\"20\"></td>\n                        <td><a href=\"javascript:jelszoemlekezteto()\">Jelszó-emlékeztető</a></td>\n                    </tr>\n\n                    <tr>\n                                                <td colspan=\"3\" align=\"center\">\n                            <a href=\"/login.php?2fa\">Bejelentkezés kétlépcsős azonosítással</a>\n                                                    </td>\n                    </tr>\n                    <tr>\n                        <td class=\"login_td\">Csökkentett biztonság</td>\n                        <td><input tabindex=4 name=\"ne_leptessen_ki\" type=\"checkbox\" value=\"1\">&nbsp;&nbsp;(<a\n                                href=\"javascript:csokkentett()\">Mi ez?</a>)\n                        </td>\n                        <td>&nbsp;</td>\n                    </tr>\n                    <tr>\n                        <td></td>\n                        <td></td>\n                        <td>[<a href=\"?set_lang=hu\">hu</a>] [<a href=\"?set_lang=en\">en</a>]</td>\n                    </tr>\n                </table>\n            </form>\n        </div>\n        <!--CAPTCHA CODE-->\n        <div style=\"text-align:left;\">\n            <div class=\"g-recaptcha\" data-sitekey=\"6LfZlt0ZAAAAAErVZ8jzKp_wpxUN22K-R1PkP5aO\"\n                 data-size=\"invisible\" data-callback=\"onSubmit\"></div>\n        </div>\n        <!--CAPTCHA CODE-->\n\n        <div style=\"display:none;\" id=\"csokkentett\">\n            <span style=\"color:#629a00;font-size:12px;line-height:30px;\">Csökkentett biztonság</span><br>\n            A csökkentett biztonságú bejelentkezés kiválasztásával a felhasználónevedet és a jelszavadat a böngészőben egy cookie-ban (sütiben) tároljuk.<br>\n            <span style=\"color:#629a00;line-height:30px;\">Miért jó ez?</span><br>\n            Ha cookie-ban tároljuk a jelszavad, akkor a böngésző (gép) újraindításánál nem kell újra beírnod a felhasználóneved és jelszavad, valamint belépned, vagyis sokkal kényelmesebb az oldal használata. Ez volt eddig az alapbeállítás, így működött a belépés. (Fontos! Ez nem azonos a böngésző jelszó mentési szolgáltatásával!)<br>\n            <span style=\"color:#629a00;line-height:30px;\">És miért rossz?</span><br>\n            A cookie-ban érzékeny adatok tárolása sajnos nem tekinthető biztonságosnak. Abban az esetben például, ha egy olyan gépen lépsz be az oldalra, amit esetleg többen is használnak (pl: iskola, könyvtár, netkávézó vagy a haver gépe), akkor nem elég a használat végén a 'Kilépés', hanem a cookie-kat is törölni kell. De ettől még előfordulhat, hogy illetéktelenek hozzáférnek a cookie tartalmához, ezzel megszerezve az oldalhoz a hozzáférésed.<br>\n            <span style=\"color:#629a00;line-height:30px;\">Mit tegyél?</span><br>\n            Azt javasoljuk, hogy ha más által is hozzáférhető gépen lépsz be az oldalra, akkor NE JELÖLD BE a csökkentett biztonságot. Viszont ha az otthoni gépeden használod az oldalt, akkor ezt nyugodtan megteheted.<br><br>Fontos! Az oldal ettől függetlenül továbbra is használ cookie-kat, csak az érzékeny információk tárolását szabályozhatod ezzel a funckióval. Így tehát a cookie-kat továbbra sem szabad letiltani!        </div>\n        <div style=\"display:none;\" id=\"jelszo_emlekezteto\">\n            <form action=\"login.php\" method=\"post\" name=\"jelszo_em\" id=\"recovery\" onsubmit=\"return jeEllenorzes()\">\n                <input type=\"hidden\" name=\"set_lang\" value=\"hu\">\n                <table width=\"400\" border=\"0\" cellspacing=\"2\" cellpadding=\"0\">\n                    <tr>\n                        <td colspan=\"3\">\n                            <div style=\"text-align:center;\">Kérjük, add meg az e-mail címed, amellyel oldalunkra regisztráltál. A megadott címre küldünk egy linket, amelyre kattintva jelszavad módosíthatod!</div>\n                        </td>\n                    </tr>\n                    <tr>\n                        <td>\n                            <div style=\"text-align:right;\">E-mail cím:</div>\n                        </td>\n                        <td width=\"5\"></td>\n                        <td>\n                            <div style=\"text-align:left;\"><input id=\"email_input\" class=\"beviteliMezo\" type=\"text\"\n                                                                 name=\"email_alapjan\" size=\"20\"></div>\n                        </td>\n                    </tr>\n                    <tr height=\"5\">\n                        <td colspan=\"3\"></td>\n                    </tr>\n                    <tr>\n                        <td colspan=\"3\">\n                            <div style=\"text-align:center;\"><input type=\"submit\" class=\"submit_btn\"\n                                                                   value=\"Küldés!\"></div>\n                        </td>\n                    </tr>\n                </table>\n            </form>\n        </div>\n        <div style=\"display:none\" id=\"invite\">\n            A funkció ideiglenesen kikapcsolva.        </div>\n        <div style=\"display:none\" id=\"subscribe\">\n            <form action=\"login.php\" method=\"post\" name=\"subscribe\" onsubmit=\"return subscribeCheck()\">\n                <input type=\"hidden\" name=\"set_lang\" value=\"hu\">\n                <table width=\"430\" border=\"0\" cellspacing=\"2\" cellpadding=\"0\">\n                    <span style=\"color:#629a00;font-size:12px;line-height:30px;\">Regisztráció</span><br>\n                    A regisztrációhoz az alábbi formot kell kitöltened:\n                    <tr>\n                        <td>\n                            <div style=\"text-align:right;\">E-mail cím</div>\n                        </td>\n                        <td width=\"5\"></td>\n                        <td>\n                            <div style=\"text-align:left;\"><input id=\"sub_email_input\" class=\"beviteliMezo\" type=\"text\"\n                                                                 name=\"sub_email\" size=\"20\"></div>\n                        </td>\n                    </tr>\n                    <tr>\n                        <td>\n                            <div style=\"text-align:right;\">Kitől hallottál az oldalról:</div>\n                        </td>\n                        <td width=\"5\"></td>\n                        <td>\n                            <div style=\"text-align:left;\"><input id=\"referer\" class=\"beviteliMezo\" type=\"text\"\n                                                                 name=\"referer\" size=\"20\" placeholder=\"Opcionális\">\n                            </div>\n                        </td>\n                    </tr>\n                    <tr>\n                        <td width=\"150\">\n                            <div style=\"text-align:right;\"></div>\n                        </td>\n                        <td width=\"5\"></td>\n                        <td width=\"245\">\n                            <div style=\"text-align:left;\"><img\n                                    src=\"images/captcha/captcha.php?width=100&height=40&characters=5\"></div>\n                        </td>\n                    </tr>\n                    <tr>\n                        <td>\n                            <div style=\"text-align:right;\">A képen látható kód:</div>\n                        </td>\n                        <td width=\"5\"></td>\n                        <td>\n                            <div style=\"text-align:left;\"><input id=\"sec_input\" class=\"beviteliMezo\" type=\"text\"\n                                                                 name=\"security_code\" size=\"20\"></div>\n                        </td>\n                    </tr>\n                    <tr>\n                        <td colspan=\"3\">\n                            <div style=\"text-align:center;\"><input type=\"submit\" name=\"submit\" class=\"submit_btn\"\n                                                                   value=\"Küldés!\"></div>\n                        </td>\n                    </tr>\n                </table>\n            </form>\n        </div>\n        \t    <!--\n        <div id=\"note\">\n            Szerzői jogi probléma esetén kérjük a <a href=\"mailto:webmaster@ncore.pro\">webmaster@ncore.pro</a> hivatalos címünkre küldjön levelet.<br><br>        </div>\n\t-->\n    </div>\n</div>\n</body>\n</html>\n",
