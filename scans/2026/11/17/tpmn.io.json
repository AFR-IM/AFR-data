:29px;}\n        .r-6 .grid-1 {position:relative; width:100%;}\n        .r-6 .grid-1 .video-view {display:none;}\n        .r-6 .grid-1 .g-1 {padding:0; padding-bottom:50px; text-align:center; background-image:url('img/bg-3.webp'); background-size:100% 120%; background-repeat:no-repeat; background-position:center;}\n        .r-6 .grid-1 .g-1 .t {font-size:27px; margin-top:70px; padding:30px;}\n        .r-6 .grid-1 .g-1 .c {font-size:17px; margin-bottom:20px; line-height:150%; padding:30px;}\n        .r-6 .grid-1 .g-1 .e {margin-top:0;font-size:26px;}\n        .r-6 .grid-1 .g-2 {background-color:#332d57; padding:30px; text-align:left;}\n        .r-6 .grid-1 .g-2 .t {font-size:29px;margin-bottom:30px;}\n        .r-6 .grid-1 .g-2 .c {font-size:17px;margin-bottom:50px; line-height:150%;}\n        .r-6 .grid-1 .g-2 .img {width:100%; margin-bottom:30px;}\n        .r-6 .grid-2 {width:100%; margin-top:20px; margin-bottom:40px;}\n        .r-6 .grid-2 .g-1 {padding:40px 20px;}\n        .r-6 .grid-2 .g-1 .t {font-size:27px; margin-bottom:30px;}\n        .r-6 .grid-2 .g-1 .c {line-height:150%;}\n        .r-6 .grid-2 .g-2 {padding:30px 30px 0 30px; text-align:left;}\n        .r-6 .grid-2 .g-2 label {display:block; color:#869ae3; margin-bottom:5px;}\n        .r-6 .grid-2 .g-2 input {display:block; width:100%; border:1px solid #869ae3; border-radius:5px; padding:15px; margin-bottom:30px; color:white; background-color:#1a182e;}\n        .r-6 .grid-2 .g-2 .btn {border:none; color:white; background-color:#ed7a0d; cursor:pointer;}\n    }\n</style>\n</head>\n<body>\n    <div class=\"header\">\n        <a href=\"\"><img class=\"logo\" src=\"img/logo.webp\" alt=\"logo\"></a>\n        <img class=\"btn-menu\" src=\"img/menu.png\" alt=\"menu\"/>\n        <div class=\"menu\" id=\"menu\">\n            <a href=\"#\" class=\"link\" link=\"forBuyer\">For Buyer</a>\n            <a href=\"#\" class=\"link\" link=\"forSeller\">For Seller</a>\n            <a href=\"#\" class=\"link\" link=\"service\">Service</a>\n            <a href=\"#\" class=\"link\" link=\"businessMetrics\">Business Metrics</a>\n            <a href=\"#\" class=\"link\" link=\"about\">About</a>\n            <a href=\"#\" class=\"link\" link=\"contact\">Contact</a>\n            <a href=\"#\" class=\"close\"></a>\n        </div>\n    </div>\n    <div class=\"main\">\n        <div class=\"i-1\"><img src=\"img/bg-0.webp\" /></div>\n        <div class=\"section r-1\">\n            <div class=\"msg\">\n                <div class=\"t-1\"><span class=\"orange\">TPMN</span> AI-POWERED OPTIMIZATION TECHNOLOGY</div>                \n                <div class=\"t-2\">Bringing data-driven solution to get full efficiency over mobile advertising</div>\n                <div class=\"t-3\">\n                    Optimizing the value of programmatic mobile advertising for publishers, advertisers, and ad networks. A real-time prediction technology that uses privacy-compliant response data, massively accumulated user pattern machine learning, and proprietary digital formats to maximize the value of <span class=\"orange\">the omni-channel ad platform.</span>\n                </div>\n               \n            </div>\n        </div>\n        <div class=\"i-2\"><img src=\"img/is-1.webp\" /></div>\n        <div class=\"section r-2\">\n            <canvas class=\"video-bg\" id=\"canvas\"></canvas>\n            <video id=\"video\" width=\"640\" height=\"360\" autoplay muted loop style=\"display:none;\" >\n                <source src=\"img/bg-1.mp4\" type=\"video/mp4\">\n            </video>\n            <div class=\"msg\" id=\"forBuyer\">\n                <div class=\"t-1\">For Buyer</div>\n                <div class=\"t-2 orange\">What we provide</div>\n            </div>\n            <div class=\"grid\">\n                <div class=\"g-1\">\n                    <div class=\"c-1\">\n                        <img src=\"img/buyer-1.webp\"/>\n                    </div>\n                    <div class=\"c-2\">\n                        Industry-Leading Value Prediction Technology\n                    </div>\n                    <div class=\"c-3\">\n                        <div>\n                        Buy traffic beyond just impressions. Our AI-powered <span class=\"highlight\">TVPE (Traffic Value Prediction Engine)</span> accurately estimates the impression value probability in real-time, so your creatives are shown to users who have the best chance of engaging with them. Besides, robotic inventory curation technology enables you to optimize the budget.\n                        </div>\n                    </div>\n                </div>\n                <div class=\"g-1\">\n                    <div class=\"c-1\">\n                        <img src=\"img/buyer-2.webp\"/>\n                    </div>\n                    <div class=\"c-2\">\n                        Private Marketplaces (PMP)\n                    </div>\n                    <div class=\"c-3\">\n                        <div>\n                        Allow you to combine strengths of programmatic and direct buys: access to premium inventory that matches your targeting criteria and that may not be available in the Open Auction, and programmatic execution on bidding, to set the impression price within the pre-negotiated CPMs.\n                        </div>\n                    </div>\n                </div>\n                <div class=\"g-1\">\n                    <div class=\"c-1\">\n                        <img src=\"img/buyer-3.webp\"/>\n                    </div>\n                    <div class=\"c-2\">\n                        Transparency & Direct Accessibility\n                    </div>\n                    <div class=\"c-3\">\n                        <div>\n                        Satisfy specific campaign needs with viewability and unique demand in order to accelerate your business.   Besides, simplify, negotiate and implement priority deals by utilizing our real-time bidding.\n                        </div>\n  