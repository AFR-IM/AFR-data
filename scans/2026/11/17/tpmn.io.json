dth = video.videoWidth;\n            canvas.height = video.videoHeight;\n            function drawVideoFrame() {\n                ctx.drawImage(video, 0, 0, canvas.width, canvas.height);\n                var imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);\n                var data = imageData.data;\n                for (let i = 0; i < data.length; i += 4) {\n                    data[i] = data[i] + 36 - 10;     // 빨간색\n                    data[i + 1] = data[i + 1] + 26 - 40 ; // 녹색\n                    data[i + 2] = data[i + 2] + 56 - 30 ; // 파란색\n            }\n                ctx.putImageData(imageData, 0, 0);\n                requestAnimationFrame(drawVideoFrame);\n        }\n            video.play();\n            drawVideoFrame();\n        });\n\n        var video1 = $('#video1')[0];\n        var canvas1 = $('#canvas1')[0];\n        var ctx1 = canvas1.getContext('2d');\n        video1.addEventListener('loadeddata', function() {\n            canvas1.width = video1.videoWidth;\n            canvas1.height = video1.videoHeight;\n            function drawVideoFrame() {\n                ctx1.drawImage(video1, 0, 0, canvas1.width, canvas1.height);\n                var imageData = ctx1.getImageData(0, 0, canvas1.width, canvas1.height);\n                var data = imageData.data;\n                for (let i = 0; i < data.length; i += 4) {\n                    if ( data[i] < 170 && data[i + 1] < 170 && data[i + 2] < 170) data[i + 3] = 0 ;\n                    data[i] = data[i] + 250;\n                    data[i + 1] = data[i + 1] - 80;\n                    data[i + 2] = data[i + 2] - 200;\n            }\n                ctx1.putImageData(imageData, 0, 0);\n                requestAnimationFrame(drawVideoFrame);\n            }\n                video1.play();\n                drawVideoFrame();\n        });\n    }\n});\n\n// 폼 로드 시점의 타임스탬프 기록\nvar formRenderTime = Math.floor(Date.now() / 1000);\nvar isSubmitting = false;\n$(\"body\")\n.on(\"click\", \".link\", function(){\n    var id = $(this).attr(\"link\");\n    var to = $(\"#\"+id).offset().top - 110;\n    $('body, html').animate({\n        scrollTop: to\n    }, 500);\n    if ( $(document).width() < 500 ) $(\"#menu\").hide();\n    return false;\n})\n.on(\"click\", \"#contactSubmit\", function(e){\n    e.preventDefault();\n    if (isSubmitting) return false; // 중복 전송 방지\n    var $formContainer = $(this).closest(\"#contactForm\");\n    var data = {};\n    var isValid = true;\n    // 1. 필수 필드 유효성 검사 (name, email, comments)\n    var name = $.trim($formContainer.find(\"[name=name]\").val());\n    var email = $.trim($formContainer.find(\"[name=email]\").val());\n    var comments = $.trim($formContainer.find(\"[name=comments]\").val());\n    if (name === \"\") {\n        alert(\"Name is empty\");\n        $formContainer.find(\"[name=name]\").focus();\n        return false;\n    }\n    if (email === \"\") {\n        alert(\"Email is empty\");\n        $formContainer.find(\"[name=email]\").focus();\n        return false;\n    }\n    // 간단한 이메일 형식 정규식 검사\n    var emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n    if (!emailRegex.test(email)) {\n        alert(\"Please enter a valid email address.\");\n        $formContainer.find(\"[name=email]\").focus();\n        return false;\n    }\n    if (comments === \"\") {\n        alert(\"Comments is empty\");\n        $formContainer.find(\"[name=comments]\").focus();\n        return false;\n    }\n    // 2. 전체 데이터 취합 (허니팟 및 옵션 필드 포함)\n    data['name'] = name;\n    data['email'] = email;\n    data['cname'] = $.trim($formContainer.find(\"[name=cname]\").val());\n    data['ctype'] = $.trim($formContainer.find(\"[name=ctype]\").val());\n    data['comments'] = comments;\n    // 허니팟 필드 (사람은 빈 값, 봇은 채워서 보냄)\n    data['website_field'] = $.trim($formContainer.find(\"[name=website_field]\").val());\n    data['user_phone_confirm'] = $.trim($formContainer.find(\"[name=user_phone_confirm]\").val());\n    // 렌더링 타임스탬프 (3초 미만 봇 차단용)\n    data['form_rendered_time'] = formRenderTime;\n    // 3. 비동기 전송\n    var $submitBtn = $(this);\n    isSubmitting = true;\n    $submitBtn.prop(\"disabled\", true).val(\"Sending...\");\n    var url = \"contact.php\";\n    callAjax(url, data, function(res){\n        alert(\"Thanks for submitting!\");\n        // 폼 초기화\n        $formContainer.find(\"input[type=text], input[type=email], textarea\").val(\"\");\n        // 타임스탬프 재설정\n        formRenderTime = Math.floor(Date.now() / 1000);\n    }, function() {\n        // 완료 후 버튼 복구 (성공/실패 공통)\n        isSubmitting = false;\n        $submitBtn.prop(\"disabled\", false).val(\"Submit\");\n    });\n})\n.on(\"click\", \".btn-menu\", function(){\n    $(\"#menu\").slideDown();\n    return false;\n})\n.on(\"click\", \"a.close\", function(){\n    $(\"#menu\").hide();\n    return false;\n});\n// callAjax 함수 개선 (완료 콜백 completeCb 추가)\nfunction callAjax(url, data, callback, completeCb) {\n    $.ajax({\n        type: 'POST',\n        url: url,\n        data: data,\n        cache: false,\n        xhrFields: { withCredentials: true },\n        contentType: \"application/x-www-form-urlencoded\",\n        success: function(res){\n            if ($.trim(res) == \"ok\") {\n                callback(res);\n            } else {\n                alert(\"We are currently unavailable. Please try again later. We apologize for the inconvenience.\");\n            }\n        },\n        error: function(XMLHttpRequest, textStatus, errorThrown){\n            alert(\"We are currently unavailable. Please try again later. We apologize for the inconvenience.\");\n        },\n        complete: function() {\n            if (typeof completeCb === \"function\") {\n                completeCb();\n            }\n        }\n    });\n}\n\n</script>\n\n",
