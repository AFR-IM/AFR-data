is.closest('.el-tabs');\n\t\t\t\t\t\tconst items = parent.querySelectorAll('.el-tabs__item');\n\t\t\t\t\t\tconst panes = parent.querySelectorAll('.el-tab-pane');\n\n\t\t\t\t\t\titems.forEach(i => i.classList.remove('is-active'));\n\t\t\t\t\t\tpanes.forEach(p => p.classList.remove('is-active'));\n\n\t\t\t\t\t\tthis.classList.add('is-active');\n\t\t\t\t\t\tconst activeBar = parent.querySelector('.el-tabs__active-bar');\n\t\t\t\t\t\tactiveBar.style.left = this.offsetLeft + 'px';\n\t\t\t\t\t\tactiveBar.style.width = this.offsetWidth + 'px';\n\n\t\t\t\t\t\tdocument.getElementById(verify).classList.add('is-active');\n\t\t\t\t\t});\n\t\t\t\t});\n\n\t\t\t\tconst jumpLinks = document.querySelectorAll('.function-box-jump');\n\t\t\t\tjumpLinks.forEach(link => {\n\t\t\t\t\tlink.addEventListener('click', function (e) {\n\t\t\t\t\t\tconst targetId = this.getAttribute('href');\n\t\t\t\t\t\tif (targetId && targetId.startsWith('#')) {\n\t\t\t\t\t\t\te.preventDefault();\n\t\t\t\t\t\t\tconst targetElement = document.querySelector(targetId);\n\t\t\t\t\t\t\tif (targetElement) {\n\t\t\t\t\t\t\t\ttargetElement.scrollIntoView({ behavior: 'smooth' });\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t});\n\t\t\t\t});\n\t\t\t});\n\t\t</script>\n\t</div>\n\t<div class=\"copyright\"> Copyright 中国移动版权所有 <a href=\"https://beian.miit.gov.cn/#/Integrated/index\"\n\t\t\ttarget=\"_blank\">粤ICP备16124124号</a></div>\n</body>\n\n</html>",
