      "body": "<!DOCTYPE html>\r\n<html lang=\"ru\">\n<head>\r\n<meta charset=\"windows-1251\">\r\n<title>������ ���� ��������� - ����� ���� � �����, ���� ����, homm online ���� - ����� ����� � �����</title>\r\n<link rel=\"shortcut icon\" href=\"https://dcdn.heroeswm.ru/i/hwmicon.ico\">\r\n<meta name=\"google-site-verification\" content=\"QtJKI54O-Z7H1EBdQJTfUv4Va7qNqVMXTVNMd6PuUsU\" />\r\n<meta name=\"yandex-verification\" content=\"fd608f3f341620f6\" />\r\n<meta name=\"description\" content=\"&quot;����� ����� � �����&quot; - ��� ������� on-line ����, ���������� ����������� ��� � ������������� ���������.\">\r\n<meta name=\"keywords\" content=\"������, ����, ���������� ����, ������, �������, ������ ����, heroes, heroeswm, �����, online, on-line ���� � ������, ����� online, ����� ������, heroes online\">\r\n<meta property=\"og:image\" content=\"https://dcdn.heroeswm.ru/i/share_logo/logo_big.jpg\"/>\n<meta property=\"og:title\" content=\"������ ���� ����� ����� � �����\"/>\n<meta property=\"og:description\" content=\"&quot;����� ����� � �����&quot; - ��� ������� on-line ����, ���������� ����������� ��� � ������������� ���������.\"/>\n<meta property=\"og:site_name\" content=\"����� ����� � �����\"/>\n<meta name=\"twitter:card\" content=\"summary\" />\n<meta name=\"twitter:title\" content=\"������ ���� ����� ����� � �����\" />\n<meta name=\"twitter:image\" content=\"https://dcdn.heroeswm.ru/i/share_logo/logo_big.jpg\" />\n<style>\r\n\r\n.body {\r\n\tmargin-left: 0px;\r\n\tmargin-top: 0px;\r\n\tmargin-right: 0px;\r\n\tmargin-bottom: 0px;\r\n\tbackground-color:#000000;\r\n\tcolor:#ddbc8b;\r\n\tfont-size:14px;\r\n\tfont-family:Georgia, \"Times New Roman\", Times, serif;\r\n}\r\n\r\n/* The page is HTML5 (standards mode); the rules below keep the layout of the former quirks-mode page. */\r\nhtml, body {\r\n\theight: 100%;\r\n}\r\n\r\ntable {\r\n\tborder-spacing: 0;\r\n\t/* In quirks mode tables did not inherit these font settings from the page. */\r\n\tfont-size: medium;\r\n\tfont-weight: normal;\r\n\tfont-style: normal;\r\n\tfont-variant: normal;\r\n\tline-height: normal;\r\n\twhite-space: normal;\r\n\ttext-align: left;\r\n}\r\n\r\ntd {\r\n\tpadding: 0;\r\n}\r\n\r\n/* Pictures fill their cells without the room for letter tails below the text baseline. */\r\ntd > img {\r\n\tdisplay: block;\r\n}\r\n\r\n/* These stay inline, as on the former page, on top of a line without height: the enter button shows its alt text\r\n   in the same place when its picture fails to load, and the browser draws the videos and the login fields the\r\n   same way. The cells of the enter button and of the login fields set line-height:0 themselves. */\r\n#flashanim, #flask, .entergame {\r\n\tline-height: 0;\r\n}\r\n\r\n.entergame input, #flashanim video, #flask video {\r\n\tvertical-align: top;\r\n\tline-height: normal;\r\n}\r\n\r\n.txt{\r\n\tfont-family:Georgia, \"Times New Roman\", Times, serif;\r\n\tfont-size:14px;\r\n}\r\n\r\na, a:visited\r\n{\r\n\tcolor:#ff9900;\r\n\ttext-decoration : underline;\r\n}\r\na:hover\r\n{\r\n\tcolor:#ffffff;\r\n\ttext-decoration : none;\r\n}\r\n\r\n/** Menu **/\r\n\r\n.mainmenu {\r\n\twidth: 319px;\r\n\t/*float: left;*/\r\n\tmargin: 0px 0;\r\n}\r\n\r\n.mainmenu li {\r\n\tfloat: left;\r\n\tlist-style-type: none;\r\n\tposition: relative;\r\n}\r\n\r\n.mainmenu a {\r\n\tcolor: #666;\r\n\tfloat: left;\r\n\theight: 40px;\r\n\toverflow: hidden;\r\n\tposition: relative;\r\n\ttext-align: center;\r\n\ttext-decoration: none;\r\n\r\n}\r\n\r\n.mainmenu span {\r\n\tbackground-position: left top;\r\n\tbackground-repeat: no-repeat;\r\n\tcursor: pointer;\r\n\tdisplay: block;\r\n\theight: 40px;\r\n\tleft: 0;\r\n\tposition: absolute;\r\n\ttop: 0;\r\n\twidth: 100%;\r\n}\r\n\r\n.mainmenu a:hover {\r\n\tvisibility: visible; /* --- IE6 bugfix --- */\r\n}\r\n\r\n.mainmenu a:hover span {\r\n\tbackground-position: left bottom;\r\n}\r\n\r\n\r\n/** EnterGame **/\r\n\r\n.entergame {\r\n\twidth: 185px;\r\n\tfloat: left;\r\n\tmargin: 0px 0;\r\n}\r\n\r\n.entergame li {\r\n\tfloat: left;\r\n\tlist-style-type: none;\r\n\tposition: relative;\r\n}\r\n\r\n.entergame a {\r\n\tfloat: left;\r\n\theight: 52px;\r\n\toverflow: hidden;\r\n\tposition: relative;\r\n}\r\n\r\n.entergame span {\r\n\tbackground-position: left top;\r\n\tbackground-repeat: no-repeat;\r\n\tcursor: pointer;\r\n\tdisplay: block;\r\n\theight: 52px;\r\n\tleft: 0;\r\n\tposition: absolute;\r\n\ttop: 0;\r\n\twidth:185px;\r\n}\r\n\r\n.entergame a:hover {\r\n\tvisibility: visible; /* --- IE6 bugfix --- */\r\n}\r\n\r\n.entergame a:hover span {\r\n\tbackground-position: left bottom;\r\n}\r\n\r\n\r\n\r\n/** StartGame **/\r\n\r\n.startgame {\r\n\twidth: 207px;\r\n\tfloat: left;\r\n\tmargin: 0px 0;\r\n}\r\n\r\n.startgame li {\r\n\tfloat: left;\r\n\tlist-style-type: none;\r\n\tposition: relative;\r\n}\r\n\r\n.startgame a {\r\n\tfloat: left;\r\n\theight: 58px;\r\n\toverflow: hidden;\r\n\tposition: relative;\r\n}\r\n\r\n.startgame span {\r\n\tbackground-position: left top;\r\n\tbackground-repeat: no-repeat;\r\n\tcursor: pointer;\r\n\tdisplay: block;\r\n\theight: 58px;\r\n\tleft: 0;\r\n\tposition: absolute;\r\n\ttop: 0;\r\n\twidth:207px;\r\n}\r\n\r\n.startgame a:hover {\r\n\tvisibility: visible; /* --- IE6 bugfix --- */\r\n}\r\n\r\n.startgame a:hover span {\r\n\tbackground-position: left bottom;\r\n}\r\n\r\n/** TryGame **/\r\n\r\n.trygame {\r\n\twidth: 130px;\r\n\tfloat: left;\r\n\tmargin: 0px 0;\r\n}\r\n\r\n.trygame li {\r\n\tfloat: left;\r\n\tlist-style-type: none;\r\n\tposition: relative;\r\n}\r\n\r\n.trygame a {\r\n\tfloat: left;\r\n\theight: 94px;\r\n\toverflow: hidden;\r\n\tposition: relative;\r\n}\r\n\r\n.trygame span {\r\n\tbackground-position: left top;\r\n\tbackground-repeat: no-repeat;\r\n\tcursor: pointer;\r\n\tdisplay: block;\r\n\theight: 94px;\r\n\tleft: 0;\r\n\tposition: absolute;\r\n\ttop: 0;\r\n\twidth:130px;\r\n}\r\n\r\n.trygame a:hover {\r\n\tvisibility: visible; /* --- IE6 bugfix --- */\r\n}\r\n\r\n.trygame a:hover span {\r\n\tbackground-position: left bottom;\r\n}\r\n\r\n\r\n.playersonline{\r\n\tcolor:#fed8c3;\r\n\tfont-style:italic;\r\n\tfont-size:12px;\r\n}\r\n\r\n\r\n/** EnterWithSocial **/\r\n\r\n.social {\r\n\twidth: 28px;\r\n\tfloat: left;\r\n\tmargin: 0px 0;\r\n}\r\n\r\n.social li {\r\n\tfloat: left;\r\n\tlist-style-type: none;\r\n\tposition: relative;\r\n}\r\n\r\n.social a {\r\n\tfloat: left;\r\n\theight: 30px;\r\n\toverflow: hidden;\r\n\tposition: relative;\r\n}\r\n\r\n.social span {\r\n\tbackground-position: left top;\r\n\tbackground-repeat: no-repeat;\r\n\tcursor: pointer;\r\n\tdisplay: block;\r\n\theight: 30px;\r\n\tleft: 0;\r\n\tposition: absolute;\r\n\ttop: 0;\r\n\twidth:28px;\r\n}\r\n\r\n.social a:hover {\r\n\tvisibility: visible; /* --- IE6 bugfix --- */\r\n}\r\n\r\n.social a:hover span {\r\n\tbackground-position: left bottom;\r\n}\r\n\r\n\r\n/* Shared PNG frame: normal above, highlighted below. HD also serves older browsers. */\r\n.index_social {\r\n    height:30px;\r\n    text-align:center;\r\n    white-space:nowrap;\r\n    font-size:0;\r\n    line-height:0;\r\n}\r\n.index_social_link {\r\n    display:inline-block;\r\n    position:relative;\r\n    width:28px;\r\n    height:30px;\r\n    margin:0 1px;\r\n    vertical-align:top;\r\n}\r\n.index_social_icon {\r\n    position:absolute;\r\n    left:4px;\r\n    top:5px;\r\n    width:20px;\r\n    height:20px;\r\n    overflow:hidden;\r\n    border-radius:0;\r\n}\r\n.index_social_icon img {\r\n    display:block;\r\n    width:20px;\r\n    height:20px;\r\n    max-width:none;\r\n    border:0;\r\n    border-radius:0;\r\n}\r\n.index_social_frame {\r\n    display:block;\r\n    position:absolute;\r\n    left:0;\r\n    top:0;\r\n    width:28px;\r\n    height:30px;\r\n    background:url(https://dcdn.heroeswm.ru/i/index2012/social/frame_hd.png) no-repeat left top;\r\n    background-size:28px 60px;\r\n}\r\n/* Both PNG sets are oversampled for zoom; density selection never changes button geometry. */\r\n@media (-webkit-min-device-pixel-ratio:1.5), (min-resolution:144dpi) {\r\n    .index_social_frame {\r\n        background-image:url(https://dcdn.heroeswm.ru/i/index2012/social/frame_retina.png);\r\n    }\r\n}\r\n.index_social_link:hover .index_social_frame, .index_social_link:focus .index_social_frame {\r\n    background-position:left bottom;\r\n}\r\n.index_social_link:focus {\r\n    outline:1px solid #f4d98c;\r\n    outline-offset:1px;\r\n}\r\n/* Mouse focus does not stay highlighted; older browsers retain the keyboard focus fallback above. */\r\n.index_social_link:focus:not(:focus-visible) {\r\n    outline:none;\r\n}\r\n.index_social_link:focus:not(:focus-visible):not(:hover) .index_social_frame {\r\n    background-position:left top;\r\n}\r\n\r\n/** Arrows **/\r\n\r\n.arrows {\r\n\twidth: 43px;\r\n\tfloat: left;\r\n\tmargin: 0px 0;\r\n}\r\n\r\n.arrows li {\r\n\tfloat: left;\r\n\tlist-style-type: none;\r\n\tposition: relative;\r\n}\r\n\r\n.arrows a {\r\n\tfloat: left;\r\n\theight: 57px;\r\n\toverflow: hidden;\r\n\tposition: relative;\r\n}\r\n\r\n.arrows span {\r\n\tbackground-position: left top;\r\n\tbackground-repeat: no-repeat;\r\n\tcursor: pointer;\r\n\tdisplay: block;\r\n\theight: 57px;\r\n\tleft: 0;\r\n\tposition: absolute;\r\n\ttop: 0;\r\n\twidth:43px;\r\n}\r\n\r\n.arrows a:hover {\r\n\tvisibility: visible; /* --- IE6 bugfix --- */\r\n}\r\n\r\n.arrows a:hover span {\r\n\tbackground-position: left bottom;\r\n}\r\n\r\n\r\n\r\n/** Menu graphics **/\r\n\r\n.menu01 {\r\n\twidth: 106px;\r\n}\r\n\r\n.menu01 span {\r\n\tbackground-image: url(https://dcdn.heroeswm.ru/i/index2012/button_about.jpg);\r\n}\r\n\r\n.menu02 {\r\n\twidth: 93px;\r\n}\r\n\r\n.menu02 span {\r\n\tbackground-image: url(https://dcdn.heroeswm.ru/i/index2012/button_forum.jpg);\r\n}\r\n\r\n.menu03 {\r\n\twidth: 120px;\r\n}\r\n\r\n.menu03 span {\r\n\tbackground-image: url(https://dcdn.heroeswm.ru/i/index2012/button_rate.jpg);\r\n}\r\n.menu04 {\r\n\twidth: 185px;\r\n}\r\n.menu04 span {\r\n\tbackground-image: url(https://dcdn.heroeswm.ru/i/index2012/enter.jpg);\r\n}\r\n.menu05 {\r\n\twidth: 207px;\r\n}\r\n.menu05 span {\r\n\tbackground-image: url(https://dcdn.heroeswm.ru/i/index2012/start2.jpg);\r\n}\r\n.menu055 {\r\n\twidth: 207px;\r\n}\r\n.menu055 span {\r\n\tbackground-image: url(https://dcdn.heroeswm.ru/i/index2012/start.jpg);\r\n}\r\n.menu06 {\r\n\twidth: 130px;\r\n}\r\n.menu06 span {\r\n\tbackground-image: url(https://dcdn.heroeswm.ru/i/index2012/try.jpg);\r\n}\r\n.social_yandex {\r\n\twidth: 28px;\r\n\t/* The link text stays hidden even where the sprite is not drawn yet (an old cached or missing picture). */\r\n\tfont-size: 0;\r\n}\r\n.social_yandex span {\r\n\tbackground-image: url(https://dcdn.heroeswm.ru/i/index2012/enter_yandex.png);\r\n}\r\n.menu07 {\r\n\twidth: 28px;\r\n}\r\n.menu07 span {\r\n\tbackground-image: url(https://dcdn.heroeswm.ru/i/index2012/enter_mailru.jpg);\r\n}\r\n.menu08 {\r\n\twidth: 28px;\r\n}\r\n.menu08 span {\r\n\tbackground-image: url(https://dcdn.heroeswm.ru/i/index2012/enter_odnoklassniki.jpg);\r\n}\r\n.menu09 {\r\n\twidth: 28px;\r\n}\r\n.menu09 span {\r\n\tbackground-image: url(https://dcdn.heroeswm.ru/i/index2012/enter_vkontakte2.jpg);\r\n}\r\n.menu10 {\r\n\twidth: 28px;\r\n}\r\n.menu10 span {\r\n\tbackground-image: url(https://dcdn.heroeswm.ru/i/index2012/enter_google.jpg);\r\n}\r\n.social_steam {\r\n\twidth: 28px;\r\n\t/* The sprite has transparent margins: the link text must not show through them. */\r\n\tfont-size: 0;\r\n}\r\n.social_steam span {\r\n\tbackground-image: url(https://dcdn.heroeswm.ru/i/index2012/enter_steam.png);\r\n}\r\n.menu11 {\r\n\twidth: 43px;\r\n}\r\n.menu11 span {\r\n\tbackground-image: url(https://dcdn.heroeswm.ru/i/index2012/arrow_l.jpg);\r\n}\r\n.menu12 {\r\n\twidth: 43px;\r\n}\r\n.menu12 span {\r\n\tbackground-image: url(https://dcdn.heroeswm.ru/i/index2012/arrow_r.jpg);\r\n}\r\n\r\n\r\n/**** CLEANER ****/\r\n\r\n.cleaner {\r\n\tfont-size: 0;\r\n\tline-height: 0;\r\n\theight: 0;\r\n\tclear: both;\r\n}\r\n\r\n\r\n\r\n.inp_login{\r\n\tvertical-align:top;\r\n\tbackground-image:url(https://dcdn.heroeswm.ru/i/index2012/login.jpg);\r\n\tbackground-color:transparent;\r\n\tcolor:#ddbc8b;\r\n    text-align:center;\r\n\tfont-family:Georgia, \"Times New Roman\", Times, serif;\r\n\tfont-size:12px;\r\n\tborder: 0px;\r\n\tpadding: 0px;\r\n\tmargin: 0px;\r\n\twidth:100%;\r\n\theight:100%;\r\n}\r\n.inp_login:focus {\r\n    outline: none;\r\n}\r\n\r\n.inp_pass{\r\n\tvertical-align:top;\r\n\tbackground-image:url(https://dcdn.heroeswm.ru/i/index2012/login.jpg);\r\n\tbackground-color:transparent;\r\n\tcolor:#ddbc8b;\r\n    text-align:center;\r\n\tfont-family:Georgia, \"Times New Roman\", Times, serif;\r\n\tfont-size:12px;\r\n\tborder: 0px;\r\n\tpadding: 0px;\r\n\tmargin: 0px;\r\n\twidth:100%;\r\n\theight:100%;\r\n}\r\n.inp_pass:focus {\r\n    outline: none;\r\n}\r\n\r\n/* Keep native hints as bright as the legacy field values, including older browsers. */\r\n.inp_login::-webkit-input-placeholder, .inp_pass::-webkit-input-placeholder {\r\n    color:#ddbc8b;\r\n    opacity:1;\r\n}\r\n.inp_login:-moz-placeholder, .inp_pass:-moz-placeholder {\r\n    color:#ddbc8b;\r\n    opacity:1;\r\n}\r\n.inp_login::-moz-placeholder, .inp_pass::-moz-placeholder {\r\n    color:#ddbc8b;\r\n    opacity:1;\r\n}\r\n.inp_login:-ms-input-placeholder, .inp_pass:-ms-input-placeholder {\r\n    color:#ddbc8b;\r\n    opacity:1;\r\n}\r\n.inp_login::-ms-input-placeholder, .inp_pass::-ms-input-placeholder {\r\n    color:#ddbc8b;\r\n    opacity:1;\r\n}\r\n.inp_login::placeholder, .inp_pass::placeholder {\r\n    color:#ddbc8b;\r\n    opacity:1;\r\n}\r\n\r\n/* Hide only the hint on focus; never erase typed or autofilled credentials. */\r\n.inp_login:focus::-webkit-input-placeholder, .inp_pass:focus::-webkit-input-placeholder {\r\n    color:transparent;\r\n    opacity:0;\r\n}\r\n.inp_login:focus:-moz-placeholder, .inp_pass:focus:-moz-placeholder {\r\n    color:transparent;\r\n    opacity:0;\r\n}\r\n.inp_login:focus::-moz-placeholder, .inp_pass:focus::-moz-placeholder {\r\n    color: