none;-ms-overflow-style:none;}\n.tabs-menu-2::-webkit-scrollbar{display:none;}\n.tabs-menu-2.has-overflow-end{-webkit-mask-image:linear-gradient(to right,#000 0,#000 calc(100% - 64px),transparent 100%);mask-image:linear-gradient(to right,#000 0,#000 calc(100% - 64px),transparent 100%);}\n.tabs-menu-2.has-overflow-start{-webkit-mask-image:linear-gradient(to right,transparent 0,#000 40px,#000 100%);mask-image:linear-gradient(to right,transparent 0,#000 40px,#000 100%);}\n.tabs-menu-2.has-overflow-start.has-overflow-end{-webkit-mask-image:linear-gradient(to right,transparent 0,#000 40px,#000 calc(100% - 64px),transparent 100%);mask-image:linear-gradient(to right,transparent 0,#000 40px,#000 calc(100% - 64px),transparent 100%);}\n.tabs-menu-2.has-overflow-end::after{content:'';position:sticky;right:0;flex:0 0 auto;align-self:center;width:9px;height:9px;margin-left:4px;border-right:2px solid currentColor;border-bottom:2px solid currentColor;transform:rotate(-45deg);opacity:.5;pointer-events:none;}\n</style>\n<script>\n(function(){\n  function wire(){\n    document.querySelectorAll('.tabs-menu-2').forEach(function(m){\n      if(m.dataset.fadeWired) return;\n      m.dataset.fadeWired='1';\n      function upd(){\n        var scrollable=m.scrollWidth-m.clientWidth>2;\n        var atEnd=m.scrollLeft+m.clientWidth>=m.scrollWidth-2;\n        m.classList.toggle('has-overflow-end',scrollable&&!atEnd);\n        m.classList.toggle('has-overflow-start',m.scrollLeft>2);\n      }\n      upd();\n      m.addEventListener('scroll',upd,{passive:true});\n      window.addEventListener('resize',upd);\n      if(window.ResizeObserver){new ResizeObserver(upd).observe(m);}\n    });\n  }\n  if(document.readyState!=='loading'){wire();}else{document.addEventListener('DOMContentLoaded',wire);}\n})();\n</script></div></div><div id=\"announcement-container\"><div class=\"w-embed w-script\"><script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n  let hostname = window.location.hostname;\n  // Endpoint URL\n  const endpoint = `https://${hostname}/api/v1/announcement`;\n\n  // Fetch data from the API\n  fetch(endpoint)\n    .then((response) => {\n      if (!response.ok) {\n        throw new Error(`Network response was not ok: ${response.statusText}`);\n      }\n      return response.json();\n    })\n    .then((data) => {\n      // If no announcement is returned, exit early\n      if (!data || !data.body) {\n        console.log(\"No announcement to display.\");\n        return;\n      }\n      \n      document.querySelector(\".w-embed.w-script\").style.display = \"none\";\n\n      const announcementContainer = document.querySelector(\"#announcement-container\")\n      announcementContainer.style.padding = \"24px\";\n      announcementContainer.style.backgroundColor = \"#FEF5E6\";\n      announcementContainer.style.display = \"flex\";\n      announcementContainer.style.gap = \"24px\";\n      announcementContainer.style.fontSize = \"16px\";\n      announcementContainer.style.justifyContent = \"space-between\";\n      announcementContainer.style.alignItems = \"center\";\n      announcementContainer.style.lineHeight = \"24px\";\n      announcementContainer.style.position = \"relative\";\n      announcementContainer.style.zIndex = \"1000\";\n\n      // Inject the body content into the container\n      const announcementContent = document.createElement(\"span\");\n      announcementContent.innerHTML = data.body;\n\n      // Add the dismiss button\n      const dismissButton = document.createElement(\"button\");\n      dismissButton.id = \"dismiss-announcement\";\n      dismissButton.innerHTML = `<svg style=\"width:1em;height:1em;\" viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M13 1L1 13M1 1L13 13\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>`;\n\t\t\tdismissButton.ariaLabel = \"Dismiss announcement\";\n      \n      // Add dismiss functionality\n      dismissButton.addEventListener(\"click\", function () {\n        hideAnnouncement(data.cookieKey);\n      });\n\n      // Append content and button to the container\n      announcementContainer.appendChild(announcementContent);\n      announcementContainer.appendChild(dismissButton);      \n    })\n    .catch((error) => {\n      console.error(\"Failed to fetch announcement:\", error);\n    });\n\n  // Function to hide the announcement and set a cookie\n  function hideAnnouncement(announcement_key) {\n    const announcement = document.getElementById(\"announcement-container\");\n    if (announcement) {\n      announcement.remove(); // Remove the announcement from the DOM\n    }\n\n    // Set a cookie to indicate the announcement has been dismissed\n    createCookie(announcement_key, \"hidden\", 365);\n  }\n\n  // Utility function to create a cookie\n  function createCookie(name, value, days) {\n    let expires = \"\";\n    if (days) {\n      const date = new Date();\n      date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);\n      expires = \"; expires=\" + date.toGMTString();\n    }\n    document.cookie = `${name}=${value}${expires}; path=/`;\n  }\n});\n</script></div></div><div data-lenis-prevent=\"\" data-animation=\"default\" data-collapse=\"all\" data-duration=\"800\" data-easing=\"ease-in-out-cubic\" data-easing2=\"ease-in-out-cubic\" role=\"banner\" class=\"nav w-nav\"><div data-lenis-prevent=\"\" class=\"signup_modal-component\"><div class=\"signup_modal-wrapper\"><div fs-scrolldisable-element=\"enable\" data-w-id=\"dbdaf6c1-455b-36c5-ec17-17ab00f1128e\" class=\"signup_modal-close-button w-embed\"><svg width=\"100%\" height=\"100%\" viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M13 1L1 13M1 1L13 13\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n</svg></div><div class=\"signup_form-modal-heading u-columns-10 u-text-align-center\"><div class=\"signup_form-modal-title 