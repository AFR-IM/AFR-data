argin-top: 0 !important;\n}\n\n/* Get rid of bottom margin on last element in any rich text element */\n.w-richtext>:last-child, .w-richtext ol li:last-child, .w-richtext ul li:last-child {\n\tmargin-bottom: 0 !important;\n}\n\n/* Prevent all click and hover interaction with an element */\n.pointer-events-off {\n\tpointer-events: none;\n}\n\n/* Enables all click and hover interaction with an element */\n.pointer-events-on {\n  pointer-events: auto;\n}\n\n/* Create a class of .div-square which maintains a 1:1 dimension of a div */\n.div-square::after {\n\tcontent: \"\";\n\tdisplay: block;\n\tpadding-bottom: 100%;\n}\n\n/* Make sure containers never lose their center alignment */\n.container-medium,.container-small, .container-large {\n\tmargin-right: auto !important;\n  margin-left: auto !important;\n}\n\n/* \nMake the following elements inherit typography styles from the parent and not have hardcoded values. \nImportant: You will not be able to style for example \"All Links\" in Designer with this CSS applied.\nUncomment this CSS to use it in the project. Leave this message for future hand-off.\n*/\n/*\na,\n.w-input,\n.w-select,\n.w-tab-link,\n.w-nav-link,\n.w-dropdown-btn,\n.w-dropdown-toggle,\n.w-dropdown-link {\n  color: inherit;\n  text-decoration: inherit;\n  font-size: inherit;\n}\n*/\n\n/* Apply \"...\" after 3 lines of text */\n.u-line-clamp-3 {\n\tdisplay: -webkit-box;\n\toverflow: hidden;\n\t-webkit-line-clamp: 3;\n\t-webkit-box-orient: vertical;\n}\n\n/* Apply \"...\" after 2 lines of text */\n.u-line-clamp-2 {\n\tdisplay: -webkit-box;\n\toverflow: hidden;\n\t-webkit-line-clamp: 2;\n\t-webkit-box-orient: vertical;\n}\n\n/* Apply \"...\" after 1 line of text */\n.u-line-clamp-1 {\n\tdisplay: -webkit-box;\n\toverflow: hidden;\n\t-webkit-line-clamp: 1;\n\t-webkit-box-orient: vertical;\n}\n\n/* Adds inline flex display */\n.display-inlineflex {\n  display: inline-flex;\n}\n\n/* These classes are never overwritten */\n.hide {\n  display: none !important;\n}\n\n@media screen and (max-width: 991px) {\n    .hide, .hide-tablet {\n        display: none !important;\n    }\n}\n  @media screen and (max-width: 767px) {\n    .hide-mobile-landscape{\n      display: none !important;\n    }\n}\n  @media screen and (max-width: 479px) {\n    .hide-mobile{\n      display: none !important;\n    }\n}\n \n.margin-0 {\n  margin: 0rem !important;\n}\n  \n.padding-0 {\n  padding: 0rem !important;\n}\n\n.spacing-clean {\npadding: 0rem !important;\nmargin: 0rem !important;\n}\n\n.margin-top {\n  margin-right: 0rem !important;\n  margin-bottom: 0rem !important;\n  margin-left: 0rem !important;\n}\n\n.padding-top {\n  padding-right: 0rem !important;\n  padding-bottom: 0rem !important;\n  padding-left: 0rem !important;\n}\n  \n.margin-right {\n  margin-top: 0rem !important;\n  margin-bottom: 0rem !important;\n  margin-left: 0rem !important;\n}\n\n.padding-right {\n  padding-top: 0rem !important;\n  padding-bottom: 0rem !important;\n  padding-left: 0rem !important;\n}\n\n.margin-bottom {\n  margin-top: 0rem !important;\n  margin-right: 0rem !important;\n  margin-left: 0rem !important;\n}\n\n.padding-bottom {\n  padding-top: 0rem !important;\n  padding-right: 0rem !important;\n  padding-left: 0rem !important;\n}\n\n.margin-left {\n  margin-top: 0rem !important;\n  margin-right: 0rem !important;\n  margin-bottom: 0rem !important;\n}\n  \n.padding-left {\n  padding-top: 0rem !important;\n  padding-right: 0rem !important;\n  padding-bottom: 0rem !important;\n}\n  \n.margin-horizontal {\n  margin-top: 0rem !important;\n  margin-bottom: 0rem !important;\n}\n\n.padding-horizontal {\n  padding-top: 0rem !important;\n  padding-bottom: 0rem !important;\n}\n\n.margin-vertical {\n  margin-right: 0rem !important;\n  margin-left: 0rem !important;\n}\n  \n.padding-vertical {\n  padding-right: 0rem !important;\n  padding-left: 0rem !important;\n}\n\n/* Apply \"...\" at 100% width */\n.truncate-width { \n\t\twidth: 100%; \n    white-space: nowrap; \n    overflow: hidden; \n    text-overflow: ellipsis; \n}\n/* Removes native scrollbar */\n.no-scrollbar {\n    -ms-overflow-style: none;\n    overflow: -moz-scrollbars-none; \n}\n\n.no-scrollbar::-webkit-scrollbar {\n    display: none;\n}\n\n</style></div><div class=\"page_code_responsive w-embed\"><style>\n/* https://fluidbuilder.webflow.io/?design=90&max=90&min=20&f&g=--site--margin,3,1_--size--2rem,2,1.75_--size--2-5rem,2.5,2_--size--3rem,3,2.25_--size--3-5rem,3.5,2.375_--size--4rem,4,2.5_--size--4-5rem,4.5,2.75_--size--5rem,5,3_--size--5-5rem,5.5,3.25_--size--6rem,6,3.5_--size--6-5rem,6.5,3.75_--size--7rem,7,4_--size--7-5rem,7.5,4.25_--size--8rem,8,4.5_--size--8-5rem,8.5,4.75_--size--9rem,9,5_--size--9-5rem,9.5,5.25_--size--10rem,10,5.5_--size--11rem,11,5.75_--size--12rem,12,6_--size--13rem,13,6.5_--size--14rem,14,7_--size--15rem,15,7.5_--size--16rem,16,8 */\n\n:root {\n\t--site--margin: clamp(1rem, 0.428rem + 2.86vw, 3rem);\n\t--size--2rem: clamp(1.75rem, 1.678rem + 0.36vw, 2rem);\n\t--size--2-5rem: clamp(2rem, 1.858rem + 0.71vw, 2.5rem);\n\t--size--3rem: clamp(2.25rem, 2.036rem + 1.07vw, 3rem);\n\t--size--3-5rem: clamp(2.375rem, 2.053rem + 1.61vw, 3.5rem);\n\t--size--4rem: clamp(2.5rem, 2.072rem + 2.14vw, 4rem);\n\t--size--4-5rem: clamp(2.75rem, 2.25rem + 2.5vw, 4.5rem);\n\t--size--5rem: clamp(3rem, 2.428rem + 2.86vw, 5rem);\n\t--size--5-5rem: clamp(3.25rem, 2.608rem + 3.21vw, 5.5rem);\n\t--size--6rem: clamp(3.5rem, 2.786rem + 3.57vw, 6rem);\n\t--size--6-5rem: clamp(3.75rem, 2.964rem + 3.93vw, 6.5rem);\n\t--size--7rem: clamp(4rem, 3.142rem + 4.29vw, 7rem);\n\t--size--7-5rem: clamp(4.25rem, 3.322rem + 4.64vw, 7.5rem);\n\t--size--8rem: clamp(4.5rem, 3.5rem + 5vw, 8rem);\n\t--size--8-5rem: clamp(4.75rem, 3.678rem + 5.36vw, 8.5rem);\n\t--size--9rem: clamp(5rem, 3.858rem + 5.71vw, 9rem);\n\t--size--9-5rem: clamp(5.25rem, 4.036rem + 6.07vw, 9.5rem);\n\t--size--10rem: clamp(5.5rem, 4.214rem + 6.43vw, 10rem);\n\t--size--11rem: clamp(5.75rem, 4.25rem + 7.5vw, 11rem);\n\t--size--12rem: clamp(6rem, 4.286rem + 8.57vw, 12rem);\n\t--size--13rem: clamp(6.5rem, 4.642rem + 9.29vw, 13rem);\n\t--size--14rem: clamp(7rem, 5rem + 10vw, 14rem);\n\t--size--15rem: clamp(7.5rem, 5.358rem + 10.71vw, 15rem);\n\t--size--16rem: clamp(8rem, 5.714rem + 11.43vw, 16rem);\n}\n\n\n/* desktop */\n:root {\n\t/* custom */\n}\n/* tablet */\n@media screen and (max-width: 991px) {\n\t:root {\n\t\t\t/* Component top and bottom padding for tablet */\n\t\t--section-spacing--none: 0;\n\t\t--section-spacing--xs: 0.875rem;\n    --section-spacing--small: 1.75rem;\n    --section-spacing--medium: 3rem;\n    --section-spacing--large: 4rem;\n    --section-spacing--xl: 6rem;\n}\n/* landscape */\n@media screen and (max-width: 767px) {\n\t:root {\n\t\t/* Component top and bottom padding for landscape */\n\t\t--section-spacing--none: 0;\n\t\t--section-spacing--xs: 0.75rem;\n    --section-spacing--small: 1.25rem;\n    --section-spacing--medium: 2.5rem;\n    --section-spacing--large: 3rem;\n    --section-spacing--xl: 5rem;\n\t}\n}\n/* portrait */\n@media screen and (max-width: 479px) {\n\t:root {\n\t\t/* Component top and bottom padding for portrait */\n\t\t--section-spacing--none: 0;\n\t\t--section-spacing--xs: 0.75rem;\n    --section-spacing--small: 1.5rem;\n    --section-spacing--medium: 2rem;\n    --section-spacing--large: 3rem;\n    --section-spacing--xl: 4rem;\n\t}\n}\n</style></div><div class=\"w-embed w-script\"><style>\n.tabs-menu-2{overflow-x:auto;overflow-y:hidden;flex-wrap:nowrap;scrollbar-width:none;-ms-overflow-style:none;}\n.tabs-menu-2::-webkit-scrollbar{display:none;}\n.tabs-menu-2.has-overflow-end{-webkit-mask-image:linear-gradient(to right,#000 0,#000 calc(100% - 64px),transparent 100%);mask-image:linear-gradient(to right,#000 0,#000 calc(100% - 64px),transparent 100%);}\n.tabs-menu-2.has-overflow-start{-webkit-mask-image:linear-gradient(to right,transparent 0,#000 40px,#000 100%);mask-image:linear-gradient(to right,transparent 0,#000 40px,#000 100%);}\n.tabs-menu-2.has-overflow-start.has-overflow-end{-webkit-mask-image:linear-gradient(to right,transparent 0,#000 40px,#000 calc(100% - 64px),transparent 100%);mask-image:linear-gradient(to right,transparent 0,#000 40px,#000 calc(100% - 64px),transparent 100%);}\n.tabs-menu-2.has-overflow-end::after{content:'';position:sticky;right:0;flex:0 0 auto;align-self:center;width:9px;height:9px;margin-left:4px;border-right:2px solid currentColor;border-bottom:2px solid currentColor;transform:rotate(-45deg);opacity:.5;pointer-events:none;}\n</style>\n<script>\n(function(){\n  function wire(){\n    document.querySelectorAll('.tabs-menu-2').forEach(function(m){\n      if(m.dataset.fadeWired) return;\n      m.dataset.fadeWired='1';\n      function upd(){\n        var scrollable=m.scrollWidth-m.clientWidth>2;\n        var atEnd=m.scrollLeft+m.clientWidth>=m.scrollWidth-2;\n        m.classList.toggle('has-overflow-end',scrollable&&!atEnd);\n        m.classList.toggle('has-overflow-start',m.scrollLeft>2);\n      }\n      upd();\n      m.addEventListener('scroll',upd,{passive:true});\n      window.addEventListener('resize',upd);\n      if(window.ResizeObserver){new ResizeObserver(upd).observe(m);}\n    });\n  }\n  if(document.readyState!=='loading'){wire();}else{document.addEventListener('DOMContentLoaded',wire);}\n})();\n</script></div></div><script src=\"https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=6751e31f9aaa082b0f7234ec\" type=\"text/javascript\" integrity=\"sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=\" crossorigin=\"anonymous\"></script><script src=\"https://cdn.prod.website-files.com/6751e31f9aaa082b0f7234ec/js/commonlit-0ab3c1-54e527d2d409034703b0a7.schunk.181a2070a530b302.js\" type=\"text/javascript\" integrity=\"sha384-JWdgqTXFub/8eKOkMquT9MN7nnkFfqj2IsxHNIv8W+n3NdpIA3X+EZEx+ykmtOKR\" crossorigin=\"anonymous\"></script><script src=\"https://cdn.prod.website-files.com/6751e31f9aaa082b0f7234ec/js/commonlit-0ab3c1-54e527d2d409034703b0a7.schunk.13bcac2531667ed0.js\" type=\"text/javascript\" integrity=\"sha384-/HXdj4Nu0l97jyDBVvtu+srrr8oYZ2wEyKbaI12VqqhKw19anDg0P+lDqQp5MF22\" crossorigin=\"anonymous\"></script><script src=\"https://cdn.prod.website-files.com/6751e31f9aaa082b0f7234ec/js/commonlit-0ab3c1-54e527d2d409034703b0a7.schunk.46923f3be03944d9.js\" type=\"text/javascript\" integrity=\"sha384-KRnC+j7QzPxF80j5Jp5lLtjtI7HBx+9pMyAzDWhOrnMcO6sLfMr2IVbocPERDjVf\" crossorigin=\"anonymous\"></script><script src=\"https://cdn.prod.website-files.com/6751e31f9aaa082b0f7234ec/js/commonlit-0ab3c1-54e527d2d409034703b0a7.bd4d119b.6fef26c6aa2863d3.js\" type=\"text/javascript\" integrity=\"sha384-+UTW/IdTjgurwKSa4Hqa7p977m4/ys2CDOzyisFMLSvrujy6SZBAOMVLzB3vRa5K\" crossorigin=\"anonymous\"></script><script src=\"https://cdn.prod.website-files.com/gsap/3.15.0/gsap.min.js\" type=\"text/javascript\"></script><!-- Turn off native Webflow animations for reduced motion settings -->\n<!--\n<script>\n\t// Cancel Webflow animations for users who prefer reduced motion\n\tif (window.matchMedia(\"(prefers-reduced-motion)\").matches) {\n\t\tconst cancelAnimationsInterval = setInterval(function () {\n\t\t\tif (typeof Webflow == \"undefined\" || typeof Webflow.require == \"undefined\") {\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\tclearInterval(cancelAnimationsInterval);\n\n\t\t\t// Get the interactions data from Webflow's state\n\t\t\tconst interactionsData = Webflow.require('ix2').store.getState().ixData;\n\t\t\t// Filter out all non-click events from the interactions\n\t\t\tinteractionsData.events = Object.fromEntries(\n\t\t\t\tObject.entries(interactionsData.events).filter(eventEntry => {\n\t\t\t\t\treturn /^MOUSE_.*CLICK$/.test(eventEntry[1].eventTypeId);\n\t\t\t\t})\n\t\t\t);\n\t\t\t// Put the data in the format that Webflow expects it\n\t\t\tinteractionsData.site = { mediaQueries: interactionsData.mediaQueries };\n\n\t\t\t// Stop Webflow's handling of animations\n\t\t\tWebflow.require(\"ix2\").destroy();\n\n\t\t\t// Reset the inline styles for every element that has already been initialized\n\t\t\tconst animatedElementsSelector = \"[style*='will-change'], [style*='opacity: 0']\";\n\t\t\tfor (const animatedEl of document.querySelectorAll(animatedElementsSelector)) {\n\t\t\t\tanimatedEl.style = \"\";\n\t\t\t}\n\n\t\t\t// Re-initialize Webflow interactions for click-related events only\n\t\t\tWebflow.require('ix2').init(interactionsData);\n\t\t}, 10);\n\t}\n</script>\n-->\n\n<!-- HubSpot Form Embed Script -->\n<script\n  charset=\"utf-8\"\n  type=\"text/javascript\"\n  src=\"//js.hsforms.net/forms/embed/v2.js\"\n  async\n  defer\n  crossorigin=\"anonymous\"\n></script>\n\n<!-- Hubform -->\n<script\n  src=\"https://cdn.jsdelivr.net/gh/oimachistudio/hubform@latest/hubform.js?hubspot_region=na1&hubspot_portalId=22070921&key=a1va2TjlfObm\"\n  crossorigin=\"anonymous\"\n></script>\n\n<script>\n  hubformSettings({\n\tanimationType: 'fade',\n\tdelay: 800\n  });\n</script>\n\n<!-- Hubspot Tracking Pixel - Added by Lydia 2.25.25 -->\n<script>\nrunUnlessCookieIsTrue('__cl_no_marketing', function() {\n  script = document.createElement('script');\n  script.type = 'text/javascript';\n  script.id = \"hs-script-loader\";\n  script.async = true;\n  script.defer = true;\n  script.src = 'https://js.hs-scripts.com/22070921.js';\n  document.getElementsByTagName('head')[0].appendChild(script);\n});\n</script>\n\n<!-- Cookie.js -->\n<script\n  defer\n  src=\"https://cdn.jsdelivr.net/npm/js-cookie@3.0.5/dist/js.cookie.min.js\"\n  crossorigin=\"anonymous\"\n></script>\n\n<!-- Helper: Send Hubspot form data to PostHog via Rails API -->\n<script>\n  function captureHubSpotFormSubmissionToPostHog({ hubSpotFormId, pathName, submissionValues }) {\n    return fetch('/api/v1/post_hog/form_submissions', {\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application/json',\n      },\n      body: JSON.stringify({\n        hubspot_form_submission_values: submissionValues,\n        hubspot_form_id: hubSpotFormId,\n        distinct_id: posthog.get_distinct_id(), // Brooks 07/14/2025 - Added for PR #32376\n        path_name: pathName,\n      }),\n    })\n    .then(() => true)\n    .catch((error) => {\n      console.error('Error capturing HubSpot form submission:', error);\n      return false;\n    })\n  }\n</script>\n\n<!-- Attach MutationObserver to Hubspot form to set lead source and capture modal form submission -->\n<script>\n  const getLeadSource = (pathname, search) => {\n    const leadSources = {\n      '': 'Web: Home Page',\n      '/about': 'Web: About Page',\n      '/benchmark-assessments': 'Web: Benchmark Assessments Page',\n      '/contact': 'Web: Contact Page',\n      '/ela-curriculum': 'Web: ELA Curriculum Page',\n      '/ela-curriculum-pilot': 'Web: Pilot Page',\n      '/impact': 'Web: Impact Page',\n      '/pricing': 'Web: Pricing Page',\n      '/professional-development': 'Web: 360 PD',\n      '/rostering-and-lms-integrations': 'Web: Integrations Page',\n      '/state-resources': 'Web: State Resources',\n      '/georgia': 'Web: GA Page',\n      '/illinois': 'Web: IL Page',\n      '/new-york': 'Web: NY Page',\n      '/ohio': 'Web: OH Page',\n      '/new-jersey': 'Web: NJ Page',\n      '/webinars': 'Web: Webinars',\n      '/ela-teacher-resources': 'Web: ELA Teacher Resources Page',\n      '/workbooks': 'Web: Workbooks Page',\n      '/wisconsin': 'Web: WI Page',\n      '/north-carolina': 'Web: NC Page',\n      '/california': 'Web: CA Page',\n      '/washington': 'Web: WA Page',\n      '/washington': 'Web: WA Page',\n      '/text-library': 'Web: Text Library',\n      '/skills-lessons': 'Web: Target Lessons',\n    };\n\n    const params = new URLSearchParams(search);\n    const channel = params.get('channel');\n    if (channel && typeof channel === 'string') {\n      return channel;\n    }\n\n    const canonicalPath = pathname.replace(/\\/$/, ''); // Remove trailing slash, if any\n    return (\n      Object.entries(leadSources).find(([path]) => canonicalPath === path)?.[1] ??\n      `Web: ${pathname}`\n    );\n  };\n\n  const pathname = window.location.pathname;\n  const search = window.location.search;\n  const leadSource = getLeadSource(pathname, search);\n\n  let observer = null;\n\n  const attachObserverToModal = () => {\n    const modalWrapper = document.querySelector(\"[hf-modal='wrapper']\");\n    const modalContainer = document.querySelector(\"article[hf-modal='hubspot-form']\");\n\n    if (modalContainer && modalWrapper) {\n      observer = new MutationObserver((mutationsList, observer) => {\n        for (const mutation of mutationsList) {\n          if (mutation.type === \"childList\") {\n            mutation.addedNodes.forEach((node) => {\n              if (node.matches && node.matches(\"form\")) {\n                // Find modal to set the focus on the first element in the form\n                findModal($(modalWrapper));\n\n                // Set lead source input value\n                const leadSourceInput = node.querySelector(\"[name='leadsource']\");\n\n                if (leadSourceInput) {\n                  leadSourceInput.value = decodeURIComponent(leadSource);\n                } else {\n                  console.error(\"[Error][Modal]: Input element with name 'leadsource' not found in the form.\");\n                }\n\n                // Attach submit event listener to form to create Posthog custom event\n                node.addEventListener(\"submit\", (event) => {\n                  const formData = new FormData(node);\n                  const submissionValues = Object.fromEntries(formData.entries());\n\n                  captureHubSpotFormSubmissionToPostHog({\n                    hubSpotFormId: node.getAttribute(\"data-form-id\") || \"unknown-modal-form-id\",\n                    pathName: window.location.pathname,\n                    submissionValues,\n                  });\n                });\n              }\n            });\n          }\n        }\n      });\n\n      observer.observe(modalContainer, {\n        childList: true,\n      });\n    } else {\n      console.log(\"[Debug][Modal]: Modal not found, will retry.\");\n    }\n  };\n\n  // Polling function to detect when the modal reappears\n  const startPollingForModal = () => {\n    const interval = setInterval(() => {\n      const modalContainer = document.querySelector(\"article[hf-modal='hubspot-form']\");\n      if (modalContainer && !observer) {\n        attachObserverToModal();  // Attach observer if modal exists\n      }\n    }, 500); // Check every 500ms\n\n    // Stop polling after some time to avoid infinite checks\n    setTimeout(() => {\n      clearInterval(interval);\n    }, 30000); // Stop after 30 seconds\n  };\n\n  document.addEventListener(\"DOMContentLoaded\", startPollingForModal);\n</script>\n\n<!-- Webflow / Hubspot Integration - Load Custom Thank You -->\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    const form = document.querySelector('.form_block-wrap');\n    const thankYouMessage = document.querySelector('.form_thank-you');\n\n    if (form) {\n      form.addEventListener('submit', function(e) {\n      e.preventDefault();\n\n      // Show thank you message\n      thankYouMessage.style.display = 'block';\n\n      // Hide the form (you may need to adjust the selector)\n      form.style.display = 'none';\n\n      // You can add additional animations here if desired\n      // For example:\n      // form.style.opacity = '0';\n      // thankYouMessage.style.opacity = '1';\n      });\n    }\n  });\n</script>\n\n<!-- LinkedIn - Added by Lydia 2.24.25-->\n<script type=\"text/javascript\">\nrunUnlessCookieIsTrue('__cl_no_marketing', function() {\n_linkedin_partner_id = \"4958868\"; window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || []; window._linkedin_data_partner_ids.push(_linkedin_partner_id); (function(l) { if (!l){window.lintrk = function(a,b){window.lintrk.q.push([a,b])}; window.lintrk.q=[]} var s = document.getElementsByTagName(\"script\")[0]; var b = document.createElement(\"script\"); b.type = \"text/javascript\";b.async = true; b.src = \"https://snap.licdn.com/li.lms-analytics/insight.min.js\"; s.parentNode.insertBefore(b, s);})(window.lintrk);\n});\n</script>\n\n<!-- Reddit - Added by Elsie 12.5.25-->\n<script>\nrunUnlessCookieIsTrue('__cl_no_marketing', function() {\n!function(w,d){if(!w.rdt){var p=w.rdt=function(){p.sendEvent?p.sendEvent.apply(p,arguments):p.callQueue.push(arguments)};p.callQueue=[];var t=d.createElement(\"script\");t.src=\"https://www.redditstatic.com/ads/pixel.js\",t.async=!0;var s=d.getElementsByTagName(\"script\")[0];s.parentNode.insertBefore(t,s)}}(window,document);rdt('init','a2_i46qtbm1dfx1');rdt('track', 'PageVisit');\n});\n</script>\n\n<!-- GSAP Animation # disabling as of 3/30/2026\n<script src=\"https://unpkg.com/split-type\" crossorigin=\"anonymous\"></script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.11.3/gsap.min.js\" crossorigin=\"anonymous\"></script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.11.3/ScrollTrigger.min.js\" crossorigin=\"anonymous\"></script>\n\n\n<script>\nwindow.addEventListener(\"DOMContentLoaded\", (event) => {\n  // Split text into spans\n  let typeSplit = new SplitType(\"[text-split]\", {\n    types: \"words, chars\",\n    tagName: \"span\"\n  });\n\n  // Link timelines to scroll position\n  function createScrollTrigger(triggerElement, timeline) {\n    // Reset tl when scroll out of view past bottom of screen\n    ScrollTrigger.create({\n      trigger: triggerElement,\n      start: \"top bottom\",\n      onLeaveBack: () => {\n        timeline.progress(0);\n        timeline.pause();\n      }\n    });\n    // Play tl when scrolled into view (60% from top of screen)\n    ScrollTrigger.create({\n      trigger: triggerElement,\n      start: \"top 60%\",\n      onEnter: () => timeline.play()\n    });\n  }\n\n  $(\"[words-slide-up]\").each(function (index) {\n    let tl = gsap.timeline({ paused: true });\n    tl.from($(this).find(\".word\"), { opacity: 0, yPercent: 100, duration: 0.5, ease: \"back.out(2)\", stagger: { amount: 0.5 } });\n    createScrollTrigger($(this), tl);\n  });\n\n  $(\"[words-rotate-in]\").each(function (index) {\n    let tl = gsap.timeline({ paused: true });\n    tl.set($(this).find(\".word\"), { transformPerspective: 1000 });\n    tl.from($(this).find(\".word\"), { rotationX: -90, duration: 0.6, ease: \"power2.out\", stagger: { amount: 0.6 } });\n    createScrollTrigger($(this), tl);\n  });\n\n  $(\"[words-slide-from-right]\").each(function (index) {\n    let tl = gsap.timeline({ paused: true });\n    tl.from($(this).find(\".word\"), { opacity: 0, x: \"1em\", duration: 0.6, ease: \"power2.out\", stagger: { amount: 0.2 } });\n    createScrollTrigger($(this), tl);\n  });\n\n  $(\"[letters-slide-up]\").each(function (index) {\n    let tl = gsap.timeline({ paused: true });\n    tl.from($(this).find(\".char\"), { yPercent: 100, duration: 0.2, ease: \"power1.out\", stagger: { amount: 0.6 } });\n    createScrollTrigger($(this), tl);\n  });\n\n  $(\"[letters-slide-down]\").each(function (index) {\n    let tl = gsap.timeline({ paused: true });\n    tl.from($(this).find(\".char\"), { yPercent: -120, duration: 0.3, ease: \"power1.out\", stagger: { amount: 0.7 } });\n    createScrollTrigger($(this), tl);\n  });\n\n  $(\"[letters-fade-in]\").each(function (index) {\n    let tl = gsap.timeline({ paused: true });\n    tl.from($(this).find(\".char\"), { opacity: 0, duration: 0.2, ease: \"power1.out\", stagger: { amount: 0.8 } });\n    createScrollTrigger($(this), tl);\n  });\n\n  $(\"[letters-fade-in-random]\").each(function (index) {\n    let tl = gsap.timeline({ paused: true });\n    tl.from($(this).find(\".char\"), { opacity: 0, duration: 0.05, ease: \"power1.out\", stagger: { amount: 0.4, from: \"random\" } });\n    createScrollTrigger($(this), tl);\n  });\n\n  $(\"[scrub-each-word]\").each(function (index) {\n    let tl = gsap.timeline({\n      scrollTrigger: {\n        trigger: $(this),\n        start: \"top 80%\",\n        end: \"top center\",\n        scrub: true\n      }\n    });\n    tl.from($(this).find(\".word\"), { opacity: 0.2, duration: 0.8, ease: \"expo.out\", stagger: { each: 0.8 }, scrub: 2 });\n  });\n\n  // Avoid flash of unstyled content\n  gsap.set(\"[text-split]\", { opacity: 1 });\n});\n</script>\n-->\n\n<!-- Lenis Smooth Scrolling -->\n<script src=\"https://unpkg.com/lenis@1.3.4/dist/lenis.min.js\" crossorigin=\"anonymous\"></script>\n\n<script>\n// LENIS SMOOTH SCROLL\n\nlet lenis;\nconst prefersReducedMotionQuery = matchMedia('(prefers-reduced-motion: reduce)');\n\nif (Webflow.env(\"editor\") === undefined && (!prefersReducedMotionQuery.matches && location.pathname !== '/webinars')) {\n  lenis = new Lenis({\n    // BKJ - leaving these uncommented values as reference. They caused motion sickness problems, and the new values\n    // address this\n    //lerp: 0.1,\n    //wheelMultiplier: 0.7,\n    lerp: 0.9,\n    wheelMultiplier: 0.5,\n    gestureOrientation: \"vertical\",\n    normalizeWheel: false,\n    smoothTouch: false\n  });\n  function raf(time) {\n    lenis.raf(time);\n    requestAnimationFrame(raf);\n  }\n  requestAnimationFrame(raf);\n}\n$(\"[data-lenis-start]\").on(\"click\", function () {\n  lenis.start();\n});\n$(\"[data-lenis-stop]\").on(\"click\", function () {\n  lenis.stop();\n});\n$(\"[data-lenis-toggle]\").on(\"click\", function () {\n  $(this).toggleClass(\"stop-scroll\");\n  if ($(this).hasClass(\"stop-scroll\")) {\n    lenis.stop();\n  } else {\n    lenis.start();\n  }\n\n  //reload lenis animations\n$(document).ready(function(){lenis.start();})\n  /**/\n});\n</script>\n\n<!-- Fixing the overlay on the home page - Damon 03.01.25 -->\n<script>\n$(document).ready(() => {\n  const toggle = document.querySelector('#w-dropdown-toggle-0');\n  const overlay = document.querySelector('.navbar_overlay');\n  toggle.addEventListener('click', function() {\n    const header = document.querySelector('.nav.w-nav');\n    const headerRect = header.getBoundingClientRect();\n    overlay.style.top = `${headerRect.bottom}px`;\n  });\n});\n</script>\n\n<!-- Conditional logic based on user_type cookie - Cindy 03.04.25 -->\n<script>\n  function getCookie(name) {\n    const cookies = document.cookie.split(\"; \");\n    for (let cookie of cookies) {\n      const [cookieName, cookieValue] = cookie.split(\"=\");\n      if (cookieName === name) {\n        return decodeURIComponent(cookieValue);\n      }\n    }\n    return null;\n  }\n\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const userTypeCookie = getCookie(\"user_type\");\n\n    if (userTypeCookie) {\n      const navbarContainer = document.querySelector(\".navbar_container-wrap\");\n\n\n      if (navbarContainer) {\n        // conditionally set the href of the logo link based on the user type\n        const logoLink = navbarContainer.querySelector(\".navbar_logo-link\");\n\n        if (logoLink) {\n          if (userTypeCookie === \"teacher\") {\n            logoLink.href = \"/en/home\";\n          } else if (userTypeCookie === \"student\") {\n            logoLink.href = \"/en/students/student_lessons\"\n          }\n        }\n\n        // modify login link to take logged in users to logged in home page\n        // hide signup and contact sales links for logged in users\n        const logInLink = document.querySelector(\".nav-link-login\");\n        const signUpLink = document.querySelector(\".nav-link-signup\");\n        const contactSalesLink = document.querySelector(\".nav-link-request-quote\");\n\n        if (logInLink) {\n          logInLink.innerText = \"Home\";\n\n          if (userTypeCookie === \"teacher\") {\n            logInLink.href = \"/en/home\";\n          } else if (userTypeCookie === \"student\") {\n            logInLink.href = \"/en/students/student_lessons\";\n          }\n        }\n\n        if (signUpLink) {\n          signUpLink.style.display = \"none\";\n        }\n\n        if (contactSalesLink) {\n          contactSalesLink.style.display = \"none\";\n        }\n      }\n    }\n  });\n</script>\n\n<script type=\"text/javascript\" defer>\nasync function clearCookiePreferences() {\n  await window.cookieStore.delete('__cl_no_analytics');\n  await window.cookieStore.delete('__cl_no_marketing');\n  window.location.reload();\n}\n\ndocument.querySelector(\"#manage-cookies\").addEventListener(\"click\", clearCookiePreferences);\n</script>\n\n<!-- Accessible Modals -->\n<script>\n  function findModal(elem) {\n    var tabbable = elem.find('select, input, textarea, button, a').filter(':visible');\n\n    var firstTabbable = tabbable.first();\n    var lastTabbable = tabbable.last();\n\n    /*remove existing handlers to prevent stacking*/\n    firstTabbable.off('keydown.modal');\n    lastTabbable.off('keydown.modal');\n    elem.off('keydown.modal');\n\n    /*set focus on first input*/\n    firstTabbable.focus();\n\n    /*redirect last tab to first input*/\n    lastTabbable.on('keydown.modal', function(e) {\n      if ((e.which === 9 && !e.shiftKey)) {\n        e.preventDefault();\n        firstTabbable.focus();\n      }\n    });\n\n    /*redirect first shift+tab to last input*/\n    firstTabbable.on('keydown.modal', function(e) {\n      if ((e.which === 9 && e.shiftKey)) {\n        e.preventDefault();\n        lastTabbable.focus();\n      }\n    });\n\n    /* allow escape key to close modal */\n    elem.on('keydown.modal', function(e) {\n      if (e.keyCode === 27) {\n        $(elem).find('[hf-modal=\"close\"], .signup_modal-close-button').click();\n      };\n    });\n  };\n\n  $(document).ready(function() {\n    var buttonThatOpenedModal;\n\n    // Hubspot modals\n    const hubformOpenButton = $('[hf-form-id]').filter(function () {\n      return $(this).attr('hf-form-id').trim() !== '';\n    });\n    const hubformModal = $('[hf-modal=\"component\"]');\n    const hubformCloseButtons = $('[hf-modal=\"close\"], [hf-modal=\"overlay\"]');\n\n    hubformOpenButton.on('click', function() {\n      hubformModal.css('display', 'flex');\n      findModal(hubformModal);\n      buttonThatOpenedModal = $(this);\n    });\n\n    hubformCloseButtons.on('keydown', function(e) {\n      // Only activate on spacebar and enter\n      if (e.which === 13 || e.which === 32) {\n        e.preventDefault();\n        var evt = document.createEvent(\"MouseEvents\");\n        evt.initMouseEvent(\"click\", true, true, window);\n        $(this).get(0).dispatchEvent(evt);\n      }\n    });\n\n    hubformCloseButtons.on('click', function() {\n      hubformModal.css('display', 'none');\n      if (buttonThatOpenedModal) {\n        buttonThatOpenedModal.focus();\n        buttonThatOpenedModal = null;\n      }\n    });\n\n\t// Sign up modal\n    const signUpOpenButton = $('.nav-link-signup');\n    const signUpModal = $('.signup_modal-component');\n    const signUpCloseButtons = $('.signup_modal-close-button, .signup_modal-overlay');\n\n    // Save trigger for focus return\n    signUpOpenButton.on('click', function() {\n      buttonThatOpenedModal = $(this);\n    });\n\n    // Observe when Webflow displays the modal\n    const signupObserver = new MutationObserver(() => {\n      if (signUpModal.css('display') === 'flex') {\n        findModal(signUpModal);\n      }\n    });\n\n    if (signUpModal.length) {\n      signupObserver.observe(signUpModal.get(0), {\n        attributes: true,\n        attributeFilter: ['style']\n      });\n    }\n\n    signUpCloseButtons.on('keydown', function(e) {\n      if (e.which === 13 || e.which === 32) {\n        e.preventDefault();\n        var evt = document.createEvent(\"MouseEvents\");\n        evt.initMouseEvent(\"click\", true, true, window);\n        $(this).get(0).dispatchEvent(evt);\n      }\n    });\n\n    signUpCloseButtons.on('click', function() {\n      if (buttonThatOpenedModal) {\n        buttonThatOpenedModal.focus();\n        buttonThatOpenedModal = null;\n      }\n    });\n  });\n</script>\n\n<script>\n// Adapted from https://status.commonlit.org/en/39d92932/widget/script.js\n// Changes from upstream are commented below\n(function () {\n  /**\n   * Configurations\n   * you can change widget configuration from here\n   */\n  const CONFIG = {\n    url: 'https://status.commonlit.org',\n    frameUrl: 'https://status.commonlit.org/widget',\n    position: 'bottom-right',\n    incident: {\n      textColor: '#333333',\n      backgroundColor: '#FFFFFF',\n    },\n    maintenance: {\n      textColor: '#333333',\n      backgroundColor: '#FFFFFF',\n    },\n    text: {\n      viewLatestUpdates: 'View latest updates',\n      lastUpdated: 'Last updated {{time}} ago',\n      scheduledFor: 'Scheduled for',\n      year: 'year',\n      years: 'years',\n      month: 'month',\n      months: 'months',\n      day: 'day',\n      days: 'days',\n      hour: 'hour',\n      hours: 'hours',\n      minute: 'minute',\n      minutes: 'minutes',\n    },\n  };\n\n  const isMobile = screen.width < 600;\n\n  /**\n   * Initialization\n   */\n  async function init() {\n    while (true) {\n      try {\n        await fetchIssues();\n      } catch {}\n      await wait(3 * 60 * 1000); // every 3 minutes\n    }\n  }\n\n  async function fetchIssues() {\n    let result = await fetch(\n      'https://api.instatus.com' +\n        '/issues?locale=en&host=status.commonlit.org',\n    ).then((res) => {\n      if (res.ok) {\n        return res.json();\n      } else {\n        return Promise.reject(res.statusText);\n      }\n    });\n\n    let issues = [];\n\n    result.activeIncidents?.forEach((incident) => {\n      issues.push({\n        type: 'incident',\n        id: incident.id,\n        status: incident.status,\n        title: incident.name,\n        updatedAt: incident.updatedAt,\n        theme: CONFIG.maintenance,\n        text: CONFIG.text,\n      });\n    });\n\n    result.activeMaintenances?.forEach((maintenance) => {\n      // Change from Instatus' setup: don't flag upcoming maintenance in a popup\n      if (maintenance.status != 'NOTSTARTEDYET') {\n        issues.push({\n          type: 'maintenance',\n          id: maintenance.id,\n          status: maintenance.status,\n          title: maintenance.name,\n          updatedAt: maintenance.updatedAt,\n          date: maintenance.date,\n          theme: CONFIG.incident,\n          text: CONFIG.text,\n        });\n      }\n    });\n\n    notifyIssues(issues);\n  }\n\n  /**\n   * Frame\n   */\n\n  let frames = [];\n  let dismissedFrameIds = {};\n  let closedFrames = [];\n  let retreviedLocalClosedFrames = localStorage.getItem('closedFrames');\n  let localClosedFrames = JSON.parse(retreviedLocalClosedFrames);\n\n  function notifyIssues(issues) {\n    frames.forEach((frame) => {\n      let issue = issues.find((issue) => issue.id === frame.id);\n      if (issue) {\n        updateIssue(issue);\n      } else {\n        dismissIssue(frame.id);\n      }\n    });\n    issues\n      .filter((issue) => {\n        let isDismissed = issue.id in dismissedFrameIds;\n        let isOnScreen = frames.some((frame) => frame.id === issue.id);\n        return !(isDismissed || isOnScreen);\n      })\n      .forEach((issue, i) => {\n        notifyIssue({ issue, timeout: i * 200 });\n      });\n  }\n\n  function notifyIssue({ issue, timeout }) {\n    if (\n      localStorage.hasOwnProperty('closedFrames') &&\n      localClosedFrames.includes(issue.id)\n    ) {\n      return;\n    }\n\n    let frame = document.createElement('iframe');\n    frame.id = issue.id;\n    frame.src =\n      CONFIG.frameUrl +\n      '?incident_url=' +\n      encodeURIComponent(CONFIG.url + '/' + issue.id) +\n      '&issue=' +\n      encodeURIComponent(JSON.stringify(issue)) +\n      '&type=' +\n      issue.type;\n    frame.style.position = 'fixed';\n    frame.style.border = 'none';\n    frame.style.boxShadow =\n      '0 0 #0000, 0 0 #0000, 0 25px 50px -12px rgba(0, 0, 0, 0.25)';\n    frame.style.zIndex = '9999';\n    frame.style.transition = 'left .3s ease, bottom .3s ease, right .3s ease';\n\n    let frameLength = frames.length;\n\n    if (isMobile) {\n      frame.style.height = '180px';\n      frame.style.width = '100vw';\n      frame.style.transition = 'bottom .3s ease';\n      frame.style.borderRadius = 'none';\n      frame.style.left = 0;\n      frame.style.bottom = '-1000px';\n    } else {\n      frame.style.height = '180px';\n      frame.style.width = '365px';\n      frame.style.borderRadius = '1rem';\n      let x = '-1000px';\n      let y = 50 + frameLength * 210 + 'px';\n      if (CONFIG.position === 'bottom-left') {\n        frame.style.left = x;\n        frame.style.bottom = y;\n      } else if (CONFIG.position === 'bottom-right') {\n        frame.style.right = x;\n        frame.style.bottom = y;\n      } else if (CONFIG.position === 'bottom-center') {\n        frame.style.bottom = y;\n        frame.style.left = 0;\n        frame.style.right = 0;\n        frame.style.margin = 'auto';\n      } else if (CONFIG.position === 'top-left') {\n        frame.style.left = x;\n        frame.style.top = y;\n      } else if (CONFIG.position === 'top-right') {\n        frame.style.right = x;\n        frame.style.top = y;\n      } else if (CONFIG.position === 'top-center') {\n        frame.style.top = y;\n        frame.style.left = 0;\n        frame.style.right = 0;\n        frame.style.margin = 'auto';\n      }\n    }\n\n    frame.onload = function (e) {\n      let actions = {\n        showFrame: function () {\n          if (isMobile) {\n            frame.style.bottom = frameLength * 180 + 'px';\n          } else {\n            let x = '50px';\n            if (\n              CONFIG.position === 'bottom-left' ||\n              CONFIG.position === 'top-left'\n            ) {\n              frame.style.left = x;\n            } else if (\n              CONFIG.position === 'bottom-right' ||\n              CONFIG.position === 'top-right'\n            ) {\n              frame.style.right = x;\n            }\n          }\n        },\n        dismissFrame: function () {\n          dismissIssue(issue.id);\n        },\n      };\n\n      window.addEventListener(\n        'message',\n        function (event) {\n          if (\n            event.data.id === issue.id &&\n            event.data.action &&\n            actions.hasOwnProperty(event.data.action)\n          ) {\n            actions[event.data.action](event.data);\n          }\n        },\n        false,\n      );\n\n      // animation\n      setTimeout(() => {\n        actions.showFrame();\n      }, timeout);\n    };\n\n    document.body.appendChild(frame);\n\n    frames.push(frame);\n  }\n\n  function updateIssue(issue) {\n    let frame = frames.find((frame) => frame.id === issue.id);\n    let newSrc =\n      CONFIG.frameUrl +\n      '?url=' +\n      encodeURIComponent(CONFIG.url + '/' + issue.id) +\n      '&issue=' +\n      encodeURIComponent(JSON.stringify(issue));\n    if (newSrc !== frame.src) {\n      frame.src = newSrc;\n    }\n  }\n\n  function dismissIssue(id) {\n    let frame = frames.find((frame) => frame.id === id);\n    dismissedFrameIds[id] = true;\n\n    closedFrames.push(id);\n    if (isMobile) {\n      frame.style.bottom = '-1000px';\n    } else {\n      frame.style.left = '-1000px';\n    }\n    localStorage.setItem('closedFrames', JSON.stringify(closedFrames));\n    setTimeout(() => {\n      removeFrame(id);\n    }, 200);\n  }\n\n  function removeFrame(id) {\n    frames = frames.filter((frame) => {\n      if (frame.id === id) {\n        frame.remove();\n        return false;\n      }\n      return true;\n    });\n    // reorder\n    frames.forEach((frame, i) => {\n      if (isMobile) {\n        frame.style.bottom = i * 130 + 'px';\n      } else {\n        frame.style.bottom = 60 + i * 20 + i * 155 + 'px';\n      }\n    });\n  }\n\n  init();\n\n  /**\n   * utils\n   */\n  function wait(ms) {\n    return new Promise((res) => setTimeout(res, ms));\n  }\n})();\n</script>\n\n<!-- Google Tag Manager -->\n<script>\nrunUnlessCookieIsTrue('__cl_no_marketing', function() {\n  (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\n  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\n  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n  })(window,document,'script','dataLayer','GTM-WWTPNSVH');\n});\n</script>\n<!-- Open signup modal from any element with data-open-signup -->\n<script>\n  document.addEventListener('click', function (e) {\n    var trigger = e.target.closest('[data-open-signup]');\n    if (!trigger) return;\n    e.preventDefault();\n    var navBtn = document.querySelector('[data-signup-source=\"nav\"]');\n    if (navBtn) navBtn.click();\n  });\n</script><script>\n$(\".span-wrapper\").each(function (index) {\n\tlet relatedEl = $(\".span-element\").eq(index);\n  relatedEl.appendTo($(this));\n});\n</script>\n\n<script async src=\"https://unpkg.com/typer-dot-js@0.1.0/typer.js\"></script>\n\n<script>\n(function () {\n  function init() {\n    document.querySelectorAll('.tl-tabs, .tabs-2').forEach(function (wrap) {\n      if (wrap.dataset.caretReady) return;\n      wrap.dataset.caretReady = '1';\n\n      var menu = wrap.querySelector('.tl-tabs-menu, .tabs-menu-2');\n      if (!menu) return;\n\n      function makeBtn(dir, label, glyph) {\n        var b = document.createElement('button');\n        b.type = 'button';\n        b.className = 'tabs-scroll-btn ' + dir;\n        b.setAttribute('aria-label', label);\n        b.innerHTML = glyph;\n        b.addEventListener('click', function () {\n          var amount = menu.clientWidth * 0.7;\n          menu.scrollBy({ left: dir === 'is-next' ? amount : -amount, behavior: 'smooth' });\n        });\n        wrap.appendChild(b);\n      }\n\n      makeBtn('is-prev', 'Scroll tabs left', '&lsaquo;');\n      makeBtn('is-next', 'Scroll tabs right', '&rsaquo;');\n\n      function update() {\n        var max = menu.scrollWidth - menu.clientWidth;\n        wrap.classList.toggle('can-prev', menu.scrollLeft > 4);\n        wrap.classList.toggle('can-next', max - menu.scrollLeft > 20);\n      }\n\n      update();\n      menu.addEventListener('scroll', update, { passive: true });\n      window.addEventListener('resize', update);\n      if (window.ResizeObserver) new ResizeObserver(update).observe(menu);\n    });\n  }\n\n  if (document.readyState !== 'loading') init();\n  else document.addEventListener('DOMContentLoaded', init);\n})();\n</script>\n\n<!-- Default the Text Library grade tabs to 7th Grade (waits for Webflow's own tab click handlers to be ready) -->\n<script>\n(function () {\n  function activateDefaultGradeTab() {\n    var allGood = true;\n    document.querySelectorAll('.tl-tabs, .tabs-2').forEach(function (wrap) {\n      var links = wrap.querySelectorAll('.w-tab-link');\n      var target = null;\n      for (var i = 0; i < links.length; i++) {\n        if (links[i].textContent.trim() === '7th Grade') { target = links[i]; break; }\n      }\n      if (target && !target.classList.contains('w--current')) {\n        allGood = false;\n        target.click();\n        target.blur();\n      }\n      wrap.classList.add('tabs-ready');\n    });\n    return allGood;\n  }\n\n  function runWhenWebflowReady() {\n    if (window.Webflow && typeof window.Webflow.push === 'function') {\n      window.Webflow.push(activateDefaultGradeTab);\n    } else {\n      var tries = 0;\n      var iv = setInterval(function () {\n        tries++;\n        if (window.Webflow && typeof window.Webflow.push === 'function') {\n          clearInterval(iv);\n          window.Webflow.push(activateDefaultGradeTab);\n        } else if (tries > 40) {\n          clearInterval(iv);\n          activateDefaultGradeTab();\n        }\n      }, 100);\n    }\n  }\n\n  runWhenWebflowReady();\n\n  // Safety net: verify the click actually took effect (Webflow's Tabs listeners can attach late); retry briefly.\n  var attempts = 0;\n  var verify = setInterval(function () {\n    attempts++;\n    var ok = activateDefaultGradeTab();\n    if (ok || attempts > 20) clearInterval(verify);\n  }, 200);\n\n  setTimeout(function () {\n    document.querySelectorAll('.tl-tabs, .tabs-2').forEach(function (wrap) {\n      wrap.classList.add('tabs-ready');\n    });\n  }, 1500);\n})();\n</script><script src=\"https://assets.commonlit.org/webflow/footer-H7GIONPR.js\" type=\"text/javascript\" integrity=\"sha256-m2lBeZio0Ca7jrcdLc+wF1r+mDfxAGU29K+tUbCgFmQ=\" crossorigin=\"anonymous\"></script><script type=\"module\" src=\"https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092\" integrity=\"sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==\" data-cf-beacon='{\"version\":\"2024.11.0\",\"token\":\"15b48a897def4d8bbb1e59d1d7672f7e\",\"spa\":2}' crossorigin=\"anonymous\"></script>\n</body></html>",
