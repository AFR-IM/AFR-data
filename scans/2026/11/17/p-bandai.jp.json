 === 'object') t.endSent = false;\r\n    }\r\n});\r\n\r\nvar messageCallback = {\r\n      /* ===== [�ǉ�] ���C�u�����C�ɓ���@�\\�F��������i������ EVENT_LOG / ON_UID_ISSUED �͉��ɂ��̂܂܎c���Ă��܂��j===== */\r\n      ON_CONFIG_RECEIVED: function (payload) {\r\n          if (!payload) return;\r\n          var L = window.SLFavBridge.live;\r\n          if (payload.title) L.name = payload.title;\r\n          if (payload.campaignStatus) L.status = payload.campaignStatus;\r\n          L.startAt = Number(payload.startedAt) || Number(payload.scheduledAt) || L.startAt;\r\n      },\r\n      ON_CAMPAIGN_STATUS_CHANGED: function (payload) {   // �������Ƀ��C�u���I�������Ƃ���\r\n          if (payload && payload.status) window.SLFavBridge.live.status = payload.status;\r\n          // [�ǉ� 2026-11-12] �������ɔz�M���I�� �� live_view_end\r\n          if (payload && payload.status === 'CLOSED') {\r\n              if (payload.campaignKey) slSendViewEnd(payload.campaignKey, 'live_closed');\r\n              else slSendViewEndAll('live_closed');\r\n          }\r\n      },\r\n      /* [�ǉ� 2026-11-12] �v���C���[�i���C���[���[�_���j�́~�{�^�� �� live_view_end\r\n         �� ���̃R�[���o�b�N��o�^����� Shoplive �W���́u����v�������u������邽�߁A�W���Ɠ��� dismissLayerModalPlayer() ��K���Ă� */\r\n      ON_CLICK_CLOSE_PLAYER_MODAL: function (payload) {\r\n          var c = payload && payload.campaign;\r\n          var ck = (typeof c === 'string') ? c : (c && (c.campaignKey || c.ck));\r\n          if (ck) slSendViewEnd(ck, 'player_close'); else slSendViewEndAll('player_close');\r\n          cloud.shoplive.dismissLayerModalPlayer();\r\n      },\r\n      CLOSE_PLAYER: function (payload) {   // �v���C���[���̕���{�^���i�W���͉������Ȃ��j\r\n          if (payload && payload.campaignKey) slSendViewEnd(payload.campaignKey, 'player_close');\r\n          else slSendViewEndAll('player_close');\r\n      },\r\n      CLICK_PRODUCT_CART: function (payload) {\r\n          // ���i���X�g���́u�n�[�g�{�^���v�itype === 'LIKE'�j��