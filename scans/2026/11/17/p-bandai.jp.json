, payload.campaignKey, payload.isLandscapeCampaign || false);\r\n          else location.href = payload.url;\r\n      },\r\n      /* ===== [�ǉ�] �����܂� ===== */\r\n      EVENT_LOG: function (payload) {\r\n          /* [�ǉ� 2026-11-11] �v���ΏۊO�� Shoplive �W�����O�� dataLayer �ɑ���Ȃ��i���v�]�ɂ��j\r\n             - product_add_to_watchlist: �n�[�g�{�^���������i���C�ɓ���ǉ��� shoplive_add_wishlist �Ōv���j\r\n             - product_list_button: ���i�G���A�̃^�b�v���iproduct_list_show �Ɠ�d�ɂȂ邽�߁j */\r\n          var SKIP_EVENT_LOG = ['product_add_to_watchlist', 'product_list_button'];\r\n          if (payload && SKIP_EVENT_LOG.indexOf(payload.name) !== -1) return;\r\n        \r\n          //log events other than video progress related events. decide which events to log from GTM triggering setting\r\n          if (payload.name !== 'player_active_seconds' && payload.name !== 'player_on_foreground' && payload.name !== 'player_on_background' && payload.name !== 'product_list_item') {\r\n            \r\n              console.log(payload.name, payload)\r\n              window.dataLayer.push({\r\n                  'event': payload.name,\r\n                  'eventProps': {\r\n                      'value': payload.feature,\r\n                      'campaignKey': payload.campaignKey\r\n                  }\r\n              });\r\n          }\r\n          else if (payload.name == 'product_list_item') {\r\n              console.log(payload.name, payload)\r\n              window.dataLayer.push({\r\n                  'event': payload.name,\r\n                  'eventProps': {\r\n                      'productId': payload.parameter.url,\r\n                      'campaignKey': payload.campaignKey\r\n                  }\r\n              });\r\n          }\r\n        \r\n          else if (payload.name == 'player_active_seconds' ) {\r\n              campaignKeyTracker['campaignKey'] = payload.campaignKey;\r\n              //����messageCallback�C�x���g��1�`3�b���Ƃɔ��΂��܂��B�i�ŏ���3�b�܂ł�1�