cation.href = payload.product.url;\r\n  },\r\n\r\n  DETAIL_ACTIVE: function(payload) {\r\n\r\n    //����messageCallback�C�x���g�̓V���[�g�t�H�[���r�f�I�̍Đ����n�܂������Ƃ������܂�\r\n    console.log('(DETAIL_ACTIVE) shortsId:' + payload.shorts.shortsId, payload)\r\n    shortsId['shortsId'] = payload.shorts.shortsId;\r\n    currentShortsId = payload.shorts.shortsId;\r\n\r\n    window.dataLayer.push({\r\n      'event': 'video_start',\r\n      'eventProps': {\r\n        'value': 0,\r\n        'videoId': payload.shorts.shortsId\r\n      }\r\n    });\r\n  },\r\n  DETAIL_VIEWING_SECONDS: function(payload) {\r\n    currentShortsId = payload.shorts.shortsId;\r\n    //����messageCallback�C�x���g��1�`3�b���Ƃɔ��΂��܂��B�i�ŏ���3�b�܂ł�1�b���ƂɁA���̌��3�b���ƂɁj\r\n    if (!shortsId[payload.shorts.shortsId]) {\r\n      shortsId[payload.shorts.shortsId] = {};\r\n      //shortsId[payload.shorts.shortsId].threeSec = false;\r\n      //shortsId[payload.shorts.shortsId].tenSec = false;\r\n      shortsId[payload.shorts.shortsId].thirtySec = false;\r\n    }\r\n\r\n    console.log('(DETAIL_VIEWING_SECONDS) shortsId:' + payload.shorts.shortsId, payload)\r\n\r\n\r\n    if (payload.videoCurrentTime > 29000 && payload.videoCurrentTime < 32000 && !shortsId[payload.shorts.shortsId].thirtySec) {\r\n      shortsId[payload.shorts.shortsId].thirtySec = true;\r\n      console.log('30sec')\r\n      window.dataLayer.push({\r\n        'event': 'video_current_time',\r\n        'eventProps': {\r\n          'value': '30sec',\r\n          'videoId': payload.shorts.shortsId\r\n        }\r\n      });\r\n    }\r\n  },\r\n  DETAIL_ON_PLAYER_DISMISS: function(payload) {\r\n    //����messageCallback�C�x���g�̓V���[�g�t�H�[���r�f�I����ʂ���������ꂽ���Ƃ������܂�\r\n    console.log('(DETAIL_ON_PLAYER_DISMISS)')\r\n    window.dataLayer.push({\r\n      'event': 'video_exit',\r\n      'eventProps': {\r\n        'value': 'close',\r\n        'videoId': currentShortsId\r\n      }\r\n    });\r\n  },\r\n}\r\n\r\ncloud.shoplive.initSh