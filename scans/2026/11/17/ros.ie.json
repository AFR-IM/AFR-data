      "status": 200,
      "body": "\n\n\n\n\n\n\n\n\n<!DOCTYPE html>\n<html lang=\"en\">\n<!--[if lt IE 7]>      <html class=\"no-js lt-ie9 lt-ie8 lt-ie7\"> <![endif]-->\n<!--[if IE 7]>         <html class=\"no-js lt-ie9 lt-ie8\"> <![endif]-->\n<!--[if IE 8]>         <html class=\"no-js lt-ie9\"> <![endif]-->\n<!--[if gt IE 8]><!--> <html class=\"no-js\"> <!--<![endif]-->\n<head>\n    <base href=\"https://www.ros.ie/oidc/\">\n\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\"/>\n    <meta charset=\"utf-8\">\n    <title>ROS - Log In</title>\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"description\" content=\"\">\n    <meta name=\"author\" content=\"\">\n\n    <!-- HTML5 shim, for IE6-8 support of HTML5 elements -->\n    <!--[if lt IE 9]>\n    <script src=\"resources/js/lib/html5.js\"></script>\n    <![endif]-->\n    \n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"resources/css/login-responsive.css?v=2310\"/>\n\t\n    <!-- favico -->\n    <link rel=\"shortcut icon\" href=\"images/revenue_logo_favicon.jpg\">\n\n    <!-- Load jQuery up here so that we can use in-page functions -->\n    <script type=\"text/javascript\" src=\"webjars/jquery/1.10.2/jquery.min.js\"></script>\n    <script type=\"text/javascript\" src=\"resources/js/jquery-ui-1.10.3.custom.min.js\"></script>\n    \n    <!-- Loads i18n for ROS language properties or i18n version for Mitre -->\n    \n  \t\t\n    \t\t<script type=\"text/javascript\" src=\"webjars/jquery-i18n-properties/1.2.2/jquery.i18n.properties.min.js\"></script>\n    \t\t<script type=\"text/javascript\">\n    \t\t\tjQuery.i18n.properties({\n    \t\t\t\tname : 'messages',\n    \t\t\t\tpath : 'https://www.ros.ie/oidc/'.replace(/\\/$/, '')+'/resources/bundle/',\n    \t\t\t\tmode : 'both',\n    \t\t\t\tlanguage : 'en'\n    \t\t\t});\n    \t\t</script>\n    \t\t\n  \t\t\n  \t\t\n\t\n    <script type=\"text/javascript\">\n\n\t    lang = \"en\";\n\t\tlangParameter = \"lang\";\n\t\tclientid = \"rosint_rp\";\n\t\tclientidParameter = \"client_id\";\n\t\tissuer = \"https://www.ros.ie/oidc/\";\n\n\t\t\n    \tfunction setPageTitle(title) {\n    \t\tdocument.title = \"ROS - \" + title;\n    \t}\n\n\t\t\n    \tfunction getUserInfo() {\n    \t\treturn ;\n    \t}\n\n\t\t\n\t\tfunction getUserAuthorities() {\n\t\t\treturn [\"ROLE_ANONYMOUS\"];\n\t\t}\n\n\t\t// is the current user an admin?\n\t\t// NOTE: this is just for\n\t\tfunction isAdmin() {\n\t\t\tvar auth = getUserAuthorities();\n\t\t\tif (auth && _.contains(auth, \"ROLE_ADMIN\")) {\n\t\t\t\treturn true;\n\t\t\t} else {\n\t\t\t\treturn false;\n\t\t\t}\n\t\t}\n    </script>\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"resources/fonts/Fira/fira.css?v=2250\"/>\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"resources/css/login-style.css?v=2640\">\n    \n\n\n\n\n\n\n\n    <script type=\"text/javascript\" src=\"/availability.js?t=1794884634039\"></script>\n\n    <script type=\"text/javascript\">\n        $(document).ready(function() {\n            if(typeof isRosDown === \"function\" && isRosDown()==true){\n                window.location = \"/sitedown.html\";\n            }\n        });\n    </script>\n<script type=\"text/javascript\" charset=\"utf-8\" src=\"resources/js/forge-complete-min.js\"></script>\n    \n    <script type=\"text/javascript\" charset=\"utf-8\" src=\"resources/js/revenue-openid-common.js?2440\"></script>\n    <script type=\"text/javascript\" charset=\"utf-8\" src=\"resources/js/revenue-openid-login.js?2250\"></script>\n\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"webjars/chosen/1.4.2/chosen.min.css\">\n    <script type=\"text/javascript\" charset=\"utf-8\" src=\"webjars/chosen/1.4.2/chosen.jquery.min.js\"></script>\n    <script type=\"text/javascript\" charset=\"utf-8\" src=\"resources/js/login-mode.js?2250\"></script>\n\n    <script type=\"text/javascript\" charset=\"utf-8\" src=\"/js/ros/rosUtils.js\"></script>\n\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"resources/css/helpcentre.css\">\n    <script type=\"text/javascript\" charset=\"utf-8\" src=\"/helpcentre/js/warning_messages.js\"></script>\n    \n    <link rel=\"stylesheet\" type=\"text/css\" href=\"resources/css/vendor.min.css?v=2250\">\n\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"resources/css/jquery-ui-1.10.3.custom.css?v=2250\" />\n    <script type=\"text/javascript\" src=\"resources/js/jquery-ui-1.10.3.custom.min.js?2250\"></script>\n    \n    <script>\n    $(document).ready(function() {\n        if(isIE()){\n            $('#login-news-section').hide();\n            $('#login-news-section-compatibility-warning').show();\n        }\n    });\n    \n    function isIE(){\n        var ua = window.navigator.userAgent; \n        var msie = ua.indexOf('MSIE '); // IE 10 or older\n        var trident = ua.indexOf('Trident/'); //IE 11\n        \n        return (msie > 0 || trident > 0);\n    }\n    \n    </script>\n    \n    <script type=\"text/javascript\" src=\"/js/ros/jquery.url.js\"></script>\n            <script type=\"text/javascript\" src=\"/js/ros/jquery.cookie.js\"></script>\n            <script type=\"text/javascript\" src=\"/js/ros/tabManager.js\"></script>\n        \n</head>\n\n<body>\n\n<div id=\"wrap\"><div class=\"container\">\n    <div class=\"header \">\n        <div class=\"inner_container\">\n            <div class=\"header-top\">\n                <a href=\"https://www.revenue.ie\"> <img class=\"logo\" src=\"resources/css/images/revenue.png\" laria-abel=\"Revenue Logo\" alt=\"Revenue Logo\" title=\"Revenue Logo\">\n                </a>\n                <a href=\"https://www.ros.ie\"> <img class=\"rosLogo\" src=\"resources/css/images/ROS_logo.png\" aria-label=\"ROS logo \" alt=\"ROS logo \" title=\"ROS logo \">\n                </a>\n            </div>\n            </h1>\n\n            <div class=\"top_links\">\n                <ul class=\"lang_links\">\n                    <li class=\"upper\" lang=\"ga\"><a href=\"/oidc/login?lang=ga&amp;client_id=rosint_rp\" title=\"Athraíonn an nasc seo an téacs ar an leathanach seo go Gaeilge \"> Gaeilge</a></li>\n                        </ul>\n            </div>\n        </div>\n        <br class=\"clear\" />\n        <div class=\"progress--section2\">\n            <div class=\"inner_container heading_top\">\n                <h1 class=\"progressText\">\n                    Secure Sign In for Business Customers </h1>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"grey-background-half\">\n        <div class=\"inner_container\">\n            <script type=\"text/javascript\">\n    $(document).ready(function() {\n        try {\n            revenue.openidCommon.getAvailableCerts($('#certList'));\n        } catch(e) {\n            revenue.openidCommon.handleError(e);\n        }\n        revenue.openidCommon.rolloverPeriod=730;\n        \n        \n        \n        $(\"span.info_icon > a, span.info_icon_close > a\").click(revenue.openidCommon.toggle_visibility);\n\n        if($('select#certList').val() == null){\n            $('select#certList>option:eq(0)').prop('selected', true);\n        }\n    });\n    \n   \n</script>\n\n<!-- Please Wait -->\n<div id=\"please_wait\">\n\tPlease wait while we determine your computer's compatibility. If this message persists, please visit the <a href=\"/helpcentre/help.html?lang=en\" >ROS Helpcentre</a> for assistance.</div><div class=\"login loginbox\" id=\"top_level_div\" browser-compatible-mode=\"true\" certs-loaded-mode=\"true\" style=\"display: none;\">\n<div class=\"row\">\n    <div class=\"login-panel-form col-md-8\">\n        <form id=\"uiForm\" onsubmit=\"revenue.openidLogin.loginProcess(); return false;\">\n\n            <div class=\"login-form-wrapper\">\n            <div class=\"form_row_load_cert\">\n                    <div class=\"form_label\">\n                        <label for=\"certList\"> Select Certificate</label>\n                    </div>\n                    <div class=\"form_input status-container\">\n                        <select id=\"certList\" name=\"certList\" class=\"form-control login-input\" title=\"List of all certificates loaded in this browser. Select the certificate you wish to use to login to ROS.\">\n                            <option selected value=\"default\">No Certificate loaded in this browser.</option>\n                        </select>\n                    </div>\n                    <div class=\"title_section certs_table\">\n                        <div class=\"sub_links\">\n                            <p class=\"link-info\">\n                                You can load a digital certificate ><a href=\"login/manage?lang=en&client_id=rosint_rp\" class=\"larger_text\"\n\t\t   title=\"Click &#34;Manage My Certificates&#34; button to load your ROS certificates into this browser and start using our new JavaScript solution.\"\n\t\t   id=\"\"\n\t\t   target=\"\">\n\t\t    Manage My Certificates</a>\n\t<span class=\"info_icon\"> <a href=\"javascript:void[0]\" for_box=\"loginInfoManageCertificates\"> <img class=\"infoIcon infoIcon-login\" src=\"resources/css/images/info_icon.png\" title=\"Manage my certificate help\" alt=\"Manage my certificate help\"></a></span>\n                            </p>\n                        </div>\n    \n                        <div class=\"infoBox white-panel login-tooltip\" id=\"loginInfoManageCertificates\">\n                            <div class=\"infoBox-top\">\n                                <p>\n                                    The correct ROS digital certificate must be loaded in the browser to login.<br/><br/>\n                                    Click on the Manage My Certificates link to locate the certificate you saved on your device and load it.</p>\n                                <br class=\"clear\" />\n                            </div>\n                            <div class=\"infoBox-bottom\">\n                                <a href=\"https://www.revenue.ie/en/online-services/support/ros-help/something-is-not-working/issues-logging-into-ros/index.aspx\" target=\"_blank\" title=\"If you are having difficulty, try these suggestions\">If you are having difficulty, try these suggestions</a>\n                            </div>\n    \n    \n                            <span class=\"close info_icon_close\"> <a href=\"javascript:void(0)\" for_box=\"loginInfoManageCertificates\"> Close</a>\n                            </span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"form_row_password\">\n                    <div class=\"form_label\">\n                        <label for=\"password\"> Enter Password</label>\n                    </div>\n                    <div class=\"form_input text status-container\">\n                        <div class=\"password-icon-container\">\n                            <input class=\"form-control login-input\" placeholder=\"Enter Password\" type=\"password\" name=\"password\" id=\"password\" autocomplete=\"current-password\"/>\n                            <a>\n                                <img id=\"show_or_hide_password_img\" src=\"resources/css/images/select_enable_password.png\" />\n                            </a>\n                        </div>\n                    </div>\n\n\t                <div class=\"title_section certs_table\">\n\t                    <div id=\"passwordManagementLinks\" class=\"sub_links\">\n\t                        <p id=\"reset-login-link\" class=\"link-info\">\n\t                            <a href=\"https://www.ros.ie/ros-registration-web/ros-registration?reissue=true&lang=en&client_id=rosint_rp\" class=\"larger_text\"\n\t\t   title=\"Forgot Password\"\n\t\t   id=\"\"\n\t\t   target=\"\">\n\t\t    Forgot Password</a>\n\t<span class=\"info_icon\"> <a href=\"javascript:void[0]\" for_box=\"loginInfoResetPassword\"> <img class=\"infoIcon infoIcon-login\" src=\"resources/css/images/info_icon.png\" title=\"Forgot Password Tooltip\" alt=\"Forgot Password Tooltip\"></a></span> <br class=\"clear\">\n\t                        </p>\n\t                    </div>\n\t\n\t                    <div class=\"infoBox white-panel login-tooltip\" id=\"loginInfoResetPassword\">\n\t\n\t                        <div class=\"infoBox-top\">\n\t                            <p>Incorrect password may occur if:</p>\n\t                            <ul>\n\t                                <li>\n\t                                    <p>You are entering your password incorrectly.</p>\n\t                                </li>\n\t                                <li>\n\t                                    <p>You have not loaded the most up to date copy of your certificate.</p>\n\t                                </li>\n\t                            </ul>\n\t                            <br class=\"clear\" />\n\t                        </div>\n\t                        <span class=\"close info_icon_close\"> <a href=\"javascript:void(0)\" for_box=\"loginInfoResetPassword\"> Close</a>\n\t                        </span>\n\t                    </div>\n\t                </div>\n\t            </div>\n\t            <div id=\"error-message-placeholder\" class=\"login-placeholder\" aria-live=\"polite\">\n\t                <div id=\"message-box\" class=\"message_parent login-message-box\" style=\"display: none;\">\n\t                    <span id=\"js_message\" class=\"message_box\"></span> <span id=\"textMessage\" class=\"message_box\"></span>\n\t                </div>\n\t            </div>\n\t            <div class=\"form_row_login_button\">\n\t                <input class=\"btn-primary btn-next login-button\" type=\"submit\" name=\"login\" id=\"login\" value=\"Login to ROS\" /> <span class=\"icon-arrow-right-bold\" aria-hidden=\"true\"></span>\n\t            </div>\n\t            <div class=\"form_row_login_button\">\n\t                <input class=\"btn-secondary btn-next login-button\" id=\"forgotPassword\" value=\"Trouble Logging In?\" onclick=\"forgotPasswordClicked('https://www.ros.ie/ros-registration-web/ros-registration?reissue=true')\"/> <span class=\"icon-arrow-right-bold\" aria-hidden=\"true\"></span>\n\t            </div>\n                </div>\n        </form>\n    </div>\n    <div id=\"loginPanalSidebar\" class=\"loginPanalSidebar col-md-4\">\n        <div class=\"sidebar-wrapper\">\n            <div class=\"sidebar-link register-for-ros\">\n                <a href=\"https://www.ros.ie/ros-registration-web/ros-registration?lang=en\" class=\"\"\n\t\t   title=\"Register for ROS\"\n\t\t   id=\"\"\n\t\t   target=\"\">\n\t\t    Register for ROS</a>\n\t</div>\n    \n            <div class=\"sidebar-link\">\n                <a id=\"help_link_play_icon\" tabindex=\"0\">\n                    <p class=\"sidebar-text\">\n                        Digital certificate explained.</br>\n                        See How it Works</br>\n                        <img id=\"play_icon\" alt=\"Click here to open a video explaining ROS certificates.\" src=\"resources/css/images/Play_Icon.png\" width=\"50\" height=\"50\" title=\"Click here to open a video explaining ROS certificates.\">\n                    </p>\n                </a>\n            </div>\n        </div>\n    </div>\n</div>\n</div>\n\n<div id=\"cert-video-modal\" tabindex=\"0\">\n    <iframe id=\"videoIframe\" tabindex=\"0\" src=\"https://www.youtube-nocookie.com/embed/XdXDRwSw1hs\" frameborder=\"0\" allowfullscreen=\"\" mozallowfullscreen=\"\" webkitallowfullscreen=\"\"></iframe>\n</div>\n\n<form id=\"loginForm\" action=\"/oidc/j_spring_security_check\" method=\"POST\">\n    <input type=\"hidden\" id=\"X509Certificate\" name=\"X509Certificate\">\n    <input type=\"hidden\" id=\"data\" name=\"data\" value=\"96d94776-2d34-4838-a930-62de16673edf\">\n    <input type=\"hidden\" id=\"signeddata\" name=\"signedData\">\n    <input type=\"hidden\" id=\"certnameused\" name=\"local_cert_name\">\n    <input type=\"hidden\" id=\"ran\" name=\"local_store_ran\">\n    <input type=\"hidden\" id=\"clientid\" name=\"client_id\" value=\"rosint_rp\">\n</form>\n\n<script>\n    $(function() {\n        $('.chzn-select').chosen( {\n            disable_search : true,\n            search_contains : true\n        });\n    });\n    \n\n        \n    $( \"#cert-video-modal\" ).dialog({\n        create: function() {\n            $(this).closest('div.ui-dialog')\n                   .find('.ui-dialog-titlebar-close')\n                   .click(function(e) {\n                       var video = $(\"#videoIframe\").attr(\"src\");\n                       $(\"#videoIframe\").attr(\"src\",\"\");\n                       $(\"#videoIframe\").attr(\"src\",video);\n                   });\n        },\n        resizable : false,\n        modal : true,\n        autoOpen : false,\n        draggable: false,\n        title : 'ROS certs explained',\n        tabindex: 0,\n    });\n    \n    $(\"#help_link_play_icon\").keydown(function(event) {\n        if (event.keyCode === 13) {\n            $(\"#help_link_play_icon\").click();\n        }\n    });\n\n    document.getElementById(\"show_or_hide_password_img\").onclick = function() {\n            var passwordField = document.getElementById(\"password\");\n            var img = document.getElementById(\"show_or_hide_password_img\");\n            if(passwordField.type == \"text\") {\n                passwordField.type = \"password\";\n                img.src = \"resources/css/images/select_disable_password.png\";\n            } else {\n                passwordField.type = \"text\";\n                img.src = \"resources/css/images/select_enable_password.png\";\n            }\n    }\n    \n    document.getElementById(\"help_link_play_icon\").onclick = function(){\n        var width;\n        if(window.innerWidth - 20 > 1080){\n            width=1080;\n        }else{\n            width = window.innerWidth - 20;\n        }       \n        var height = width / 16 * 9\n        $(\"#cert-video-modal\").dialog( \"option\", \"width\", width );\n        $(\"#cert-video-modal\").dialog( \"option\", \"height\", height );\n        $(\"#cert-video-modal\").dialog('open');\n        \n        $(\"#cert-video-modal\").parent().attr(\"id\",\"cert-video-parent\");\n    }\n    \n        \n</script></div>\n    </div>\n    <div class=\"inner_container\">\n        <div class=col-lg-12\">\n                <iframe id=\"login-news-section\"  title=\"Login information update section \" src=\"https://www.revenue.ie/ros-content/ROS-Info-section-text-en.aspx\"></iframe>\n                <div id=\"login-news-section-compatibility-warning\" style=\"display:none;\">\n                <p class=\"login-compatibility-message\">\n                    Unsupported Browser detected. Please change browser to view this information.<br>\n                    <a href=\"https://www.revenue.ie/en/online-services/support/technical-requirements/system-requirements/ros-system-requirements.aspx\" class=\"\"\n\t\t   title=\"System Requirements\"\n\t\t   id=\"\"\n\t\t   target=\"_blank\">\n\t\t    Click here for more information on browser compatibility</a>\n\t</p>        \n            </div>\n        </div>\n        <div class=\"links\">\n                <div class=\"row\">\n                    <div class=\"useful-links-row col-md-5\">\n                        <h2 class=\"underline useful-links-heading\">\n                            Useful Links</h2>\n                        <ul class=\"useful-links-list\">\n                            <li class=\"useful-links\"><a href=\"https://www.revenue.ie/en/news/index.aspx\" class=\"\"\n\t\t   title=\"View Latest Revenue News\"\n\t\t   id=\"\"\n\t\t   target=\"\">\n\t\t    View Latest Revenue News</a>\n\t</li>\n                            <li class=\"useful-links\"><a href=\"https://www.revenue.ie/en/online-services/support/ros-help/getting-started-on-ros/about-ros/what-is-ros.aspx \" class=\"\"\n\t\t   title=\"Learn about ROS\"\n\t\t   id=\"\"\n\t\t   target=\"\">\n\