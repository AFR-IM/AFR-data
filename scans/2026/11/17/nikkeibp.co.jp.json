      "body": "<!DOCTYPE HTML>\n<html lang=\"ja\">\n<head prefix=\"og: http://ogp.me/ns# fb: http://ogp.me/ns/fb# article: http://ogp.me/ns/article#\">\n<meta name=\"description\" content=\"日経BPは日本経済新聞グループの一員として、経営・技術・生活という3分野で主にビジネスパーソンに向けて事業を展開しています。その内容は、雑誌・書籍の出版事業、デジタル事業、展示会・セミナーなどのイベント事業、調査・コンサルティング事業など、多種多彩なメディアとサービスを駆使して、高付加価値の先端・専門情報を提供しています。\">\n<meta name=\"bingbot\" content=\"noarchive\"><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=1,user-scalable=no\" />\n<meta property=\"og:title\" content=\"日経BP\">\n<meta property=\"og:description\" content=\"日経BPは日本経済新聞グループの一員として、経営・技術・生活という3分野で主にビジネスパーソンに向けて事業を展開しています。その内容は、雑誌・書籍の出版事業、デジタル事業、展示会・セミナーなどのイベント事業、調査・コンサルティング事業など、多種多彩なメディアとサービスを駆使して、高付加価値の先端・専門情報を提供しています。\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:url\" content=\"https://www.nikkeibp.co.jp/\">\n<meta property=\"og:image\" content=\"https://www.nikkeibp.co.jp/images/bplogo/og-logo.png\">\n<title>日経BP</title>\n<link rel=\"canonical\" href=\"https://www.nikkeibp.co.jp/\">\n<link href=\"/css/www/2018/font.css\" rel=\"stylesheet\">\n<link href=\"/css/www/2018/common.css?20231122\" rel=\"stylesheet\" type=\"text/css\">\n<link rel=\"stylesheet\" href=\"/css/www/2018/index.css?260527\">\n<script type=\"text/javascript\" src=\"/js/bpcommon/jquery-1.x.min.js\"></script>\n<script type=\"text/javascript\" src=\"/js/www/2018/jquery.matchHeight-min.js\"></script>\n<script type=\"text/javascript\" src=\"/js/www/2018/common.js?20200121\"></script>\n<script type=\"text/javascript\" src=\"/js/www/2018/form.js?20181212\"></script>\n<script src=\"/js/www/2018/slick.min.js?20200826\"></script>\n<script src=\"/js/www/2018/index.js?20200826\"></script>\n<!-- Start TagManager -->\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n})(window,document,'script','dataLayer','GTM-N67TT5M');</script>\n<!-- End TagManager --></head>\n<body id=\"top\">\n<div id=\"wrap\" class=\"top\">\n\n<!-- HEADER START -->\n<header>\n<div class=\"inner\">\n  <p class=\"logo\"><a href=\"/\">日経BP</a></p>\n  <div id=\"menuBtn\"><span>MENU</span></div>\n  <nav id=\"gNavi\">\n    <ul>\n      <li><a href=\"/company/\">企業情報</a></li>\n      <li>\n        <strong><a href=\"/business/\">事業紹介</a>\n        <ul>\n          <li><a href=\"/media/\">メディア</a></li>\n          <li><a href=\"/solution/\">ソリューション</a></li>\n          <li><a href=\"/publication/\">出版・書籍</a></li>\n          <li><a href=\"/event/\">イベント・セミナー</a></li>\n        </ul>\n        </strong>\n      </li>\n      <li><a href=\"/news/\">お知らせ</a></li>\n      <li><a href=\"/saiyo/\">採用案内</a></li>\n    </ul>\n  </nav>\n  <nav id=\"spNavi\">\n    <ul>\n      <li>\n        <strong><span>企業情報</span></strong>\n        <ul>\n          <li><a href=\"/company/\">会社概要</a></li>\n          <li><a href=\"/company/about.html\">企業理念</a></li>\n          <li><a href=\"/company/officer.html\">役員一覧</a></li>\n          <li><a href=\"/company/overseas.html\">海外支局・海外法人</a></li>\n          <li><a href=\"/company/group.html\">グループ会社</a></li>\n          <li><a href=\"/company/sustainability.html\">サステナビリティ</a></li>\n          <li><a href=\"/company/awards.html\">表彰</a></li>\n          <li><a href=\"/company/access.html\">アクセス</a></li>\n        </ul>\n      </li>\n      <li>\n        <strong><span>事業紹介</span></strong>\n        <ul>\n          <li><a href=\"/business/\">事業概要</a></li>\n          <li><a href=\"/media/\">メディア</a></li>\n          <li><a href=\"/solution/\">ソリューション</a></li>\n          <li><a href=\"/publication/\">出版・書籍</a></li>\n          <li><a href=\"/event/\">イベント・セミナー</a></li>\n        </ul>\n      </li>\n      <li><a href=\"/news/\">お知らせ</a></li>\n      <li><a href=\"/saiyo/\">採用案内</a></li>\n      <li class=\"language\"><a href=\"http://www.nikkeibp.com/\">English</a><a href=\"http://www.nikkeibp.com/ch/\">中文</a></li>\n    </ul>\n  </nav>\n</div>\n</header>\n<!-- HEADER END -->\n<div id=\"topMain\">\n  <div class=\"inner\">\n    <h1><span class=\"txt1\">その先を見る。</span><span class=\"txt2\">その先を解く。</span><span class=\"logo\">日経BP</span></h1>\n  </div>\n  <div class=\"movie\"></div>\n</div>\n\n  <div id=\"topics\">\n  <div class=\"inner\">\n    <p>お知らせ・<br>ニュースリリース</p>\n    <ul>\n<li>\n<ul class=\"topicsList\">\n<li><a href=\"/atcl/newsrelease/corp/20261027/\">デジタル媒体の誌面ビューアー版の閲覧再開について</a></li>\n<li><a href=\"/atcl/newsrelease/corp/20261112\">一部のお問い合わせフォームを停止しています</a></li>\n<li><a href=\"/atcl/newsrelease/corp/20261021_2/\">【重要なお知らせ】日本経済新聞社への不正アクセスに伴う当社サービス利用者の個人情報の漏えいについて</a></li>\n<li><a href=\"/atcl/newsrelease/corp/20261116/\">朝井リョウ『イン・ザ・メガチャーチ』 Billboard JAPAN Book Charts 第一回年間チャートにて 3 冠獲得</a></li>\n</ul></li>\n    </ul>\n    <a href=\"/news/\">一覧を見る</a>\n  </div>\n</div>\n <div id=\"services\">\n  <h2 class=\"subTtl\">事業紹介<span>SERVICES</span></h2>\n  <div class=\"col2\">\n    <div class=\"col media\">\n      <a href=\"/media/\">\n        <h3>メディア<span>MEDIA</span></h3>\n        <img src=\"/images/www/2018/index/ico-services_01.png\" alt=\"\">\n        <p>経営・技術・生活の先端・<br>専門情報を幅広く発信</p>\n      </a>\n    </div>\n    <div class=\"col solution\">\n      <a href=\"/solution/\">\n        <h3>ソリューション<span>SOLUTION</span></h3>\n        <img src=\"/images/www/2018/index/ico-services_02.png\" alt=\"\">\n        <p>独自の視点・分析、専門領域の人脈・場の創出。<br>真似のできないソリューション</p>\n      </a>\n    </div>\n    <div class=\"col publication\">\n      <a href=\"/publication/\">\n        <h3>出版・書籍<span>PUBLICATION</span></h3>\n        <img src=\"/images/www/2018/index/ico-services_03.png\" alt=\"\">\n        <p>ロングセラーから時流のテーマまで<br>独自視点のラインナップ</p>\n      </a>\n    </div>\n    <div class=\"col event\">\n      <a href=\"/event/\">\n        <h3>イベント・セミナー<span>EVENT SEMINAR</span></h3>\n        <img src=\"/images/www/2018/index/ico-services_04.png\" alt=\"\">\n        <p>「体感型メディア」で<br>効果的なコミュニケーションを</p>\n      </a>\n    </div>\n  </div>\n</div>\n\n<div id=\"data\">\n  <h2 class=\"subTtl\">数字で見る日経BP<span>DATA of NIKKEI BP</span></h2>\n  <div class=\"btnLink\">\n  <ul>\n    <li><div class=\"box\"><img src=\"/images/www/2018/index/bnr-data_01.png\" alt=\"50を超えるメディア\"><span class=\"num\" id=\"data1\">50</span></div></li>\n    <li><div class=\"box\"><img src=\"/images/www/2018/index/bnr-data_02.png\" alt=\"専門雑誌一筋50年\"><span class=\"num\" id=\"data2\">50</span></div></li>\n    <li><div class=\"box\"><img src=\"/images/www/2018/index/bnr-data_03.png\" alt=\"930万ビジネスパーソンID\"><span class=\"num\" id=\"data3\">930</span></div></li>\n    <li><div class=\"box\"><img src=\"/images/www/2018/index/bnr-data_04.png\" alt=\"調査データアーカイブ100万本\"><span class=\"num\" id=\"data4\">100</span></div></li>\n    <li><div class=\"box\"><img src=\"/images/www/2018/index/bnr-data_05.png\" alt=\"300人以上の専門記者\"><span class=\"num\" id=\"data5\">300</span></div></li>\n    <li><div class=\"box\"><img src=\"/images/www/2018/index/bnr-data_06_2.png\" alt=\"年間約1,000回のセミナー・イベント\"><span class=\"num\" id=\"data6\">1,000</span></div></li>\n  </ul>\n  </div>\n</div>\n\n<ul id=\"bnr\">\n  <li><a href=\"https://www.nikkeibp.co.jp/saiyo/\"><img src=\"/images/www/2018/index/bnr-recruit_01.jpg?230118\" alt=\"日経BP採用案内\" class=\"pc\"/><img src=\"/images/www/2018/index/bnr-recruit_02.jpg?230118\" alt=\"日経BP採用案内\" class=\"sp\"/></a></li>\n</ul>\n\n<div id=\"other\" class=\"btnArea\">\n  <ul>\n    <li><a href=\"/company/about.html\"><span>日経BPとは</span></a></li>\n    <li><a href=\"/company/\"><span>会社概要</span></a></li>\n    <li><a href=\"/history/\"><span>日経BPのあゆみ</span></a></li>\n    <li><a href=\"/company/sustainability.html\"><span>SDGs/ESG への<br>取り組み</span></a></li>\n  </ul>\n</div>\n\n<div id=\"seminar\"><a href=\"https://www.nikkeibp.co.jp/seminar/\" target=\"_blank\">セミナーをお探しの方はこちら</a><