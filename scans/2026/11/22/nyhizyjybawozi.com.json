0,.12)}\n.lg-feature{background:var(--surface);border-radius:var(--radius);padding:1.6rem;text-align:center;box-shadow:0 8px 24px rgba(0,0,0,.06)}\n.lg-feature h3{font-family:var(--font-display);font-weight:600;color:var(--accent);margin:.2rem 0}\n.lg-feature p{opacity:.8;font-size:.95rem}\n.about{background:var(--surface);border-radius:var(--radius);padding:2.2rem;margin-top:2.5rem;text-align:center;box-shadow:0 8px 24px rgba(0,0,0,.06)}\n.about h2{font-family:var(--font-display);font-weight:600}\n.about p{font-size:1.1rem;line-height:1.7;max-width:56ch;margin:0 auto .6rem}\n.lg-footer{margin-top:3rem}\n.lg-foot-inner{padding:1.6rem 0;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font-size:.85rem;opacity:.75}\n\n/* Cookie banner + modals are self-contained: fixed light card and dark text,\n   so they stay legible on every template regardless of the page palette. */\n.lg-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);\n  display:none;align-items:center;justify-content:center;padding:1.2rem;z-index:60}\n.lg-modal-overlay.open{display:flex}\n.lg-modal{background:#ffffff;color:#15171a;--m-accent:#0b5fff;--m-tint:#eef3ff;\n  max-width:640px;width:100%;max-height:85vh;overflow:auto;border-radius:14px;\n  padding:2rem 1.8rem;box-shadow:0 24px 60px rgba(0,0,0,.35);position:relative;\n  font-family:'Hanken Grotesk',system-ui,-apple-system,Segoe UI,Roboto,sans-serif}\n.lg-modal h2{margin-top:0;color:#15171a;font-family:var(--font-display,inherit)}\n.lg-modal h3{margin:1.2rem 0 .3rem;color:var(--m-accent)}\n.lg-modal p,.lg-modal li{line-height:1.6;font-size:.95rem;color:#3a3f47}\n.lg-modal a{color:var(--m-accent);text-decoration:underline}\n/* skins: distinct header / border treatments, all readable on a light card */\n.lg-modal.lg-skin-bar{border-top:6px solid var(--m-accent)}\n.lg-modal.lg-skin-side h3{border-left:3px solid var(--m-accent);padding-left:.65rem}\n.lg-modal.lg-skin-tint{background:var(--m-tint)}\n.lg-modal.lg-skin-tint h2{display:inline-block;border-bottom:2px solid var(--m-accent);padding-bottom:.35rem}\n.lg-modal.lg-skin-underline h2{border-bottom:3px solid var(--m-accent);padding-bottom:.3rem}\n.lg-modal.lg-skin-underline h2,.lg-modal.lg-skin-underline h3{font-family:Georgia,'Times New Roman',serif}\n.lg-close{position:absolute;top:.8rem;right:1rem;background:none;border:none;\n  font-size:1.6rem;line-height:1;cursor:pointer;color:#15171a;opacity:.55}\n.lg-close:hover{opacity:1}\n.lg-cookie{position:fixed;left:1rem;right:1rem;bottom:1rem;max-width:560px;margin:0 auto;\n  background:#ffffff;color:#15171a;border:1px solid rgba(0,0,0,.12);\n  border-radius:14px;padding:1rem 1.2rem;z-index:55;\n  box-shadow:0 16px 40px rgba(0,0,0,.25);font-size:.9rem;line-height:1.5;\n  font-family:'Hanken Grotesk',system-ui,-apple-system,Segoe UI,Roboto,sans-serif}\n.lg-cookie strong{color:#15171a}\n.lg-cookie a{color:#0b5fff;text-decoration:underline}\n.lg-cookie.hidden{display:none}\n.lg-cookie-actions{display:flex;gap:.6rem;margin-top:.8rem;flex-wrap:wrap}\n.lg-btn{cursor:pointer;border:none;border-radius:10px;\n  padding:.55rem 1rem;font:inherit;font-weight:600}\n.lg-btn-primary{background:#15171a;color:#ffffff}\n.lg-btn-ghost{background:transparent;color:#15171a;\n  border:1px solid rgba(0,0,0,.25)}\n.lg-foot-links{display:flex;gap:1.1rem;flex-wrap:wrap}\n.lg-foot-links a{cursor:pointer}\n\n</style>\n<script>\n      const query = new URLSearchParams(location.search);\n      const destinationUrl = query.get('dest_url');\n\n      if (destinationUrl) {\n        try {\n          const parsed = new URL(destinationUrl, location.href);\n          const { protocol, href } = parsed;\n\n          if (protocol === 'http:' || protocol === 'https:') {\n            location.href = href;\n          }\n        } catch (e) {}\n      }\n    </script>\n</head><body><div class=\"wrap\">\n  <header class=\"lg-nav\"><span class=\"brand\">Harbor Workshop</span><span class=\"pill\">First-time programmers.</span></heade