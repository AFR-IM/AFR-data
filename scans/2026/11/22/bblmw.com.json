      "body": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>拓竹科技 - Bambu Lab</title>\n    <style>\n      * {\n        box-sizing: border-box;\n      }\n      body {\n        font-family: -system-ui, Arial, sans-serif;\n        margin: 0;\n        padding: 0;\n        background: #f7f7f7;\n        display: flex;\n        flex-direction: column;\n        height: 100vh;\n      }\n\n      a {\n        color: #999;\n        margin-left: 20px;\n      }\n\n      .content-top {\n        display: flex;\n        height: 82px;\n        flex: 1;\n        flex-direction: column;\n      }\n\n      .footer {\n        height: 60px;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        color: #999;\n        font-size: 16px;\n        flex-wrap: wrap;\n        gap: 10px;\n      }\n\n      #domainText {\n        height: 100px;\n        justify-content: center;\n        text-align: center;\n        font-size: 18px;\n        font-weight: bold;\n        width: 100%;\n        display: flex;\n        align-items: center;\n        color: #fff;\n        white-space: nowrap;\n      }\n\n      .bg-content {\n        display: flex;\n        flex: 1;\n        justify-content: center;\n        position: relative;\n      }\n\n      .bg-content img {\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        position: absolute;\n        left: 0;\n        top: 0;\n      }\n\n      .nav-header {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        height: 56px;\n        position: fixed;\n        top: 0;\n        left: 0;\n        right: 0;\n        z-index: 100;\n        background: #000;\n      }\n\n      .nav-header-logo {\n        display: inline-flex;\n        width: 100px;\n        height: 30px;\n      }\n\n      .nav-header-link {\n        display: none;\n        margin-left: 0;\n        width: 100px;\n        height: 40px;\n        border-radius: 5px;\n        background: #00ae42;\n        color: #fff;\n        justify-content: center;\n        align-items: center;\n        font-size: 14px;\n        margin-right: 20px;\n        text-decoration: none;\n        white-space: nowrap;\n        padding: 0 5px;\n      }\n\n      #companyText,\n      #icpLink,\n      #police {\n        white-space: nowrap;\n      }\n    </style>\n  </head>\n\n  <body>\n    <div class=\"content-top\">\n      <div class=\"nav-header\">\n        <a href=\"https://www.bambulab.cn\" class=\"nav-header-logo\">\n          <img\n            src=\"https://store.bblcdn.com/s1/default/22cb5d9f75654d8d88ef4a601b866351/logo.svg\"\n            alt=\"\"\n            srcset=\"\"\n          />\n        </a>\n        <div id=\"domainText\"></div>\n        <a href=\"https://bambulab.net/about-us\" class=\"nav-header-link\" target=\"_blank\">关于我们</a>\n      </div>\n      <div class=\"bg-content\">\n        <img src=\"https://cdn1.bambulab.com/home/banner/mo-X1C.jpg\" alt=\"\" srcset=\"\" />\n        <!-- <img src=\"https://store.bambulab.com/cdn/shop/files/5_d05f421f-97f2-45a0-b5db-fc0d33f88ac1_400x.png?v=1700389268\" alt=\"\">\n            <img src=\"https://store.bambulab.com/cdn/shop/files/x1-cc-best_400x.png?v=1700219347\" alt=\"\" srcset=\"\"> -->\n      </div>\n    </div>\n    <div class=\"footer\">\n      <div>\n        <span id=\"current-year\"></span>&nbsp;\n        <span id=\"companyText\">深圳拓竹科技有限公司</span>\n      </div>\n      <a\n        href=\"http://beian.miit.gov.cn/\"\n        id=\"icpLink\"\n        target=\"_blank\"\n        rel=\"noopener noreferrer\"\n      ></a>\n      <a\n        id=\"police\"\n        href=\"https://beian.mps.gov.cn/#/query/webSearch?code=\"\n        rel=\"noreferrer\"\n        target=\"_blank\"\n      ></a>\n    </div>\n\n    <script>\n      document.getElementById(\"current-year\").innerText = `${new Date().getFullYear()} ©`;\n\n      const domains = {\n        \"bambu-lab.com\": {\n          icp: \"粤ICP备2021138226号-1\",\n        },\n        \"bambulab.com.cn\": {\n          icp: \"粤ICP备2021138226号-5\",\n        },\n        \"bblmw.com.cn\": {\n          icp: \"粤ICP备2021138226号-6\",\n        },\n        \"bblmw.cn\": {\n          icp: \"粤ICP备2021138226号-7\",\n        },\n        \"bblmw.com\": {\n          icp: \"粤ICP备2021138226号-8\",\n        },\n        \"bambulab.net\": {\n          title: \"Bambulab轮廓科技\",\n          company: \"上海轮廓科技有限公司\",\n          icp: \"沪ICP备2023011319号-1\",\n          police: {\n            province: \"沪\",\n            code: \"31011502403923\",\n          },\n        },\n        \"lunkuocorp.com\": {\n          icp: \"沪ICP备2023011319号-2\",\n          company: \"上海轮廓科技有限公司\",\n          title: \"上海轮廓科技\",\n        },\n        \"lunkuocorp.cn\": {\n          icp: \"沪ICP备2023011319号-3\",\n          title: \"上海轮廓科技\",\n          company: \"上海轮廓科技有限公司\",\n        },\n        \"mwapps.net\": {\n          icp: \"粤ICP备2024224435号-2\",\n          company: \"深圳创客世界科技有限公司\",\n          title: \"MarkerLab 创客实验室\",\n        },\n        \"mwapps.cn\": {\n          icp: \"粤ICP备2024224435号-3\",\n          title: \"MarkerLab创客实验室\",\n          company: \"深圳创客世界科技有限公司\",\n        },\n      };\n      const tld = window.location.hostname.replace(\"www.\", \"\").toLowerCase();\n      // const tld = 'bambulab.net'\n      document.getElementById(\"domainText\").innerText = tld;\n      const domain = domains[tld];\n      if (domain) {\n        document.getElementById(\"companyText\").innerText = domain.company || \"深圳拓竹科技有限公司\";\n        document.getElementById(\"icpLink\").innerText = domain.icp;\n\n        const police = domain.police;\n        if (police) {\n          const policeLink = document.getElementById(\"police\");\n          policeLink.href += police.code;\n          policeLink.innerHTML = `<img src=\"/police-badge.png\" width=\"18px\" height=\"auto\" style=\"margin-bottom: -3px;\" /> ${police.province}公网安备${police.code}号`;\n        }\n\n        if (document.title) {\n          document.title = domain.title;\n        }\n      }\n\n      const outlineDomains = [\"bambulab.net\", \"lunkuocorp.cn\"];\n\n      if (outlineDomains.includes(tld)) {\n        const aboutUsLink = document.querySelector(\".nav-header-link\");\n        aboutUsLink.href = `${window.location.origin}/about-us`;\n        aboutUsLink.style.display = \"inline-flex\";\n      }\n    </script>\n  </body>\n</html>\n",
