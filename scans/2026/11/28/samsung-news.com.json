      "body": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Samsung News</title>\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css\" />\n    <link rel=\"stylesheet\" href=\"/about/css/style.css\">\n    <script src=\"/about/js/jquery-3.6.0.min.js\"></script>\n    <script src='https://cdnjs.cloudflare.com/ajax/libs/Swiper/6.8.4/swiper-bundle.min.js'></script>\n    <script src=\"/about/js/index.js\"></script>\n</head>\n<body>\n    <!-- html -->\n\n    <div class=\"wrapper\">\n        <header class=\"header\">\n            <div class=\"top\">\n               <div class=\"container\">\n                    <h1>Samsung News</h1>\n                    <a href=\"https://galaxystore.samsung.com/detail/com.samsung.android.app.spage?cId=000006738177\" class=\"btn btnDown\">Download now</a>\n               </div>\n            </div>\n        </header>\n        <section class=\"mainVisual\">\n            <div class=\"container\">\n                <div class=\"video\">\n                    <video id=\"mainVideo\" autoplay muted loop>\n                        <source type=\"video/mp4\" src=\"https://images.samsung.com/is/content/samsung/assets/us/apps/samsung-news/06062023/SNews_Mod1_SNews_Hero_Desktop_Video.mp4\" >\n                    </video>\n                </div>\n                <div class=\"mainText\">\n                    <img class=\"logo\" src=\"/about/images/pc/SNews_Mod1_SNews_logo_desktop.png\" alt=\"Samsung News BETA\">\n                    <h2>Just the daily news you need.</h2>\n                    <a href=\"https://galaxystore.samsung.com/detail/com.samsung.android.app.spage?cId=000006738177\" class=\"btn btnDown\">Download now</a>\n                </div>\n            </div>\n        </section>\n        <section class=\"news\">\n            <div class=\"container\">\n                <div class=\"item\">\n                    <div class=\"text\">\n                        <h2>Welcome to Samsung News.</h2>\n                        <p>Samsung News is your newest destination for trending, breaking, and local news. With trusted partners, we bring you tailored morning and evening briefings alongside expertly curated top stories. It’s just the news you need, daily.</p>\n                        <a href=\"https://galaxystore.samsung.com/detail/com.samsung.android.app.spage?cId=000006738177\" class=\"btn btn01\">Download now</a>\n                    </div>\n                    <div class=\"visual\">\n                        <img src=\"/about/images/pc/SNews_Mod2_DeviceLockup.png\" alt=\"\">\n                    </div>\n                </div>\n                <div class=\"item\">\n                    <div class=\"text\">\n                        <strong>Daily Briefing</strong>\n                        <h2>Daily news from dawn to dusk.</h2>\n                        <p>Expert news editors help bring you the day's top stories, twice daily. Start your day with the \"Morning Briefing\" and wrap up with the \"Evening Briefing.\" It’s all your essential news, all in one place.</p>\n                        <a href=\"https://galaxystore.samsung.com/detail/com.samsung.android.app.spage?cId=000006738177\" class=\"btn btn02\">See now</a>\n                    </div>\n                    <div class=\"video\">\n                        <video autoplay muted loop>\n                            <source type=\"video/mp4\" src=\"https://images.samsung.com/is/content/samsung/assets/us/apps/samsung-news/04192023-2/SNews_Mod3_Daily_Briefing_Video1.mp4\" >\n                        </video>\n                    </div>\n                </div>\n                <div class=\"item\">\n                    <div class=\"text\">\n                        <strong>Customization</strong>\n                        <h2>Personalized for you, by you.</h2>\n                        <p>Looking for a personalized news experience? Handpick the sources you trust and filter out the ones you don't, curating a tailored feed. Whether that includes your favorite local news, podcasts, or established national news outlets.</p>\n                        <a href=\"https://galaxystore.samsung.com/detail/com.samsung.android.app.spage?cId=000006738177\" class=\"btn btn03\">See now</a>\n                    </div>\n                    <div class=\"visual\">\n                        <img src=\"/about/images/pc/SNews_Mod3_Customization.png\" alt=\"\">\n                    </div>\n                </div>\n            </div>\n        </section>\n    </div>\n\n    <!-- // html -->\n\n</body>\n</html>\n",
