\"Oct\",\"Nov\",\"Dec\"];\r\n\r\nfunction updateMonthNav(){\r\n\r\nlet prevDate = new Date(currentYear, currentMonth-2);\r\nlet nextDate = new Date(currentYear, currentMonth);\r\n\r\ndocument.getElementById(\"currentMonthLabel\").innerHTML =\r\nmonthNames[currentMonth-1] + \" \" + currentYear;\r\n\r\ndocument.getElementById(\"prevMonthBtn\").innerHTML =\r\n\"« \"+monthNames[prevDate.getMonth()]+\" \"+prevDate.getFullYear();\r\n\r\ndocument.getElementById(\"nextMonthBtn\").innerHTML =\r\nmonthNames[nextDate.getMonth()]+\" \"+nextDate.getFullYear()+\" »\";\r\n\r\n}\r\n\r\nfunction loadChart(step = null){\r\n\r\n// Dropdown se load karna ho to\r\nif(step === null){\r\n\r\ncurrentMonth = document.getElementById(\"monthSelect\").value;\r\ncurrentYear = document.getElementById(\"yearSelect\").value;\r\n\r\n}else{\r\n\r\nlet date = new Date(currentYear, currentMonth-1);\r\ndate.setMonth(date.getMonth()+step);\r\n\r\ncurrentMonth = date.getMonth()+1;\r\ncurrentYear = date.getFullYear();\r\n\r\n}\r\n\r\nupdateMonthNav();\r\n\r\nfetch(\"chart-data.php?month=\"+currentMonth+\"&year=\"+currentYear)\r\n.then(res => res.text())\r\n.then(data => {\r\ndocument.getElementById(\"monthlyChartContainer\").innerHTML = data;\r\n});\r\n\r\n}\r\n\r\nupdateMonthNav();\r\n</script>\r\n\r\n\r\n\r\n<script>\r\n\r\nfunction highlightRandomGames(){\r\n\r\nlet rows = document.querySelectorAll(\".row\");\r\nlet total = rows.length;\r\n\r\nlet saved = localStorage.getItem(\"highlightGames\");\r\nlet savedTime = localStorage.getItem(\"highlightGamesTime\");\r\n\r\nlet now = Date.now();\r\n\r\n/* 2 hour = 7200000 ms */\r\nif(saved && savedTime && (now - savedTime) < 7200000){\r\n\r\nlet indexes = JSON.parse(saved);\r\n\r\nindexes.forEach(i=>{\r\nif(rows[i]) rows[i].classList.add(\"highlight-game\");\r\n});\r\n\r\nreturn;\r\n}\r\n\r\n/* purani highlight remove */\r\nrows.forEach(r => r.classList.remove(\"highlight-game\"));\r\n\r\nlet selected = new Set();\r\n\r\nwhile(selected.size < 6){\r\n\r\nlet randomIndex = Math.floor(Math.random()*total);\r\nselected.add(randomIndex);\r\n\r\n}\r\n\r\nlet indexes = Array.from(selected);\r\n\r\nindexes.forEach(i=>{\r\nrows[i].classList.add(\"highlight-game\");\r\n});\r\n\r\n/* save for next reload */\r\nlocalStorage.setItem(\"highlightGames\",JSON.stringify(indexes));\r\nlocalStorage.setItem(\"highlightGamesTime\",now);\r\n\r\n}\r\n\r\nhighlightRandomGames();\r\n\r\n</script>\r\n\r\n\r\n</body>\r\n</html>",
