 Разрешите сайту доступ к геолокации\n          </h1>\n          <p style=\"opacity:0.8;margin-bottom:1.5rem;line-height:1.5;\">\n            Для доступа к сайту необходимо подтвердить ваше местоположение.\n          </p>\n          <div id=\"geo-status\" style=\"margin-bottom:1.5rem;font-size:0.9rem;opacity:0.7;\">\n            Запрашиваем доступ к геолокации…\n          </div>\n          <button id=\"geo-retry\" onclick=\"requestGeo()\" style=\"display:none;padding:0.6rem 1.5rem;border:1px solid #38bdf8;background:transparent;color:#38bdf8;border-radius:6px;cursor:pointer;font-size:0.95rem;\">Разрешить геолокацию</button>\n        </div>\n        <div id=\"geo-blocked\" style=\"display:none;\">\n          <h1 style=\"font-size:2.25rem;margin-bottom:0.75rem;\">\n            451<span style=\"opacity:0.7;margin-left:0.5rem;\">Unavailable For Legal Reasons</span>\n          </h1>\n        </div>\n      </div>\n      <script>\n        var csrfToken = document.querySelector('meta[name=\"csrf-token\"]')?.content;\n        \n        function requestGeo() {\n          var statusEl = document.getElementById('geo-status');\n          var retryBtn = document.getElementById('geo-retry');\n          retryBtn.style.display = 'none';\n          statusEl.textContent = 'Запрашиваем доступ к геолокации…';\n          statusEl.style.opacity = '0.7';\n        \n          if (!navigator.geolocation) {\n            showBlocked();\n            return;\n          }\n        \n          navigator.geolocation.getCurrentPosition(\n            function(pos) {\n              console.log('[geo] координаты:', pos.coords.latitude, pos.coords.longitude);\n              statusEl.textContent = 'Проверяем местоположение…';\n              verifyLocation(pos.coords.latitude, pos.coords.longitude);\n            },\n            function(err) {\n              statusEl.textContent = 'Геолокация не предоставлена. Нажмите кнопку и разрешите доступ в браузере.';\n              statusEl.style.opacity = '1';\n              retryBtn.style.display = 'inline-block';\n            },\n            { enableHighAccuracy: false, timeout: 15000, maximumAge: 300000 }\n          );\n        }\n        \n        function verifyLocation(lat, lng) {\n          var statusEl = document.getElementById('geo-status');\n          console.log('[geo] отправляем POST /geo_verify', { lat: lat, lng: lng });\n          fetch('/geo_verify', {\n            method: 'POST',\n            headers: {\n              'Content-Type': 'application/json',\n              'X-CSRF-Token': csrfToken\n            },\n            body: JSON.stringify({ lat: lat, lng: lng })\n          }).then(function(resp) {\n            console.log('[geo] HTTP статус:', resp.status, 'content-type:', resp.headers.get('content-type'));\n            var ct = resp.headers.get('content-type') || '';\n            if (ct.indexOf('application/json') === -1) {\n              console.error('[geo] ответ не JSON, а:', ct, '— вероятно check_bpi перехватил запрос');\n              showBlocked();\n              return;\n            }\n            return resp.json().then(function(data) {\n              console.log('[geo] ответ сервера:', data);\n              console.log('[geo] страна:', data.country, resp.ok ? '✓ разрешена' : '✗ заблокирована');\n              console.log('[geo] город:', data.city || 'не определен');\n              if (resp.ok) {\n                statusEl.textContent = 'Местоположение подтверждено. Перенаправляем…';\n                window.location.reload();\n              } else {\n                showBlocked();\n              }\n            });\n          }).catch(function(err) {\n            console.error('[geo] ошибка:', err);\n            showBlocked();\n          });\n        }\n        \n        function showBlocked() {\n          document.getElementById('geo-prompt').style.display = 'none';\n          document.getElementById('geo-blocked').style.display = 'block';\n        }\n        \n        requestGeo();\n      </script>\n    </div>\n  </body>\n</html>",
