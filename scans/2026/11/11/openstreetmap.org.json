button name=\"button\" type=\"submit\" class=\"btn btn-primary p-1\" title=\"Go\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"20\"><circle cx=\"13\" cy=\"7\" r=\"6.5\" fill=\"currentColor\" fill-opacity=\".5\" stroke=\"currentColor\"></circle><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" d=\"M9.75 12.629a6.5 6.5 0 0 1-2.379-2.379\"></path><path stroke=\"currentColor\" stroke-opacity=\".5\" stroke-width=\"2\" d=\"m1 19 .5-.5\"></path><path stroke=\"currentColor\" stroke-width=\"2.5\" d=\"M1.5 18.5 6 14\"></path><path stroke=\"currentColor\" stroke-opacity=\".5\" stroke-width=\"2\" d=\"m6 14 .5-.5\"></path><path stroke=\"currentColor\" stroke-width=\"1.5\" d=\"m6.5 13.5 2-2\"></path></svg>\n</button>      </div>\n      <a class=\"btn btn-primary p-1 switch_link\" title=\"Find directions between two points\" href=\"/directions\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"24\" class=\"align-bottom\"><path fill=\"none\" stroke=\"currentColor\" stroke-opacity=\".5\" d=\"M11.5 11.5v-3h3v-1l-5-5-5 5v1h3v6\"></path><path fill=\"currentColor\" fill-opacity=\".5\" stroke=\"currentColor\" d=\"M7.5 21.5h4v-5a1 1 0 0 1 1-1h5v3h1l5-5-5-5h-1v3h-6a4 4 0 0 0-4 4z\"></path></svg>\n</a>    </div>\n  </form>\n\n  <form method=\"GET\" action=\"/directions\" class=\"directions_form bg-body-secondary p-2\">\n    <div class=\"d-flex flex-column gap-2\">\n      <div class=\"d-flex gap-2 align-items-center\">\n        <div class=\"btn-group routing_modes\" role=\"group\">\n            <input type=\"radio\" name=\"modes\" id=\"modes_car\" value=\"car\" class=\"btn-check\" autocomplete=\"off\" disabled=\"disabled\" />\n            <label class=\"btn btn-outline-secondary px-2 py-1\" title=\"Car\" for=\"modes_car\"><i class=\"bi bi-car-front-fill fs-6\" aria-hidden=\"true\"></i></label>\n            <input type=\"radio\" name=\"modes\" id=\"modes_bicycle\" value=\"bicycle\" class=\"btn-check\" autocomplete=\"off\" 