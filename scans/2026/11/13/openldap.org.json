    "homepage": {
      "status": 200,
      "body": "<NOSTRIP><!--\n     Copyright (c) 2014-2021, OpenLDAP Foundation, All Rights Reserved.\n     Author:   www-data (www-data@agnesi.openldap.org)\n     Modified: 2026-08-07 17:31:31.\n     Generated from ``index.wml'' via WML 2.32.0.\n               by root (root@agnesi.openldap.org)\n               on 2026-10-22 17:43:18.\n\n     DO NOT EDIT THIS FILE DIRECTLY! INSTEAD EDIT ``index.wml''.\n--></NOSTRIP>\n<!--\n name: Main Page\n site: OpenLDAP\n area: main\n subarea:\tmain\n page: main (off) (off)\n select:\tmain\n id:\n\t$Id: 90aaaffc39c1a6d7969eddce19c03749a765b51d $\n-->\n<HTML>\n<HEAD>\n<TITLE>OpenLDAP, Main Page</TITLE>\n<META NAME=\"viewport\" CONTENT=\"width=device-width,initial-scale=1\">\n<META NAME=\"Copyright\" CONTENT=\"Copyright 2014-2026 The OpenLDAP Foundation, All Rights Reserved.\">\n<NOSTRIP><META NAME=\"Author\"    CONTENT=\"www-data, www-data@agnesi.openldap.org\">\n<META NAME=\"Generator\" CONTENT=\"WML 2.32.0\">\n<META NAME=\"Modified\"  CONTENT=\"2026-08-07 17:31:31\">\n</NOSTRIP>\n<SCRIPT TYPE=\"text/javascript\" LANGUAGE=\"JavaScript\"><NOSTRIP>\n<!-- Hiding the code\n\n\t// don't frame me\n\tif(window.location != window.parent.location) {\n\t\twindow.parent.location = window.location;\n\t}\n\n// done hiding -->\n</NOSTRIP></SCRIPT>\n<META NAME=\"swish-keywords\" CONTENT=\"home, homepage, home page, main\">\n<META NAME=\"keywords\" CONTENT=\"OpenLDAP, Open, LDAP, X.500, Directory, Open Source, OpenSource, Source, home, homepage, home page, main\">\n<META NAME=\"description\" CONTENT=\"The Open Source for LDAP software and information. Home of OpenLDAP.\">\n</HEAD>\n<BODY BGCOLOR=\"#ffffff\" TEXT=\"#000000\" LINK=\"#0000ff\" ALINK=\"#ff0000\" VLINK=\"#800080\">\n\n\n<FONT FACE=\"Arial,Verdana,Helvetica\">\n<!-- BEGIN OF ACTUAL PAGE CONTENTS -->\n<DIV ALIGN=\"center\">\n<DIV ALIGN=\"center\"><IMG ALT=\"OpenLDAP\" SRC=\"images/headers/LDAPworm.gif\" WIDTH=\"305\" HEIGHT=\"120\"><BR>\n<FONT SIZE=\"2\"><EM>community developed LDAP software</EM></FONT>\n</DIV></TD>\n<P>\n<TABLE SUMMARY=\"\">\n<TR>\n<TD VALIGN=\"top\">\n<DIV STYLE=\"overflow: hidden;\">\n<DIV STYLE=\"float:left;\">\n<FONT SIZE=\"2\">\n<UL>\n<LI><A HREF=\"project/\">The Project</A>\n\t<UL>\n\t<LI><B><A HREF=\"conf/\">Conferences</A></B>\n\t<LI><I><A HREF=\"pub/\">Other Publications</A></I>\n\t</UL>\n<LI><A HREF=\"foundation/\">The Foundation</A>\n\t<UL>\n\t<LI><A HREF=\"foundation/sponsors.html\">Sponsors</A>\n\t</UL>\n<LI><B><A HREF=\"devel/\">Development</A></B>\n\t<UL>\n\t<LI><I><A HREF=\"devel/contributing.html\">Contributing</A></I>\n\t<LI><A HREF=\"https://git.openldap.org\">Browse Sources</A>\n\t<LI><A HREF=\"software/repo.html\">Repository Access</A>\n\t</UL>\n</UL>\n</FONT>\n</DIV>\n<DIV STYLE=\"float:left;\">\n<FONT SIZE=\"2\">\n<UL>\n<LI><B><A HREF=\"software/\">Software</A></B>\n\t<UL>\n\t<LI><B><I><A HREF=\"software/download/\">Download!</A></I></B>\n\t<LI><A HREF=\"/doc\">OpenLDAP Admin Guide</A>\n\t<UL><LI><I><B><A HREF=\"doc/admin27/quickstart.html\"\n>Quick Start Guide</A></B></I></UL>\n\t<LI><A HREF=\"software/man.cgi\">Manual Pages</A>\n\t<LI><I><A HREF=\"software/roadmap.html\">Roadmap</A></I>\n\t</UL>\n</UL>\n</FONT>\n</DIV>\n<DIV STYLE=\"float:left;\">\n<FONT SIZE=\"2\">\n<UL>\n<LI><B><A HREF=\"support/\">Support</A></B>\n\t<UL>\n\t<LI><I><A HREF=\"faq/\">Faq-O-Matic</A></I>\n\t<LI><B><A HREF=\"its/\">Issue Tracking</A></B>\n\t<LI><A HREF=\"lists/\">Mailing Lists</A>\n\t<LI><A HREF=\"irc/\">Internet Relay Chat</A>\n\t</UL>\n<LI><I><B><A HREF=\"search/\">Search!</A></B></I>\n</UL>\n</FONT>\n</DIV>\n</FONT>\n</DIV>\n</TD>\n</TR>\n</TABLE>\n</DIV>\n<P>\n<TABLE WIDTH=\"100%\" SUMMARY=\"\">\n<TR><TD COLSPAN=\"2\">\n<A HREF=\"software/\">OpenLDAP Software</A> is an\n<A HREF=\"http://www.opensource.org/\">open source</A>\nimplementation of the\n<B>L</B>ightweight <B>D</B>irectory <B>A</B>ccess <B>P</B>rotocol.\n</TD></TR>\n<TR><TD>\nThe suite includes:\n<UL>\n<LI><A HREF=\"software/man.cgi?query=lloadd\">lloadd</A>\n\t- stand-alone LDAP Load Balancer Daemon (server or slapd module)\n<LI><A HREF=\"software/man.cgi?query=slapd\">slapd</A>\n\t- stand-alone LDAP daemon (server)\n<LI><A HREF=\"software/man.cgi?query=ldap\">libraries</A>\n\timplementing the LDAP protocol, and\n<LI>utilities, tools, and sample clients.\n</UL>\nAlso available from the <A HREF=\"project/\">OpenLDAP Project</A>:\n<UL>\n<LI><A HREF=\"fortress/\">Fortress</A> - Role-based identity access management Java SDK\n<LI><A HREF=\"jldap/\">JLDAP</A> - LDAP Class Libraries for Java\n<LI><A HREF=\"jdbcldap/\">JDBC-LDAP</A> - Java JDBC - LDAP Bridge Driver\n<LI><A HREF=\"https://git.openldap.org/openldap/openldap/-/tree/mdb.RE/0.9\">LMDB</A> - Lightning Memory-Mapped Database\n</UL>\n</TD>\n<TD ALIGN=\"left\">\n<TABLE BORDER=\"0\" CELLPADDING=\"10\" SUMMARY=\"\">\n<TR><TD ALIGN=\"left\">\n<TABLE BORDER=\"1\" CELLPADDING=\"10\" SUMMARY=\"\">\n<TR>\n<TD ALIGN=\"center\" BGCOLOR=\"#f0f0f0\">\n<B>OpenLDAP Feature Release 2.7.2</B><BR>\n<I><A HREF=\"software/download/\">Now available!</A></I>\n</TD>\n</TR>\n<TR><TD ALIGN=\"center\" BGCOLOR=\"#f0f0f0\">\n<B>OpenLDAP Long Term Support Release 2.6.16</B><BR>\n<I><A HREF=\"software/download/\">Now available!</A></I>\n</TD>\n</TR>\n</TABLE>\n</DIV>\n</TD></TR>\n</TABLE>\n</TD>\n</TR>\n</TABLE>\n<HR>\n<TABLE WIDTH=\"100%\" SUMMARY=\"\">\n<TR>\n<TD ALIGN=\"right\">\n<DIV ALIGN=\"center\">Site funded and managed by:<BR><A\n\tHREF=\"https://www.symas.com/welcome-to-symas\"><IMG BORDER=\"0\"\n\tALT=\"Site funded and managed by Symas\"\n\tSRC=\"/images/symas-logo-small.png\"></A><BR>\n</DIV>\n</TD>\n<TD ALIGN=\"center\"><SMALL>This site is <A HREF=\"powered.html\">powered</A>\nby <A HREF=\"http://www.opensource.org/\">open source</A> software.</SMALL></TD>\n<TD></TD>\n<TD ALIGN=\"right\" VALIGN=\"top\">\n<DIV ALIGN=\"center\">Hosting provided by:<BR><A\n\tHREF=\"https://www.symas.com/welcome-to-symas\"><IMG BORDER=\"0\"\n\tALT=\"Hosting provided by Symas\"\n\tSRC=\"/images/symas-logo-small.png\"></A><BR>\n</DIV>\n</TD>\n</TR>\n</TABLE>\n<!-- END OF ACTUAL PAGE CONTENTS -->\n</FONT>\n\n\n<P>\n<FONT COLOR=\"#808080\" FACE=\"Arial,Verdana,Helvetica\" SIZE=\"1\"><B>\n________________<BR>\n<SMALL>&copy; Copyright 2014-2026, <A HREF=\"http://www.OpenLDAP.org/foundation/\">OpenLDAP Foundation</A>. <A HREF=\"/privacy.html\">Privacy Statement</A></SMALL><BR>\n<SMALL><TT>\n\t$Id: 90aaaffc39c1a6d7969eddce19c03749a765b51d $\n</TT></SMALL>\n</B></FONT>\n\n</BODY>\n</HTML>\n",
