  }\n\n      h2{\n        margin-top: 18px;\n        font-size: 26px;\n        line-height: 26px;\n        font-weight: 200;\n      }\n\n\n\n      .btn {\n        border: 1px solid #EF3743;\n        background-color: #EF3743;\n        color: white;\n        line-height: 44px;\n        width: 250px;\n        margin-top: 0;\n        -webkit-border-radius: 5px;\n        -moz-border-radius: 5px;\n        border-radius: 5px;\n        display: inline-block;\n      }\n\n      .btn:hover {\n        border: 1px solid #f0606c;\n        background-color: #f0606c;\n      }\n\n      .footer {\n          position: absolute;\n          bottom: 0;\n          width: 100%;\n          height: 60px;\n          background-color: #2A273F;\n      }\n\n    </style>\n\n    <script type=\"text/javascript\">\n    function delayedRedirect(){\n        window.location = \"https://platform.33across.com/\"\n    }\n    </script>\n\n    <script src=\"https://use.typekit.net/vqk5buo.js\"></script>\n    <script>\n      try {\n        Typekit.load({async: true});\n      } catch (e) {\n      }\n    </script>\n\n    <%= csrf_meta_tags %>\n  </head>\n  <body onLoad=\"setTimeout('delayedRedirect()', 10000)\">\n\n    <!-- HEADER -->\n    <div class=\"container-fluid header\">\n      <div class=\"row-fluid\">\n        <div class=\"span6 padding logo\">\n          <a href=\"https://platform.33across.com/dashboard\">\n            <img src=\"/img/dashboard_logo.png\">\n          </a>\n        </div>\n      </div>\n    </div>\n\n    <!-- BODY -->\n    <div class=\"container-fluid\">\n      <div class=\"wrapper\">\n\n        <div class=\"headline\">\n          <h1>We've Moved!</h1>\n          <h2>Your favorite traffic and monetization platform has a new look and more insights!</h2>\n        </div>\n\n        <div class=\"redirect_msg\">\n          <i>You will be automatically re-directed in 10 seconds</i>\n        </div>\n\n        <p>Already have an account?</p>\n\n        <a href=\"https://platform.33across.com