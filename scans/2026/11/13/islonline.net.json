div class=\"box-inside margin-after-xs font-weight-semibold\"\">\n            <div class=\"row\">\n                <div class=\"col-md-5 col-sm-12\">Session Type:</div>\n                <div class=\"col-md-7 col-sm-12 font-xs-bold\"><%= ISL.JOIN.type[ISL.JOIN.sessionType] %></div>\n            </div>\n            <div class=\"row\">\n                <div class=\"col-md-5 col-sm-12\">Session Code:</div>\n                <div class=\"col-md-7 col-sm-12 font-xs-bold\"><%= ISL.JOIN.formatSessionCode(code) %></div>\n            </div>\n            \n            <% if(supporterName) { %>\n            <div class=\"row\">\n                <div class=\"col-md-5 col-sm-12\">Full Name:</div>\n                <div class=\"col-md-7 col-sm-12 font-xs-bold\"><%= supporterName %></div>\n            </div>\n            <% } if(supporterEmail) { %>\n            <div class=\"row\">\n                <div class=\"col-md-5 col-sm-12\">E-Mail:</div>\n                <div class=\"col-md-7 col-sm-12 font-xs-bold\"><%= supporterEmail %></div>\n            </div>\n            <% } if(supporterUsername) { %>\n            <div class=\"row\">\n                <div class=\"col-md-5 col-sm-12\">Username:</div>\n                <div class=\"col-md-7 col-sm-12 font-xs-bold\"><%= supporterUsername %></div>\n            </div>\n            <% } %>\n            \n        </div>\n    </script>\n\n    <script type=\"text/html\" id=\"alwaysonSessionInfoTemplate\">\n        <div class=\"box-inside margin-after-xs font-weight-semibold\"\">\n            <div class=\"row\">\n                <div class=\"col-md-4 col-sm-12\">Session Type:</div>\n                <div class=\"col-md-8 col-sm-12 font-xs-bold\"><%= ISL.JOIN.type[ISL.JOIN.sessionType] %></div>\n            </div>\n            <div class=\"row\">\n                <div class=\"col-md-4 col-sm-12\">Grant Code:</div>\n                <div class=\"col-md-8 col-sm-12 font-xs-bold\"><%= ISL.JOIN.formatSessionCode(code) %></div>\n            </div>\n      