ss=\"col-md-5 col-sm-12\">Status:</div>\n                <div class=\"col-md-7 col-sm-12 font-xs-bold\"><%= status %></div>\n            </div>\n            <div class=\"row\">\n                <div class=\"col-md-5 col-sm-12\">Starting On:</div>\n                <div class=\"col-md-7 col-sm-12 font-xs-bold\"><%= start_time %></div>\n            </div>\n            <div class=\"row\">\n                <div class=\"col-md-5 col-sm-12\">Your Role:</div>\n                \n                <div class=\"col-md-7 col-sm-12 font-xs-bold\"><%= owner == 1 ? translate('owner') : \"undefined\" !== typeof default_role ? translate(default_role) : \"/\" %></div>\n                \n            </div>\n            <% if(\"undefined\" !== typeof subscribe){ %>\n            <div class=\"row\">\n                <div class=\"col-md-5 col-sm-12\">Notifications:</div>\n                <div class=\"col-md-7 col-sm-12 font-xs-bold\">\n                    <div class=\"join-subscribtion\">\n                        <a href=\"javascript:void(0);\" onclick=\"ISL.JOIN.showSubscribeForm();return false;\" class=\"subscribe\">Subscribe</a>\n                        <a href=\"javascript:void(0);\" onclick=\"ISL.JOIN.unsubscribe(this);return false;\" class=\"unsubscribe hidden\">Unsubscribe</a>\n                        <div class=\"subscribe-email hidden\"><span class=\"bracket\">&nbsp;(</span><span class=\"address\"></span><span class=\"bracket\">)</span></div>\n                        <div class=\"subscribe-form hidden inputform\">\n                                                        <div class=\"icp-input d-flex\">\n                                <input type=\"text\" id=\"subscribe-email\" class=\"flex-grow-1\" placeholder=\"Email address\" />\n                                <span class=\"input-group-btn ms-1\">\n                                    <a href=\"javascript:void(0);\" onclick=\"ISL.JOIN.subscribe(this);return false;\" class=\"button\">OK</a>\n                               </span>\n                            </div>\n                            \n                        </div>\n                    </div>\n                </div>\n            </div>\n            <% } %>\n        </div>\n    </script>\n\n\n\t\t\t<noscript><div class=\"js-hint alert alert-warning margin-top\">Please enable JavaScript for the optimal experience.</div></noscript>\n\t\t\r\n\t\r\n\t\t<!-- Live chat -->\r\n\t\t\r\n\t\r\n\t<!-- Zoho live chat -->\r\n\t\r\n\t<!-- Admin settings overrides -->\r\n\t\r\n\t<!-- Cookie Law -->\r\n\t<div class=\"cookie-warning\" style=\"display:none;\">\r\n        <div class=\"cookie-warning-body\">\r\n            <h2 class=\"cookie-consent-title\">Cookie Consent</h2>\r\n            <p>\r\n                We use cookies to ensure the proper functioning of our website (essential cookies) and, with your consent, for other purposes (functional and other cookies) as outlined in our <a href=\"https://www.islonline.com/legal/cookies.htm?hl=en\">Cookie Policy</a> and <a href=\"https://www.islonline.com/legal/privacy-policy.htm?hl=en\">Privacy Policy</a>. You can update your cookie preferences at any time.\r\n            </p>\r\n            <div class=\"text-center\">\r\n                <ul class=\"list-actions list-unstyled list-inline\">\r\n                    <li><a href=\"javascript:void(0);\" class=\"btn btn-cta\" onclick=\"setCookiesConsent('.cookie-warning',true);\">Accept All</a></li>\r\n                    <li><a href=\"javascript:void(0);\" class=\"btn btn-primary\" onclick=\"setCookiesConsent('.cookie-warning',false);\">Essential Only</a></li>\r\n                    <li ><a href=\"https://www.islonline.com/legal/cookies.htm?hl=en#manage-settings\" class=\"btn btn-primary\" onclick=\"setCookiesConsent('.cookie-warning',false);\">Manage Cookies</a></li>\r\n                </ul>\r\n                <ul class=\"list-bottom-links list-unstyled list-inline\">\r\n                    <li>\r\n                        <a href=\"https://www.islonline.com/join/\" class=\"gray-text-link\">Join a Session</a>\r\n                    </li>\r\n                    <li>\r\n                        <a href=\"https://www.islonline.net/start/ISLLight?branch=any&amp;stable_since=2014-01-01\" class=\"gray-text-link\" rel=\"nofollow\">Download ISL Light</a>\r\n                    </li>\r\n                </ul>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\n\t\t\n        <footer class=\"clear\">\n            <div class=\"footer wrapper \">\n\t\t\t\t<p class=\"copyright\">\n\t\t\t\t\t<span class=\"footer-left\">&copy; 2003-2026 <a target=\"_blank\" href=\"https://www.islonline.com\">ISL Online</a></span>\n\t\t\t\t\t<span class=\"footer-right\">\n\t\t\t\t\t\t\n\t\t\t\t\t\t<a target=\"_blank\" href=\"https://www.islonline.com/help/?hl=en\">Manuals</a>\n\t\t\t\t\t\t&#x7c;\n\t\t\t\t\t\t<a href=\"/users/main/change_language.html\">English</a>\n\t\t\t\t\t\t&#x7c; Version: <a id=\"change-version-href\" href=\"/users/main/change_version.html\">Change</a>\n\t\t\t\t\t\t<script type=\"text/javascript\">if(typeof(ISLWebVersionCurrent) != 'undefined' && ISLWebVersionCurrent.title !== '') $('#change-version-href').html(ISLWebVersionCurrent.title);</script>\n\t\t\t\t\t</span>\n\t\t\t\t</p>\n            </div>\n        </footer>\n\t\t</div>\n\t\t</div>\n\t\t</div>\n\t\t\n\t\t\r\n\t\t<script>\r\n\t\t\t\r\n\t\t\t\tvar loggedIn = false;\r\n\t\t\t\r\n\t\r\n\t\t\tvar detectedGeoipCountry = 'US';\r\n\t\t\tvar langVariant = '';\r\n\t\t\tvar langCode = 'en';\r\n\t\t\tvar mytoken = '';\r\n\t\t\tvar secureRedir = '2_YqfY7uKvl.tyKWwHwNvzQBEan12.Y7wTLrmUCNo1zWRR0zGGL6f9anmU41PGrIe_aLvf66h63DPgAKpdjHRvpxyYJSWZcmb88CAEoxhgbMOLmrXR3eKywMuA9moEAgGTAQI-';\r\n\t\t\tfunction setVersion(setNew) {\r\n\t\t\t\tif(setNew) {\r\n\t\t\t\t\tsetComVersionCookie('flag_enable').done(function() {\r\n\t\t\t\t\t\tlocation.reload();\r\n\t\t\t\t\t});\r\n\t\t\t\t} else {\r\n\t\t\t\t\tdocument.location.href = 'https://www.islonline.com/set-cookies.htm?flag_disable=www_5288&flag_expiry=60&redir=' + encodeURIComponent(document.location.href.replace('account','islv61'));\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tfunction setComVersionCookie(queryParamKey) {\r\n\t\t\t\tvar URL = 'https://www.islonline.com/set-cookies.htm';\r\n\t\t\t\treturn ajax = $.ajax({\r\n\t\t\t\t\turl:URL + '?' + queryParamKey + '=www_5288', \r\n\t\t\t\t\tmethod : \"GET\",\r\n\t\t\t\t\txhrFields: {\r\n\t\t\t\t\t\twithCredentials: true\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t\t}\r\n\t\t</script>\r\n\t\t\r\n\t\t<!-- Back to reports redirect change -->\t\r\n\t\t<script>\r\n\t\t  document.addEventListener('DOMContentLoaded', function() {\t\t\t\t\r\n\t\t\t\tif (!document.URL.split('/').filter(Boolean).pop().startsWith('meetings.html')) return;\r\n\t\t\t\tconst container = document.querySelector('.content');\r\n\t\t\t\tconst backLink = container.children[0];\r\n\t\t\t\tif (backLink && backLink.getAttribute('href') === '/users/reports') {\r\n\t\t\t\t  backLink.setAttribute('href','/users/main/session_redirect?redirect=https://www.islonline.com/account/hosted-service/reports.htm');\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t</script>\r\n\t\t<!-- Back to reports redirect change -->\t\r\n\t\t\r\n\t\t<script type=\"text/javascript\" src=\"/webspace/account/notifications.js\"></script>\r\n\t\t<script type=\"text/javascript\" src=\"/webspace/account/scripts.js\"></script>\r\n\t\t<!-- detected country code: US -->\r\n\t\n\t\t\n\t\t\n\t\t\n\t</body>\n</html>\n",
