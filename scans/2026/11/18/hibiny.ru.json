document.body.innerHTML = \"<div style=\\\"font-family:Arial,sans-serif;font-size:16px;padding:20px;text-align:center;\\\">Проверка браузера остановлена.<br><br>Обновите страницу через несколько минут.</div>\";\r\n        return;\r\n    }\r\n\r\n    state.n++;\r\n    state.t = now;\r\n    setState(state);\r\n\r\n    fetch(\"/data/botguard_verify.php\", {\r\n        method: \"POST\",\r\n        credentials: \"same-origin\",\r\n        headers: {\r\n            \"Content-Type\": \"application/x-www-form-urlencoded;charset=UTF-8\",\r\n            \"X-Requested-With\": \"XMLHttpRequest\"\r\n        },\r\n        body: \"token=\" + encodeURIComponent(token)\r\n    }).then(function(response){\r\n    if (response.ok) {\r\n      setTimeout(function(){\r\n          location.replace(returnUrl);\r\n      }, 700);\r\n      return;\r\n    }\r\n        document.body.innerHTML = \"<div style=\\\"font-family:Arial,sans-serif;font-size:16px;padding:20px;\\\">Проверка не пройдена. Обновите страницу.</div>\";\r\n    }).catch(function(){\r\n        document.body.innerHTML = \"<div style=\\\"font-family:Arial,sans-serif;font-size:16px;padding:20px;\\\">Ошибка проверки. Обновите страницу.</div>\";\r\n    });\r\n})();\r\n</script>\r\n\r\n<noscript>\r\n<div style=\"font-family:Arial,sans-serif;font-size:16px;padding:20px;\">\r\nДля просмотра страницы включите JavaScript.\r\n</div>\r\n</noscript>\r\n</body>\r\n</html>",
