    "homepage": {
      "status": 200,
      "body": "<!DOCTYPE html>\r\n<html class=\"lectiosite\" lang=\"da\" xml:lang=\"da\" dir=\"ltr\" xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head>\r\n\t<META HTTP-EQUIV=\"CACHE-CONTROL\" CONTENT=\"NO-CACHE\">\r\n\t<META HTTP-EQUIV=\"PRAGMA\" CONTENT=\"NO-CACHE\">\r\n\t\r\n\t<meta name=\"description\" content=\"Lectio - Studieadministration og kommunikation: Skema, Lærerløn, Timeregnskab, Bogdepot, Fravær, Karakterer, Spørgeskemaer, Konsultationer, Dokumenter, Beskeder, Grupper, Studieplan, Indberetninger, Planlægning, Skemavisning, Beviser, Valgfagstilmelding, Holdpakning, Time-fagfordeling, Skemalægning\" />\r\n\t<meta name=\"keywords\" content=\"Undervisning, Uddannelse, Kommunikation, Administration, Skole, Gymnasie, Gymnasium, Erhvervsgymnasie, Erhvervsgymnasium, Erhvervsskole, Skema, Lærerløn, Timeregnskab, Bogdepot, Fravær, Karakterer, Spørgeskemaer, Konsultationer, Dokumenter, Beskeder, Grupper, Studieplan, Indberetninger, Planlægning, Skemavisning, Beviser, Valgfagstilmelding, Holdpakning, Time-fagfordeling, Skemalægning\" />\r\n\t<meta http-equiv=\"content-type\" content=\"text/html;charset=utf-8\" />\r\n\t<meta http-equiv=\"Content-Style-Type\" content=\"text/css\" />\r\n\t<link rel=\"stylesheet\" href=\"lectio/content/lectio-css.bundle.css\" type=\"text/css\" media=\"all\" />\r\n\t\r\n\t\r\n\t<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\r\n\t\r\n\t<title>MaCom Lectio</title>\r\n\t<link rel=\"shortcut icon\" href=\"/favicon64.ico\" />\r\n    <link rel=\"apple-touch-icon\" sizes=\"144x144\" href=\"/apple-touch-icon-144x144-precomposed.png\" />\r\n\t<link rel=\"apple-touch-icon\" sizes=\"114x114\" href=\"/apple-touch-icon-114x114-precomposed.png\" />\r\n    <link rel=\"apple-touch-icon\" sizes=\"72x72\" href=\"/apple-touch-icon-72x72-precomposed.png\" />\r\n    <link rel=\"apple-touch-icon\" href=\"/apple-touch-icon-precomposed.png\" />\r\n\t<link rel=\"icon\" sizes=\"57x57\" type=\"image/png\" href=\"/favicon57.png\" />\r\n\t<link rel=\"icon\" sizes=\"114x114\" type=\"image/png\" href=\"/favicon114.png\" />\r\n\t<style>\r\n\t\t\r\n\r\n\t</style>\r\n</head>\r\n<body>\r\n<script language=javascript>\r\nfunction getCookie(c_name)\r\n{\r\nvar i,x,y,ARRcookies=document.cookie.split(\";\");\r\nfor (i=0;i<ARRcookies.length;i++)\r\n{\r\n  x=ARRcookies[i].substr(0,ARRcookies[i].indexOf(\"=\"));\r\n  y=ARRcookies[i].substr(ARRcookies[i].indexOf(\"=\")+1);\r\n  x=x.replace(/^\\s+|\\s+$/g,\"\");\r\n  if (x==c_name)\r\n    {\r\n    return unescape(y);\r\n    }\r\n  }\r\n}\r\n\r\nif (getCookie(\"lecmobile\")==\"1\") {\r\n\twindow.location='/lectio/login_list.aspx';\r\n}\r\n\r\ndocument.addEventListener('readystatechange', function() {\r\n\tif (document.readyState == 'interactive') {\r\n\t\tvar iframe = document.getElementsByTagName('iframe')[0];\r\n\t\tiframe.focus();\r\n\t}\r\n})\r\n\r\n</script>\r\n\r\n<div class=\"site-container\">\r\n\t<div class=\"site-header-container\" >\r\n\t\t<div><img src=\"lectio/img/lectio_logo.png\" alt=\"lectio\" /></div>\r\n\t\t<div>\r\n\t\t\t<div style=\"text-align:left;padding:2em 0.5em 1em 3.5em; max-width:28em\">\r\n\t\t\t\t<span style=\"text-align:left;font-size: 1.7em;line-height:1.3em\">Studieadministration, kommunikation og digitale læremidler</span><br/>\r\n\t\t\t\t<span style=\"text-align:left;font-size: 1.1em;line-height:1.1em;\">\r\n\t\t\t\t\tLectio er webbaseret, så eneste forudsætning er adgang til internettet.&nbsp;&nbsp;\r\n\t\t\t\t\t<a href=\"pdf/omlectio.pdf\">&#11208; Læs mere her</a>\r\n\t\t\t\t</span>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n\t<div>\r\n\t\t<div class=\"ls-std-rowblock\">\r\n\t\t\t<div></div>\r\n\t\t\t<div>\r\n\t\t\t\t<div title=\"skift til mobilvisning\" class=\"buttonoutlined mobilvis\"><a href=\"/lectio/login_list.aspx?forcemobile=1\">Mobilvisning</a></div>\t\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t\t<div class=\"site-content-container\">\r\n\t\t\t<table class=\"lectioSimpleBox ls-table-layout2\" >\r\n              <tr class=\"lectioBorderBot\">\r\n                <th>Om Lectio</th>\r\n                <th>Kontakt</th>\r\n                <th>V&aelig;lg skole</th>\r\n              </tr>\r\n              <tr>\r\n                <td style=\"text-align:center;vertical-align:top;;padding:1em;min-height:300px;max-height:340px\">\r\n\t\t\t\t\t <div style=\"width:12rem\" class=\"buttonlinklist\"><a href=\"introduktion.htm\">Introduktion</a></div>\r\n\t\t\t\t\t <div style=\"width:12rem\" class=\"buttonlinklist\"><a href=\"erfaringer.htm\" >Erfaringer med Lectio</a></div>\r\n\t\t\t\t\t <div style=\"width:12rem\" class=\"buttonlinklist\"><a href=\"dokumenter.htm\" >Vejledninger</a></div>\r\n\t\t\t\t\t <div style=\"width:12rem\" class=\"buttonlinklist\"><a href=\"produktinformation.htm\" >Produktinformation</a></div>\r\n\t\t\t\t\t <div style=\"width:12rem\" class=\"buttonlinklist\"><a href=\"presse.htm\" >Presseomtale</a></div>\r\n\t\t\t\t\t <div style=\"width:12rem\" class=\"buttonlinklist\"><a href=\"oracle_om_lectio.htm\" >Oracle om Lectio</a></div>\r\n\t\t\t\t\t <div style=\"width:12rem\" class=\"buttonlinklist\"><a href=\"ommacom.htm\" >Om MaCom A/S</a></div>\r\n                </td>\r\n                <td  style=\"vertical-align:top;padding:1em;text-align:left\">\r\n\t\t\t\t\t<div style=\"width:12rem\" class=\"buttonlinklist\"><a href=\"lectio/kontakt_formular.aspx?type=fejlmelding\" >Fejlmelding</a></div>\r\n\t\t\t\t\t<div style=\"width:12rem\" class=\"buttonlinklist\"><a href=\"lectio/kontakt_formular.aspx?type=sporgsmaal\"  >Spørgsmål</a></div>\r\n\t\t\t\t\t<div style=\"width:12rem\" class=\"buttonlinklist\"><a href=\"lectio/kontakt_formular.aspx?type=tilmelding\"  >Tilmeld skole</a></div>\r\n\t\t\t\t\t<div style=\"width:12rem\" class=\"buttonlinklist\"><a href=\"/lectio/Cookies.aspx\">Om cookies</a></div>\r\n                </td>\r\n                <td rowspan=\"2\" style=\"vertical-align:top;padding:1em;padding-right:0em\">\r\n                  <iframe src=\"lectio/login_list.aspx\"   style=\