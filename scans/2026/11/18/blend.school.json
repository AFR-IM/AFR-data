      "body": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n  <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n  <meta name=\"robots\" content=\"noindex\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=yes\">\n\n  <title>BLEND | 校務支援システム</title>\n  <meta name=\"description\" content=\"先生の校務をもっと簡単に、スマートに\">  <meta name=\"description\" content=\"BLEND, ブレンド, 校務支援システム, モチベーションワークス株式会社\">\n\t\t\t<link href=\"/assets/css/base.css?ver=20241002\" rel=\"stylesheet\">\n\t\t<link href=\"/assets/css/app.css?ver=20251224\" rel=\"stylesheet\">\n\t\t<link href=\"/assets/css/mobile.css?ver=20250701\" rel=\"stylesheet\">\n\t\t<link href=\"/assets/css/color.css?time=20261118122912\" rel=\"stylesheet\">\n\n\t\t<script src=\"/assets/js/ie10-viewport-bug-workaround.js\"></script>\n\t\t<!--[if lt IE 9]>\n\t\t<script src=\"/assets/js/html5shiv.min.js\"></script>\n\t\t<script src=\"/assets/js/respond.min.js\"></script>\n\t\t<![endif]-->\n\n\t\n<!-- Global site tag (gtag.js) - Google Analytics -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=UA-42259849-5\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n\n  gtag('config', 'UA-42259849-5');\n</script>\n\n<style type=\"text/css\">\n\t\t\t.ui-accordion-header .fa {\n\t\t\tvertical-align: middle;\n\t\t}\n\t\t.unread_blend_info {\n\t\t\tdisplay: none;\n\t\t}\n\t\t@media (max-width: 767px) {\n\t\t\t.unread_blend_mobile {\n\t\t\t\tdisplay: none;\n\t\t\t}\n\t\t}\n</style>\n<script src=\"/assets/js/jquery-2.2.3.min.js\"></script>\n<script>\n\t$(function(){\n\t\t$(\"#school_id_change\").keydown(function(e){\n\t\t\tif(e.which === 13) {\n\t\t\t\tlet value = $(this).val();\n\t\t\t\tif(value.match(/[^0-9]+/) || value.length < 1) {\n\t\t\t\t\talert('数値のみを入力してください');\n\t\t\t\t\treturn false;\n\t\t\t\t}\n\t\t\t\tchangeSchool(this);\n\t\t\t}\n\t\t})\n\t})\n</script>\n</head>\n\n<body id=\"admin\" class=\"login\">\n\n\n<div class=\"page clearfix\">\n<style type=\"text/css\">\n\t:root {\n\t\tbackground-color: rgb(6, 16, 26);\n\t}\n\tsection{\n\t\tbackground-color: rgb(6, 16, 26);\n\t\tpadding : 5% 8%;\n\t\tpadding-bottom: 60px;\n\t}\n\n\tsection.login2 form{\n\t\twidth: 350px;\n\t\tmargin: 0 auto;\t\t\n\t}\n\t\n\tsection.login2 form input {\n\t\tborder-bottom: 1px solid #fff;\n\t\theight: 50px;\n\t\tmargin-bottom: 1rem;\n\t\tcolor: #fff;\n\t\tfont-size: 18px;\n\t\tletter-spacing: 0.022em;\n\t\twidth: 100%;\n\t}\n\n\tsection.login2 form input[type=\"submit\"], section.login form button {\n\t\tborder: 1px solid #fff;\n\t\t-webkit-border-radius: 3px;\n\t\t-moz-border-radius: 3px;\n\t\tborder-radius: 3px;\n\t\theight: 55px;\n\t\tfont-size: 16px;\n\t\tletter-spacing: 0.05em;\n\t\tmargin-top: 1.5rem;\n\t\tfont-weight: 500;\n\t\tbackground: #fff;\n\t\tcolor: rgb(41, 120, 189);\n\t}\n\tsection.login2 form p {\n\t\ttext-align: center;\n\t\tmargin: 2rem 0 0;\n\t}\n\n\n\t@media (max-width: 834px){\n\t\t#mainte{\n\t\t\twidth: 100%;\n\t\t}\n\t\tsection.login2 form {\n\t\t\twidth: 100%;\n\t\t}\n\t}\n\n</style>\n\n\n<section class=\"login2\">\n\n\t<div style=\"width: 100%;\">\n\t\t<div style=\"padding-top: 40px; margin: 0 auto 0; width:350px;\">\n\t\t\t<img src=\"/assets/img/blend_w_350.png\" alt=\"BLEND\" style=\"width:200px;margin-bottom:2rem;\">\n\t\t</div>\n\t\t\t</div>\n\n\t<form method=\"post\" style=\"top:80%;\">\n\n\t\t<input type=\"text\" name=\"login_id\" placeholder=\"メールアドレス\" id='login_id' value=\"\" autocomplete=\"email\">\n\t\t<input type=\"password\" name=\"password\" placeholder=\"パスワード\" id='login_password' autocomplete=\"current-password\">\n\t\t<p class=\"error\" style=\"display:none;margin-top:0;\"></p>\n\t\t<div class=\"stylishLabel\"><label><input type=\"checkbox\" name=\"remember\" id=\"remember\" value=\"1\" ><span style=\"color:#999;\">次回からメールアドレスの入力を省略</span></label></div>\n\t\t<p class=\"error\" style=\"margin-top:0;\"></p><!--\t<button type=\"button\" id='login_form_submit'><i class=\"fa fa-sign-in\" aria-hidden=\"true\"></i>ログイン</button>-->\n\t\t<input type=\"submit\" value=\"ログイン\" id=\"login_form_submit2\" style=\"cursor:pointer;\">\n\t\t<p>\n\t\t\t<a href=\"/forgot_password\" style=\"color:#999;\">パスワードをお忘れですか？</a>\n\t\t</p>\n\n\t\t\n\t\t<div style=\"width:100%;margin-top:2rem;\">\n\t\t\t<div style=\"float:left; width:50%;text-align: center;\">\n\t\t\t\t<p style=\"margin-top:0;\"><a href=\"/login/google_login\" style=\"color:#999;\">生徒Googleログイン</a></p>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t<div style=\"float:left; width:50%;text-align: center;\">\n\t\t\t\t<p style=\"margin-top:0;\"><a href=\"/parent\" style=\"color:#999;\">保護者の方の初回登録</a></p>\n\t\t\t</div>\n\t\t\t<div style=\"clear:both;\"></div>\n\n\t\t</div>\n\n\t\t<p>\n\t\t\t<a href=\"/privacy\" style=\"color:#999;\">プライバシーポリシー</a>\n\t\t</p>\n\t</form>\n</section>\n</div>\n<!-- /.page -->\n\n\t<!-- JS -->\n\t<script src=\"/assets/js/jquery-ui.min.js\"></script>\n\t<script src=\"/assets/js/fastclick.js\"></script>\n\t<script src=\"/assets/js/bignumber.min.js\"></script>\n\t<script src=\"/assets/js/jquery.stickybits.min.js\"></script>\n\t<script src=\"/assets/js/form-datetime-util.js?time=20261118122912\"></script>\n\t\t<script src=\"/assets/js/datepicker-sunday-start.js\"></script>\n\t\t<script src=\"/assets/js/admin.js?time=20261118122912\"></script>\n\n<script type=\"text/javascript\">\nfunction changeSchool(select_school_element) {\n\tlet select_value = $(select_school_element).val();\n\tlet school_id = select_value;\n\t\tlet menu_numbers_json = JSON.parse('[]');\n\tlet active_num = $('#left_accordion').accordion('option', 'active');\n\tlet active_func = menu_numbers_json[active_num];\n\n\tlet uri = document.location.pathname;\n\tlet get_param = document.location.search;\n\n\tlet form_elm = $('<form></form>').attr('id', 'change_school_param').attr('method', 'post').attr('action', '/admin/change_school_param');\n\tlet input1 = $('<input>').attr('type', 'hidden').attr('name', 'school_id').attr('value', school_id);\n\tform_elm.append(input1);\n\tlet input2 = $('<input>').attr('type', 'hidden').attr('name', 'uri').attr('value', uri);\n\tform_elm.append(input2);\n\tlet input3 = $('<input>').attr('type', 'hidden').attr('name', 'get_param').attr('value', get_param);\n\tform_elm.append(input3);\n\tlet input4 = $('<input>').attr('type', 'hidden').attr('name', 'active_func').attr('value', active_func);\n\tform_elm.append(input4);\n\n\t$('body').append(form_elm);\n\n\t$('#change_school_param').submit();\n}\n\nfunction changeYear(year_value) {\n\t\tlet menu_numbers_json = JSON.parse('[]');\n\tlet active_num = $('#left_accordion').accordion('option', 'active');\n\tlet active_func = menu_numbers_json[active_num];\n\n\tlet uri = document.location.pathname;\n\tlet get_param = document.location.search;\n\n\tlet form_elm = $('<form></form>').attr('id', 'change_year').attr('method', 'post').attr('action', '/admin/change_year_param');\n\tlet input1 = $('<input>').attr('type', 'hidden').attr('name', 'year').attr('value', year_value);\n\tform_elm.append(input1);\n\tlet input2 = $('<input>').attr('type', 'hidden').attr('name', 'uri').attr('value', uri);\n\tform_elm.append(input2);\n\tlet input3 = $('<input>').attr('type', 'hidden').attr('name', 'get_param').attr('value', get_param);\n\tform_elm.append(input3);\n\tlet input4 = $('<input>').attr('type', 'hidden').attr('name', 'active_func').attr('value', active_func);\n\tform_elm.append(input4);\n\n\t$('body').append(form_elm);\n\n\t$('#change_year').submit();\n}\n\n$(function() {\n\t$('.unread_blend_info').fadeIn(400);\n\n\n});\n</script>\n\n<script>\n\n//削除\n$(document).on('click', 'li.notification.opened .notice-list.open .close', function(event) {\n\tevent.preventDefault();\n\tvar id = $(this).parent().find('a').attr('id');\n\tid = id.substring(6);\n\t$.ajax({\n\t\turl: '/admin/delete_notice',\n\t\ttype: 'POST',\n\t\tdataType: 'json',\n\t\tdata: {\n\t\t\t'delete': true,\n\t\t\t'id': id,\n\t\t}\n\t});\n\tvar ulclass = $(this).parent().attr('class');\n\tif(ulclass=='unread'){\n\t\tvar tmpcount = $('.notification .count').html();\n\t\ttmpcount = parseInt(tmpcount) - 1;\n\t\t$('.notification .count').html(tmpcount);\n\t}\n\t$(this).parent().hide('slow');\n});\n\n//「消去」まとめて削除\n$(document).on('click', 'li.notification.opened .notice-list.open .delete_multi', function(event) {\n\tevent.preventDefault();\n\tvar showing_notice_ids = $('li.notification .notice-list').find('a');\n\tvar delete_notice_ids = [];\n\tfor (var i = 0; i < showing_notice_ids.length; i++) {\n\t\tvar element = showing_notice_ids[i];\n\n\t\tif ($(element).attr('id') !== undefined) {\n\t\t\tvar notice_id = $(element).attr('id').substring('notice'.length);\n\t\t\tif (!delete_notice_ids.includes(notice_id)) {\n\t\t\t\tdelete_notice_ids.push(notice_id);\n\t\t\t}\n\t\t}\n\t}\n\tif (delete_notice_ids.length < 1) {\n\t\treturn;\n\t}\n\n\t$.ajax({\n\t\turl: '/admin/delete_multi_notice',\n\t\ttype: 'POST',\n\t\tdataType: 'json',\n\t\tdata: {\n\t\t\t'delete': true,\n\t\t\t'notice_ids': delete_notice_ids,\n\t\t}\n\t})\n\t.done(function(result) {\n\t\t$('li.notification .notice-list').html('');\n\n\t\t$('li.notification .toggle').data('page', 0);\n\t\t$('li.notification .toggle').click();\n\t});\n\n});\n\n//リンクを押した\n$(document).on('click', 'li.notification .notice-list.open a.notice', function(event) {\n\tvar id = $(this).attr('id');\n\tid = id.substring('notice'.length);\n\n\t$.ajax({\n\t\turl: '/admin/read_notice',\n\t\ttype: 'POST',\n\t\tdataType: 'json',\n\t\tdata: {\n\t\t\t'read': true,\n\t\t\t'id': id,\n\t\t},\n\t}).fail(function (jqXHR, textStatus, errorThrown){\n\t\t// console.log(jqXHR, textStatus, errorThrown);\n\t});\n});\n\n//通知ベル押した→一覧取得\n$(document).on('click', 'li.notification .toggle', function(event) {\n\tevent.preventDefault();\n\tvar page = $(this).data('page');\n\t$('li.notification .notice-list').html('');\n\n\t$.ajax({\n\t\turl: '/admin/load_notice',\n\t\ttype: 'POST',\n\t\tdataType: 'json',\n\t\tdata: {\n\t\t\t'page': page,\n\t\t}\n\t})\n\t.done(function (result) {\n\t\t// console.log(result);\n\t\tpage++;\n\t\tvar append_html = '';\n\t\tif (result.count_all == 0) {\n\t\t\tappend_html = '<li>通知はありません</li>';\n\t\t\t$('li.notification .notice-list').html($(append_html));\n\t\t} else {\n\t\t\t$('li.last').remove();\n\t\t\tappend_html += '<div class=\"notice_cnt\">';\n\t\t\tappend_html += load_notice(result.more_notice);\n\t\t\t$('li.notification .notice-list').html($(append_html));\n\n\t\t\tappend_html = '</div><li class=\"last\">';\n\t\t\tif (page * 10 < result.count_all) {\n\t\t\t\tappend_html += '<div class=\"more_div\"><a href=\"javascript:void(0);\" class=\"more\" data-page=\"'+page+'\">もっと読む</a></div>';\n\t\t\t}\n\n\t\t\tappend_html += '<div class=\"delete_multi_div\"><a href=\"javascript:void(0);\" class=\"delete_multi\">一括消去</a></div>';\n\t\t\tappend_html += '</li>';\n\t\t\t$('li.notification .notice-list').append($(append_html));\n\t\t}\n\n\t\tif ($('li.notification .notice-list').hasClass('open')) {\n\n\t\t} else {\n\t\t\t$('li.notification .notice-list').toggleClass('open');\n\t\t\t$('li.notification').toggleClass('opened');\n\t\t}\n\n\t\tif (result.count_unread < 1) {\n\t\t\t$('li.notification .count').hide();\n\t\t} else {\n\t\t\t$('li.notification .count').text(result.count_unread);\n\t\t\t$('li.notification .count').show();\n\t\t}\n\t}).fail(function (jqXHR, textStatus, errorThrown) {\n\t// console.log(jqXHR, textStatus, errorThrown);\n\t});\n});\n\n//もっと読む\n$(document).on('click', 'li.notification .notice-list.open a.more', function(event) {\n\tevent.preventDefault();\n\tvar page = $(this).data('page');\n\t$.ajax({\n\turl: '/admin/load_notice',\n\ttype: 'POST',\n\tdataType: 'json',\n\tdata: {\n\t\t'page': page,\n\t}\n\t})\n\t.done(function (result) {\n\t\t// console.log(result);\n\t\tvar notice_list = result.more_notice;\n\t\tpage++;\n\n\t\tvar append_html = '';\n\t\t$('li.last').remove();\n\t\tappend_html = load_notice(result.more_notice);\n\t\t$('.notice_cnt').append($(append_html));\n\n\t\tif (result.count_all > 1) {\n\t\t\tvar html = '<li class=\"last\">';\n\n\t\t\tif (page * 10 < result.count_all) {\n\t\t\t\thtml += '<div class=\"more_div\"><a href=\"javascript:void(0);\" class=\"more\" data-page=\"'+page+'\">もっと読む</a></div>';\n\t\t\t}\n\t\t\thtml += '<div class=\"delete_multi_div\"><a href=\"javascript:void(0);\" class=\"delete_multi\">一括消去</a></div>';\n\t\t\thtml += '</li>';\n\t\t\t$('li.notification .notice-list').append($(html));\n\t\t}\n\n\t\tif (result.count_unread < 1) {\n\t\t\t$('li.notification .count').hide();\n\t\t} else {\n\t\t\t$('li.notification .count').text(result.count_unread);\n\t\t\t$('li.notification .count').show();\n\t\t}\n\t}).fail(function (jqXHR, textStatus, errorThrown) {\n\t\t// console.log(jqXHR, textStatus, errorThrown);\n\t});\n});\n\nfunction load_notice(notice_list) {\n\tvar html = '';\n\n\tfor( var i=0; i<notice_list.length; i++) {\n\t\tvar item = notice_list[i];\n\t\tif (typeof item == 'object') {\n\t\t\thtml += '<li class=\"';\n\t\t\thtml += item.view_flg == \"0\" ? 'unread' : 'read';\n\t\t\thtml += '\">';\n\t\t\thtml += '<a href=\"' + item.link + '\" class=\"notice\" id=\"notice' + item.id + '\">';\n\t\t\thtml += item.message + '</a>';\n\t\t\thtml += '<span class=\"dt\">' + item.created_at + '</span>';\n\t\t\thtml += '<span class=\"close\"><a href=\"javascript:void(0);\"><i class=\"fa fa-times-circle fa-lg\"></i></a></span></li>';\n\t\t}\n\t}\n\n\treturn html;\n}\n\n$(document).on('click', 'body', function (event) {\n\t// event.preventDefault();\n\tvar targetElement = $(event.target);\n\tvar is_notification_element = targetElement.parents('.notification').length > 0 ? true : false;\n\tif (is_notification_element) {\n\t\treturn;\n\t}\n\tif ($('li.notification .notice-list').hasClass('open')) {\n\t\t$('li.notification .notice-list').toggleClass('open');\n\t\t$('li.notification').toggleClass('opened');\n\t}\n});\n</script>\n</body>\n</html>\n",
      "url": "https://blend.school/login"
    },
