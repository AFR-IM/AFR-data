      "status": 200,
      "body": "\n<head>\n    <meta charset=\"UTF-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>KanTime-Login</title>\n\n    <link rel=\"icon\" type=\"image/x-icon\" href=\"/identity/v2/accounts/favicon.ico\" />\n    <link rel=\"stylesheet\" href=\"/identity/v2/accounts/lib/bootstrap/dist/css/bootstrap.min.css\" />\n    <link rel=\"stylesheet\" href=\"/identity/v2/accounts/lib/fontawesome/css/all.min.css\" />\n    <link rel=\"stylesheet\" href=\"/identity/v2/accounts/lib/Fonts/stylesheet.css\" />\n    <link rel=\"stylesheet\" href=\"/identity/v2/accounts/css/site.css?version=811267\" />\n    <script src=\"/identity/v2/accounts/js/site.js?version=811267\"></script>\n    <script src=\"/identity/v2/accounts/lib/jquery/dist/jquery.js\"></script>\n    <script src=\"https://accounts.google.com/gsi/client\" async defer></script>\n\n    <script type=\"text/javascript\">\n        var InstanceCode = \"Production\";\n        var ErrorMessage = \"\";\n        var isCaptchaValidated = false;\n        var enable_captcha = (\"False\" === \"False\") ? false : true;\n\n        document.addEventListener(\"DOMContentLoaded\", function (event) {\n\n            //localStorage.clear();\n            sessionStorage.clear();\n\n            var username = document.getElementById(\"txt_username\").value\n\n            if (username.trim() == '') {\n                document.getElementById('txt_username').focus();\n            }\n            else {\n                document.getElementById('txt_password').focus();\n            }\n\n            document.getElementById('lbl_errormessage').style.display = \"none\";\n            document.getElementById('lbl_errorusername').style.display = \"none\";\n\n            if (ErrorMessage != \"\") {\n                document.getElementById('lbl_errormessage').innerHTML = '<i class=\"fa fa-info-circle crederror\" aria-hidden=\"true\"></i>&nbsp;' + ErrorMessage;\n                document.getElementById('lbl_errormessage').style.display = \"inline-block\";\n            }\n\n            if ('false' == 'true')\n                document.getElementById(\"txt_username\").readOnly = true;\n            else\n                document.getElementById(\"txt_username\").readOnly = false;\n\n            if (enable_captcha) {\n                document.getElementById(\"txt_username\").addEventListener(\"keydown\", function (e) {\n                    if ((e.code === \"Enter\" || e.keyCode == 13) && !document.getElementById(\"btn_login\").disabled) {\n                        OnLoginClick();\n                    }\n                });\n\n                document.getElementById(\"txt_password\").addEventListener(\"keydown\", function (e) {\n                    if ((e.code === \"Enter\" || e.keyCode == 13) && !document.getElementById(\"btn_login\").disabled) {\n                        OnLoginClick();\n                    }\n                });\n\n                document.getElementById(\"btn_login\").addEventListener(\"click\", function (e) {\n                    if (!document.getElementById(\"btn_login\").disabled)\n                        OnLoginClick();\n                });\n            }\n            else {\n                document.getElementById(\"txt_username\").addEventListener(\"keydown\", function (e) {\n                    if (e.code === \"Enter\" || e.keyCode == 13) {\n                        OnLoginClick();\n                    }\n                });\n\n                document.getElementById(\"txt_password\").addEventListener(\"keydown\", function (e) {\n                    if (e.code === \"Enter\" || e.keyCode == 13) {\n                        OnLoginClick();\n                    }\n                });\n\n                document.getElementById(\"btn_login\").addEventListener(\"click\", function (e) {\n                    OnLoginClick();\n                });\n            }\n\n        });\n\n        async function OnLoginClick() {\n            if (enable_captcha) {\n                disableButtons();\n            }\n            ResetErrors();\n\n            var username = document.getElementById(\"txt_username\").value\n\n            if (username.trim() == '') {\n                document.getElementById('lbl_errorusername').style.display = \"inline-block\";\n                document.getElementById('lbl_errorusername').innerHTML = '<i class=\"fa fa-info-circle crederror\" aria-hidden=\"true\"></i>&nbsp; Enter User Name';\n                if (enable_captcha) {\n                    enableButtons();\n                }\n                return;\n            };\n\n\n            document.getElementById('LoginContext').value = 'PWD';\n\n            if (enable_captcha) {\n                var ret = await captchaValidation();\n            }\n\n            AuthorizeForm.submit();\n        }\n\n        function onForgotPasswordClick() {\n\n            var loginId = document.getElementById(\"txt_username\").value.trim();\n            var redirectUrl = \"https://www.kantimehealth.net/phx/idagency_portal/forgot-password\";\n\n            //var loginHint = \"\";\n\n            // ⭐ If login_hint is null/blank → use login_id\n            // if (!loginHint || loginHint.trim() === \"\") {\n            //     loginHint = loginId;\n            // }\n\n\n            // Collect parameters\n            var params = {\n                login_id: loginId,\n                login_hint: \"\",\n                state: \"\",\n                nonce: \"\",\n                response_type: \"\",\n                redirect_uri: \"\",\n                scope: \"\"\n            };\n\n            var clientId = \"kantimeclient\";\n\n            // ⭐ Include client_id ONLY if not equal to 'kantimeclient'\n            if (clientId && clientId.trim().toLowerCase() !== \"kantimeclient\") {\n                params.client_id = clientId;\n            }\n\n            // Build final query string (only non-null values)\n            var queryParts = [];\n\n            for (var key in params) {\n                if (params[key] && params[key].trim() !== \"\") {\n                    queryParts.push(key + \"=\" + encodeURIComponent(params[key]));\n                }\n            }\n\n            // Join parameters\n            var finalUrl = redirectUrl + \"?\" + queryParts.join(\"&\");\n\n            // Redirect\n            window.location.href = finalUrl;\n        }\n\n\n        async function onSSOProviderClick(providerId) {\n            if (enable_captcha) {\n                disableButtons();\n            }\n            ResetErrors();\n\n            var username = document.getElementById(\"txt_username\").value\n\n            if (username.trim() == '') {\n                document.getElementById('lbl_errorusername').innerHTML = '<i class=\"fa fa-info-circle crederror\" aria-hidden=\"true\"></i>&nbsp; Enter User Name to Continue';\n                document.getElementById('lbl_errorusername').style.display = \"inline-block\";\n                if (enable_captcha) {\n                    enableButtons();\n                }\n                return;\n            }\n\n            document.getElementById('SSOProviderId').value = providerId;\n            document.getElementById('LoginContext').value = 'SSO';\n\n            if (enable_captcha) {\n                var ret = await captchaValidation();\n            }\n\n            AuthorizeForm.submit();\n        }\n\n        function ResetErrors() {\n            ErrorMessage = \"\";\n\n            document.getElementById('lbl_errormessage').style.display = \"none\";\n            document.getElementById('lbl_errorusername').style.display = \"none\";\n        }\n\n        function enableButtons() {\n            document.getElementById('btn_login').disabled = false;\n\n            var items = document.getElementsByClassName(\"ssoicon\");\n\n            for (var i = 0; i < items.length; i++) {\n                var item = items[i];\n                item.classList.remove(\"disable_img\");\n            }\n        }\n\n        function disableButtons() {\n            document.getElementById('btn_login').disabled = true;\n\n            var items = document.getElementsByClassName(\"ssoicon\");\n\n            for (var i = 0; i < items.length; i++) {\n                var item = items[i];\n                item.classList.add(\"disable_img\");\n            }\n        }\n\n        function captchaValidation() {\n            return new Promise((resolve, reject) => {\n                try {\n                    grecaptcha.enterprise.ready(async () => {\n                        const token = await grecaptcha.enterprise.execute(\"6LcUr9UpAAAAAIKhsWYyXtG_EIQLXXlyhYC-AzKV\", { action: 'LOGINPAGE' });\n                        document.getElementById('CaptchaToken').value = token;\n                        resolve(true);\n                    });\n                } catch (ex) {\n                    resolve(true);\n                }\n            })\n        }\n\n        function closearrow() {\n            let notification_sec = document.querySelector(\".notification_sec\");\n            let arrow_sec = document.getElementById(\"upArrow\");\n            notification_sec.classList.toggle(\"expand_notf\");\n\n            if (arrow_sec.classList.contains('rotate180')) {\n                arrow_sec.classList.remove(\"rotate180\");\n            } else {\n                arrow_sec.classList.add(\"rotate180\");\n            }\n        }\n    </script>\n</head>\n\n<body>\n    <form method=\"post\" name=\"AuthorizeForm\" action=\"/identity/v2/Accounts/Authorize\">\n        <input type=\"hidden\" data-val=\"true\" data-val-required=\"The SSOProviderId field is required.\" id=\"SSOProviderId\" name=\"SSOProviderId\" value=\"0\" />\n        <input type=\"hidden\" data-val=\"true\" data-val-required=\"The LoginContext field is required.\" id=\"LoginContext\" name=\"LoginContext\" value=\"\" />\n        <input type=\"hidden\" data-val=\"true\" data-val-required=