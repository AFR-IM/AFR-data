-top:8px;padding:9px;border-radius:24px;\r\n}\r\n  .top-logo img{\r\n\tborder-radius:17px;\r\n}\r\n  .age-notice{\r\n    font-size:1.22rem;\r\n    padding:13px 22px;\r\n    margin:0 auto 10px;\r\n    border-width:3px;\r\n    box-shadow:0 10px 22px rgba(191,84,95,.14);\r\n  }\r\n  .age-notice::before{\r\n    width:62px;\r\n    height:34px;\r\n    font-size:1.08rem;\r\n  }\r\n  .hero{\r\n\tpadding:28px 28px 24px;border-radius:32px;\r\n}\r\n  .hero-lead{\r\n\tfont-size:1.08rem;\r\n}\r\n  .cta-panel{\r\n\tdisplay:grid;grid-template-columns:1fr 1fr;gap:10px;align-items:center;padding:14px;\r\n}\r\n  .cta-price{\r\n    grid-column:1/-1;\r\n    margin-bottom:0;\r\n    font-size:.98rem;\r\n  }\r\n  .cta-secondary{\r\n\tmargin-top:0;\r\n}\r\n  .cta-note{grid-column:1/-1}\r\n  .sample-grid{gap:12px}\r\n  .section{\r\n\tpadding:20px;margin-top:20px;\r\n}\r\n  .benefits{grid-template-columns:repeat(3,1fr)}\r\n  .benefit{\r\n\tgrid-template-columns:1fr;text-align:center;justify-items:center;padding:15px 12px;\r\n}\r\n  .menu-list{grid-template-columns:1fr 1fr}\r\n  .menu-card.featured{grid-column:1/-1}\r\n  .app-list{grid-template-columns:1fr 1fr}\r\n.pc-only{\r\n\tdisplay:inline;\r\n}\r\n}\r\n@media (max-width:374px){\r\n  .cta-price{\r\n    padding:9px 8px;\r\n    gap:4px 7px;\r\n    font-size:.84rem;\r\n  }\r\n  .cta-price strong{\r\n    font-size:1.02rem;\r\n  }\r\n  .cta-price span{\r\n    font-size:.76rem;\r\n  }\r\n}\r\n\r\n@media (max-width:374px){\r\n  .wrapper{width:min(100% - 18px,860px)}\r\n  .hero{\r\n\tpadding:16px 12px 14px;border-radius:24px;\r\n}\r\n  .hero-title{\r\n\tfont-size:1.44rem;\r\n}\r\n  .value-strip{gap:5px}\r\n  .value-item{\r\n\tpadding:9px 3px;\r\n}\r\n  .value-item b{\r\n\tfont-size:1rem;\r\n}\r\n  .cta-primary,.cta-secondary{\r\n\tfont-size:1rem;\r\n}\r\n  .section{\r\n\tpadding:13px;\r\n}\r\n  .sticky-inner a{\r\n\tfont-size:.86rem;\r\n}\r\n}\r\n\r\n@media (max-width:767px){\r\n  .wrapper{\r\n    width:min(100% - 14px, 860px);\r\n  }\r\n  .top-logo{\r\n    margin:2px auto 7px;\r\n    padding:3px;\r\n    border-radius:16px;\r\n  }\r\n  .top-logo img{\r\n    border-radius:12px;\r\n  }\r\n  .sample-grid{\r\n    grid-template-columns:1fr;\r\n  }\r\n  .sample-card img{\r\n    aspect-ratio:4 / 3;\r\n  }\r\n  .sample-grid .sample-card:nth-child(n+2){\r\n    display:none;\r\n  }\r\n\r\n  .pcmax-ad-pc{\r\n    display:none;\r\n  }\r\n  .pcmax-ad-sp{\r\n    display:flex;\r\n  }\r\n  .pcmax-ad-sp img{\r\n    width:min(100%, 336px);\r\n    max-width:100%;\r\n    height:auto;\r\n    object-fit:contain;\r\n  }\r\n}\r\n\r\n\r\n@media (max-width:767px){\r\n  .age-notice{\r\n    font-size:1rem;\r\n    padding:10px 13px;\r\n    border-width:2px;\r\n    gap:7px;\r\n    margin-bottom:8px;\r\n  }\r\n  .age-notice::before{\r\n    width:50px;\r\n    height:28px;\r\n    font-size:.92rem;\r\n  }\r\n}\r\n\r\n.legal-notice{\r\n  border:2px solid #f0d8ca;\r\n  background:#ffffff;\r\n}\r\n.legal-list{\r\n  display:grid;\r\n  gap:10px;\r\n  margin-top:10px;\r\n}\r\n.legal-item{\r\n  padding:12px;\r\n  border:1px solid #f0d8ca;\r\n  border-radius:16px;\r\n  background:#ffffff;\r\n}\r\n.legal-item h3{\r\n  color:var(--main-deep);\r\n  font-size:.98rem;\r\n  font-weight:950;\r\n  line-height:1.35;\r\n  margin-bottom:4px;\r\n}\r\n.legal-item p{\r\n  color:#5f514d;\r\n  font-size:.9rem;\r\n  font-weight:650;\r\n  line-height:1.65;\r\n}\r\n.legal-item strong{\r\n  color:#d7183a;\r\n  font-weight:950;\r\n}\r\n@media (max-width:374px){\r\n  .age-notice{\r\n    font-size:1.04rem;\r\n    padding:11px 13px;\r\n  }\r\n  .age-notice::before{\r\n    width:50px;\r\n    height:30px;\r\n    font-size:.94rem;\r\n  }\r\n  .age-subnotice{\r\n    font-size:.84rem;\r\n    padding:8px 10px;\r\n  }\r\n}\r\n\r\n\r\n\r\n.about-section{\r\n  margin-top:16px;\r\n}\r\n.menu-section{\r\n  margin-top:14px;\r\n}\r\n.menu-section .section-title{\r\n  margin-bottom:12px;\r\n}\r\n\r\n\r\n.report-link{\r\n  display:flex;\r\n  align-items:center;\r\n  justify-content:center;\r\n  min-height:48px;\r\n  margin-top:10px;\r\n  border-radius:14px;\r\n  background:linear-gradient(180deg,#ffffff 0%,#fff7f4 100%);\r\n  border:1px solid #9f243c;\r\n  color:#8f1d35;\r\n  font-size:.96rem;\r\n  font-weight:900;\r\n  letter-spacing:.02em;\r\n  box-shadow:0 5px 12px rgba(80,20,30,.10);\r\n  text-shadow:0 1px 0 rgba(255,255,255,.78);\r\n}\r\n.report-link::after{\r\n  content:\"〉\";\r\n  margin-left:7px;\r\n  font-weight:950;\r\n}\r\n\r\n-->\r\n</style>\r\n</head>\r\n<body>\r\n<div class=\"wrapper\">\r\n  <header class=\"top-logo\">\r\n    <h1><img src=\"top20260922.jpg\" alt=\"妻投稿倶楽部｜人妻・素人女性の画像投稿掲示板\" fetchpriority=\"high\" decoding=\"async\"></h1>\r\n  </header>\r\n\r\n  <div class=\"age-notice\">18歳未満の方の閲覧をお断りします</div>\r\n  <main>\r\n    <section class=\"hero\" aria-labelledby=\"mainTitle\">\r\n      <div class=\"hero-inner\">\r\n        <div class=\"hero-kicker\">会員様限定・高品質オリジナル作品</div>\r\n        <h2 class=\"hero-title\" id=\"mainTitle\">妻投稿倶楽部<span class=\"grad\">メンバーズ</span></h2>\r\n        <p class=\"hero-lead\">高品質オリジナル作品 <strong>9,000枚以上</strong>をお楽しみいただけます。当画像・動画投稿掲示板の運営はメンバーズ会員様のご支援によって運営されています。ぜひご入会いただければ幸いです。</p>\r\n\r\n        <div class=\"value-strip\" aria-label=\"メンバーズの特徴\">\r\n          <div class=\"value-item\"><b>9,000枚以上の限定作品</b><span>メンバーズ会員限定!!</span></div>\r\n          <div class=\"value-item\"><b>厳選 素人モデル</b><span>100人以上の人妻・素人女性を見放題!!</span></div>\r\n          <div class=\"value-item\"><b>毎週更新</b><span>継続追加</span></div>\r\n        </div>\r\n\r\n        <div class=\"cta-panel\">\r\n          <div class=\"cta-price\">30日間 <strong>2,950円</strong><span>✓安心決済</span><span>✓スマホ対応</span></div>\r\n          <a class=\"cta-primary\" href=\"member/menu.html\">メンバーズ案内を見る</a>\r\n          <a class=\"cta-secondary\" target=\"_blank\" rel=\"noopener\" href=\"https://vvvvvv.digi-v.net/on/\">会員ログイン</a>\r\n          <div class=\"cta-note\"><span>・高品質画像</span><span>・会員限定コンテンツ</span><span>・随時更新</span></div>\r\n        </div>\r\n\r\n        <div class=\"sample-grid\">\r\n          <a class=\"sample-card\" href=\"member/menu.html\"><img src=\"385/888a.jpg\" width=\"380\" height=\"296\" alt=\"妻投稿倶楽部 メンバーズ会員案内\" loading=\"lazy\" decoding=\"async\"><span class=\"sample-badge\">会員サンプル</span></a>\r\n          <a class=\"sample-card\" href=\"member/menu.html\"><img src=\"385/777.jpg\" width=\"380\" height=\"296\" alt=\"妻投稿倶楽部 メンバーズ限定画像\" loading=\"lazy\" decoding=\"async\"><span class=\"sample-badge\">会員サンプル</span></a>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"section about-section\">\r\n      <h2 class=\"section-title\">このサイトについて</h2>\r\n      <p class=\"top-text\">当サイトは、夫婦・カップルの刺激ある円満生活を応援する画像・動画投稿コミュニティです。メンバーズでは、会員様限定の高品質オリジナル作品をお楽しみいただけます。</p>\r\n    </section>\r\n\r\n    <section class=\"section menu-section\">\r\n      <h2 class=\"section-title\">妻投稿倶楽部 メニュー</h2>\r\n      <div class=\"menu-list\">\r\n    <div class=\"menu-card\">\r\n          <div class=\"menu-head\"><h3>メンバーズ会員入口</h3><span class=\"menu-pill\">会員様専用</span></div>\r\n          <p class=\"menu-text\">会員様限定でお楽しみいただけます。</p>\r\n          <a class=\"menu-link\" target=\"_blank\" rel=\"noopener\" href=\"https://wvvw.digi-v.net/on/\">メンバーズ会員入口</a>\r\n        </div>\r\n\r\n        <div class=\"menu-card\">\r\n          <div class=\"menu-head\"><h3>画像投稿掲示板</h3><span class=\"menu-pill\">80,000件以上</span></div>\r\n          <p class=\"menu-text\">画像投稿をお楽しみいただけます。</p>\r\n          <a class=\"menu-link\" href=\"https://tuma.jp/gazou\" target=\"_blank\" rel=\"noopener\">画像投稿</a>\r\n        </div>\r\n\r\n        <div class=\"menu-card\">\r\n          <div class=\"menu-head\"><h3>動画投稿掲示板</h3><span class=\"menu-pill\">30,000件以上</span></div>\r\n          <p class=\"menu-text\">動画投稿をお楽しみいただけます。</p>\r\n          <a class=\"menu-link movie\" href=\"https://tumadouga.jp\" target=\"_blank\" rel=\"noopener\">動画投稿</a>\r\n        </div>\r\n\r\n        <div class=\"menu-card\">\r\n          <div class=\"menu-head\">\r\n        <h3>寝取られ・貸出し募集掲示板</h3>\r\n      </div>\r\n      <p class=\"menu-text\"><span class=\"red\">単独者同士の出会いを目的とした利用は禁止です。</span></p>\r\n          <a class=\"menu-link\" href=\"https://tuma.jp/swap.html\" target=\"_blank\" rel=\"noopener\">募集掲示板</a>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n\r\n    <section class=\"ad-box\">\r\n      <h2 class=\"ad-heading\">管理人おすすめのセフレ・恋人探しのアプリ</h2>\r\n      <div class=\"ad-main\">\r\n        <a class=\"pcmax-ad pcmax-ad-pc\" href=\"https://pcmax.jp/lp/?ad_id=rm285896\" target=\"_blank\" rel=\"noopener\"><img src=\"pc728200b.png\" width=\"728\" height=\"200\" alt=\"PCMAX\" loading=\"lazy\" decoding=\"async\"></a>\r\n        <a class=\"pcmax-ad pcmax-ad-sp\" href=\"https://pcmax.jp/lp/?ad_id=rm285896\" target=\"_blank\" rel=\"noopener\"><img src=\"pcmax300250p.png\"  alt=\"PCMAX\" loading=\"lazy\" decoding=\"async\"></a>\r\n        <p>会員数2,500万人を超える国内最大の出会い!</p>\r\n    <br>\r\n    <br>\r\n<a href=\"https://happymail.co.jp/?zf18816905\" rel=\"nofollow noopener\" target=\"_blank\">\r\n<img src=\"https://img.happymail.co.jp/img/pc_l/1200x628B.gif\" width=\"600\" height=\"314\" alt=\"ハッピーメール\" loading=\"lazy\" decoding=\"async\">\r\n</a>\r\n <p>知名度抜群の優良人気出会いサイト</p>\r\n<br>\r\n  </div>\r\n  <a class=\"other-link\" href=\"happy/happy.html\">その他 おすすめセフレ・恋人探しはこちら</a><br>\r\n  </section>\r\n\r\n    <div class=\"pr-section\">\r\n      <div class=\"pr-label\">セックスライフ必需品 PR</div>\r\n      <a target=\"_blank\" rel=\"noopener\" href=\"https://www.e-nls.com/access.php?agency_id=af611875\"><img src=\"link/goods1.jpg\" width=\"728\" height=\"90\" alt=\"老舗のアダルトグッズ通販 NLS\" loading=\"lazy\" decoding=\"async\"></a>\r\n      <p class=\"pr-text\">老舗のアダルトグッズ通販「NLS」</p>\r\n    </div>\r\n\r\n    <section class=\"section legal-notice\">\r\n      <h2 class=\"section-title\">ご利用に関する重要なお願い</h2>\r\n      <div class=\"legal-list\">\r\n        <div class=\"legal-item\">\r\n          <h3>18歳未満の閲覧・投稿禁止</h3>\r\n          <p>当サイトは<strong>18歳未満の方の閲覧・投稿を固くお断りします。</strong>18歳未満と思われる人物が写る画像・動画、または18歳未満を対象とする投稿は一切禁止します。</p>\r\n        </div>\r\n        <div class=\"legal-item\">\r\n          <h3>違法行為・金銭交渉の禁止</h3>\r\n          <p>単独者同士の出会いを目的とした利用、売買春、援助交際、金銭の授受を伴う交渉、違法行為、公序良俗に反する投稿を禁止します。</p>\r\n        </div>\r\n        <div class=\"legal-item\">\r\n          <h3>同意のない投稿・権利侵害の禁止</h3>\r\n          <p>投稿画像・動画は、被写体の同意を得たものに限ります。リベンジポルノ、無断転載等の投稿を禁止します。</p>\r\n        </div>\r\n        <div class=\"legal-item\">\r\n          <h3>管理人による削除対応</h3>\r\n          <p>投稿内容に問題があると判断した場合、管理人の判断により予告なく削除します。違法性が疑われる投稿や通報があった投稿については、確認のうえ速やかに対応します。</p>\r\n          <a class=\"report-link\" href=\"https://tuma.jp/gazou/contact?id=\" target=\"_blank\" rel=\"noopener\">問題のある投稿を通報する</a>\r\n          <a class=\"report-link\" href=\"https://tuma.jp/kiyaku.html\" target=\"_blank\" rel=\"noopener\">利用規約を確認する</a>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n<div class=\"contact\"><a href=\"https://tuma.jp/gazou/contact?id=\" target=\"_blank\" rel=\"noopener\">管理人に問い合わせはこちら</a></div>\r\n  </main>\r\n</div>\r\n\r\n</body>\r\n</html>",
