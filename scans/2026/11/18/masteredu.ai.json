                         <i class=\"fas fa-lightbulb\"></i>\n                        </div>\n                        <h3>Business</h3>\n                        <p>Innovative business ideas and startup tips</p>\n                    </div>\n                </div>\n\n                <div class=\"category-card\" id=\"personal-growth\" data-category=\"personal-growth\">\n                    <div class=\"category-content\">\n                        <div class=\"category-icon-box\" aria-hidden=\"true\">\n                            <i class=\"fas fa-graduation-cap\"></i>\n                        </div>\n                        <h3>Personal Growth</h3>\n                        <p>Self-improvement and life skills development</p>\n                    </div>\n                </div>\n\n                <div class=\"category-card\" id=\"spoken-english\" data-category=\"spoken-english\">\n                    <div class=\"category-content\">\n                        <div class=\"category-icon-box\" aria-hidden=\"true\">\n                            <i class=\"fas fa-language\"></i>\n                        </div>\n                        <h3>Spoken English</h3>\n                        <p>Improve your English speaking and communication skills</p>\n                    </div>\n                </div>\n\n                <div class=\"category-card\" id=\"social-media-growth\" data-category=\"social-media-growth\">\n                    <div class=\"category-content\">\n                        <div class=\"category-icon-box\" aria-hidden=\"true\">\n                            <i class=\"fas fa-share-nodes\"></i>\n                        </div>\n                        <h3>Social Media &amp; Growth</h3>\n                        <p>Social media strategies and audience growth tips</p>\n                    </div>\n                </div>\n\n                <div class=\"category-card\" id=\"secrets-india\" data-category=\"secrets-india\">\n                    <div class=\"category-content\">\n 