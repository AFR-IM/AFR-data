n-block d3\">\n      <div class=\"section-label\" id=\"lbl-mgmt\">Vodstvo</div>\n      <div class=\"brand-card\">\n        <div class=\"mgmt-row\">\n          <div>\n            <div class=\"field-label\" id=\"fl-contact\">Splošni kontakt</div>\n            <div class=\"mgmt-sub\" id=\"mgmt-sub\">Vodstvo / splošne zadeve</div>\n          </div>\n          <a href=\"mailto:info@avant.si\" class=\"email-btn\">\n            <svg viewBox=\"0 0 24 24\"><path d=\"M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z\"/><polyline points=\"22,6 12,13 2,6\"/></svg>\n            info@avant.si\n          </a>\n        </div>\n      </div>\n    </div>\n\n  </div><!-- /wrapper -->\n\n  <footer>\n    <span class=\"footer-copy\">Avant.si d.o.o. &copy; 1992 &ndash; <span id=\"year\"></span></span>\n  </footer>\n</div><!-- /page -->\n\n<script>\n  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';\n  window.scrollTo(0, 0);\n  document.getElementById('year').textContent = new Date().getFullYear();\n\n  /* ── TRANSLATIONS ── */\n  const T = {\n    sl: {\n      title:      'Podatki podjetja — Avant.si',\n      htmlLang:   'sl',\n      hdrSub:     'Spletna infrastruktura &amp; digitalne storitve - že od leta 1992',\n      lblLegal:   'Pravni subjekt',\n      flName:     'Naziv podjetja',\n      flCountry:  'Država',\n      flAddress:  'Naslov',\n      flCity:     'Kraj / Poštna številka',\n      flReg:      'Matična številka',\n      flVat:      'Davčna številka',\n      lblBrand:   'Naša blagovna znamka',\n      flSupport:  'Podpora',\n      flWeb:      'Spletna mesta',\n      lblMgmt:    'Vodstvo',\n      flContact:  'Splošni kontakt',\n      mgmtSub:    'Vodstvo / splošne zadeve',\n      neoservLogo: 'https://www.neoserv.si/dist/img/cms/ns-hero-logo.svg',\n      neoservEmail:'info@neoserv.si',\n      neoservUrl:  'https://www.neoserv.si',\n      neoservDomain:'neoserv.si',\n    },\n    en: {\n      title:      'Company Data — Avant.si',\n      htmlLang:   'en',\n      hdrSub:     'Web infrastructure &amp; digital services - est. 1992',\n      lblLegal:   'Legal Entity',\n      flName:     'Company Name',\n      flCountry:  'Country',\n      flAddress:  'Address',\n      flCity:     'City / ZIP',\n      flReg:      'Registration No.',\n      flVat:      'Tax No.',\n      lblBrand:   'Our Brand',\n      flSupport:  'Support',\n      flWeb:      'Websites',\n      lblMgmt:    'Management',\n      flContact:  'General Contact',\n      mgmtSub:    'Leadership &amp; general inquiries',\n      neoservLogo: 'https://www.neoserv.si/dist/static/neoserv-logo-en.png',\n      neoservEmail:'info@neoserv.com',\n      neoservUrl:  'https://www.neoserv.com',\n      neoservDomain:'neoserv.com',\n    }\n  };\n\n  function setLang(lang) {\n    const t = T[lang];\n    document.documentElement.lang  = t.htmlLang;\n    document.title                  = t.title;\n    document.getElementById('hdr-sub').innerHTML   = t.hdrSub;\n    document.getElementById('lbl-legal').childNodes[0].textContent = t.lblLegal;\n    document.getElementById('fl-name').textContent    = t.flName;\n    document.getElementById('fl-country').textContent = t.flCountry;\n    document.getElementById('fl-address').textContent = t.flAddress;\n    document.getElementById('fl-city').textContent    = t.flCity;\n    document.getElementById('fl-reg').textContent     = t.flReg;\n    document.getElementById('fl-vat').textContent     = t.flVat;\n    document.getElementById('lbl-brand').childNodes[0].textContent = t.lblBrand;\n    document.getElementById('fl-support').textContent = t.flSupport;\n    document.getElementById('fl-web').textContent     = t.flWeb;\n    document.getElementById('lbl-mgmt').childNodes[0].textContent  = t.lblMgmt;\n    document.getElementById('fl-contact').textContent = t.flContact;\n    document.getElementById('mgmt-sub').innerHTML     = t.mgmtSub;\n    document.getElementById('neoserv-logo').src         = t.neoservLogo;\n    document.getElementById('neoserv-logo-link').href   = t.neoservUrl;\n    const emailEl = document.getElementById('neoserv-email');\n    emailEl.href        = 'mailto:' + t.neoservEmail;\n    emailEl.textContent = t.neoservEmail;\n    const urlEl = document.getElementById('neoserv-url');\n    urlEl.href          = t.neoservUrl;\n    document.getElementById('neoserv-url-text').textContent = t.neoservDomain;\n\n    document.getElementById('btn-sl').classList.toggle('active', lang === 'sl');\n    document.getElementById('btn-en').classList.toggle('active', lang === 'en');\n  }\n\n  /* ── PARTICLE NETWORK ── */\n  const canvas = document.getElementById('bg-canvas');\n  const ctx    = canvas.getContext('2d');\n  const BLUE   = [25, 117, 187];\n  const ORANGE = [245, 138, 31];\n  const N = 64, DIST = 190, SPEED = 0.22;\n  let W, H, nodes = [];\n\n  function resize() {\n    W = canvas.width  = window.innerWidth;\n    H = canvas.height = window.innerHeight;\n  }\n  function init() {\n    nodes = Array.from({ length: N }, () => ({\n      x:  Math.random() * W,\n      y:  Math.random() * H,\n      vx: (Math.random() - 0.5) * SPEED,\n      vy: (Math.random() - 0.5) * SPEED,\n      r:  Math.random() * 2.2 + 1.0,\n      col: Math.random() < 0.18 ? ORANGE : BLUE,\n    }));\n  }\n  function draw() {\n    ctx.clearRect(0, 0, W, H);\n    for (const n of nodes) {\n      n.x += n.vx; n.y += n.vy;\n      if (n.x < 0 || n.x > W) n.vx *= -1;\n      if (n.y < 0 || n.y > H) n.vy *= -1;\n    }\n    for (let i = 0; i < nodes.length; i++) {\n      for (let j = i + 1; j < nodes.length; j++) {\n        const dx = nodes[i].x - nodes[j].x;\n        const dy = nodes[i].y - nodes[j].y;\n        const d  = Math.hypot(dx, dy);\n        if (d < DIST) {\n          const a = (1 - d / DIST) * 0.22;\n          const c = (nodes[i].col === ORANGE || nodes[j].col === ORANGE) ? ORANGE : BLUE;\n          ctx.strokeStyle = `rgba(${c[0]},${c[1]},${c[2]},${a})`;\n          ctx.lineWidth = 0.9;\n          ctx.beginPath();\n          ctx.moveTo(nodes[i].x, nodes[i].y);\n          ctx.lineTo(nodes[j].x, nodes[j].y);\n          ctx.stroke();\n        }\n      }\n    }\n    for (const n of nodes) {\n      ctx.beginPath();\n      ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);\n      ctx.fillStyle = `rgba(${n.col[0]},${n.col[1]},${n.col[2]},0.55)`;\n      ctx.fill();\n    }\n    requestAnimationFrame(draw);\n  }\n\n  resize(); init(); draw();\n  window.addEventListener('resize', () => { resize(); init(); });\n</script>\n</body>\n</html>\n",
