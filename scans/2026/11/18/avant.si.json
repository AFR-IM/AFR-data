    "homepage": {
      "status": 200,
      "body": "<!DOCTYPE html>\n<html lang=\"sl\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Podatki podjetja — Avant.si</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600&family=Syne:wght@400;600;700;800&display=swap\" rel=\"stylesheet\" />\n  <style>\n    :root {\n      --bg:         #f8f9fc;\n      --surface:    #ffffff;\n      --blue:       #1975bb;\n      --blue-lo:    rgba(25, 117, 187, 0.07);\n      --blue-mid:   rgba(25, 117, 187, 0.20);\n      --blue-hi:    rgba(25, 117, 187, 0.40);\n      --orange:     #f58a1f;\n      --orange-lo:  rgba(245, 138, 31, 0.08);\n      --orange-mid: rgba(245, 138, 31, 0.22);\n      --border:     #e2e8f0;\n      --border-hi:  #b8cfe8;\n      --text:       #0f1c2e;\n      --text-dim:   #4a6580;\n      --text-lo:    #94a8bc;\n      --mono:       'IBM Plex Mono', monospace;\n      --sans:       'Syne', sans-serif;\n    }\n\n    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n    html { scroll-behavior: smooth; }\n\n    body {\n      font-family: var(--sans);\n      background: var(--bg);\n      color: var(--text);\n      min-height: 100vh;\n      overflow-x: hidden;\n    }\n\n    /* ── CANVAS / GRID ── */\n    #bg-canvas {\n      position: fixed; inset: 0;\n      z-index: 0; pointer-events: none;\n    }\n    .grid-overlay {\n      position: fixed; inset: 0;\n      z-index: 0; pointer-events: none;\n      background-image:\n        linear-gradient(rgba(25,117,187,0.035) 1px, transparent 1px),\n        linear-gradient(90deg, rgba(25,117,187,0.035) 1px, transparent 1px);\n      background-size: 64px 64px;\n    }\n\n    /* ── PAGE SHELL ── */\n    .page {\n      position: relative; z-index: 1;\n      min-height: 100vh;\n      display: flex; flex-direction: column;\n    }\n\n    /* ── TOPBAR ── */\n    .topbar {\n      max-width: 900px;\n      margin: 0 auto;\n      width: 100%;\n      padding: 26px 32px 0;\n      display: flex;\n      justify-content: flex-end;\n      opacity: 0;\n      animation: fadeIn 0.6s 0.05s ease forwards;\n    }\n\n    .lang-switch {\n      display: flex;\n      align-items: center;\n      gap: 0;\n      border: 1px solid var(--border);\n      border-radius: 6px;\n      overflow: hidden;\n      font-family: var(--mono);\n      font-size: 12px;\n      letter-spacing: 0.12em;\n      box-shadow: 0 1px 4px rgba(0,0,0,0.06);\n    }\n    .lang-btn {\n      padding: 8px 18px;\n      background: var(--surface);\n      border: none;\n      color: var(--text-lo);\n      cursor: pointer;\n      transition: background 0.2s, color 0.2s;\n      font-family: var(--mono);\n      font-size: 12px;\n      letter-spacing: 0.12em;\n      text-transform: uppercase;\n      line-height: 1;\n    }\n    .lang-btn:hover { background: var(--blue-lo); color: var(--text-dim); }\n    .lang-btn.active {\n      background: var(--blue-lo);\n      color: var(--blue);\n      border-left: 1px solid var(--blue-mid);\n      font-weight: 600;\n    }\n    .lang-btn:first-child.active { border-left: none; border-right: 1px solid var(--blue-mid); }\n    .lang-divider {\n      width: 1px; height: 32px;\n      background: var(--border);\n    }\n\n    /* ── WRAPPER ── */\n    .wrapper {\n      flex: 1;\n      max-width: 900px;\n      margin: 0 auto;\n      width: 100%;\n      padding: 52px 32px 72px;\n    }\n\n    /* ── HEADER ── */\n    .header {\n      margin-bottom: 52px;\n      opacity: 0;\n      animation: fadeUp 0.7s 0.12s ease forwards;\n    }\n    .logo-wrap { margin-bottom: 18px; }\n    .logo-wrap svg { filter: none; }\n    /* invert logo for light bg — re-color fills */\n    .logo-wrap .ls0 { fill: #f58a1f; }\n    .logo-wrap .ls1 { fill: #1975bb; }\n    .header-sub {\n      font-family: var(--mono);\n      font-size: 14px;\n      color: var(--text-dim);\n      letter-spacing: 0.06em;\n      display: flex;\n      align-items: center;\n      gap: 12px;\n    }\n    .header-sub::before {\n      content: '';\n      display: inline-block;\n      width: 26px; height: 2px;\n      background: var(--orange);\n      flex-shrink: 0;\n      border-radius: 2px;\n    }\n    .header-divider {\n      margin-top: 28px; height: 2px;\n      background: linear-gradient(90deg, var(--blue) 0%, rgba(25,117,187,0.10) 55%, transparent 100%);\n      border-radius: 2px;\n    }\n\n    /* ── SECTION LABEL ── */\n    .section-label {\n      font-family: var(--mono);\n      font-size: 11px; font-weight: 600;\n      letter-spacing: 0.26em;\n      text-transform: uppercase;\n      color: var(--text-lo);\n      margin-bottom: 16px;\n      display: flex; align-items: center; gap: 12px;\n    }\n    .section-label::after {\n      content: ''; flex: 1; height: 1px;\n      background: var(--border);\n    }\n\n    /* ── CARD ── */\n    .card {\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-radius: 10px;\n      padding: 36px 40px;\n      box-shadow: 0 2px 16px rgba(15,28,46,0.06), 0 1px 4px rgba(15,28,46,0.04);\n      position: relative; overflow: hidden;\n      transition: border-color 0.3s, box-shadow 0.3s;\n    }\n    .card::before {\n      content: ''; position: absolute;\n      top: 0; left: 0; right: 0; height: 3px;\n      background: linear-gradient(90deg, var(--blue), rgba(25,117,187,0.0) 70%);\n      opacity: 0; transition: opacity 0.35s;\n      border-radius: 10px 10px 0 0;\n    }\n    .card:hover {\n      border-color: var(--border-hi);\n      box-shadow: 0 8px 40px rgba(25,117,187,0.09), 0 2px 12px rgba(15,28,46,0.06);\n    }\n    .card:hover::before { opacity: 1; }\n    .card::after {\n      content: ''; position: absolute;\n      top: 13px; right: 13px;\n      width: 14px; height: 14px;\n      border-top: 1.5px solid var(--border-hi);\n      border-right: 1.5px solid var(--border-hi);\n      opacity: 0.5; pointer-events: none;\n    }\n\n    /* ── COMPANY GRID ── */\n    .company-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 28px 40px;\n    }\n    @media (max-width: 540px) {\n      .company-grid { grid-template-columns: 1fr; gap: 22px; }\n    }\n\n    .field-label {\n      font-family: var(--mono);\n      font-size: 10px; font-weight: 600;\n      letter-spacing: 0.22em; text-transform: uppercase;\n      color: var(--text-lo); margin-bottom: 6px;\n    }\n    .field-value {\n      font-family: var(--sans);\n      font-size: 20px; font-weight: 700;\n      color: var(--text); line-height: 1.3;\n    }\n\n    /* reg / vat row */\n    .id-row {\n      margin-top: 28px;\n      display: flex; gap: 16px; flex-wrap: wrap;\n    }\n    .id-badge {\n      display: inline-flex; align-items: center; gap: 10px;\n      background: var(--blue-lo);\n      border: 1px solid var(--blue-mid);\n      border-radius: 6px;\n      padding: 10px 20px;\n      font-family: var(--mono);\n      font-size: 16px; font-weight: 600;\n      color: var(--blue); letter-spacing: 0.08em;\n    }\n    .id-badge-label {\n      font-size: 10px; letter-spacing: 0.18em;\n      text-transform: uppercase;\n      color: var(--text-lo);\n      display: block; margin-bottom: 3px;\n    }\n    .id-dot {\n      width: 7px; height: 7px;\n      border-radius: 50%;\n      background: var(--blue);\n      animation: blink 2.5s infinite;\n      flex-shrink: 0;\n    }\n\n    /* ── SECTION BLOCKS ── */\n    .section-block {\n      margin-bottom: 28px;\n      opacity: 0;\n      animation: fadeUp 0.55s ease forwards;\n    }\n    .d1 { animation-delay: 0.20s; }\n    .d2 { animation-delay: 0.32s; }\n    .d3 { animation-delay: 0.44s; }\n\n    /* ── BRAND CARD ── */\n    .brand-card {\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-radius: 10px;\n      padding: 36px 40px;\n      box-shadow: 0 2px 16px rgba(15,28,46,0.06), 0 1px 4px rgba(15,28,46,0.04);\n      position: relative; overflow: hidden;\n      transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;\n    }\n    .brand-card::before {\n      content: ''; position: absolute;\n      top: 0; left: 0; right: 0; height: 3px;\n      background: linear-gradient(90deg, var(--orange), rgba(245,138,31,0.08) 60%, transparent);\n      opacity: 0.8; transition: opacity 0.3s;\n      border-radius: 10px 10px 0 0;\n    }\n    .brand-card::after {\n      content: ''; position: absolute;\n      top: 13px; right: 13px;\n      width: 14px; height: 14px;\n      border-top: 1.5px solid var(--orange-mid);\n      border-right: 1.5px solid var(--orange-mid);\n      opacity: 0.6;\n    }\n    .brand-card:hover {\n      border-color: rgba(245,138,31,0.30);\n      transform: translateY(-2px);\n      box-shadow: 0 12px 40px rgba(245,138,31,0.08), 0 2px 12px rgba(15,28,46,0.06);\n    }\n    .brand-card:hover::before { opacity: 1; }\n\n    .brand-inner {\n      display: grid;\n      grid-template-columns: auto 1fr;\n      gap: 0 44px;\n      align-items: start;\n    }\n    @media (max-width: 540px) {\n      .brand-inner { grid-template-columns: 1fr; gap: 24px; }\n    }\n\n    .brand-logo-wrap img {\n      width: 260px; height: auto;\n      display: block;\n      opacity: 0.92;\n      margin-top: 4px;\n    }\n\n    .brand-details { display: flex; flex-direction: column; gap: 18px; }\n\n    .support-row {\n      display: flex; align-items: center;\n      gap: 12px; flex-wrap: wrap;\n    }\n    .live-pill {\n      display: inline-flex; align-items: center; gap: 7px;\n      font-family: var(--mono);\n      font-size: 10px; font-weight: 600;\n      letter-spacing: 0.20em; text-transform: uppercase;\n      padding: 5px 12px; border-radius: 4px;\n      background: var(--orange-lo);\n      border: 1px solid var(--orange-mid);\n      color: var(--orange); white-space: nowrap;\n    }\n    .live-pill .dot {\n      width: 6px; height: 6px; border-radius: 50%;\n      background: var(--orange); animation: blink 2s infinite;\n    }\n    .brand-email {\n      font-family: var(--mono); font-size: 15px;\n      color: var(--orange); text-decoration: none;\n      font-weight: 500;\n      transition: color 0.2s, text-shadow 0.2s;\n      letter-spacing: 0.02em;\n    }\n    .brand-email:hover { color: #c96e10; }\n\n    /* url row */\n    .url-row {\n      display: flex; align-items: center; gap: 12px; flex-wrap: wrap;\n    }\n    .brand-url {\n      font-family: var(--mono); font-size: 14px;\n      color: var(--text-dim); text-decoration: none;\n      display: inline-flex; align-items: center; gap: 6px;\n      transition: color 0.2s;\n      letter-spacing: 0.02em;\n    }\n    .brand-url:hover { color: var(--blue); }\n    .brand-url svg {\n      width: 13px; height: 13px;\n      stroke: currentColor; fill: none;\n      stroke-width: 1.8; flex-shrink: 0; opacity: 0.6;\n    }\n    .url-sep {\n      color: var(--text-lo);\n      font-family: var(--mono); font-size: 13px;\n    }\n\n    /* ── MGMT ── */\n    .mgmt-row {\n      display: flex; align-items: center;\n      justify-content: space-between;\n      gap: 20px; flex-wrap: wrap;\n    }\n    .mgmt-sub {\n      font-family: var(--mono); font-size: 14px;\n      color: var(--text-dim); letter-spacing: 0.02em; margin-top: 5px;\n    }\n    .email-btn {\n      display: inline-flex; align-items: center; gap: 10px;\n      padding: 13px 26px;\n      background: var(--blue); border: none;\n      border-radius: 6px; font-family: var(--mono); font-size: 14px;\n      color: #fff; text-decoration: none; letter-spacing: 0.04em;\n      font-weight: 500;\n      transition: background 0.2s, box-shadow 0.2s, transform 0.15s;\n      white-space: nowrap;\n      box-shadow: 0 2px 12px rgba(25,117,187,0.22);\n    }\n    .email-btn:hover {\n      background: #1460a0;\n      box-shadow: 0 4px 20px rgba(25,117,187,0.32);\n      transform: translateY(-1px);\n    }\n    .email-btn svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 1.8; flex-shrink: 0; }\n\n    /* ── FOOTER ── */\n    footer {\n      position: relative; z-index: 1;\n      border-top: 1px solid var(--border);\n      padding: 22px 32px;\n      max-width: 900px; margin: 0 auto; width: 100%;\n    }\n    .footer-copy {\n      font-family: var(--mono); font-size: 12px;\n      color: var(--text-lo); letter-spacing: 0.06em;\n    }\n\n    /* ── ANIMATIONS ── */\n    @keyframes fadeUp {\n      from { opacity: 0; transform: translateY(14px); }\n      to   { opacity: 1; transform: translateY(0); }\n    }\n    @keyframes fadeIn {\n      from { opacity: 0; } to { opacity: 1; }\n    }\n    @keyframes blink {\n      0%, 100% { opacity: 1; } 50% { opacity: 0.25; }\n    }\n  </style>\n</head>\n<body>\n\n<canvas id=\"bg-canvas\" style=\"display:block;position:fixed;inset:0;\"></canvas>\n<div class=\"grid-overlay\" style=\"position:fixed;inset:0;\"></div>\n\n<div class=\"page\">\n\n  <!-- TOPBAR: language switch -->\n  <div class=\"topbar\">\n    <div class=\"lang-switch\">\n      <button class=\"lang-btn active\" id=\"btn-sl\" onclick=\"setLang('sl')\">SL</button>\n      <div class=\"lang-divider\"></div>\n      <button class=\"lang-btn\" id=\"btn-en\" onclick=\"setLang('en')\">EN</button>\n    </div>\n  </div>\n\n  <div class=\"wrapper\">\n\n    <!-- HEADER -->\n    <div class=\"header\">\n      <div class=\"logo-wrap\">\n        <svg version=\"1.2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 439 93\" width=\"260\" height=\"56\" aria-label=\"Avant.si\">\n          <style>.ls0{fill:#f58a1f}.ls1{fill:#1975bb}.ls2{fill:none;stroke:#f58e1e}</style>\n          <g>\n            <g><path class=\"ls0\" d=\"m251.57 84.86q0-2.71 1.85-4.59 1.85-1.87 4.62-1.87 2.72 0 4.57 1.87 1.84 1.88 1.84 4.59 0 2.61-1.87 4.46-1.88 1.85-4.54 1.85-2.72 0-4.59-1.85-1.88-1.85-1.88-4.46z\"/></g>\n            <g><g><path class=\"ls1\" d=\"m98.23 36.23l-15.22 41.95-15.27-41.95h-9.78l17.72 47.99q1.25 3.37