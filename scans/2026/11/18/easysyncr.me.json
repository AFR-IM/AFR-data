\n        <div class=\"text-center mb-2 px-4\">\r\n             <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-500/10 border border-violet-500/20 text-[9px] md:text-[10px] font-bold text-violet-400 uppercase tracking-[0.2em] mb-4\">\r\n                <i data-lucide=\"sparkles\" class=\"w-3 h-3 interaction-hint\"></i> Hover to interact\r\n            </div>\r\n        </div>\r\n\r\n        <div id=\"canvas-wrapper\" onclick=\"window.location.href='/sign-up'\">\r\n            <canvas id=\"physicsCanvas\"></canvas>\r\n        </div>\r\n\r\n        <section class=\"max-w-7xl mx-auto px-6 text-center -mt-4 md:-mt-10 relative z-10\">\r\n            <h2 class=\"text-3xl md:text-5xl font-extrabold mb-6 tracking-tight\">\r\n                Securely <span class=\"text-violet-500\">Sync</span> and Share.\r\n            </h2>\r\n            <p class=\"text-sm md:text-lg text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed\">\r\n                The fastest way to move data across the globe. End-to-end encrypted, uncapped speeds, and zero tracking.\r\n            </p>\r\n\r\n            <div class=\"flex flex-col items-center\">\r\n                <a href=\"/sign-up\" class=\"btn-premium w-full sm:w-auto px-10 py-4 md:py-5 rounded-2xl font-extrabold text-base md:text-xl flex items-center justify-center gap-4\">\r\n                    <i data-lucide=\"rocket\" class=\"w-5 h-5 md:w-6 md:h-6\"></i>\r\n                    START UPLOADING\r\n                </a>\r\n                <p class=\"mt-4 text-[9px] md:text-xs text-slate-500 uppercase tracking-widest opacity-60\">\r\n                    Encrypted transfers • Up to 20GB free\r\n                </p>\r\n            </div>\r\n        </section>\r\n\r\n        <section class=\"max-w-7xl mx-auto px-6 mt-20 md:mt-32 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6\">\r\n            <div class=\"glass p-6 md:p-8 rounded-[1.5rem] md:rounded-[2rem] hover:bg-white/[0.04] transition-all\">\r\n               