t\tcase '列車遅延':\n\t\t\t\t\t\tcase '運転再開':\n\t\t\t\t\t\tcase '運転状況':\n\t\t\t\t\t\t\tstatus_icon_class = 'icon-status-triangle';\n\t\t\t\t\t\t\tbreak;\n\t\t\t\t\t\tcase '運転見合わせ':\n\t\t\t\t\t\t\tstatus_icon_class = 'icon-status-cross';\n\t\t\t\t\t\t\tbreak;\n\t\t\t\t\t\tdefault:\n\t\t\t\t\t\t\tstatus_icon_class = 'icon-status-exclamation';\n\t\t\t\t\t\t\tbreak;\n\t\t\t\t\t}\n\t\t\t\t\tstatus = '<span class=\"has-status\"><span class=\"icon-base-20 '+ status_icon_class +'\"></span>' + registedLineInformationList[obj.code].traffic_status + '</span>';\n\t\t\t\t}\n\n\t\t\t\t$('#registered-line-name-' + lineCount).attr('href', '/transit/train-status' + '/line/' + obj.code);\n\t\t\t\t$('#registered-line-name-' + lineCount).text(registedLineInformationList[obj.code].name);\n\t\t\t\t$('#registered-line-status-' + lineCount).append(status);\n\t\t\t\t$('#registered-line-time-' + lineCount).text(registedLineInformationList[obj.code].time);\n\t\t\t\t$('#registered-line-unregister-' + lineCount).attr('href', '/transit/train-status' + '/line/' + obj.code);\n\t\t\t\t$('#registered-line-li-' + lineCount).css('display', 'block');\n\n\t\t\t\tlineCount++;\n\t\t\t})\n \t \t}else{\n \t \t\t$registered_line.append('<li>運行情報の取得に失敗しました。<br></li>');\n \t \t}\n\n \t \t$('.ek-train-status-top-registed').css('display', 'block');\n \t}else{\n \t\t$('.ek-train-status-top-no-registed').css('display', 'block');\n\t}\n}\n\n//ページ読み込み後の処理\n$(window).on('load', function (){\n\n\t// 「登録路線の運行情報」へのフォーカス処理\n\tvar userAgent = window.navigator.userAgent.toLowerCase();\n\t// chrome以外(chromeは、URLクリックしたとき「#」で遷移するため処理しない)\n\tvar scrollFlg;\n\tif(userAgent.indexOf('msie') != -1 || userAgent.indexOf('trident') != -1) {\n\t\tscrollFlg = true;\n\t} else if(userAgent.indexOf('edge') != -1) {\n\t\tscrollFlg = true;\n\t} else if(userAgent.indexOf('chrome') != -1) {\n\t\tscrollFlg = false;\n\t} else if(userAgent.indexOf('safari') != -1) {\n\t\tscrollFlg = true;\n\t} else if(userAgent.indexOf('firefox') != -1) {\n\t\tscrollFlg = true;\n\t} else {\n\t\tscrollFlg = true;\n\t}\n\tif(scrollFlg){\n\t\tif (location.href.match(/#registerd-lines/)) {\n\t\t\tvar target = $('#registerd-lines');\n\t\t\tvar position = target.offset().top;\n\t\t\t$('html, body').scrollTop(position);\n\t\t}\n\t}\n});\n</script><script type=\"text/javascript\" src=\"https://mob-gw.ekitan.com/inc/v2/js/Suggest?v=5_0-pc\" charset=\"utf-8\"></script>\n<script type=\"text/javascript\">\n\nvar trafficLineList = new Array();\n\nvar lineHistoryList = new Array();\n\nconst maxHistoryCount = '10';\n\nconst searchBtnName = 'ek-grandtop-search';\n\n$(function(){\n\t\n\tvar historyString = localStorage.getItem('ek_line_history');\n\tif(historyString != null) {\n\t\tlineHistoryList = JSON.parse(historyString);\n\t}\n\tredrawHistory();\n})\n\n// ページ読み込み完了後の処理\nwindow.onload = function () {\n\t// 路線名テキストをクリア(ブラウザで戻った時の検索ボタン押下時の不具合防止)\n\t$('.ek-search-line-name').val('');\n};\n\n\n\n\tvar listHeader = '<div class=\"my-pulldown-header\">候補から選択してください</div>'; // マイデータ特別をつけるため\n\t\n// インクリメンタルサーチ ver4\n$.suggest_api('https://mob-gw.ekitan.com/inc/v2', \"59ac10afcdd71d7873648cf094e03894\"); \n\n\n\tvar isTabChange = false;\n    showMyData = function(suggest, isShowDefaultList) {\n    \tsuggest.isShowDefaultList = isShowDefaultList ? isShowDefaultList : false;\n\n    \tsuggest._clearHideUlTimer();\n\n    \tvar $pulldown = $('.ek-modal-history');\n\n    \t$pulldown.removeAttr('data-ek-suggest-selector').attr('data-ek-suggest-selector',suggest.text_selector);\n\n    \t// ulを表示するエレメントの位置を調整\n    \tif (suggest.position || !suggest.position()) {\n    \t\t$(suggest.text_selector).after($pulldown); // ul要素の位置をテキストボックスの直後に移動\n    \t\tvar pos = suggest.position();\n    \t\t$pulldown.css({'left': pos.left, 'top': pos.top, 'width': '325px'});\n    \t};\n\n    \t// header div 候補のヘッダー\n    \tvar header = $('<div/>').attr('class', 'nav-tabs-wrap-center');\n    \tvar tab = $('<ul/>').attr('class', 'tab-nav').attr('role', 'tablist');\n\n    \tvar content = $('<div class=\"tab-content\"></div>');\n    \tvar history = $('<div id=\"modal-history\" role=\"tabpanel\" class=\"tab-pane\">');\n\n    \tif(lineHistoryList != \"\" && lineHistoryList.length > 0){\n\n\t\t\tfor(var i = 0; i < lineHistoryList.length; i++) {\n    \t\t\tvar item = lineHistoryList[i];\n    \t\t\tvar json = JSON.stringify(item);\n\t\t\t}\n    \t} else {\n    \t\thistory.append($('<span class=\"caution-nodata\">履歴がありません</span>'))\n    \t\t\t\t.append($('<p class=\"dele-all\" style=\"display: none;\"><a ga-event-lbl=\"GA-TRAC_grand-top_PC_line-history-all-delete\">すべて消去</a></p>'));\n    \t}\n    \tcontent.append(history);\n\n    \t$pulldown.html('').append(header).append(content);\n\n    \t$pulldown.show();\n    };\n    \n    hideMyData = function(suggest) {\n    \tsuggest._clearHideUlTimer();\n    \t$('.ek-modal-history').html('').hide().removeAttr('data-ek-suggest-selector');\n    \tsuggest.isShowDefaultList = false;\n    };\n\n    \n\t_myDataClickEvent = function(e) {\n\t\te.preventDefault();\n\t\t// click element\n\t\t$li = $(e.currentTarget);\n\t\tvar data = $.parseJSON($li.attr('data-ek-mydata-json'));\n\t\tvar selector = $('.ek-mydata-ul').attr('data-ek-suggest-selector');\n\n\t\tvar suggest = $(selector).suggest();\n\n\t\tdata.selectedType = \"click\";\n\t\tsuggest._selectedItem(data, true);\n\t\thideMyData(suggest);\n\t};\n\n    \n\t_historyDeleteClickEvent = function(e) {\n\t\te.preventDefault();\n\t\tvar code = $(e.currentTarget).data('ek-delete-code');\n\t\tlineHistoryList.some(function(v, i) {\n\t\t\tif(v.code == code) {\n\n\t\t\t\tlineHistoryList.splice(i,1);\n\t\t\t}\n\t\t});\n\t\tlocalStorage.setItem('ek_line_history', JSON.stringify(lineHistoryList));\n\n\t\tredrawHistory();\n\t\treturn false;\n\t};\n\n\t\n\t_allHistoryDeleteClickEvent = function(e) {\n\t\te.preventDefault();\n\t\tlineHistoryList = Array();\n\t\tlocalStorage.setItem('ek_line_history', JSON.stringify(lineHistoryList));\n\n\t\tvar selector = $('.ek-mydata-ul').attr('data-ek-suggest-selector');\n\t\tvar suggest = $(selector).suggest();\n\t\tsuggest.isDeleteClick = true;\n\t\tshowMyData(suggest, true);\n\t\t$('a[href=\"#modal-history\"]').parent().addClass('active');\n\t\t$('#modal-history').addClass('active');\n\t\t$('a[href=\"#modal-mydata\"]').parent().removeClass('active');\n\t\t$('#modal-mydata').removeClass('active');\n\t\t$(selector).focus();\n\t\t$(selector).on('blur',this._callArgs(this._blur));\n\t\treturn false;\n\t};\n\n\t\n\tredrawHistory = function() {\n\n\t\tif(searchBtnName == 'ek-search'){\n\t\t\t$('.station-list').remove();\n\t\t}\n\n\t\tvar mydata_ul = $('<ul class=\"station-list history\"></ul>');\n\t\tif(lineHistoryList != \"\" && lineHistoryList.length > 0){\n    \t\tfor(var i = 0; i < lineHistoryList.length; i++) {\n    \t\t\tvar item = lineHistoryList[i];\n    \t\t\tvar json = JSON.stringify(item);\n    \t\t\tvar $a_tag = $('<a class=\"ek-set-mydata-station\" onclick=\"_clickHistory(\\'' + item.code + '\\', \\'' + item.name + '\\');\" ga-event-lbl=\"GA-TRAC_grand-top_PC_line-name-history\"></a>').html(item.name);\n    \t\t\tvar $del_a_tag = $('<a href=\"\" class=\"btn-dele\" ga-event-lbl=\"GA-TRAC_grand-top_PC_line-history-delete\"></a>');\n    \t\t\t$del_a_tag.attr('data-ek-delete-code', item.code);\n     \t\t\t$del_a_tag.off('click').on('click', _historyDeleteClickEvent);\n    \t\t\tmydata_ul.append( $('<li/>').attr('data-ek-mydata-json',json).append($a_tag).append($del_a_tag));\n    \t\t}\n    \t\tmydata_ul.append('<p class=\"dele-all\"><a onclick=\"_historyAllDeleteEvent()\" ga-event-lbl=\"GA-TRAC_grand-top_PC_line-history-all-delete\">すべて消去</a></p>');\n    \t\t$('.ek-search-line-name').closest('.input-box-wrap').find('.my-station').css('display', 'block');\n\t\t}else{\n \t\t\tmydata_ul.append( $('<li/>').attr('data-ek-mydata-json',json).append('履歴がありません') );\n \t\t\t$('.ek-search-line-name').closest('.input-box-wrap').find('.my-station').css('display', 'none');\n\t\t}\n\t\t$('.modal-body').append(mydata_ul);\n\t}\n\n\t\n\t_historyAllDeleteEvent = function(e) {\n\t\tlineHistoryList = Array();\n\t\tlocalStorage.setItem('ek_line_history', JSON.stringify(lineHistoryList));\n\n\t\tredrawHistory();\n\t\treturn false;\n\t};\n\n\t\n\tmyDataKeyEvent = function(e, suggest, visible) {\n\t\tconsole.log(\"mydatakeyevent\");\n\t\tsuggest.showMyData(suggest, true);\n\t\treturn;\n\n\t\tvar $ul = $('.ek-mydata-ul');\n\t\tif ($ul.is(':visible')) {\n\t\t\t// 候補リスト表示中のキーイベント\n\t\t\tvar $div = $ul.find('div.active');\n\t\t\tif (e.type == 'keydown' && e.keyCode == this.keyCode.DOWN) {\n\t\t\t\te.preventDefault();\n\t\t\t\tvar li_active = $div.find('li.active');\n\t\t\t\tif (li_active.length) {\n\t\t\t\t\t$(li_active).removeClass('active');\n\t\t\t\t\t$(li_active).next().addClass('active');\n\t\t\t\t} else {\n\t\t\t\t\t$div.find('li:first-child').addClass('active');\n\t\t\t\t}\n\n\t\t\t} else if (e.type == 'keydown' && e.keyCode == this.keyCode.UP) {\n\t\t\t\te.preventDefault();\n\t\t\t\tvar li_active = $div.find('li.active');\n\t\t\t\tif (li_active.length) {\n\t\t\t\t\t$(li_active).removeClass('active');\n\t\t\t\t\t$(li_active).prev().addClass('active');\n\t\t\t\t} else {\n\t\t\t\t\t$div.find('li:last-child').addClass('active');\n\t\t\t\t}\n\t\t\t} else if (e.type == 'keydown' && e.keyCode == this.keyCode.TAB) {\n\t\t\t\tvar li_active = $div.find('li.active');\n\t\t\t\tif (li_active.length) {\n\t\t\t\t\tvar data = $.parseJSON(li_active.attr('data-ek-mydata-json'));\n\t\t\t\t\tli_active.removeClass('active');\n\t\t\t\t\tdata.selectedType = 'tab';\n\t\t\t\t\tthis._selectedItem(data, true);\n\t\t\t\t\tthis.hideMyData(suggest);\n\t\t\t\t}\n\t\t\t} else if (e.type == 'keyup' && this._enter && e.keyCode == this.keyCode.RETURN) {\n\t\t\t\tvar li_active = $div.find('li.active');\n\t\t\t\tif (li_active.length) {\n\t\t\t\t\tvar data = $.parseJSON(li_active.attr('data-ek-mydata-json'));\n\t\t\t\t\tli_active.removeClass('active');\n\t\t\t\t\tdata.selectedType = 'enter';\n\t\t\t\t\tthis._selectedIt