ul\").append('<li>' + suggestObj.code + ',' + suggestObj.name + '</li>');\n\t        }\n\t    });\n\n\t\t// 運行情報APIの路線情報がないものを、インクリメンタルサーチの一覧から削除\n\t    deleteIndexList.reverse();\n\t    $.each(deleteIndexList, function(index, value) {\n\t\t\t$('.ek-increment li').eq(value).remove();\n\t    })\n\n\t    // 候補の有無\n\t    if($('.ek-increment li').length > 0){\n\n\t\t\t$('.ek-increment').css('display', 'block');\n\n\t\t\t// リストの最初を初期表示でアクティブにする\n\t\t\t$('.ek-increment li').eq(0).addClass('active');\n\t    }else{\n\t\t\t$('.ek-increment').css('display', 'none');\n\t\t}\n\t},\n\n\tlistHeader:        listHeader,\n\t\t\t\t// 履歴連携用\n\t\t\tshowMyData:        showMyData,\n\t\t\thideMyData:        hideMyData,\n\t\t\tmyDataKeyEvent:    myDataKeyEvent,\n\t});\n\n// 検索ボタンクリック(運行情報トップ)\n$('.ek-search').on('click', function(e){\n\t// 路線名テキストボックスが未入力 or 候補がない場合、エラーメッセージを表示\n\tif($('.ek-search-line-name').val() == '' || $('#availableSuggestLineList ul li').length == 0){\n\t\t$('.alert-wrap').css('display', 'block');\n\n\t\tdataLayer.push({\n\t\t\tevent: 'form_validation_error',\n\t\t\tform_name: 'train_status_line_search',\n\t\t\terror_message: '路線を入力してください。'\n\t\t});\n\n\t\treturn;\n\t}else{\n\t\t$('.alert-wrap').css('display', 'none');\n\t}\n\n\te.preventDefault();\n\n\tvar availableSuggestLineListHash = {};\n\t$('#availableSuggestLineList ul li').each(function() {\n\t\tvar ary = $(this).text().split(',');\n\t\tavailableSuggestLineListHash[ary[0]] = ary[1];\n\t});\n\n\tvar lineCode;\n\tvar lineName;\n\tvar keywordFlg = false;\n\n\t// 完全一致\n\t$.each(availableSuggestLineListHash, function(code, name) {\n\t\tif(name == $('.ek-search-line-name').val()){\n\t\t\tlineCode = code;\n\t\t\tlineName = name;\n\t\t\treturn false;\n\t\t}\n    });\n\n\t// 部分一致\n\tif(lineCode == undefined || lineName== undefined){\n\t\t$.each(availableSuggestLineListHash, function(code, name) {\n\t\t\tif(name.indexOf($('.ek-search-line-name').val()) > -1){\n\t\t\t\tlineCode = code;\n\t\t\t\tlineName = name;\n\t\t\t\tkeywordFlg = true;\n\t\t\t\treturn false;\n\t\t\t}\n\t\t});\n\t}\n\n\t// 最初の候補\n\tif(lineCode == undefined || lineName== undefined){\n\t\t$.each(availableSuggestLineListHash, function(code, name) {\n\t\t\tlineCode = code;\n\t\t\tlineName = name;\n\t\t\tkeywordFlg = true;\n\t\t\treturn false;\n\t    });\n\t}\n\n\t// 履歴に保存\n\t_addLineHistory(lineCode, lineName);\n\n\t// 画面遷移\n\tvar url = \"/transit/train-status/line/\" + lineCode;\n\tif(keywordFlg){\n\t\turl += '?keyword=' + $('.ek-search-line-name').val();\n\t}\n\twindow.location.href = url;\n});\n\n// 検索ボタンクリック(グランドトップ)\n$('.ek-grandtop-search').on('click', function(e){\n\t// 路線名テキストボックスが未入力 or 候補がない場合、エラーメッセージを表示\n\tif($('.ek-search-line-name').val() == '' || $('#availableSuggestLineList ul li').length == 0){\n\t\t$('.alert-grandtop-wrap').css('display', 'block');\n\n\t\t\t\t\tDISP += 'PC';\n\t\t\n\t\tdataLayer.push({\n\t\t\tevent: 'form_validation_error',\n\t\t\tform_name: 'grandtop_train_status_line_search',\n\t\t\terror_message: '路線を入力してください。'\n\t\t});\n\n\t\treturn;\n\t}else{\n\t\t$('.alert-grandtop-wrap').css('display', 'none');\n\t}\n\n\te.preventDefault();\n\n\tvar availableSuggestLineListHash = {};\n\t$('#availableSuggestLineList ul li').each(function() {\n\t\tvar ary = $(this).text().split(',');\n\t\tavailableSuggestLineListHash[ary[0]] = ary[1];\n\t});\n\n\tvar lineCode;\n\tvar lineName;\n\tvar keywordFlg = false;\n\n\t// 完全一致\n\t$.each(availableSuggestLineListHash, function(code, name) {\n\t\tif(name == $('.ek-search-line-name').val()){\n\t\t\tlineCode = code;\n\t\t\tlineName = name;\n\t\t\treturn false;\n\t\t}\n    });\n\n\t// 部分一致\n\tif(lineCode == undefined || lineName== undefined){\n\t\t$.each(availableSuggestLineListHash, function(code, name) {\n\t\t\tif(name.indexOf($('.ek-search-line-name').val()) > -1){\n\t\t\t\tlineCode = code;\n\t\t\t\tlineName = name;\n\t\t\t\tkeywordFlg = true;\n\t\t\t\treturn false;\n\t\t\t}\n\t\t});\n\t}\n\n\t// 最初の候補\n\tif(lineCode == undefined || lineName== undefined){\n\t\t$.each(availableSuggestLineListHash, function(code, name) {\n\t\t\tlineCode = code;\n\t\t\tlineName = name;\n\t\t\tkeywordFlg = true;\n\t\t\treturn false;\n\t    });\n\t}\n\n\t// 履歴に保存\n\t//_addLineHistory(lineCode, lineName);\n\n\t// 画面遷移\n\tvar url = \"/transit/train-status/line/\" + lineCode;\n\tif(keywordFlg){\n\t\turl += '?keyword=' + $('.ek-search-line-name').val();\n\t}\n\twindow.location.href = url;\n});\n\n// 再検索ボタン(詳細ページ 候補あり)押下\n$('.ek-re_search').on('click', function(e){\n\twindow.location.href = \"/transit/train-status/line/\" + $('.select-line').val();\n});\n\n// SP 都道府県selectBox選択時\n$('.select-prefecture').change(function() {\n\tif($(this).val() != \"\"){\n    \twindow.location.href = \"/transit/train-status/company/pref/\" + $(this).val();\n\t}\n});\n\n\nvar $trainStatusMyStation = $('.ek-search-line-name').closest('.input-box-wrap').find('.my-station');\n\n$trainStatusMyStation.on('click', function(e) {\n  var $pulldown = $('.modal-history');\n  var $input = $('.ek-search-line-name');\n\n  if ($pulldown.css('display') === 'block') {\n    $pulldown.css('display', 'none');\n  } else {\n    $input.after($pulldown);\n\n    $pulldown\n      .removeAttr('data-ek-suggest-selector')\n      .attr('data-ek-suggest-selector', '.ek-search-line-name');\n\n    var pos = $input.position();\n    pos.top += $input.outerHeight();\n\n    $pulldown.css({\n      top: pos.top,\n      left: pos.left,\n      display: 'block'\n    });\n  }\n});\n\n// 路線名テキストボックスのkeyup処理\n$('.ek-search-line-name').keyup(function() {\n\t$('.ek-search-line-name').removeClass('completed');\n});\n\n$(document).click(function(event) {\n\t\n\tif(!$trainStatusMyStation.length) {\n\t\treturn;\n\t}\n\t// 履歴アイコン以外および履歴以外をクリックしたとき\n\tif(!$(event.target).closest('.my-station').is($trainStatusMyStation) && !$(event.target).closest('.modal-history').length && !$(event.target).closest('.dele-all').length) {\n\t\t$('.modal-history').css('display', 'none');\n\t}\n});\n\n</script>\n\n\n\t<script src=\"/common/js/ekitan-mydata.js?20261102125317\"></script>\n\n\t<!-- サイドカラム追従 ie11用 -->\n\t<script src=\"https://cdnjs.cloudflare.com/ajax/libs/stickyfill/2.1.0/stickyfill.min.js\"></script>\n\t<script>\n\tvar elements = $('.scroll-follow');\n\tStickyfill.add(elements);\n\t</script>\n</body>\n</html>\n",
