=\"/team/\" title=\"�������\"><strong>�������</strong></a></li>\r\n                      <li><a href=\"/adv/\" title=\"������� �� �����\"><strong>������� �� �����</strong></a></li>\r\n                    </ul>\r\n                  </div>\r\n                </div>\r\n              </li>\r\n\r\n              \r\n\r\n            </ul>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    </div>\r\n  </nav>\r\n\r\n<script type=\"text/javascript\">\r\n\r\n    // ������ �������� ������ �������������� ��� Jquery\r\n    var a = document.querySelectorAll('#nav > li > a');\r\n    for (var i=0; i<a.length; i++) {\r\n        if (a[i].getAttribute('direct') != 1) {\r\n            a[i].onclick = function() {\r\n                return false;\r\n            };\r\n        }\r\n    }\r\n\r\n    // ����������� � ������������ ���� ��� jquery\r\n    function showMenu(obj) {\r\n        var is_selected = (obj.className == 'selected');\r\n        // �������� ����� ����������� ����\r\n        var prev_obj = document.querySelectorAll('li.selected')[0];\r\n        if (prev_obj && prev_obj.children.length > 1) {\r\n            prev_obj.className = '';\r\n            prev_obj.children[1].firstElementChild.style.display = 'none';\r\n        }\r\n        // ������������� ����\r\n        if ( ! is_selected) {\r\n            obj.className = 'selected';\r\n            obj.children[1].firstElementChild.style.display = 'block';\r\n        }\r\n        return false;\r\n    }\r\n\r\n    // ����������� ���� (��� ���� ���������)\r\n    window.addEventListener(\"DOMContentLoaded\", function() {\r\n        var menu = document.getElementById(\"mob_page_menu_block\");\r\n        if (!menu || menu.offsetParent === null) return;\r\n\r\n        var wrap = menu.parentNode;\r\n        var prev = wrap.querySelector(\".page_menu_arrow_prev\");\r\n        var next = wrap.querySelector(\".page_menu_arrow_next\");\r\n\r\n        function updatePageMenuArrows() {\r\n            var maxScroll = menu.scrollWidth - menu.clientWidth;\r\n            if (maxScroll <= 2) {\r\n                wrap.classList.remove(\"has_prev\");\r\n                wrap.classList.remove(\"has_next\");\r\n                return;\r\n            }\r\n            wrap.classList.toggle(\"has_prev\", menu.scrollLeft > 2);\r\n            wrap.classList.toggle(\"has_next\", menu.scrollLeft < maxScroll - 2);\r\n        }\r\n\r\n        function scrollPageMenu(dir) {\r\n            var step = Math.max(200, Math.round(menu.clientWidth * 0.75));\r\n            menu.scrollLeft += dir * step;\r\n        }\r\n\r\n        updatePageMenuArrows();\r\n\r\n        var selected = menu.querySelector(\"li.selected, li#selected\");\r\n        if (selected) {\r\n            var selRight = selected.offsetLeft + selected.offsetWidth;\r\n            if (selRight > menu.scrollLeft + menu.clientWidth - 8) {\r\n                menu.scrollLeft = selRight - menu.clientWidth + 8;\r\n            }\r\n        }\r\n        updatePageMenuArrows();\r\n\r\n        menu.addEventListener(\"click\", function(e) {\r\n            var link = e.target.closest(\"a\");\r\n            if (link) {\r\n                yam_counter(\"mobile_context_menu\", \"\");\r\n            }\r\n        });\r\n\r\n        menu.addEventListener(\"scroll\", updatePageMenuArrows);\r\n        window.addEventListener(\"resize\", updatePageMenuArrows);\r\n\r\n        if (prev) {\r\n            prev.addEventListener(\"click\", function() { scrollPageMenu(-1); });\r\n        }\r\n        if (next) {\r\n            next.addEventListener(\"click\", function() { scrollPageMenu(1); });\r\n        }\r\n\r\n        menu.addEventListener(\"wheel\", function(e) {\r\n            if (menu.scrollWidth <= menu.clientWidth) return;\r\n            if (e.deltaY === 0) return;\r\n            e.preventDefault();\r\n            menu.scrollLeft += e.deltaY;\r\n        });\r\n    });\r\n\r\n    // ������ ���������� ����� �� �������� - ������������ � �������� �������, ���� �� �� ����� ������\r\n    window.addEventListener(\"DOMContentLoaded\", function() {\r\n        var control = document.querySelector(\".forum_controls_block\");\r\n        if (!control || control.scrollWidth <= control.clientWidth) return;\r\n\r\n        var current = control.querySelector(\".control_current\");\r\n        if (!current) return;\r\n\r\n        var block = control.getBoundingClientRect();\r\n        var item = current.getBoundingClientRect();\r\n        if (item.left >= block.left && item.right <= block.right) return;\r\n\r\n        control.scrollLeft += item.left - block.left - (block.width - item.width) / 2;\r\n    });\r\n\r\n    // ������� ��� ������ ��������� ����\r\n    function showMobMenu(block_id) {\r\n        // ���� Jquery?\r\n        if ($) {\r\n            $('#' + block_id + '').slideToggle(200);\r\n        } else {\r\n            var obj = document.getElementById(block_id);\r\n            if (obj.style.display == 'none') {\r\n                obj.style.display = 'block';\r\n            } else {\r\n                obj.style.display = 'none';\r\n            }\r\n        }\r\n    }\r\n\r\n    // �������� � ������� �������� ���������\r\n    var af_lib_loaded = false;\r\n    var af_lib_started = Math.floor(Date.now());\r\n    var af_lib_finished = 0;\r\n    function setAfLib() {\r\n        if (!af_lib_loaded) {\r\n            af_lib_loaded = true;\r\n            af_lib_finished = Math.floor(Date.now());\r\n            console.log('Adfox loaded at ' + (af_lib_finished - af_lib_started) + ' ms.');\r\n        }\r\n    }\r\n  </script>\r\n  <div id=\"all_body_block\">\r\n\r\n    <!-- �������� �� ������ ����� � ���� -->\r\n    <div id=\"gap_space\"></div>\r\n\r\n    <!-- �������� -->\r\n    <div id=\"top_space\" style=\"height: 0.5rem; cursor: default;\"></div>\r\n\r\n    <!-- ��������� -->\r\n    <div class=\"top_line\" id=\"top_line\">\r\n\r\n<style>\r\n#top_space { display: none; }\r\n</style>\r\n\r\n<div style=\"width:100%; min-height: 250px; max-heigh