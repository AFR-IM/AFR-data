rand\",\"name\":\"imo\",\"logo\":\"https://static-web.imoim.net/as/indigo-static/official/graphics/logo200.png\"},\"sameAs\":[\"https://www.facebook.com/imo.im\",\"https://www.tiktok.com/@imo_global\"]},{\"@type\":\"WebSite\",\"name\":\"imo\",\"url\":\"https://imo.im/\"},{\"@type\":\"WebPage\",\"@id\":\"https://imo.im/#homepage\",\"url\":\"https://imo.im/\",\"name\":\"imo: Free Video Calls and Messages - Official Website\",\"isPartOf\":{\"@type\":\"WebSite\",\"url\":\"https://imo.im\"}}]}</script><script src=\"/comm/libs/assets-load-monitor/2.5.6/assets-load-monitor-init.min.js\"></script><link rel=\"preload\" as=\"image\" href=\"/cdn-assets-s/imo-official/img/header-bg.cfc2a403.webp\" fetchpriority=\"high\" type=\"image/webp\"><link href=\"/cdn-assets-s/imo-official/css/chunk-vendors.15d78b96.css\" rel=\"stylesheet\"><link href=\"/cdn-assets-s/imo-official/css/chunk-common.4453297b.css\" rel=\"stylesheet\"><link href=\"/cdn-assets-s/imo-official/css/views/pc/index.98f1b32a.css\" rel=\"stylesheet\"></head><body><div id=\"app\"><div class=\"ssr-content home\"><section><h1>Free, Simple, and Secure</h1><p>Stay close to the people who matter with free, private calls and messages—wherever you are.</p></section><section id=\"audio\"><h2>Smooth HD Video &amp; Voice Calls</h2><p>Make free HD one-on-one or group video and voice calls with family and friends—perfect for everyday chats, group catch-ups, and international calls.</p></section><section id=\"global-call\"><h2>Stable on Weak Networks</h2><p>Works across 2G, 3G, 4G, and Wi-Fi, automatically adjusting call quality to your connection so calls stay smooth and stable, even on weak networks.</p></section><section id=\"secure\"><h2>Stay Connected with Your Groups</h2><p>Create private or public groups to share updates, or start a group call to bring family, friends, and coworkers together—no matter where they are.</p></section><section><h2>More Ways to Message</h2><p>Send text, photos, videos, and voice messages, or share files like PDF, DOC, and ZIP. Add emoji and stickers to make conversations lively and expressive.</p></section><section id=\"translate\"><h2>Ultimate Privacy Protection</h2><p>Your personal messages and calls are protected with end-to-end encryption, so no one outside the chat can read or listen in. Features like screenshot blocking help keep your conversations strictly private.</p></section><section><h2>Share Life&#39;s Moments</h2><p>Share photos, videos, and moods with imo Story—an easy way to keep friends in the loop on what you&#39;re up to.</p></section></div></div><script>// 加载执行完骨架屏渲染脚本的耗时\n      window.__web104__ = {\n        startTime: Date.now(),\n        duration: performance.now(),\n      };</script><script ignore src=\"/cdn-assets-s/imo-official/libs/flexible-pc-v2.js\"></script><script src=\"/comm/libs/common-vendor/1.1.0/common_vendor.min.js\"></script><script>(function (m, e, t, r, i, k, a) {\n    m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };\n    m[i].l = 1 * new Date();\n    for (let j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }\n    k = e.createElement(t), a = e.getElementsByTagName(t)[0], k.async = 1, k.src = r, a.parentNode.insertBefore(k, a);\n  })\n  (window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');\n  ym(97349169, 'init', {\n    clickmap: true,\n    trackLinks: true,\n    accurateTrackBounce: true,\n    webvisor: true,\n  });</script><noscript><div><img src=\"https://mc.yandex.ru/watch/97349169\" style=\"position:absolute; left:-9999px;\" alt=\"\"></div></noscript><script src=\"/cdn-assets-s/imo-official/js/chunk-vendors.f29b3274.js\"></script><script src=\"/cdn-assets-s/imo-official/js/chunk-common.912fc3fc.js\"></script><script src=\"/cdn-assets-s/imo-official/js/views/pc/index.272cd572.js\"></script></body></html>",
