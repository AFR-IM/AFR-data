35rem}\n.lg-modal.lg-skin-underline h2{border-bottom:3px solid var(--m-accent);padding-bottom:.3rem}\n.lg-modal.lg-skin-underline h2,.lg-modal.lg-skin-underline h3{font-family:Georgia,'Times New Roman',serif}\n.lg-close{position:absolute;top:.8rem;right:1rem;background:none;border:none;\n  font-size:1.6rem;line-height:1;cursor:pointer;color:#15171a;opacity:.55}\n.lg-close:hover{opacity:1}\n.lg-cookie{position:fixed;left:1rem;right:1rem;bottom:1rem;max-width:560px;margin:0 auto;\n  background:#ffffff;color:#15171a;border:1px solid rgba(0,0,0,.12);\n  border-radius:14px;padding:1rem 1.2rem;z-index:55;\n  box-shadow:0 16px 40px rgba(0,0,0,.25);font-size:.9rem;line-height:1.5;\n  font-family:'Hanken Grotesk',system-ui,-apple-system,Segoe UI,Roboto,sans-serif}\n.lg-cookie strong{color:#15171a}\n.lg-cookie a{color:#0b5fff;text-decoration:underline}\n.lg-cookie.hidden{display:none}\n.lg-cookie-actions{display:flex;gap:.6rem;margin-top:.8rem;flex-wrap:wrap}\n.lg-btn{cursor:pointer;border:none;border-radius:10px;\n  padding:.55rem 1rem;font:inherit;font-weight:600}\n.lg-btn-primary{background:#15171a;color:#ffffff}\n.lg-btn-ghost{background:transparent;color:#15171a;\n  border:1px solid rgba(0,0,0,.25)}\n.lg-foot-links{display:flex;gap:1.1rem;flex-wrap:wrap}\n.lg-foot-links a{cursor:pointer}\n\n</style>\n<script>\n      const query = new URLSearchParams(location.search);\n      const destinationUrl = query.get('dest_url');\n\n      if (destinationUrl) {\n        try {\n          const parsed = new URL(destinationUrl, location.href);\n          const { protocol, href } = parsed;\n\n          if (protocol === 'http:' || protocol === 'https:') {\n            location.href = href;\n          }\n        } catch (e) {}\n      }\n    </script>\n</head><body><div class=\"wrap\">\n  <header class=\"lg-nav\"><span class=\"brand\">Crest Workshop</span><span class=\"tag\">First-time budgeters and students.</span></header>\n  <section class=\"hero\"><h1>Foundations of Personal Finance</h