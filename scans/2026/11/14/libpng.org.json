brary, <A HREF=\"http://www.libmng.com/\"\n><B>libmng</B></A>.\n\n<CENTER>\n<P ALIGN=\"center\">\n   <A HREF=\"pub/png/libpng.html\"><IMG WIDTH=88 HEIGHT=31 BORDER=0\n    SRC=\"pub/png/img_png/libpng-88x31.png\" ALT=\"[libpng now!]\"></A>\n\n   <P>\n   <A HREF=\"pub/png/index.html\"><IMG WIDTH=98 HEIGHT=31 BORDER=0\n    SRC=\"pub/png/img_png/pngnow.png\" ALT=\"[PNG now!]\"></A>\n\n   &nbsp; &nbsp; &nbsp;\n\n   <A HREF=\"pub/mng/index.html\"><IMG WIDTH=98 HEIGHT=31 BORDER=0\n    SRC=\"pub/mng/img_mng/mngnow-bearcy.png\" ALT=\"[MNG now!]\"></A>\n\n   <P>\n   <A HREF=\"http://sourceforge.net/projects/png-mng\"><IMG WIDTH=80 HEIGHT=15\n    SRC=\"http://sflogo.sourceforge.net/sflogo.php?group_id=32355&amp;type=9\"\n    ALT=\"[primary site hosted by SourceForge]\" BORDER=0 ALIGN=\"right\"></A>\n\n   &nbsp; &nbsp; &nbsp;\n\n   <A HREF=\"http://www.libmng.com/\"><IMG WIDTH=88 HEIGHT=31 BORDER=0\n    SRC=\"pub/mng/img_mng/libmng.png\" ALT=\"[powered by libmng]\"></A>\n</P>\n</CENTER>\n\n<P>\n<HR>\n\n<CENTER>\n  <FONT SIZE=\"-1\">\n  Copyright &#169; 2001-2009 <A HREF=\"http://gregroelofs.com/\">Greg Roelofs</A>.\n  </FONT>\n</CENTER>\n\n</BODY>\n</HTML>\n",
