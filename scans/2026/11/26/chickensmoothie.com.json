450d8b5ed960fb6a072e42\"><img src=\"/img/dressups_challenge.png?2\" alt=\"Join the dressups challenge!\" width=\"277\" height=\"120\" style=\"max-width:100%; height:auto\" /></a>\n\n\t\t<span class=\"corners-bottom\"><span></span></span></div>\n\t</div>\n\t<div class=\"panel bg4\" id=\"latest_drawings\">\n\t\t<div class=\"inner\"><span class=\"corners-top\"><span></span></span>\n\t\t<h3>Featured drawings</h3>\n\t\t<ul><li ><div><a href=\"Forum/viewtopic.php?f=125&amp;t=5157322&amp;sid=71f3e8159f450d8b5ed960fb6a072e42\"><img src=\"/oekaki/image/image.php?id=4421069&amp;size=feature&amp;format=auto&amp;rev=1795315880\"></a></div>By <a href=\"Forum/memberlist.php?mode=viewprofile&amp;u=114558&amp;sid=71f3e8159f450d8b5ed960fb6a072e42\">Error</a></li><li class=\"reqjs\"><div><a href=\"Forum/viewtopic.php?f=76&amp;t=5157486&amp;sid=71f3e8159f450d8b5ed960fb6a072e42\"><img src=\"/oekaki/image/image.php?id=4421363&amp;size=feature&amp;format=auto&amp;rev=1795455810\"></a></div>By <a href=\"Forum/memberlist.php?mode=viewprofile&amp;u=1111920&amp;sid=71f3e8159f450d8b5ed960fb6a072e42\">Silv3rSpac3</a></li><li class=\"reqjs\"><div><a href=\"Forum/viewtopic.php?f=137&amp;t=5155952&amp;sid=71f3e8159f450d8b5ed960fb6a072e42\"><img src=\"/oekaki/image/image.php?id=4419763&amp;size=feature&amp;format=auto&amp;rev=1795639951\"></a></div>By <a href=\"Forum/memberlist.php?mode=viewprofile&amp;u=918145&amp;sid=71f3e8159f450d8b5ed960fb6a072e42\">nightcrawler!</a></li><li class=\"reqjs\"><div><a href=\"Forum/viewtopic.php?f=125&amp;t=5157312&amp;sid=71f3e8159f450d8b5ed960fb6a072e42\"><img src=\"/oekaki/image/image.php?id=4378139&amp;size=feature&amp;format=auto&amp;rev=1795311100\"></a></div>By <a href=\"Forum/memberlist.php?mode=viewprofile&amp;u=320889&amp;sid=71f3e8159f450d8b5ed960fb6a072e42\">Crazyclaww</a></li><li class=\"reqjs\"><div><a href=\"Forum/viewtopic.php?f=125&amp;t=5156601&amp;sid=71f3e8159f450d8b5ed960fb6a072e42\"><img src=\"/oekaki/image/image.php?id=4420472&amp;size=feature&amp;format=auto&amp;rev=1794805380\"></a></div>By <a href=\"Forum/memberlist.php?mode=viewprofile&amp;u=334452&amp;sid=71f3e8159f450d8b5ed960fb6a072e42\">Archaeopteryx.</a></li><li class=\"reqjs\"><div><a href=\"Forum/viewtopic.php?f=129&amp;t=5156847&amp;sid=71f3e8159f450d8b5ed960fb6a072e42\"><img src=\"/oekaki/image/image.php?id=4415703&amp;size=feature&amp;format=auto&amp;rev=1794984365\"></a></div>By <a href=\"Forum/memberlist.php?mode=viewprofile&amp;u=357391&amp;sid=71f3e8159f450d8b5ed960fb6a072e42\">zym</a></li><li class=\"reqjs\"><div><a href=\"Forum/viewtopic.php?f=127&amp;t=5157690&amp;sid=71f3e8159f450d8b5ed960fb6a072e42\"><img src=\"/oekaki/image/image.php?id=4421579&amp;size=feature&amp;format=auto&amp;rev=1795568854\"></a></div>By <a href=\"Forum/memberlist.php?mode=viewprofile&amp;u=852442&amp;sid=71f3e8159f450d8b5ed960fb6a072e42\">Wooper</a></li><li class=\"reqjs\"><div><a href=\"Forum/viewtopic.php?f=125&amp;t=5156848&amp;sid=71f3e8159f450d8b5ed960fb6a072e42\"><img src=\"/oekaki/image/image.php?id=4416717&amp;size=feature&amp;format=auto&amp;rev=1794984984\"></a></div>By <a href=\"Forum/memberlist.php?mode=viewprofile&amp;u=833434&amp;sid=71f3e8159f450d8b5ed960fb6a072e42\">lilpupin</a></li></ul>\n\t\t<div class=\"prevnext reqjs\"><a href=\"#\" id=\"prev\">&lt; Prev</a> <a href=\"#\" id=\"next\">Next &gt;</a></div>\n\t\t<span class=\"corners-bottom\"><span></span></span></div>\n\t</div>\n</div>\n<div id=\"main_right\">\n\t<div class=\"panel bg4\" id=\"welcome\">\n\t\t<div class=\"inner\"><span class=\"corners-top\"><span></span></span>\n\t\t\t\t\t<h2>Welcome!</h2>\n\t\t\t<p>\n\t\t\t\tAdopt <strong>free virtual pets</strong> at Chicken Smoothie!\n\t\t\t</p>\n\t\t\t<p>\n\t\t\t\tCollect new pets every month, watch them grow, dress them up and trade them with friends!\n\t\t\t\tCreate artwork using our free online Oekaki app, and join clubs, roleplays, and discussions in the Forum!\n\t\t\t</p>\n\t\t\t<p>\n\t\t\t\t<strong>Get started right away by clicking the \"Adopt\" button above!</strong>\n\t\t\t</p>\n\t\t\n\t\t<span class=\"corners-bottom\"><span></span></span></div>\n\t</div>\n\t<div class=\"panel bg4\" id=\"news\">\n\t\t<div class=\"inner\"><span class=\"corners-top\"><span></span></span>\n\t\t<h3>Site news</h3>\n\t\t<div id=\"newslist\">\n\t\t\t\t\t\t\t<div class='newsitem'>\n\t<div class='date'>15th November 26</div>\n\t<div class='newscontent'>\n\t\t<p><span style=\"font-size: 150%; line-height: 116%;\" class=\"bbcode-size\"><span class=\"d-text bbcode-color\" style=\"color: #800000; --d-tc: #f97979\"><span style=\"font-weight: bold\">Mid Month Update - November 2026</span></span></span><br /><br /><span style=\"font-weight: bold\">Site Updates:</span><br />- Rarities are updated!<br /><img src=\"//www.chickensmoothie.com/img/stamps/Personality%20&amp;%20Profile/Pride/pride-17.png\" alt=\"Image\" /><img src=\"//www.chickensmoothie.com/img/stamps/CS%20Pets/Insects%20etc/BugStamp_26.png\" alt=\"Image\" /><br />- We have new Insect and Pride stamps available - made by Firielle and UnluckyStar. They can be found by going to &quot;CS Pets &gt; Insects etc&quot;, and in &quot;Personality &amp; Profile &gt; Pride&quot;<br />- The emojis for the multiple wishlist feature have been chosen: <a href=\"/Forum/viewtopic.php?f=20&amp;t=5145863&amp;start=470#p154099150\" class=\"postlink\">⭐ ❤️ 💎 🍀</a><br /><br /><span style=\"font-weight: bold\">What's coming up:</span><br /><br />- Multiple wishlists feature should be ready for December!<br />- Our annual Advent Calendar event starts Dec. 1st. December is a busy time on CS, if you are new to the site we recommend reading through the FAQs on last year's <a href=\"/Forum/viewtopic.php?f=108&amp;t=5093639#p150903125\" class=\"postlink\"><span style=\"font-weight: bold\">help thread</span></a>. Additional warnings related to the Dec. 18th will be posted when we get closer so they don't get lost!<br /><br /><span style=\"font-weight: bold\">Dress-Up Challenge Feature:</span><br />November 2026 Dress-Up Challenge Feature/Winner :<br />&quot;If you believe, you can be a sheep!&quot; by <a href=\"/Forum/memberlist.php?mode=viewprofile&amp;u=731849\" class=\"postlink\">Pinecous</a><br /><a href=\"/Forum/viewtopic.php?t=5154014\" class=\"postlink\"><img src=\"//www.chickensmoothie.com/dressups/350-species-swap/291259.png\" alt=\"Image\" /></a><br />Congrats! Want to win limited store items like this user did? Make sure to participate in our themed dress-up challenges for a chance!</p>\n\t</div>\n\t<div class='after'></div>\n</div>\t\t\t\t\t\t\t<div class='newsitem'>\n\t<div class='date'>7th November 26</div>\n\t<div class='newscontent'>\n\t\t<p>Our Halloween event trade-ins are now over, bringing our event to a close! Come and help Totoro collect candy again next year!<br /><br />We've now returned to our regular &quot;CSDullGreen&quot; site theme, but if you're still longing for candy corn you can switch back to CSHallow <a href=\"/Forum/ucp.php?i=prefs&amp;mode=personal\" class=\"postlink\">from your My Account page</a></p>\n\t</div>\n\t<div class='after'></div>\n</div>\t\t\t\t\t\t\t<div class='newsitem'>\n\t<div class='date'>6th November 26</div>\n\t<div class='newscontent'>\n\t\t<p>Surprise! We've added an extra day for you to trade in your Halloween candy! That's 24 hours starting right now, and time is counting down, so if you didn't already trade in your candy, do so now <a href=\"/halloween/\" class=\"postlink\">on the Halloween page</a>!</p>\n\t</div>\n\t<div class='after'></div>\n</div>\t\t\t\t\t\t\t<div class='newsitem'>\n\t<div class='date'>3rd November 26</div>\n\t<div class='newscontent'>\n\t\t<p>Our Halloween candy hunt has now finished! You now have three days left to trade in your Halloween candy. Don't leave it to the last minute and risk missing out!<br /><br />Check out the <a href=\"/halloween/\" class=\"postlink\">countdown timer on the Halloween page</a> to see exactly how much time you have left!</p>\n\t</div>\n\t<div class='after'></div>\n</div>\t\t\t\t\t\t\t<div class='newsitem'>\n\t<div class='date'>1st November 26</div>\n\t<div class='newscontent'>\n\t\t<p><span style=\"font-size: 150%; line-height: 116%;\" class=\"bbcode-size\"><span class=\"d-text bbcode-color\" style=\"color: #800000; --d-tc: #f97979\"><span style=\"font-weight: bold\">November 2026</span></span></span><br /><br />Welcome to November! New store items by Codex have officially arrived! Come grab these stylish <a href=\"/store/category.php?id=8\" class=\"postlink\"><span style=\"font-weight: bold\">Sunglasses Items</span></a>! Keep in mind, these are limited store items and will become unavailable in two months. Additionally, you can also find a small collection of <a href=\"/store/category.php?id=8&amp;pageStart=0\" class=\"postlink\">glasses</a> that we've added permanently to the store!<br /><br /><img src=\"//www.chickensmoothie.com/dressups/352-let-s-feast/291233.png\" alt=\"Image\" /><br /><br />As always, a fresh batch of monthly pets is ready to <a href=\"/adoptables/\" class=\"postlink\"><span style=\"font-weight: bold\">Adopt</span></a>! Be sure to adopt your outcomes to see how they grow throughout the month.<br /><br /><img src=\"//www.chickensmoothie.com/pet/532701728&amp;trans=1.jpg\" alt=\"Image\" /><br /><br />We are celebrating Día de los Muertos! Make sure to grab the giveaways on our <span style=\"font-weight: bold\"><a href=\"/adoptables/special%20event\" class=\"postlink\">Special Event</a></span> page, available for the next two weeks only!<br /><br /><a href=\"/halloween/\" class=\"postlink\"><img src=\"//static.chickensmoothie.com/trans.php?k=7D0C28C1A0948A12A86DCED711FC67B6&amp;i=mF-aM8Ms5ovIOCCaO45OTg\" alt=\"Image\" /></a><br /><br />Our <a href=\"/halloween/\" class=\"postlink\"><span style=\"font-weight: bold\">Halloween Event</span></a> has officially wrapped up its daily giveaways. <span style=\"font-weight: bold\">Yesterday was the last day for new gifts and prizes!</span> After today, you will have one more day to collect tokens, followed by three additional days to redeem them. On the Halloween page we've added <span style=\"font-weight: bold\">a new free pack of stamps to collect</span>, don't miss it!<br /><br />And last but not least, express your creativity in this month's <a href=\"/dressups/\" class=\"postlink\"><span style=\"font-weight: bold\">Dressup Challenges</span></a>!!</p>\n\t</div>\n\t<div class='after'></div>\n</div>\t\t\t\t\t\t<div id=\"newssub\">\n\t\t\t\t<a href=\"news/news.php\">View older news</a>\n\t\t\t</div>\n\t\t</div>\n\t\t<span class=\"corners-bottom\"><span></span></span></div>\n\t</div>\n</div>\n<div class=\"clear\"></div>\n\r\n</div>\r\n\r\n\n<div class=\"advert large bottom\">\n\t<ins class=\"adsbygoogle\"\n\t\t style=\"display:block;height:100px\"\n\t\t data-ad-client=\"ca-pub-8329218400368230\"\n\t\t data-ad-slot=\"4807523692\"\n\t\t data-ad-format=\"horizontal\"\n\t\t \n\t></ins>\n\t<script>\n\t\t(adsbygoogle = window.adsbygoogle || []).push({});\n\t</script>\n</div>\n</div>\n\n<div id=\"page-footer\">\n\n\t<div class=\"navbar\">\n\t\t<div class=\"inner\"><span class=\"corners-top\"><span></span></span>\n\n\t\t<ul class=\"linklist\">\n\t\t\t<li class=\"icon-home\">\n\t\t\t\n\t\t\t\t<a href=\"/?sid=71f3e8159f450d8b5ed960fb6a072e42\">Home</a>\n\t\t\t\n\t\t\t</li>\n\t\t\t\t\n\t\t\t<li class=\"rightside\">\n\t\t\t\t\n\t\t\t\t&copy; Chicken Smoothie 2026 |\n\t\t\t\t<a href=\"/time.php?sid=71f3e8159f450d8b5ed960fb6a072e42\">03:36, Nov 26th</a> |\n\t\t\t\t<a href=\"/team/?sid=71f3e8159f450d8b5ed960fb6a072e42\">Our team</a> |\n\t\t\t\t<span class=\"edit-cookie-consent\"><a href=\"#\">Edit consent</a> |</span>\n\t\t\t\t<a href=\"/privacy.php\">Privacy Policy</a>\n\t\t\t</li>\n\t\t</ul>\n\n\t\t<span class=\"corners-bottom\"><span></span></span></div>\n\t</div>\n\t\n\t\n\t<div>\n\t\t<a id=\"bottom\" name=\"bottom\" accesskey=\"z\"></a>\n\t\t\n\t</div>\n</div>\n<div id=\"footer-decoration-1\"></div>\n</div>\n</div>\n<script type='text/javascript' src='/res/jquery.cycle.lite.1.7.js'></script>\n<script type='text/javascript'>\n$(document).ready(function() {\n\t$('.reqjs').css('display', 'block');\n\t\n\tvar latest_drawings = $(\"#latest_drawings ul\");\n\t\n    latest_drawings.cycle({\n\t    prev:   '#prev', \n\t    next:   '#next', \n    \ttimeout: 6000\n\t});\n\t\n\tfunction resize_right() {\n\t\tvar newslist = $(\"#newslist\");\n\t\t\n\t\tvar delta = $(\"#main_left\").height() - $(\"#main_right\").height();\n\t\t\n\t\tvar new_height = newslist.height() + delta;\n\t\t\n\t\tif (new_height > 100) {\n\t\t\tnewslist.css('min-height', new_height);\n\t\t}\n\t}\n\t\n\t$('#latest_drawings ul li img').each(function() {\n\t\t$(this).load(function() {\n\t\t\tif (this.height > 0) {\n\t\t\t\tlatest_drawings.height(Math.max(latest_drawings.height(), this.height));\n\t\t\t\tresize_right();\n\t\t\t}\n\t\t});\n\t\t\n\t\tif (this.height > 0) {\n\t\t\tlatest_drawings.height(Math.max(latest_drawings.height(), this.height));\n\t\t\tresize_right();\n\t\t}\n\t});\n\t\n\t$(window).resize(function() {\n\t\tresize_right();\n\t});\n});\n</script>\n</body>\n</html>",
