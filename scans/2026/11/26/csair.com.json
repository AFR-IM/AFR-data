ter;\n\t\t\t}\n\t\n\t\t\t.erweima>div{\n\t\t\t\tdisplay: inline-block;\n\t\t\t\tmargin-left: 40px;\n\t\t\t}\n\t\t\t\n\t\t\t#footer-box{\n\t\t\t\tmargin-top:0!important;\n\t\t\t}\n\t\t</style>\n</head>\n<body>\n\t\t<div class=\"err_404\">\n\t\t\t\t<div class=\"error_box block_box\">\n\t\t\t\t</div>\n\t\t\t\t<div id=\"err_txt\">\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<div class=\"err_txt_left\">\n\t\t\t\t\t\t\t\t<div class=\"sorryPage\">很抱歉，未找到指定页面。</div>\n\t\t\t\t\t\t\t\t<div class=\"error404\">错误代码：404</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"err_txt_right\">\n\t\t\t\t\t\t\t\t<button class=\"returnHome\" onclick=\"returnHome()\">返回首页</button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"erweima\">\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t<img src=\"/error/images/a-qr.jpg\" alt=\"\">\n\t\t\t\t\t\t\t\t<div class=\"downloadApp\">\n\t\t\t\t\t\t\t\t\t\t扫描二维码下载客户端\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t<img src=\"/error/images/b-qr.jpg\" alt=\"\">\n\t\t\t\t\t\t\t\t<div class=\"focusWechat\">\n\t\t\t\t\t\t\t\t\t扫描二维码关注南方航空微信号\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<script src=\"//www.csair.com/headfoot/cn/headfoot.js\" type=\"text/javascript\"></script>\n\t\t\t\t<script>\n\t\t\t\t\tvar lang = $.cookie(\"language\") || $.GetQueryString(\"subsite\") || $.cookie(\"changehead\"),\n\t\t\t\t\t\t\t_COUNTRY,\n\t\t\t\t\t\t\t_LANGUAGE;\n\t\t\t\t\tif(/^(EN|ZH|KO)\\_(AU|NZ|KR|US|SG|GB|CA|DE|NL|FR|IT|JP|HK|TW|TH|MY|RU|ID|VN|PH|IN)$/i.test(lang)){\n\t\t\t\t\t\t\tlang = lang .split(\"_\")[1] + \"_\" + lang .split(\"_\")[0]\n\t\t\t\t\t}\n\t\t\t\t\tif(lang){\n\t\t\t\t\t\t\t_LANGUAGE = lang.split(\"_\")[1].toLowerCase();\n\t\t\t\t\t\t\tif(_LANGUAGE.toLowerCase() == \"en\"){\n\t\t\t\t\t\t\t\t$(\".sorryPage\").text(\"Sorry, page not found.\");\n\t\t\t\t\t\t\t\t$(\".error404\").text(\"Error code: 404\");\n\t\t\t\t\t\t\t\t$(\".returnHome\").text(\"Return Home\");\n\t\t\t\t\t\t\t\t$(\".downloadApp\").text(\"APP download\");\n\t\t\t\t\t\t\t\t$(\".focusWechat\").text(\"Wechat public account\");\n\t\t\t\t\t\t\t\t$(\"title\").text(\"Page Not Found - China Southern Airlines\");\n\t\t\t\t\t\t\t}else if(_LANGUAGE.toLowerCase() == \"ko\"){\n\t\t\t\t\t\t\t\t$(\".sorryPage\").text(\"이 페이지를 표시할 수 없습니다\");\n\t\t\t\t\t\t\t\t$(\".error404\").text(\"에러코드: 404\");\n\t\t\t\t\t\t\t\t$(\".returnHome\").text(\"돌아가기\");\n\t\t\t\t\t\t\t\t$(\".downloadApp\").text(\"APP다운로드\");\n\t\t\t\t\t\t\t\t$(\".focusWechat\").text(\"중국남방항공 웨이신\");\n\t\t\t\t\t\t\t\t$(\"title\").text(\"해당 페이지를 찾을 수 없습니다 - 중국남방항공\");\n\t\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\tfunction returnHome(){\n\t\t\t\t\t\t\tlang = $.cookie(\"language\") || $.GetQueryString(\"subsite\") || $.cookie(\"changehead\");\n\t\t\t\t\t\t\tif(/^(EN|ZH|KO)\\_(AU|NZ|KR|US|SG|GB|CA|DE|NL|FR|IT|JP|HK|TW|TH|MY|RU|ID|VN|PH|IN)$/i.test(lang)){\n\t\t\t\t\t\t\t\t\tlang = lang .split(\"_\")[1] + \"_\" + lang .split(\"_\")[0]\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif(lang && lang.split(\"_\")[1] != \"CN\"){\n\t\t\t\t\t\t\t\t\t_COUNTRY = lang.split(\"_\")[0].toLowerCase();\n\t\t\t\t\t\t\t\t\t_LANGUAGE = lang.split(\"_\")[1].toLowerCase();\n\t\t\t\t\t\t\t\t\twindow.location.href = \"/\" + _COUNTRY + \"/\" + _LANGUAGE;\n\t\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\t\tif(/CN/.test(lang)){\n\t\t\t\t\t\t\t\t\tif(lang.split(\"_\")[0] == \"en\"){\n\t\t\t\t\t\t\t\t\t\twindow.location.href='/en/index.shtml';\n\t\t\t\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\t\t\t\twindow.location.href='/cn/index.shtml';\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\t\t\twindow.location.href='/cn/index.shtml';\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\t$.headfooter();\n\t\t\t\t\t$.cookie(\"language\",lang,{ path: \"/\" ,domain: '.csair.com'});\n\t\t\t\t</script>\n\t\t\t</div>\n</body>\n</html>",
