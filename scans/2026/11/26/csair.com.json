      "body": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head>\r\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\" />\r\n  <meta name=\"description\" content=\"中国南方航空官网,提供国内国际机票预订,飞机票查询,航班查询,特价打折机票预订,明珠会员服务等.南航特价优惠机票2折起,南航官网预订机票最高直减15%,南航全国销售服务热线95539.\" />\r\n  <meta name=\"keywords\" content=\"中国南方航空公司官网,机票预订,机票查询,特价机票预定,打折机票\" />\r\n  <meta property=\"qc:admins\" content=\"24411613676331126375716450630454\" />\r\n  <meta name=\"baidu-site-verification\" content=\"cS5mVyzBcq\" />\r\n  <title>中国南方航空官网-机票查询,机票预定,航班查询</title>\r\n</head>\r\n\r\n<body>\r\n<!-- ip 自动定位 开始 -->\r\n<!--<script type=\"text/javascript\" src=\"iplocator/ip.aspx\" charset=\"utf-8\"></script>-->\r\n<!-- 自动定位 结束 -->\r\n<script type=\"text/javascript\">\r\n  var searchurl = window.location.href,\r\n      url = \"/cn/index.shtml\",\r\n      sUserAgent = navigator.userAgent || navigator.vendor || window.opera,\r\n      hostName = location.hostname,\r\n      cookieName = 'language',\r\n      cookieValue = Cookie_operator(cookieName),\r\n      ip_info;\r\n  var siteList = ['AU','CA','HK','ID','IN','JP','KR','MY','NZ','PH','RU','SG','TW','TH','US','VN','EU','CN','APAC','MEA','WA',\"MO\",\"MX\"],\r\n      sitelangList = ['zh','en','tc','ko','ja','de','it','fr','ru','es'];\r\n  var __mockIp = location.search?new URLSearchParams(window.location.search).get('for'):(localStorage.getItem(\"__mockip__\") ||\"\");\r\n\r\n  const controller = new AbortController();\r\n  const signal = controller.signal;\r\n\r\n  setTimeout(() => {\r\n    controller.abort();\r\n  }, 3000); // 设置超时为3秒\r\n\r\n  fetch(\"https://www.csair.com/iplocator/getIpInfo\"+(__mockIp?\"?for=\"+__mockIp:\"\"), {signal}).then(function (response){\r\n    return response.json()\r\n  }).then(function(data) {\r\n    if(data && data.region){\r\n      ip_info = data.site || data.region[0] || '';\r\n      window.location.href = checkUs() || checkKr() || checkCookieValue() ||  checkIpAddress() || checkMobileDevice() || url\r\n    }else{\r\n      window.location.href = checkCookieValue() || checkMobileDevice() || url\r\n    }\r\n  }).catch(function(e) {\r\n    window.location.href = checkCookieValue() || checkMobileDevice() || url\r\n  });\r\n\r\n\r\n  var checkUs = function (){\r\n    if(!ip_info || ip_info.toUpperCase() !== \"US\") return '';\r\n    Cookie_operator(cookieName, 'en_us');\r\n    return \"/us/en/index.shtml\";\r\n  }\r\n  var checkCookieValue = function (){\r\n    if(!cookieValue) return '';\r\n    var url,\r\n        onSite = cookieValue.split(\"_\")[1],\r\n        onLang = cookieValue.split(\"_\")[0];\r\n    try {\r\n      if(siteList.indexOf(onSite.toUpperCase()) > -1 && sitelangList.indexOf(onLang.toLowerCase()) > -1){\r\n        if(onSite.toLocaleLowerCase() === 'cn'){\r\n          url = \"/\"+(onLang.toLocaleLowerCase() === 'zh'?'cn':'en')+\"/index.shtml\";\r\n        }else{\r\n          url = \"/\"+onSite.toLocaleLowerCase()+\"/\"+onLang+\"/index.shtml\";\r\n        }\r\n      }\r\n    }catch (e) {}\r\n\r\n    return url;\r\n  }\r\n  var checkKr = function(){\r\n    if(!ip_info || ip_info.toUpperCase() !=='KR') return  '';\r\n    var url;\r\n    if (sUserAgent.indexOf(\"IPAD\") > -1 || sUserAgent.indexOf(\"IPHONE\") > -1 || sUserAgent.indexOf(\"IOS\") > -1 || sUserAgent.indexOf(\"INCOGNITO\") > -1 || sUserAgent.indexOf(\"WEBMATE\") > -1) {//跳转到3g.csair.com\r\n      url = \"https://mkr.csair.com\";\r\n    } else if (sUserAgent.indexOf(\"ANDROID\") > -1 || sUserAgent.indexOf(\"UCWEB\") > -1 || sUserAgent.indexOf(\"HTC\") > -1 || sUserAgent.indexOf(\"DREAM\") > -1 || sUserAgent.indexOf(\"CUPCAKE\") > -1) {\r\n      url = \"http://mkr.csair.com\";\r\n    } else {\r\n      url = \"/kr/ko/index.shtml?auto=true\";\r\n      Cookie_operator(cookieName, 'ko_kr');\r\n    }\r\n    return url;\r\n  }\r\n\r\n  var checkMobileDevice = function (){\r\n    if(isMobileDevice()){\r\n      return \"http://m.csair.com\";\r\n    }\r\n    return;\r\n  }\r\n\r\n  var checkIpAddress = function (){\r\n    if(!ip_info) return '';\r\n    var url;\r\n    try {\r\n      if(siteList.indexOf(ip_info) > -1 ){\r\n        if(ip_info.toLocaleLowerCase() === 'cn'){\r\n          url = \"/cn/index.shtml\";\r\n        }else{\r\n          url = \"/\"+ip_info.toLocaleLowerCase()+\"/en/index.shtml\";\r\n        }\r\n      }\r\n    }catch (e) {}\r\n\r\n    return url;\r\n  }\r\n\r\n  function Cookie_operator(name, value, options){\r\n    if (typeof value != 'undefined') { // set cookie\r\n      options = options || {};\r\n      if (value === null) {\r\n        value = '';\r\n        options = $.extend({}, options);\r\n        options.expires = -1;\r\n      }\r\n      var expires = '';\r\n      if (options.expires && (typeof options.expires == 'number' || options.expires.toUTCString)) {\r\n        var date;\r\n        if (typeof options.expires == 'number') {\r\n          date = new Date();\r\n          date.setTime(date.getTime() + (options.expires * 24 * 60 * 60 * 1000));\r\n        } else {\r\n          date = options.expires;\r\n        }\r\n        expires = '; expires=' + date.toUTCString();\r\n      }\r\n\r\n      var path = options.path ? '; path=' + (options.path) : '';\r\n      var domain = options.domain ? '; domain=' + (options.domain) : '';\r\n      var secure = options.secure ? '; secure' : '';\r\n      try {\r\n        document.cookie = [name, '=', encodeURIComponent(value), expires, path, domain, secure].join('');\r\n      } catch (e) {\r\n        document.cookie = [name, '=', value, expires, path, domain, secure].join('');\r\n      }\r\n    } else { //get cookie\r\n      var cookieValue = null;\r\n      if (document.cookie && document.cookie != '') {\r\n        var cookies = document.cookie.split(';');\r\n        for (var i = 0; i < cookies.length; i++) {\r\n          var cookie = cookies[i].trim();\r\n          // Does this cookie string begin with the name we want?\r\n          if (cookie.substring(0, name.length + 1) == (name + '=')) {\r\n            try {\r\n              cookieValue = decodeURIComponent(cookie.substring(name.length + 1));\r\n            } catch (e) {\r\n              cookieValue = cookie.substring(name.length + 1);\r\n            }\r\n            break;\r\n          }\r\n        }\r\n      }\r\n      return cookieValue;\r\n    }\r\n  }\r\n\r\n  function isMobileDevice() {\r\n    const mobileAgents = [\r\n      'Android', 'iPhone', 'iPad', 'iPod', 'BlackBerry', 'IEMobile', 'Opera Mini', 'Mobile', 'Windows Phone', 'webOS', 'Kindle', 'Silk', 'Firefox Mobile', 'Opera Mobi', 'UCWEB', 'UC Browser', 'Mobile Safari', 'Chrome Mobile', 'BlackBerry', 'Nokia', 'Phone', 'Mobile', 'Opera Mini', 'Opera Mobi'\r\n    ];\r\n\r\n    // 检查用户代理字符串是否包含任何移动设备片段\r\n    for (let i = 0; i < mobileAgents.length; i++) {\r\n      if (sUserAgent.indexOf(mobileAgents[i]) !== -1) {\r\n        return true;\r\n      }\r\n    }\r\n\r\n    // 如果没有匹配到则是桌面设备\r\n    return false;\r\n  }\r\n</script>\r\n</body>\r\n</html>\r\n",
