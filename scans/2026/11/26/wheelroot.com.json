      "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"description\" content=\"Drawing Fundamentals — Anyone can learn to draw — start with the basics.\">\n<meta name=\"robots\" content=\"index, follow\">\n<title>Drawing Fundamentals | Slate Studio</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Mulish:wght@400;600&display=swap\" rel=\"stylesheet\">\n<style>\n*{box-sizing:border-box}\nbody{margin:0}\nimg{max-width:100%}\na{text-decoration:none}\n.lg-features{display:grid;gap:1rem}\n@media(min-width:720px){.lg-features{grid-template-columns:repeat(3,1fr)}}\n:root{--bg:#f6ede1;--fg:#3b2a1e;--accent:#c0683a;--accent-fg:#fff;--surface:#fdf7ef;--hair:rgba(0,0,0,.1);--radius:40px;--font-display:'Fraunces',serif}\nbody{background:var(--bg);color:var(--fg);font-family:'Mulish',system-ui,sans-serif}\n.wrap{max-width:920px;margin:0 auto;padding:1.6rem}\n.lg-nav{display:flex;justify-content:space-between;align-items:center}\n.brand{font-family:var(--font-display);font-weight:700;font-size:1.4rem}\n.pill{background:var(--surface);border-radius:999px;padding:.4rem 1rem;font-size:.82rem;border:1px solid var(--hair)}\n.hero{text-align:center;padding:4rem 0 2.5rem}\n.blob{display:inline-block;background:var(--accent);color:#fff;padding:.3rem 1.1rem;border-radius:40px 40px 40px 8px;font-size:.85rem;font-weight:600}\n.hero h1{font-family:var(--font-display);font-weight:700;font-size:clamp(2.3rem,6vw,4rem);line-height:1.05;margin:1rem auto .6rem;max-width:16ch}\n.hero p{font-size:1.2rem;opacity:.82;max-width:42ch;margin:0 auto}\n.cta{display:inline-block;margin-top:1.6rem;background:var(--accent);color:#fff;padding:.9rem 1.9rem;border-radius:40px;font-weight:600}\n.lg-feature{background:var(--surface);border-radius:30px;padding:1.6rem;text-align:center}\n.lg-feature h3{font-family:var(--font-display);color:var(--accent);margin:.2rem 0}\n.lg-feature p{opacity:.8;font-size:.95rem}\n.about{background:var(--surface);border-radius:var(--radius);padding:2.2rem;margin-top:2.5rem;text-align:center}\n.about p{font-size:1.12rem;line-height:1.75;max-width:56ch;margin:0 auto .8rem}\n.lg-footer{margin-top:3rem}\n.lg-foot-inner{padding:1.6rem 0;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font-size:.85rem;opacity:.75}\n\n/* Cookie banner + modals are self-contained: fixed light card and dark text,\n   so they stay legible on every template regardless of the page palette. */\n.lg-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);\n  display:none;align-items:center;justify-content:center;padding:1.2rem;z-index:60}\n.lg-modal-overlay.open{display:flex}\n.lg-modal{background:#ffffff;color:#15171a;--m-accent:#0b5fff;--m-tint:#eef3ff;\n  max-width:640px;width:100%;max-height:85vh;overflow:auto;border-radius:14px;\n  padding:2rem 1.8rem;box-shadow:0 24px 60px rgba(0,0,0,.35);position:relative;\n  font-family:'Hanken Grotesk',system-ui,-apple-system,Segoe UI,Roboto,sans-serif}\n.lg-modal h2{margin-top:0;color:#15171a;font-family:var(--font-display,inherit)}\n.lg-modal h3{margin:1.2rem 0 .3rem;color:var(--m-accent)}\n.lg-modal p,.lg-modal li{line-height:1.6;font-size:.95rem;color:#3a3f47}\n.lg-modal a{color:var(--m-accent);text-decoration:underline}\n/* skins: distinct header / border treatments, all readable on a light card */\n.lg-modal.lg-skin-bar{border-top:6px solid var(--m-accent)}\n.lg-modal.lg-skin-side h3{border-left:3px solid var(--m-accent);padding-left:.65rem}\n.lg-modal.lg-skin-tint{background:var(--m-tint)}\n.lg-modal.lg-skin-tint h2{display:inline-block;border-bottom:2px solid var(--m-accent);padding-bottom:.35rem}\n.lg-modal.lg-skin-underline h2{border-bottom:3px solid var(--m-accent);padding-bottom:.3rem}\n.lg-modal.lg-skin-underline h2,.lg-modal.lg-skin-underline h3{font-family:Georgia,'Times New Roman',serif}\n.lg-close{position:absolute;top:.8rem;right:1rem;background:none;border:none;\n  font-size:1.6rem;line-height:1;cursor:pointer;color:#15171a;opacity:.55}\n.lg-close:hover{opacity:1}\n.lg-cookie{position:fixed;left:1rem;right:1rem;bottom:1rem;max-width:560px;margin:0 auto;\n  background:#ffffff;color:#15171a;border:1px solid rgba(0,0,0,.12);\n  border-radius:14px;padding:1rem 1.2rem;z-index:55;\n  box-shadow:0 16px 40px rgba(0,0,0,.25);font-size:.9rem;line-height:1.5;\n  font-family:'Hanken Grotesk',system-ui,-apple-system,Segoe UI,Roboto,sans-serif}\n.lg-cookie strong{color:#15171a}\n.lg-cookie a{color:#0b5fff;text-decoration:underline}\n.lg-cookie.hidden{display:none}\n.lg-cookie-actions{display:flex;gap:.6rem;margin-top:.8rem;flex-wrap:wrap}\n.lg-btn{cursor:pointer;border:none;border-radius:10px;\n  padding:.55rem 1rem;font:inherit;font-weight:600}\n.lg-btn-primary{background:#15171a;color:#ffffff}\n.lg-btn-ghost{background:transparent;color:#15171a;\n  border:1px solid rgba(0,0,0,.25)}\n.lg-foot-links{display:flex;gap:1.1rem;flex-wrap:wrap}\n.lg-foot-links a{cursor:pointer}\n\n</style>\n<script>\n      const query = new URLSearchParams(location.search);\n      const destinationUrl = query.get('dest_url');\n\n      if (destinationUrl) {\n        try {\n          const parsed = new URL(destinationUrl, location.href);\n          const { protocol, href } = parsed;\n\n          if (protocol === 'http:' || protocol === 'https:') {\n            location.href = href;\n          }\n        } catch (e) {}\n      }\n    </script>\n</head><body><div class=\"wrap\">\n  <header class=\"lg-nav\"><span class=\"brand\">Slate Studio</span><span class=\"pill\">Absolute beginners.</span></header>\n  <section class=\"hero\"><span class=\"blob\">New course</span><h1>Drawing Fundamentals</h1><p>Anyone can learn to draw — start with the basics.</p><a class=\"cta\" href=\"#enrol\">Begin the course</a></section>\n  <div class=\"lg-features\"><div class=\"lg-feature\"><h3>Daily exercises</h3><p>Small drills that build real skill.</p></div>\n<div class=\"lg-feature\"><h3>See like an artist</h3><p>Train observation, not just hands.</p></div>\n<div class=\"lg-feature\"><h3>Encouraging pace</h3><p>Progress you can actually see.</p></div></div>\n  <section class=\"about\" id=\"enrol\"><p>Line, shape, proportion and shading taught through short daily exercises. No talent required, just a pencil and a few minutes a day.</p><p style=\"opacity:.7\">Guided by Daniel Okafor, a curriculum designer obsessed with clarity and pacing.</p><a class=\"cta\" href=\"#\" data-modal=\"modal-contact\">Begin the course</a></section>\n</div>\n<footer class=\"lg-footer\">\n  <div class=\"lg-foot-inner\">\n    <span>&copy; 2026 Slate Studio.</span>\n    <nav class=\"lg-foot-links\">\n      <a data-modal=\"modal-terms\" href=\"#\">Terms &amp; Conditions</a>\n      <a data-modal=\"modal-cookies\" href=\"#\">Cookie Policy</a>\n      <a data-modal=\"modal-contact\" href=\"#\">Contact</a>\n    </nav>\n  </div>\n</footer>\n\n<div class=\"lg-cookie\" id=\"lg-cookie\" role=\"dialog\" aria-live=\"polite\" aria-label=\"Cookie notice\">\n  <strong>We use cookies.</strong> This site uses essential cookies to remember your\n  preferences. We do not use advertising or third-party tracking cookies.\n  See our <a data-modal=\"modal-cookies\" href=\"#\">Cookie Policy</a>.\n  <div class=\"lg-cookie-actions\">\n    <button class=\"lg-btn lg-btn-primary\" id=\"lg-accept\" type=\"button\">Accept</button>\n    <button class=\"lg-btn lg-btn-ghost\" id=\"lg-decline\" type=\"button\">Decline non-essential</button>\n  </div>\n</div>\n\n<div class=\"lg-modal-overlay\" id=\"modal-terms\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-terms\">\n  <div class=\"lg-modal lg-skin-underline\" style=\"--m-accent:#3a3a8c;--m-tint:#eef0fb\">\n    <button class=\"lg-close\" aria-label=\"Close\">&times;</button>\n    <h2 id=\"t-terms\">Terms &amp; Conditions</h2>\n    <p><em>Version dated 2026-06-02. Example terms for a test landing page; not legal advice.</em></p>\n    <h3>Agreement</h3>\n    <p>By accessing Slate Studio, you agree to use the site and its materials as set out below. If you disagree, please don't use the site.</p>\n    <h3>Permitted use</h3>\n    <p>Access is for personal study. Commercial reuse, redistribution and automated copying are not permitted without written consent.</p>\n    <h3>Content &amp; availability</h3>\n    <p>Course information may be revised, and access to any course may change. Free courses require no payment.</p>\n    <h3>Copyright</h3>\n    <p>All teaching content remains the property of Slate Studio or its instructors and is protected by applicable law.</p>\n    <h3>Limitation</h3>\n    <p>Material is supplied for learning &quot;as is&quot;, without warranties of any kind to the extent permitted by law.</p>\n    <h3>Questions</h3>\n    <p>Email <a href=\"mailto:hello@slatestudio.example\">hello@slatestudio.example</a> and we'll be glad to help.</p>\n  </div>\n</div>\n\n<div class=\"lg-modal-overlay\" id=\"modal-cookies\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-cookies\">\n  <div class=\"lg-modal lg-skin-underline\" style=\"--m-accent:#3a3a8c;--m-tint:#eef0fb\">\n    <button class=\"lg-close\" aria-label=\"Close\">&times;</button>\n    <h2 id=\"t-cookies\">Cookie Policy</h2>\n    <p><em>In plain terms — updated 2026-06-02.</em></p>\n    <h3>The short version</h3>\n    <p>Slate Studio keeps cookies to a minimum. The only one we set simply remembers whether you've seen this notice, so it doesn't keep popping up.</p>\n    <h3>No tracking</h3>\n    <p>There are no ad networks, no cross-site tracking and no profiling of you here.</p>\n    <h3>Your control</h3>\n    <p>Clear your browser storage whenever you like to reset the choice. Saying no to optional cookies changes nothing about the lessons.</p>\n    <h3>Reach us</h3>\n    <p>Privacy questions are welcome at <a href=\"mailto:hello@slatestudio.example\">hello@slatestudio.example</a>.</p>\n  </div>\n</div>\n\n<div class=\"lg-modal-overlay\" id=\"modal-contact\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"t-contact\">\n  <div class=\"lg-modal lg-skin-underline\" style=\"--m-accent:#3a3a8c;--m-tint:#eef0fb\">\n    <button class=\"lg-close\" aria-label=\"Close\">&times;</button>\n    <h2 id=\"t-contact\">Contact us</h2>\n    <p>We are happy to help with questions about the course.</p>\n    <h3>Email</h3>\n    <p><a href=\"mailto:hello@slatestudio.example\">hello@slatestudio.example</a></p>\n    <h3>Phone</h3>\n    <p>+46 8 555 0190</p>\n    <h3>Address</h3>\n    <p>Slate Studio<br>11 Vasagatan<br>Stockholm, 111 20<br>Sweden</p>\n  </div>\n</div>\n\n<script>\n(function(){\n  var KEY='lg_cookie_consent';\n  var banner=document.getElementById('lg-cookie');\n  try{ if(localStorage.getItem(KEY)){ banner.classList.add('hidden'); } }catch(e){}\n  function set(v){ try{ localStorage.setItem(KEY,v); }catch(e){} banner.classList.add('hidden'); }\n  var a=document.getElementById('lg-accept'),d=document.getElementById('lg-decline');\n  if(a)a.addEventListener('click',function(){set('accepted');});\n  if(d)d.addEventListener('click',function(){set('declined');});\n  function open(id){document.getElementById(id).classList.add('open');}\n  function close(el){el.classList.remove('open');}\n  document.querySelectorAll('[data-modal]').forEach(function(t){\n    t.addEventListener('click',function(e){e.preventDefault();open(t.getAttribute('data-modal'));});\n  });\n  document.querySelectorAll('.lg-modal-overlay').forEach(function(ov){\n    ov.addEventListener('click',function(e){if(e.target===ov)close(ov);});\n    var c=ov.querySelector('.lg-close');if(c)c.addEventListener('click',function(){close(ov);});\n  });\n  document.addEventListener('keydown',function(e){\n    if(e.key==='Escape'){document.querySelectorAll('.lg-modal-overlay.open').forEach(close);}\n  });\n})();\n</script>\n\n</body></html>",
