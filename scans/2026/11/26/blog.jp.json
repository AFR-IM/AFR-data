      "body": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"utf-8\">\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=Edge\" />\n<meta name=\"referrer\" content=\"always\">\n<meta name=\"referrer\" content=\"unsafe-url\">\n<title>はじめてガイド - ライブドアブログ</title>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0,minimum-scale=1.0,maximum-scale=1.0,user-scalable=0\" />\n<link rel=\"shortcut icon\" href=\"https://parts.blog.livedoor.jp/favicon.ico\" />\n<link rel=\"apple-touch-icon\" href=\"https://parts.blog.livedoor.jp/img/portal/lite/ld_blog.png\" />\n<link rel=\"stylesheet\" href=\"https://parts.blog.livedoor.jp/blog_portal/lite/css/v3/main.css?v=20240325\" />\n<meta property=\"og:site_name\" content=\"livedoor Blog\">\n<meta property=\"og:image\" content=\"https://blog.livedoor.com/blog_portal/pc/img/v3/common/blog_OGP.png\">\n<meta name=\"description\" content=\"ライブドアブログは完全無料で豊富な機能をご利用いただけるブログ作成サービスです。デザインカスタマイズはもちろん、アクセス解析、各SNSとの連携、プライベート機能、独自ドメインなど、充実した機能と使いやすさでみなさまのブログライフを応援します。\">\n<meta property=\"og:description\" content=\"ライブドアブログは完全無料で豊富な機能をご利用いただけるブログ作成サービスです。デザインカスタマイズはもちろん、アクセス解析、各SNSとの連携、プライベート機能、独自ドメインなど、充実した機能と使いやすさでみなさまのブログライフを応援します。\">\n<style>\n#lb-container #lb-header {\n  position: absolute;\n}\n#lb-container #lb-wrapper {\n  margin-bottom: 0;\n}\n#lb-container #lb-footer {\n  margin-top: -100px;\n}\n#lb-container.guide #lb-guide .contents .box .right .ldapp .img img{\n  width: 175px;\n}\n\n@media screen and (min-width:1025px) {\n  #lb-container.guide #lb-guide .contents .box .title {\n    text-align: center;\n  }\n  #lb-container.guide #lb-guide .contents .box .name {\n    text-align: center;\n  }\n  #lb-container.guide #lb-guide .contents .box .right .arrow {\n    text-align: center;\n  }\n  #lb-container.guide #lb-guide .contents .box .right .arrow a::before {\n    content: none;\n  }\n  #lb-container.guide #lb-guide .contents .more.gray {\n    width: 320px;\n    margin: 0 auto;\n  }\n}\n</style>\n</head>\n<body>\n<div id=\"lb-container\" class=\"guide\">\n  <header id=\"lb-header\" >\n    <div class=\"header-inner\">\n      <h1 class=\"logo\"><a href=\"https://blog.livedoor.com/\"><img src=\"https://parts.blog.livedoor.jp/img/common/logo_w.svg\" alt=\"ライブドアブログ\" width=\"307\" height=\"52\"></a> </h1>\n    </div>\n  </header>\n  <section id=\"lb-wrapper\">\n    <div id=\"lb-guide\">\n      <div class=\"guide-title\">\n        <div class=\"pan\"><span><a href=\"https://blog.livedoor.com/\">TOP</a></span> ＞ ライブドアブログとは</div>\n        <span class=\"logo\"><img src=\"https://parts.blog.livedoor.jp/img/common/logo.svg\" alt=\"ライブドアブログ\" width=\"160\" height=\"29\"></span>\n        <div class=\"title-inner\">\n          <h2>読み手にも書き手にも寄り添った<br>ブログサービスを目指し<br>最高のブログ環境をあなたへお届けします。</h2>\n          <span class=\"bg\"><img src=\"https://parts.blog.livedoor.jp/blog_portal/pc/img/v3/guide/h2_bg.svg\" alt=\"\" width=\"439\" height=\"96\"></span>\n        </div>\n        <div class=\"more\"><a href=\"https://blog.livedoor.com/signup/input?utm_source=blogportal_guide\">ブログをはじめる</a></div>\n        <span class=\"bg_1\"><img src=\"https://parts.blog.livedoor.jp/blog_portal/pc/img/v3/guide/parts_01.svg\" alt=\"\" width=\"65\" height=\"59\"></span>\n        <span class=\"bg_2\"><img src=\"https://parts.blog.livedoor.jp/blog_portal/pc/img/v3/guide/parts_02.svg\" alt=\"\" width=\"86\" height=\"77\"></span>\n        <div class=\"contents clearfix\">\n          <div class=\"box clearfix\">\n            <div class=\"right\">\n              <div class=\"inner\">\n                <span class=\"img_1\"><img src=\"https://parts.blog.livedoor.jp/blog_portal/pc/img/v3/guide/icon_01.svg\" alt=\"\" width=\"111\" height=\"111\"></span>\n                <span class=\"img_2\"><img src=\"https://parts.blog.livedoor.jp/blog_portal/pc/img/v3/guide/icon_02.svg\" alt=\"\" width=\"96\" height=\"103\"></span>\n              </div>\n              <ul class=\"list_1\">\n                <li>blog.jp</li>\n                <li>diary.to</li>\n                <li>officialblog.jp</li>\n              </ul>\n              </div>\n              <div class=\"left\">\n                <span class=\"title\">簡単カスタマイズ&<br>自由なドメイン設定</span>\n                <span class=\"name\">管理画面からの簡単な操作だけでオリジナルデザインが作成可能。さらに、手軽にブログURLを変更したい方のために、blog.jp、diary.to、officialblog.jp、などの中からお好きなドメインを選ぶことができます。独自ドメインの設定も無料。</span>\n                <span class=\"name\">自分だけのオリジナルブログを作成しましょう！</span>\n              </div>\n            </div><!-- .box -->\n            <div class=\"box clearfix\">\n                <div class=\"left\">\n                    <div class=\"img_3\">\n                        <span><img src=\"https://parts.blog.livedoor.jp/blog_portal/lite/img/v3/guide/ldapp.png\" alt=\"\" width=\"208\" height=\"392\"></span>\n                    </div>\n                </div>\n                <div class=\"right\">\n                    <span class=\"title\">アプリでブログの<br>更新通知が受け取れる！</span>\n                    <span class=\"name\">お気に入りのブログの更新通知をライブドアアプリで受け取ることができる「新着記事通知」を搭載。<br>また、本アプリでは毎日編集部おすすめ記事を配信しており、あなたのブログが掲載される可能性も！</span>\n                    <div class=\"ldapp\">\n                        <a href=\"https://apps.apple.com/jp/app/%E3%83%A9%E3%82%A4%E3%83%96%E3%83%89%E3%82%A2%E3%83%8B%E3%83%A5%E3%83%BC%E3%82%B9-%E8%A6%81%E7%B4%84%E3%83%8B%E3%83%A5%E3%83%BC%E3%82%B9%E3%82%A2%E3%83%97%E3%83%AA/id1398649461\">\n                            <span class=\"img\"><img src=\"https://parts.blog.livedoor.jp/blog_portal/lite/img/v3/guide/ldapp_ios.png\" alt=\"\" height=\"56\"></span>\n                        </a>\n                        <a href=\"https://play.google.com/store/apps/details?id=com.linecorp.livedoornews\">\n                            <span class=\"img\"><img src=\"https://parts.blog.livedoor.jp/blog_portal/lite/img/v3/guide/ldapp_android.png\" height=\"56\"></span>\n                        </a>\n                    </div>\n                </div>\n            </div><!-- .box -->\n            <div class=\"box clearfix\">\n              <div class=\"right\">\n                <span class=\"img_4\"><img src=\"https://parts.blog.livedoor.jp/blog_portal/pc/img/v3/guide/icon_03.svg\" alt=\"\" width=\"348\" height=\"198\"></span>\n              </div>\n              <div class=\"left\">\n                <span class=\"title\">他社ブログからの<br>お引越しもラクラク！</span>\n                <span class=\"name\">ライブドアブログは主要ブログサービスからの移転に対応しています。かんたん操作で気軽にお引越し！</span>\n                <div class=\"more gray\"><a href=\"https://blog.livedoor.com/guide/move.html\">お引越しガイドはこちら</a></div>\n              </div>\n            </div><!-- .box -->\n            <div class=\"box clearfix\">\n              <div class=\"left\">\n                <span class=\"img_5\"><img src=\"https://parts.blog.livedoor.jp/blog_portal/pc/img/v3/guide/icon_04.svg\" alt=\"\" width=\"273\" height=\"210\"></span>\n              </div>\n              <div class=\"right\">\n                <span class=\"title\">リアルタイムで<br>アクセス数チェック</span>\n                <span class=\"name\">ブログを続ける上で欠かせないアクセス解析機能。閲覧数や訪問数だけでなく、PC・スマートフォンそれぞれのデバイス別の閲覧数をリアルタイムでチェックできるアクセス解析をご利用いただけます。</span>\n                <span class=\"name\">また、Google Analyticsは、コードを設定するだけで簡単に設置可能。アクセス状況が気になる人のための豊富な機能が揃っています。</span>\n              </div>\n            </div><!-- .box -->\n            <div class=\"box clearfix\">\n              <div class=\"right\">\n                <div class=\"download clearfix\">\n                <span class=\"img_6\"><img src=\"https://parts.blog.livedoor.jp/blog_portal/pc/img/v3/guide/iphone_02.png\" alt=\"\" width=\"208\" height=\"392\"></span>\n                <div class=\"download-inner\">\n                  <span class=\"posted-app\"><img src=\"https://parts.blog.livedoor.jp/img/common/logo_posted_app.png\" alt=\"\" width=\"67\" height=\"67\"></span>\n                  <span><a href=\"https://itunes.apple.com/jp/app/id333206790?mt=8\" target=\"_blank\"><img src=\"https://parts.blog.livedoor.jp/blog_portal/pc/img/v3/guide/download_ios.png\" alt=\"App Storeか>らダウンロード\" width=\"152\" height=\"48\"></a></span>\n                  <span><a href=\"https://play.google.com/store/apps/details?id=jp.co.livedoor.android.blog\" target=\"_blank\"><img src=\"https://parts.blog.livedoor.jp/blog_portal/pc/img/v3/guide/download_android.png\" alt=\"Google Playで手に入れよう\" width=\"152\" height=\"48\"></a></span>\n                </div>\n              </div>\n            </div>\n            <div class=\"left\">\n              <span class=\"title\">投稿・アクセス解析・閲覧まで<br>スマートフォンに完全対応</span>\n              <span class=\"name\">記事投稿やコメント確認など、ほとんどの操作をスマートフォンで行えますので、スマートフォンしか持っていない方も安心してご利用いただけます。iPhoneとAndroid向けのアプリを活用すれば、もっと簡単に操作できます。</span>\n            </div>\n          </div><!-- .box -->\n          <div class=\"box clearfix\">\n            <div class=\"left\">\n              <ul class=\"list_2\">\n                <li><img src=\"https://parts.blog.livedoor.jp/blog_portal/pc/img/v3/guide/icon_05.svg\" alt=\"\" width=\"154\" height=\"165\"></li>\n                <li><img src=\"https://parts.blog.livedoor.jp/blog_portal/pc/img/v3/guide/icon_06.svg\" alt=\"\" width=\"154\" height=\"154\"></li>\n                <li><img src=\"https://parts.blog.livedoor.jp/blog_portal/pc/img/v3/guide/icon_07.svg\" alt=\"\" width=\"154\" height=\"154\"></li>\n              </ul>\n            </div>\n            <div class=\"right\">\n              <span class=\"title\">NPO法人や公共団体、<br>教育機関をサポートします</span>\n              <span class=\"name\">NPO、公共団体、教育機関等が運営するブログを対象に、「広告非表示プラン（無料）」をご用意しております。<br>適応条件、審査につきましては以下詳細をご確認ください。</span>\n              <span class=\"arrow\"><a href=\"https://staff.livedoor.blog/archives/51907109.html\">「広告非表示プラン（無料）」新設のお知らせ</a></span>\n            </div>\n          </div><!-- .box -->\n        </div>\n      </div>\n    </div>\n  </section>\n  <footer id=\"lb-footer\" class=\"clearfix\" role=\"contentinfo\">\n    <div class=\"footer-inner\">\n      <div class=\"sitemap\">\n        <ul>\n          <li><a href=\"https://www.livedoor.com\">livedoor</a></li>\n          <li><a href=\"https://www.livedoor.com/rules/\">利用規約</a></li>\n          <li><a href=\"https://blog.livedoor.com/rule/guideline.html\">ガイドライン</a></li>\n          <li><a href=\"https://blog.livedoor.com/sitemap/\">サイトマップ</a></li>\n          <li><a href=\"https://www.livedoor.com/privacy/\">プライバシー</a></li>\n          <li><a href=\"https://support.livedoor.info/hc/ja/categories/9858152348303\">ヘルプ</a></li>\n        </ul>\n      </div>\n      <div class=\"box\"><p class=\"copy\"><small>&copy;&#160;livedoor</small></p></div>\n    </div>\n  </footer>\n</div>\n<link rel=\"preload\" as=\"script\" href=\"https://pdn.adingo.jp/p.js\">\n<link rel=\"preconnect\" href=\"https://sh.adingo.jp\" crossorigin=\"use-credentials\">\n<div class=\"fluct-unit-1000237803\"></div>\n<script type=\"text/javascript\" src=\"https://pdn.adingo.jp/p.js\" async></script>\n<script type=\"text/javascript\">\n  var fluctAdScript = fluctAdScript || {};\n  fluctAdScript.cmd = fluctAdScript.cmd || [];\n  fluctAdScript.cmd.push(function (cmd) {\n    cmd.loadByGroup(\"1000142573\");\n    cmd.display(\".fluct-unit-1000237803\", \"1000237803\");\n  });\n</script>\n</body>\n</html>\n",
