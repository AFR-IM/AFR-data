/li>\r\n                     <li>\r\n                        <a href=\"https://www.kpn.com/service/mobiel/problemen/toestelhulp.htm#/topic/e-mail/handmatig-instellen/device\" target=\"_blank\">\r\n                           E-mail instellen op je mobiele telefoon\r\n                        </a>\r\n                     </li>\r\n                     <li>\r\n                        <a href=\"https://www.kpn.com/service/internet/e-mail/geen-e-mail-ontvangen-of-versturen.htm\" target=\"_blank\">\r\n                           Problemen bij het ontvangen en versturen van e-mail\r\n                        </a>\r\n                     </li>\r\n                     <li>\r\n                        <a href=\"https://freeler.email.kpn.com\" target=\"_blank\">\r\n                           Freeler e-mail instellingen beheren\r\n                        </a>\r\n                     </li>\r\n                  </ul>\r\n                  <ul class=\"links-right\"></ul>\r\n               </div>\r\n            </div>\r\n         </div>\r\n      </div>\r\n   </div>\r\n</body>\r\n</html>",
