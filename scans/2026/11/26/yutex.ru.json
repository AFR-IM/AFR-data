ar(--ytx-blue-dark));\r\n    color: #fff !important;\r\n    font-size: 14px;\r\n    font-weight: 800;\r\n    text-align: center;\r\n    text-decoration: none;\r\n    box-shadow: var(--ytx-glow-blue);\r\n    transition: transform .15s;\r\n}\r\n\r\n.index-page .ytx-plan-order:hover {\r\n    transform: translateY(-1px);\r\n    color: #fff;\r\n}\r\n\r\n.index-page .ytx-plan-featured .ytx-plan-order {\r\n    background: linear-gradient(135deg, var(--ytx-coral), #d93830);\r\n    box-shadow: var(--ytx-glow-coral);\r\n}\r\n\r\n.index-page .ytx-sale-banner {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    gap: 16px 24px;\r\n    margin-bottom: 28px;\r\n    padding: 20px 24px;\r\n    border-radius: var(--ytx-radius);\r\n    background:\r\n        radial-gradient(circle at 0% 50%, rgba(255, 255, 255, .14), transparent 50%),\r\n        linear-gradient(135deg, #1a1412 0%, #4a2010 40%, #1e2844 100%);\r\n    color: #fff;\r\n    border: 1px solid rgba(255, 255, 255, .1);\r\n    box-shadow: var(--ytx-shadow);\r\n}\r\n\r\n.index-page .ytx-sale-banner__left {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    align-items: center;\r\n    gap: 14px 18px;\r\n    flex: 1 1 280px;\r\n}\r\n\r\n.index-page .ytx-sale-banner__badge {\r\n    flex-shrink: 0;\r\n    padding: 6px 12px;\r\n    border-radius: 999px;\r\n    background: linear-gradient(90deg, var(--ytx-gold), #f59e0b);\r\n    color: var(--ytx-dark);\r\n    font-size: 11px;\r\n    font-weight: 800;\r\n    letter-spacing: .06em;\r\n    text-transform: uppercase;\r\n}\r\n\r\n.index-page .ytx-sale-banner__text strong {\r\n    display: block;\r\n    margin-bottom: 4px;\r\n    font-size: clamp(1rem, 2.2vw, 1.2rem);\r\n    line-height: 1.35;\r\n}\r\n\r\n.index-page .ytx-sale-banner__text span {\r\n    display: block;\r\n    font-size: 14px;\r\n    opacity: .9;\r\n    color: #ffd8a8;\r\n}\r\n\r\n.index-page .ytx-sale-banner .ytx-btn--primary {\r\n    flex-shrink: 0;\r\n    white-space: nowrap;\r\n}\r\n\r\n.index-page .ytx-trust__list li.ytx-trust__item--hot {\r\n    padding: 4px 12px;\r\n    border-radius: 999px;\r\n    background: rgba(245, 184, 32, .15);\r\n    border: 1px solid rgba(245, 184, 32, .35);\r\n}\r\n\r\n.index-page .ytx-trust__list li.ytx-trust__item--hot a {\r\n    color: #ffd8a8;\r\n    text-decoration: none;\r\n    font-weight: 800;\r\n}\r\n\r\n.index-page .ytx-trust__list li.ytx-trust__item--hot a:hover {\r\n    color: #fff;\r\n    text-decoration: underline;\r\n}\r\n\r\n.index-page .ytx-hero__urgency {\r\n    margin-top: 14px;\r\n    font-size: 13px;\r\n    font-weight: 700;\r\n    color: var(--ytx-muted);\r\n}\r\n\r\n.index-page .ytx-hero__urgency b {\r\n    color: var(--ytx-red);\r\n}\r\n\r\n.index-page .ytx-pill--forever {\r\n    background: linear-gradient(135deg, #fff8e6, #ffe8b8);\r\n    border-color: rgba(245, 184, 32, .5);\r\n    color: #8a5a00;\r\n}\r\n\r\n.index-page .ytx-plans-head__sub--sale {\r\n    margin-top: 8px;\r\n    font-weight: 700;\r\n    color: var(--ytx-red);\r\n}\r\n\r\n.index-page .dashed { border-bottom: 1px dashed; }\r\n\r\n/* Web Studio featured */\r\n.index-page .index-web-studio-plan {\r\n    grid-column: 1 / -1;\r\n    width: auto !important;\r\n    margin: 8px 0 0 !important;\r\n}\r\n\r\n.index-page .ytx-web-studio {\r\n    display: grid;\r\n    grid-template-columns: 120px 1fr auto;\r\n    gap: 20px;\r\n    align-items: center;\r\n    padding: 24px 28px;\r\n    background:\r\n        linear-gradient(135deg, rgba(253, 198, 59, .12) 0%, transparent 40%),\r\n        linear-gradient(225deg, rgba(125, 154, 226, .15) 0%, transparent 45%),\r\n        linear-gradient(135deg, #fff 0%, #f8fafc 100%);\r\n    border: 1px solid rgba(148, 39, 6, .15);\r\n    border-radius: var(--ytx-radius);\r\n    box-shadow: var(--ytx-shadow);\r\n    position: relative;\r\n    overflow: hidden;\r\n}\r\n\r\n.index-page .ytx-web-studio::after {\r\n    content: \"PRO\";\r\n    position: absolute;\r\n    top: 16