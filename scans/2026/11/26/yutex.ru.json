yle*=\"FDC63B\"],\r\n.index-page .guarantee li:nth-child(2) div.money {\r\n    background: var(--ytx-gold);\r\n}\r\n\r\n.index-page .guarantee li div.money div.ico {\r\n    float: none;\r\n    flex-shrink: 0;\r\n    padding: 0;\r\n}\r\n\r\n.index-page .guarantee li div.money div.ico img { width: 36px; }\r\n\r\n.index-page .guarantee li div.money div.description {\r\n    float: none;\r\n    max-width: none !important;\r\n    padding: 0;\r\n    font-size: 14px;\r\n    line-height: 1.55;\r\n    color: #fff;\r\n}\r\n\r\n.index-page .guarantee li div.money div.description span {\r\n    display: block;\r\n    margin-bottom: 4px;\r\n    font-size: 16px;\r\n    font-weight: 700;\r\n    color: var(--ytx-dark);\r\n}\r\n\r\n/* Protection */\r\n.index-page .protection-items {\r\n    display: grid;\r\n    grid-template-columns: repeat(4, 1fr);\r\n    gap: 20px;\r\n    width: min(800px, 100%) !important;\r\n    margin: 0 auto 24px !important;\r\n}\r\n\r\n.index-page .protection-items .item {\r\n    text-align: center;\r\n    padding: 24px 12px 20px;\r\n    background: var(--ytx-card);\r\n    border: 1px solid var(--ytx-line);\r\n    border-radius: var(--ytx-radius);\r\n    box-shadow: var(--ytx-shadow-sm);\r\n    transition: transform .2s, box-shadow .2s;\r\n}\r\n\r\n@media (hover: hover) and (pointer: fine) {\r\n    .index-page .protection-items .item:hover {\r\n        transform: translateY(-4px);\r\n        box-shadow: var(--ytx-shadow);\r\n    }\r\n}\r\n\r\n.index-page .protection-items .item .square {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    width: 64px;\r\n    height: 64px;\r\n    margin: 0 auto;\r\n    border-radius: 16px;\r\n    font-size: 13px;\r\n    font-weight: 800;\r\n    letter-spacing: .04em;\r\n    color: #fff;\r\n    box-shadow: 0 6px 16px rgba(0, 0, 0, .12);\r\n}\r\n\r\n.index-page .protection-items .item:nth-child(1) .square {\r\n    background: linear-gradient(135deg, #3b82f6, #1d4ed8);\r\n}\r\n\r\n.index-page .protection-items .item:nth-child(2) .square {\r\n    background: linear-gradient(135deg, #ef4444, #b91c1c);\r\n}\r\n\r\n.index-page .protection-items .item:nth-child(3) .square {\r\n    background: linear-gradient(135deg, #8b5cf6, #6d28d9);\r\n}\r\n\r\n.index-page .protection-items .item:nth-child(4) .square {\r\n    background: linear-gradient(135deg, #10b981, #047857);\r\n}\r\n\r\n.index-page .protection-items .item p {\r\n    margin: 8px 0 0;\r\n    font-size: 14px;\r\n    font-weight: 600;\r\n    color: var(--ytx-text);\r\n}\r\n\r\n.index-page .ytx-prose {\r\n    width: min(760px, 100%);\r\n    margin: 0 auto;\r\n    font-size: 16px;\r\n    line-height: 1.65;\r\n    color: var(--ytx-text);\r\n}\r\n\r\n.index-page .ytx-prose ul {\r\n    margin: 12px 0 0;\r\n    padding-left: 22px;\r\n}\r\n\r\n.index-page .ytx-prose li { margin-bottom: 6px; }\r\n\r\n.index-page .hor-line {\r\n    height: 1px;\r\n    margin: 32px auto;\r\n    max-width: var(--ytx-max);\r\n    background: var(--ytx-line);\r\n}\r\n\r\n/* Free shops */\r\n.index-page .ytx-shops {\r\n    display: grid;\r\n    grid-template-columns: 1fr 1.2fr;\r\n    gap: 36px;\r\n    align-items: start;\r\n}\r\n\r\n.index-page .ytx-shops__image img {\r\n    border: 1px solid var(--ytx-line);\r\n    border-radius: var(--ytx-radius-sm);\r\n    box-shadow: var(--ytx-shadow-sm);\r\n}\r\n\r\n.index-page .ytx-shops__content .title-red {\r\n    display: block;\r\n    font-size: 17px;\r\n    font-weight: 700;\r\n    color: var(--ytx-coral);\r\n    line-height: 1.45;\r\n}\r\n\r\n.index-page .ytx-shops__content ul {\r\n    margin: 12px 0 16px;\r\n    padding-left: 22px;\r\n    line-height: 1.65;\r\n}\r\n\r\n.index-page .ytx-shops__content .title-black {\r\n    display: block;\r\n    font-weight: 700;\r\n    color: var(--ytx-dark);\r\n}\r\n\r\n.index-page .ytx-shops__note {\r\n    margin-top: 16px;\r\n    font-size: 15px;\r\n    line-height: 1.55;\r\n    color: var(--ytx-muted);\r\n}\r\n\r\n.index-page .video-wrap {\r\n    position: relative;\r\n    width: min(853px, 100%);\r\n    margin: 0 auto;\r\n    padding-bottom: 56.25%;\r\n    height: 0;\r\n    overflow: hidden;\r\n    border-radius: var(--ytx-radius);\r\n    box-shadow: var(--ytx-shadow);\r\n}\r\n\r\n.index-page .video-wrap iframe {\r\n    position: absolute;\r\n    inset: 0;\r\n    width: 100%;\r\n    height: 100%;\r\n    border: 0;\r\n}\r\n\r\n/* Features grid */\r\n.index-page .ytx-features {\r\n    display: grid;\r\n    grid-template-columns: repeat(3, 1fr);\r\n    gap: 24px;\r\n}\r\n\r\n.index-page .ytx-feature-card {\r\n    text-align: center;\r\n    padding: 28px 22px;\r\n    background: var(--ytx-card);\r\n    border: 1px solid var(--ytx-line);\r\n    border-radius: var(--ytx-radius);\r\n    box-shadow: var(--ytx-shadow-sm);\r\n    transition: transform .2s, box-shadow .2s, border-color .2s;\r\n    position: relative;\r\n    overflow: hidden;\r\n}\r\n\r\n.index-page .ytx-feature-card::before {\r\n    content: \"\";\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    right: 0;\r\n    height: 3px;\r\n    background: linear-gradient(90deg, var(--ytx-blue), var(--ytx-coral));\r\n    opacity: 0;\r\n    transition: opacity .2s;\r\n}\r\n\r\n@media (hover: hover) and (pointer: fine) {\r\n    .index-page .ytx-feature-card:hover {\r\n        transform: translateY(-4px);\r\n        box-shadow: var(--ytx-shadow);\r\n        border-color: rgba(125, 154, 226, .35);\r\n    }\r\n    .index-page .ytx-feature-card:hover::before { opacity: 1; }\r\n}\r\n\r\n.index-page .ytx-feature-card img,\r\n.index-page .ytx-feature-card .ytx-feature-icon {\r\n    display: block;\r\n    margin: 0 auto 16px;\r\n}\r\n\r\n.index-page .ytx-feature-icon {\r\n    width: 116px;\r\n    height: 115px;\r\n    border-top-left-radius: 50%;\r\n    border-bottom-right-radius: 50%;\r\n    background-image: url('i/hdd.png');\r\n    background-size: contain;\r\n    background-repeat: no-repeat;\r\n    background-position: center;\r\n}\r\n\r\n.index-page .y