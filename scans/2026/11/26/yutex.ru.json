      "body": "<!DOCTYPE html>\r\n<html xmlns:og=\"http://ogp.me/ns#\" itemscope itemtype=\"http://schema.org/WebPage\" lang=\"ru\">\r\n<head>\r\n<meta charset=\"windows-1251\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n\r\n<title>Yutex - �������, ��������� ������� � ���������� PHP, MySQL - ���������� ������</title>\r\n\r\n<meta name=\"yandex-verification\" content=\"b58e3927db90da59\" />\r\n<meta name=\"robots\" content=\"index, follow\">\r\n<meta name=\"google\" content=\"notranslate\">\r\n<link href=\"https://yutex.ru//icons/favicon.ico\" rel=\"shortcut icon\" type=\"image/x-icon\" />\r\n\r\n<meta name=\"Description\" content=\"Yutex - �������� ������� ��� ������ ����� � ������� �� ������� � ������� �������� �������� �������. �� ����������� �������� �������� � ������� ������ ��������!������� �������� � ������� ������ ��������!\" />\r\n\r\n<link rel=\"stylesheet\" href=\"style.css?v=128\" type=\"text/css\" />\r\n<link rel=\"stylesheet\" href=\"table.css?v=104\" type=\"text/css\" />\r\n<link rel=\"stylesheet\" href=\"css/bootstrap.css\" type=\"text/css\" />\r\n<link href=\"//fonts.googleapis.com/css?family=PT+Sans:400,700,700italic&subset=latin,cyrillic\" rel=\"stylesheet\" type=\"text/css\" />\r\n<script defer src=\"js/jquery.js\"></script>\r\n<script defer src=\"js/jqueryExtend.js\"></script>\r\n<script defer src=\"js/core.js?v=119\"></script>\r\n<style>\r\n/* ===== Yutex Home � ������ �������� (���� ����) ===== */\r\n.index-page {\r\n    --ytx-red: #8a2204;\r\n    --ytx-coral: #e04a42;\r\n    --ytx-blue: #5b8def;\r\n    --ytx-blue-dark: #3b68d4;\r\n    --ytx-gold: #f5b820;\r\n    --ytx-green: #1d8a4a;\r\n    --ytx-purple: #7c5cff;\r\n    --ytx-dark: #14110f;\r\n    --ytx-text: #2d3748;\r\n    --ytx-muted: #5c6578;\r\n    --ytx-line: #dde3ef;\r\n    --ytx-bg: #eef2f8;\r\n    --ytx-card: #ffffff;\r\n    --ytx-radius: 16px;\r\n    --ytx-radius-sm: 12px;\r\n    --ytx-shadow: 0 14px 40px rgba(20, 17, 15, .1);\r\n    --ytx-shadow-sm: 0 4px 16px rgba(20, 17, 15, .07);\r\n    --ytx-glow-coral: 0 8px 28px rgba(224, 74, 66, .28);\r\n    --ytx-glow-blue: 0 8px 28px rgba(91, 141, 239, .25);\r\n    --ytx-max: 1180px;\r\n    --ytx-font: 'PT Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\r\n    overflow-x: hidden;\r\n    -webkit-text-size-adjust: 100%;\r\n    color: var(--ytx-text);\r\n    font-family: var(--ytx-font);\r\n    background:\r\n        radial-gradient(ellipse 120% 80% at 0% 0%, rgba(224, 74, 66, .07), transparent 50%),\r\n        radial-gradient(ellipse 90% 60% at 100% 5%, rgba(91, 141, 239, .09), transparent 45%),\r\n        linear-gradient(180deg, #f7f9fc 0%, var(--ytx-bg) 100%);\r\n}\r\n\r\n.index-page *,\r\n.index-page *::before,\r\n.index-page *::after { box-sizing: border-box; }\r\n\r\n.index-page a { color: inherit; }\r\n.index-page img { max-width: 100%; height: auto; }\r\n\r\n.index-page .ytx-container {\r\n    width: min(var(--ytx-max), 100%);\r\n    margin: 0 auto;\r\n    padding: 0 20px;\r\n}\r\n\r\n.index-page .ytx-section {\r\n    padding: 56px 0;\r\n}\r\n\r\n.index-page .ytx-section--white { background: var(--ytx-card); }\r\n.index-page .ytx-section--alt { background: var(--ytx-bg); }\r\n\r\n.index-page .ytx-title {\r\n    margin: 0 0 10px;\r\n    text-align: center;\r\n    font-size: clamp(1.5rem, 3vw, 2rem);\r\n    font-weight: 700;\r\n    color: var(--ytx-dark);\r\n    line-height: 1.25;\r\n    position: relative;\r\n}\r\n\r\n.index-page .ytx-title::after {\r\n    content: \"\";\r\n    display: block;\r\n    width: 64px;\r\n    height: 4px;\r\n    margin: 14px auto 0;\r\n    border-radius: 999px;\r\n    background: linear-gradient(90deg, var(--ytx-red), var(--ytx-coral), var(--ytx-gold));\r\n}\r\n\r\n.index-page .ytx-subtitle {\r\n    margin: 0 auto 36px;\r\n    max-width: 720px;\r\n    text-align: center;\r\n    font-size: clamp(1rem, 2vw, 1.2rem);\r\n    font-weight: 600;\r\n    color: var(--ytx-muted);\r\n    line-height: 1.45;\r\n}\r\n\r\n.index-page .ytx-btn {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    gap: 8px;\r\n    min-height: 44px;\r\n    padding: 10px 22px;\r\n    border: none;\r\n    border-radius: var(--ytx-radius-sm);\r\n    font-family: inherit;\r\n    font-size: 15px;\r\n    font-weight: 700;\r\n    text-decoration: none;\r\n    cursor: pointer;\r\n    transition: transform .15s, box-shadow .15s, background .15s;\r\n}\r\n\r\n.index-page .ytx-btn:hover { transform: translateY(-1px); }\r\n\r\n.index-page .ytx-btn--primary {\r\n    background: linear-gradient(135deg, var(--ytx-coral), #d94f48);\r\n    color: #fff;\r\n    box-shadow: 0 4px 14px rgba(226, 97, 90, .35);\r\n}\r\n\r\n.index-page .ytx-btn--outline {\r\n    background: #fff;\r\n    color: var(--ytx-dark);\r\n    border: 2px solid var(--ytx-line);\r\n}\r\n\r\n.index-page .ytx-btn--ghost {\r\n    background: transparent;\r\n    color: var(--ytx-red);\r\n    border: 2px solid rgba(148, 39, 6, .25);\r\n}\r\n\r\n.index-page .ytx-actions { text-align: center; margin-top: 28px; }\r\n\r\n/* Promo bars */\r\n.index-page .promo-bar {\r\n    padding: 12px 20px;\r\n    text-align: center;\r\n    font-size: 14px;\r\n    font-weight: 600;\r\n    cursor: pointer;\r\n    line-height: 1.45;\r\n}\r\n\r\n/* Domain modal */\r\n.index-page .sheet {\r\n    display: none;\r\n    position: fixed;\r\n    inset: 0;\r\n    z-index: 10000;\r\n    background: rgba(15, 23, 42, .6);\r\n    padding: 16px;\r\n    overflow-y: auto;\r\n    backdrop-filter: blur(4px);\r\n}\r\n\r\n.index-page .domain-window {\r\n    width: min(520px, 100%);\r\n    margin: 40px auto;\r\n    padding: 24px;\r\n    background: var(--ytx-card);\r\n    border-radius: var(--ytx-radius);\r\n    box-shadow: var(--ytx-shadow);\r\n}\r\n\r\n.index-page .domain-window .close-btn {\r\n    float: right;\r\n    color: var(--ytx-muted);\r\n    cursor: pointer;\r\n    font-size: 14px;\r\n    font-weight: 600;\r\n}\r\n\r\n.index-page .domain-window input[type=\"text\"] {\r\n    width: 100%;\r\n    margin: 16px 0 12px;\r\n    padding: 12px 14px;\r\n    border: 1px solid var(--ytx-line);\r\n    border-radius: var(--ytx-radius-sm);\r\n    font-size: 16px;\r\n}\r\n\r\n.index-page .domain-window .btn.btn-info { width: 100%; margin-top: 0 !important; }\r\n\r\n/* Top strip � ������ ������� ������ ����� */\r\n.index-page .ytx-topstrip {\r\n    background: linear-gradient(90deg, #1a1412 0%, #3d1f14 40%, #1e2844 100%);\r\n    color: #fff;\r\n    font-size: 12px;\r\n    font-weight: 700;\r\n    border-bottom: 1px solid rgba(255, 255, 255, .08);\r\n}\r\n\r\n.index-page .ytx-topstrip__inner {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    align-items: center;\r\n    justify-content: center;\r\n    gap: 8px 20px;\r\n    padding: 8px 0;\r\n}\r\n\r\n.index-page .ytx-topstrip__item {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n    opacity: .95;\r\n}\r\n\r\n.index-page .ytx-topstrip__item::before {\r\n    content: \"\";\r\n    width: 6px;\r\n    height: 6px;\r\n    border-radius: 50%;\r\n    background: linear-gradient(135deg, var(--ytx-gold), var(--ytx-coral));\r\n    flex-shrink: 0;\r\n}\r\n\r\n.index-page .ytx-topstrip__link {\r\n    color: #ffd8a8;\r\n    text-decoration: none;\r\n    font-weight: 800;\r\n}\r\n\r\n.index-page .ytx-topstrip__link:hover {\r\n    color: #fff;\r\n    text-decoration: underline;\r\n}\r\n\r\n/* Header */\r\n.index-page .ytx-header {\r\n    background:\r\n        radial-gradient(circle at 0% 0%, rgba(224, 74, 66, .06), transparent 45%),\r\n        radial-gradient(circle at 100% 0%, rgba(91, 141, 239, .07), transparent 40%),\r\n        linear-gradient(180deg, #ffffff 0%, #fafbfd 100%);\r\n    border-bottom: 1px solid var(--ytx-line);\r\n    box-shadow: var(--ytx-shadow-sm);\r\n    position: relative;\r\n}\r\n\r\n.index-page .ytx-header::before {\r\n    content: \"\";\r\n    position: absolute;\r\n    inset: 0;\r\n    background-image: radial-gradient(rgba(148, 39, 6, .04) 1px, transparent 1px);\r\n    background-size: 20px 20px;\r\n    pointer-events: none;\r\n    opacity: .6;\r\n}\r\n\r\n.index-page .ytx-header::after {\r\n    content: \"\";\r\n    position: absolute;\r\n    left: 0;\r\n    right: 0;\r\n    bottom: 0;\r\n    height: 3px;\r\n    background: linear-gradient(90deg, var(--ytx-red), var(--ytx-coral), var(--ytx-gold), var(--ytx-blue));\r\n}\r\n\r\n.index-page .ytx-header__inner {\r\n    display: grid;\r\n    grid-template-columns: 190px minmax(320px, 1fr) auto;\r\n    gap: 28px;\r\n    align-items: center;\r\n    padding: 22px 0;\r\n    position: relative;\r\n    z-index: 1;\r\n}\r\n\r\n.index-page .ytx-logo {\r\n    text-align: center;\r\n    text-decoration: none;\r\n    display: block;\r\n}\r\n\r\n.index-page .ytx-logo__mark {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    padding: 6px 10px 5px;\r\n    border-radius: var(--ytx-radius-sm);\r\n    background: linear-gradient(145deg, #fff 0%, #fff8f6 100%);\r\n    border: 1px solid rgba(224, 74, 66, .1);\r\n    box-shadow: 0 4px 14px rgba(20, 17, 15, .06);\r\n}\r\n\r\n.index-page .ytx-logo img {\r\n    display: block;\r\n    width: 140px;\r\n    max-width: 100%;\r\n    height: auto;\r\n}\r\n\r\n.index-page .ytx-slogan {\r\n    display: block;\r\n    margin-top: 10px;\r\n    font-size: 13px;\r\n    line-height: 1.45;\r\n    color: var(--ytx-muted);\r\n}\r\n\r\n.index-page .ytx-slogan b {\r\n    color: var(--ytx-red);\r\n    font-weight: 800;\r\n}\r\n\r\n.index-page .ytx-header-nav {\r\n    width: 100%;\r\n    min-width: 0;\r\n}\r\n\r\n.index-page .ytx-header-nav__panel {\r\n    width: 100%;\r\n    padding: 16px 20px 18px;\r\n    border-radius: var(--ytx-radius);\r\n    background:\r\n        linear-gradient(135deg, rgba(255, 255, 255, .95) 0%, rgba(248, 250, 252, .98) 100%);\r\n    border: 1px solid rgba(224, 74, 66, .12);\r\n    box-shadow: var(--ytx-shadow-sm);\r\n}\r\n\r\n.index-page .ytx-header-nav__title {\r\n    margin-bottom: 12px;\r\n    padding-bottom: 10px;\r\n    border-bottom: 1px solid var(--ytx-line);\r\n    font-size: 12px;\r\n    font-weight: 800;\r\n    letter-spacing: .08em;\r\n    text-transform: uppercase;\r\n    color: var(--ytx-muted);\r\n}\r\n\r\n.index-page .ytx-header-nav__links {\r\n    display: grid;\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n    gap: 8px 14px;\r\n}\r\n\r\n.index-page .ytx-header-nav__links a.big {\r\n    display: flex;\r\n    align-items: center;\r\n    min-height: 44px;\r\n    padding: 10px 14px;\r\n    border-radius: var(--ytx-radius-sm);\r\n    font-size: 16px;\r\n    font-weight: 700;\r\n    line-height: 1.3;\r\n    color: var(--ytx-dark);\r\n    text-decoration: none;\r\n    background: rgba(238, 242, 248, .65);\r\n    border: 1px solid rgba(221, 227, 239, .9);\r\n    transition: background .15s, color .15s, border-color .15s, box-shadow .15s;\r\n}\r\n\r\n.index-page .ytx-header-nav__links a.big:hover {\r\n    color: var(--ytx-red);\r\n    background: #fff;\r\n    border-color: rgba(224, 74, 66, .22);\r\n    box-shadow: var(--ytx-shadow-sm);\r\n}\r\n\r\n.index-page .ytx-header-nav__links a.ytx-header-nav__link--accent {\r\n    grid-column: 1 / -1;\r\n    justify-content: center;\r\n    background: linear-gradient(135deg, rgba(224, 74, 66, .1), rgba(245, 184, 32, .08));\r\n    border-color: rgba(224, 74, 66, .28);\r\n    color: var(--ytx-red);\r\n    font-size: 17px;\r\n    font-weight: 800;\r\n}\r\n\r\n.index-page .ytx-header-nav__links a.ytx-header-nav__link--accent:hover {\r\n    background: linear-gradient(135deg, rgba(224, 74, 66, .16), rgba(245, 184, 32, .12));\r\n    color: #7a1800;\r\n}\r\n\r\n.index-page #vk_like { display: none !important; }\r\n\r\n.index-page .index-mobile-toggle {\r\n    display: none;\r\n    width: 100%;\r\n    max-width: 320px;\r\n    margin: 0 auto 12px;\r\n    padding: 10px 16px;\r\n    border: 2px solid var(--ytx-line);\r\n    border-radius: var(--ytx-radius-sm);\r\n    background: #fff;\r\n    color: var(--ytx-red);\r\n    font-size: 15px;\r\n    font-weight: 700;\r\n    cursor: pointer;\r\n}\r\n\r\n.index-page .index-header-contacts.is-collapsed .index-header-contacts-inner { display: none; }\r\n\r\n.index-page .index-header-contacts-inner {\r\n    text-align: right;\r\n    font-size: 13px;\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: flex-end;\r\n    gap: 12px;\r\n}\r\n\r\n.index-page .ytx-contacts-row {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    justify-content: flex-end;\r\n    gap: 6px 14px;\r\n}\r\n\r\n.index-page .index-header-contacts-inner .red-mini {\r\n    display: inline-block;\r\n    margin: 0;\r\n    color: var(--ytx-red);\r\n    font-weight: 600;\r\n    text-decoration: none;\r\n}\r\n\r\n.index-page .index-header-contacts-inner .red-mini:hover {\r\n    text-decoration: underline;\r\n}\r\n\r\n.index-page .index-header-contacts-inner .devider { display: none; }\r\n\r\n.index-page .ytx-cabinet-btn {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    min-height: 42px;\r\n    padding: 10px 22px;\r\n    border-radius: var(--ytx-radius-sm);\r\n    background: linear-gradient(135deg, var(--ytx-coral), #d94f48);\r\n    color: #fff !important;\r\n    font-size: 15px;\r\n    font-weight: 800;\r\n    text-decoration: none !important;\r\n    box-shadow: 0 4px 14px rgba(226, 97, 90, .35);\r\n    transition: transform .15s, box-shadow .15s;\r\n}\r\n\r\n.index-page .ytx-cabinet-btn:hover {\r\n    transform: translateY(-1px);\r\n    box-shadow: 0 6px 18px rgba(226, 97, 90, .4);\r\n}\r\n\r\n.index-page .ytx-phone-block {\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: flex-end;\r\n    gap: 10px;\r\n    width: 100%;\r\n    max-width: 280px;\r\n}\r\n\r\n.index-page .ytx-phone-main {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 12px;\r\n    padding: 10px 16px;\r\n    border-radius: var(--ytx-radius-sm);\r\n    background: var(--ytx-bg);\r\n    border: 1px solid var(--ytx-line);\r\n    text-decoration: none !important;\r\n    color: var(--ytx-dark) !important;\r\n    transition: border-color .15s, box-shadow .15s;\r\n}\r\n\r\n.index-page .ytx-phone-main:hover {\r\n    border-color: rgba(148, 39, 6, .25);\r\n    box-shadow: var(--ytx-shadow-sm);\r\n}\r\n\r\n.index-page .ytx-phone-main__icon {\r\n    flex-shrink: 0;\r\n    width: 48px;\r\n    height: 48px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    border-radius: 50%;\r\n    background: rgba(148, 39, 6, .08);\r\n    color: var(--ytx-red);\r\n    font-size: 22px;\r\n    line-height: 1;\r\n}\r\n\r\n.index-page .ytx-phone-main__body {\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: flex-start;\r\n    line-height: 1.2;\r\n}\r\n\r\n.index-page .ytx-phone-main__number {\r\n    font-size: 20px;\r\n    font-weight: 800;\r\n    color: var(--ytx-red) !important;\r\n    letter-spacing: -.01em;\r\n}\r\n\r\n.index-page .ytx-phone-main__hint {\r\n    margin-top: 3px;\r\n    font-size: 12px;\r\n    font-weight: 600;\r\n    color: var(--ytx-muted) !important;\r\n}\r\n\r\n.index-page .ytx-messengers {\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: stretch;\r\n    gap: 6px;\r\n    width: 100%;\r\n}\r\n\r\n.index-page .ytx-contact-action {\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    min-height: 36px;\r\n    padding: 8px 14px;\r\n    border-radius: var(--ytx-radius-sm);\r\n    border: 1px solid var(--ytx-line);\r\n    background: #fff;\r\n    color: var(--ytx-dark);\r\n    font-size: 13px;\r\n    font-weight: 700;\r\n    text-decoration: none !important;\r\n    text-align: center;\r\n    transition: background .15s, border-color .15s, color .15s;\r\n}\r\n\r\n.index-page .ytx-contact-action:hover {\r\n    background: var(--ytx-bg);\r\n    border-color: rgba(148, 39, 6, .2);\r\n    color: var(--ytx-red);\r\n}\r\n\r\n.index-page .ytx-contact-action--tg {\r\n    border-color: rgba(42, 171, 238, .35);\r\n    color: #1d8ecf;\r\n}\r\n\r\n.index-page .ytx-contact-action--tg:hover {\r\n    background: #eef9ff;\r\n    border-color: #2aabee;\r\n    color: #1578b0;\r\n}\r\n\r\n.index-page .ytx-contact-action--wa {\r\n    border-color: rgba(37, 211, 102, .35);\r\n    color: #1a9e4b;\r\n}\r\n\r\n.index-page .ytx-contact-action--wa:hover {\r\n    background: #eefdf4;\r\n    border-color: #25d366;\r\n    color: #128c3a;\r\n}\r\n\r\n/* legacy table hidden if present */\r\n.index-page .phone-numbers { display: none; }\r\n\r\n/* Hero */\r\n.index-page .ytx-hero {\r\n    position: relative;\r\n    overflow: hidden;\r\n    padding: 56px 0 44px;\r\n    background:\r\n        radial-gradient(circle at 15% 30%, rgba(224, 74, 66, .22), transparent 42%),\r\n        radial-gradient(circle at 85% 20%, rgba(91, 141, 239, .24), transparent 40%),\r\n        radial-gradient(circle at 50% 100%, rgba(245, 184, 32, .18), transparent 50%),\r\n        linear-gradient(145deg, #fff5f3 0%, #f5f8ff 48%, #eef6ff 100%);\r\n    border-bottom: 1px solid rgba(221, 227, 239, .8);\r\n}\r\n\r\n.index-page .ytx-hero::before {\r\n    content: \"\";\r\n    position: absolute;\r\n    width: 420px;\r\n    height: 420px;\r\n    top: -120px;\r\n    right: -80px;\r\n    border-radius: 50%;\r\n    background: radial-gradient(circle, rgba(91, 141, 239, .18), transparent 70%);\r\n    pointer-events: none;\r\n    animation: ytx-float 8s ease-in-out infinite;\r\n}\r\n\r\n.index-page .ytx-hero::after {\r\n    content: \"\";\r\n    position: absolute;\r\n    width: 320px;\r\n    height: 320px;\r\n    bottom: -100px;\r\n    left: -60px;\r\n    border-radius: 50%;\r\n    background: radial-gradient(circle, rgba(224, 74, 66, .15), transparent 70%);\r\n    pointer-events: none;\r\n    animation: ytx-float 10s ease-in-out infinite reverse;\r\n}\r\n\r\n@keyframes ytx-float {\r\n    0%, 100% { transform: translateY(0); }\r\n    50% { transform: translateY(14px); }\r\n}\r\n\r\n.index-page .ytx-hero__inner {\r\n    position: relative;\r\n    z-index: 1;\r\n    max-width: 820px;\r\n    text-align: center;\r\n}\r\n\r\n.index-page .ytx-hero__eyebrow {\r\n    display: inline-block;\r\n    margin-bottom: 14px;\r\n    padding: 6px 14px;\r\n    border-radius: 999px;\r\n    background: rgba(255, 255, 255, .85);\r\n    border: 1px solid rgba(148, 39, 6, .12);\r\n    font-size: 13px;\r\n    font-weight: 700;\r\n    letter-spacing: .02em;\r\n    color: var(--ytx-red);\r\n    box-shadow: var(--ytx-shadow-sm);\r\n}\r\n\r\n.index-page .ytx-hero__title {\r\n    margin: 0 0 16px;\r\n    font-size: clamp(1.85rem, 4.8vw, 3rem);\r\n    font-weight: 800;\r\n    line-height: 1.12;\r\n    letter-spacing: -.03em;\r\n    background: linear-gradient(135deg, var(--ytx-dark) 20%, var(--ytx-red) 55%, var(--ytx-coral) 100%);\r\n    -webkit-background-clip: text;\r\n    background-clip: text;\r\n    color: transparent;\r\n}\r\n\r\n.index-page .ytx-hero__lead {\r\n    margin: 0 auto 22px;\r\n    max-width: 640px;\r\n    font-size: clamp(1rem, 2vw, 1.15rem);\r\n    line-height: 1.6;\r\n    color: var(--ytx-muted);\r\n}\r\n\r\n.index-page .ytx-hero__pills {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    justify-content: center;\r\n    gap: 8px;\r\n    margin-bottom: 26px;\r\n}\r\n\r\n.index-page .ytx-hero__pills span {\r\n    padding: 8px 16px;\r\n    border-radius: 999px;\r\n    font-size: 13px;\r\n    font-weight: 800;\r\n    box-shadow: var(--ytx-shadow-sm);\r\n    border: 1px solid transparent;\r\n}\r\n\r\n.index-page .ytx-pill--red {\r\n    background: linear-gradient(135deg, #fff, #fff0ee);\r\n    border-color: rgba(224, 74, 66, .25);\r\n    color: var(--ytx-red);\r\n}\r\n\r\n.index-page .ytx-pill--blue {\r\n    background: linear-gradient(135deg, #fff, #eef4ff);\r\n    border-color: rgba(91, 141, 239, .3);\r\n    color: var(--ytx-blue-dark);\r\n}\r\n\r\n.index-page .ytx-pill--gold {\r\n    background: linear-gradient(135deg, #fff, #fff8e6);\r\n    border-color: rgba(245, 184, 32, .35);\r\n    color: #9a6700;\r\n}\r\n\r\n.index-page .ytx-pill--green {\r\n    background: linear-gradient(135deg, #fff, #ecfdf3);\r\n    border-color: rgba(29, 138, 74, .3);\r\n    color: var(--ytx-green);\r\n}\r\n\r\n.index-page .ytx-hero__actions {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    justify-content: center;\r\n    gap: 12px;\r\n}\r\n\r\n/* Trust strip */\r\n.index-page .ytx-trust {\r\n    padding: 16px 0;\r\n    background: linear-gradient(90deg, #1a1412 0%, #2a1814 35%, #1a2238 70%, #14110f 100%);\r\n    color: #fff;\r\n    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .08);\r\n}\r\n\r\n.index-page .ytx-trust__list {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    justify-content: center;\r\n    gap: 8px 28px;\r\n    margin: 0;\r\n    padding: 0;\r\n    list-style: none;\r\n    font-size: 14px;\r\n    font-weight: 600;\r\n}\r\n\r\n.index-page .ytx-trust__list li {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n}\r\n\r\n.index-page .ytx-trust__list li::before {\r\n    content: \"\";\r\n    width: 8px;\r\n    height: 8px;\r\n    border-radius: 50%;\r\n    background: linear-gradient(135deg, var(--ytx-gold), var(--ytx-coral));\r\n    flex-shrink: 0;\r\n}\r\n\r\n/* Scroll reveal */\r\n.index-page .ytx-reveal {\r\n    opacity: 0;\r\n    transform: translateY(22px);\r\n    transition: opacity .6s ease, transform .6s ease;\r\n}\r\n\r\n.index-page .ytx-reveal.is-visible {\r\n    opacity: 1;\r\n    transform: none;\r\n}\r\n\r\n/* Main nav + domain */\r\n.index-page .ytx-main-nav {\r\n    background: rgba(255, 255, 255, .92);\r\n    border-bottom: 1px solid var(--ytx-line);\r\n    position: sticky;\r\n    top: 0;\r\n    z-index: 100;\r\n    backdrop-filter: blur(12px);\r\n    -webkit-backdrop-filter: blur(12px);\r\n}\r\n\r\n.index-page .ytx-main-nav__inner {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    gap: 16px;\r\n    padding: 14px 0;\r\n}\r\n\r\n.index-page .ytx-main-nav__links {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    align-items: center;\r\n    gap: 6px;\r\n}\r\n\r\n.index-page .ytx-main-nav__links a {\r\n    padding: 8px 14px;\r\n    border-radius: 999px;\r\n    font-size: 15px;\r\n    font-weight: 700;\r\n    text-decoration: none;\r\n    color: var(--ytx-dark);\r\n    transition: background .15s, color .15s;\r\n}\r\n\r\n.index-page .ytx-main-nav__links a:hover { background: var(--ytx-bg); }\r\n\r\n.index-page .ytx-main-nav__links a.main-linkS {\r\n    background: linear-gradient(135deg, rgba(224, 74, 66, .14), rgba(245, 184, 32, .12));\r\n    color: var(--ytx-red);\r\n    border: 1px solid rgba(224, 74, 66, .22);\r\n    box-shadow: var(--ytx-shadow-sm);\r\n}\r\n\r\n.index-page .domain-box-checker {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n    flex: 1 1 320px;\r\n    max-width: 440px;\r\n    margin-left: auto;\r\n    padding: 8px;\r\n    border-radius: var(--ytx-radius-sm);\r\n    background: linear-gradient(135deg, rgba(91, 141, 239, .08), rgba(224, 74, 66, .06));\r\n    border: 1px solid rgba(91, 141, 239, .2);\r\n    box-shadow: var(--ytx-shadow-sm);\r\n}\r\n\r\n.index-page .domain-box-checker input[type=\"text\"] {\r\n    flex: 1;\r\n    min-width: 0;\r\n    padding: 10px 14px;\r\n    border: 1px solid var(--ytx-line);\r\n    border-radius: var(--ytx-radius-sm);\r\n    font-size: 15px;\r\n}\r\n\r\n.index-page .domain-box-checker .btn.btn-info {\r\n    flex-shrink: 0;\r\n    margin-top: 0 !important;\r\n    white-space: nowrap;\r\n}\r\n\r\n/* Plans */\r\n.index-page .ytx-plans-wrap {\r\n    padding: 44px 0 52px;\r\n    background:\r\n        radial-gradient(circle at 100% 0%, rgba(91, 141, 239, .06), transparent 35%),\r\n        radial-gradient(circle at 0% 100%, rgba(224, 74, 66, .05), transparent 35%);\r\n}\r\n\r\n.index-page .ytx-plans-head__title {\r\n    margin: 0 0 8px;\r\n    font-size: clamp(1.45rem, 3vw, 1.9rem);\r\n    font-weight: 800;\r\n    background: linear-gradient(135deg, var(--ytx-dark), var(--ytx-red));\r\n    -webkit-background-clip: text;\r\n    background-clip: text;\r\n    color: transparent;\r\n}\r\n\r\n.index-page .ytx-main-nav__links .main-devider { display: none; }\r\n\r\n.index-page .ytx-plans-head__sub {\r\n    margin: 0;\r\n    font-size: 15px;\r\n    color: var(--ytx-muted);\r\n}\r\n\r\n.index-page .h-plans {\r\n    list-style: none;\r\n    margin: 0;\r\n    padding: 0;\r\n    display: grid;\r\n    grid-template-columns: repeat(4, minmax(0, 1fr));\r\n    gap: 16px;\r\n}\r\n\r\n/* floatfix ::before/::after ������ CSS Grid � �������� ������ */\r\n.index-page .h-plans.floatfix::before,\r\n.index-page .h-plans.floatfix::after,\r\n.index-page .guarantee.floatfix::before,\r\n.index-page .guarantee.floatfix::after {\r\n    content: none;\r\n    display: none;\r\n}\r\n\r\n.index-page .h-plans > li {\r\n    margin: 0 !important;\r\n    float: none !important;\r\n    width: auto !important;\r\n    min-width: 0;\r\n    display: flex;\r\n    flex-direction: column;\r\n}\r\n\r\n.index-page .h-plans li div.mainDescription {\r\n    flex: 1;\r\n    display: flex;\r\n    flex-direction: column;\r\n    padding: 22px 20px 18px;\r\n    background: var(--ytx-card);\r\n    border: 1px solid var(--ytx-line);\r\n    border-radius: var(--ytx-radius);\r\n    box-shadow: var(--ytx-shadow-sm);\r\n    transition: transform .2s, box-shadow .2s, border-color .2s;\r\n    position: relative;\r\n    overflow: hidden;\r\n}\r\n\r\n.index-page .h-plans li div.mainDescription::before {\r\n    content: \"\";\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    right: 0;\r\n    height: 4px;\r\n    background: linear-gradient(90deg, var(--ytx-blue), #a5b4fc);\r\n}\r\n\r\n.index-page .h-plans > li:nth-child(2) div.mainDescription::before {\r\n    background: linear-gradient(90deg, #60a5fa, var(--ytx-blue));\r\n}\r\n\r\n.index-page .h-plans > li:nth-child(3) div.mainDescription::before {\r\n    background: linear-gradient(90deg, var(--ytx-gold), #fbbf24);\r\n}\r\n\r\n.index-page .h-plans > li:nth-child(4) div.mainDescription::before {\r\n    background: linear-gradient(90deg, var(--ytx-red), var(--ytx-coral));\r\n}\r\n\r\n.index-page .ytx-plan-featured div.mainDescription {\r\n    border-color: rgba(224, 74, 66, .5);\r\n    box-shadow: var(--ytx-glow-coral);\r\n    transform: scale(1.02);\r\n}\r\n\r\n.index-page .ytx-section--alt {\r\n    background:\r\n        linear-gradient(180deg, rgba(255, 255, 255, .55), rgba(255, 255, 255, 0)),\r\n        var(--ytx-bg);\r\n}\r\n\r\n.index-page .ytx-section--white {\r\n    background: var(--ytx-card);\r\n    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .8);\r\n}\r\n\r\n.index-page .guarantee li div.money {\r\n    background: linear-gradient(135deg, #6b9af0, #4a7fe8);\r\n    box-shadow: var(--ytx-glow-blue);\r\n}\r\n\r\n.index-page .guarantee li div.money[style*=\"FDC63B\"],\r\n.index-page .guarantee li:nth-child(2) div.money {\r\n    background: linear-gradient(135deg, #ffd055, #f5b820);\r\n    box-shadow: 0 8px 28px rgba(245, 184, 32, .35);\r\n}\r\n\r\n.index-page .ytx-feature-card::before {\r\n    opacity: 1;\r\n    height: 4px;\r\n}\r\n\r\n.index-page .ytx-stat {\r\n    transition: transform .2s, box-shadow .2s;\r\n}\r\n\r\n@media (hover: hover) and (pointer: fine) {\r\n    .index-page .ytx-stat:hover {\r\n        transform: translateY(-4px);\r\n        box-shadow: var(--ytx-shadow);\r\n    }\r\n}\r\n\r\n.index-page .ytx-cabinet-btn {\r\n    background: linear-gradient(135deg, #f2554d, #d93830, #c42820);\r\n    box-shadow: var(--ytx-glow-coral);\r\n}\r\n\r\n.index-page .ytx-phone-main {\r\n    background: linear-gradient(135deg, #fff, #fff8f6);\r\n    border-color: rgba(224, 74, 66, .2);\r\n}\r\n\r\n.index-page .ytx-phone-main__icon {\r\n    background: linear-gradient(135deg, rgba(224, 74, 66, .15), rgba(245, 184, 32, .12));\r\n}\r\n\r\n.index-page .promo-bar {\r\n    font-weight: 700;\r\n    letter-spacing: .01em;\r\n}\r\n\r\n.index-page #specialOffer {\r\n    background: linear-gradient(90deg, #fff3e8, #ffe8dc) !important;\r\n    color: var(--ytx-red) !important;\r\n}\r\n\r\n.index-page #yandexSearch {\r\n    background: linear-gradient(90deg, #eef4ff, #e8f0ff) !important;\r\n    color: var(--ytx-blue-dark) !important;\r\n}\r\n\r\n.index-page .ytx-gradient-text {\r\n    background: linear-gradient(135deg, var(--ytx-dark), var(--ytx-red), var(--ytx-coral));\r\n    -webkit-background-clip: text;\r\n    background-clip: text;\r\n    color: transparent;\r\n}\r\n\r\n.index-page .ytx-plans-head {\r\n    text-align: center;\r\n    margin-bottom: 28px;\r\n}\r\n\r\n.index-page .ytx-plan-featured div.mainDescription::before {\r\n    height: 5px;\r\n    background: linear-gradient(90deg, var(--ytx-red), var(--ytx-coral), var(--ytx-gold));\r\n}\r\n\r\n.index-page .ytx-plan-badge {\r\n    position: absolute;\r\n    top: 12px;\r\n    left: 50%;\r\n    right: auto;\r\n    transform: translateX(-50%);\r\n    padding: 4px 10px;\r\n    border-radius: 999px;\r\n    background: linear-gradient(135deg, var(--ytx-coral), #d94f48);\r\n    color: #fff;\r\n    font-size: 10px;\r\n    font-weight: 800;\r\n    letter-spacing: .04em;\r\n    text-transform: uppercase;\r\n    white-space: nowrap;\r\n    box-shadow: 0 2px 8px rgba(226, 97, 90, .4);\r\n    z-index: 1;\r\n}\r\n\r\n.index-page .ytx-plan-featured .plan-title {\r\n    padding-top: 22px;\r\n}\r\n\r\n.index-page .h-plans li div.mainDescription:hover {\r\n    transform: translateY(-3px);\r\n    box-shadow: var(--ytx-shadow);\r\n}\r\n\r\n.index-page .h-plans li span.plan-title {\r\n    margin: 0 0 14px;\r\n    padding: 0;\r\n    font-size: 1.35rem;\r\n    font-weight: 700;\r\n    text-align: center;\r\n    color: var(--ytx-dark);\r\n}\r\n\r\n.index-page .h-plans li div.features {\r\n    flex: 1;\r\n    padding: 0;\r\n    font-size: 15px;\r\n    line-height: 1.7;\r\n}\r\n\r\n.index-page .h-plans li span.feature {\r\n    display: block;\r\n    padding-left: 22px;\r\n    margin-bottom: 4px;\r\n    background-image: url(i/favourite15.png);\r\n    background-repeat: no-repeat;\r\n    background-position: left 6px;\r\n    background-size: 11px;\r\n}\r\n\r\n.index-page .h-plans li span.feature.purple-star {\r\n    background-image: url(i/favourite15-purple.png);\r\n}\r\n\r\n.index-page .h-plans li div.price {\r\n    position: relative;\r\n    display: block;\r\n    width: 100%;\r\n    margin-top: 16px;\r\n    padding: 14px 0 0;\r\n    border-top: 1px solid var(--ytx-line);\r\n    border-right: none;\r\n    font-size: 17px;\r\n    font-weight: 700;\r\n    color: var(--ytx-dark);\r\n}\r\n\r\n.index-page .h-plans li div.price a {\r\n    position: static;\r\n    display: inline-block;\r\n    margin-top: 8px;\r\n    width: auto;\r\n    left: auto;\r\n    top: auto;\r\n    font-size: 14px;\r\n    font-weight: 600;\r\n    color: var(--ytx-blue-dark);\r\n    text-decoration: none;\r\n    border-bottom: 1px solid rgba(90, 127, 212, .4);\r\n}\r\n\r\n.index-page .index-plan-note {\r\n    position: static;\r\n    display: block;\r\n    width: auto;\r\n    left: auto;\r\n    margin-top: 8px;\r\n    font-size: 12px;\r\n    font-weight: 600;\r\n    color: #cf5151;\r\n}\r\n\r\n.index-page .h-plans li div.unlimited-time {\r\n    margin-top: 12px;\r\n    padding: 14px 14px 12px;\r\n    background:\r\n        radial-gradient(circle at 100% 0%, rgba(245, 184, 32, .22), transparent 55%),\r\n        linear-gradient(135deg, #fff8ed 0%, #fff3dc 100%);\r\n    border: 1px solid rgba(245, 184, 32, .45);\r\n    border-radius: var(--ytx-radius-sm);\r\n    font-size: 12px;\r\n    line-height: 1.45;\r\n    color: #5c3d00;\r\n    text-align: center;\r\n    box-shadow: 0 6px 18px rgba(245, 184, 32, .18);\r\n}\r\n\r\n.index-page .ytx-forever-offer__badge {\r\n    display: inline-block;\r\n    margin-bottom: 6px;\r\n    padding: 3px 10px;\r\n    border-radius: 999px;\r\n    background: linear-gradient(90deg, var(--ytx-red