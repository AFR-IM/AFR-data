ter;\r\n    border-radius: var(--ytx-radius);\r\n    background:\r\n        radial-gradient(circle at 20% 30%, rgba(255, 255, 255, .16), transparent 45%),\r\n        radial-gradient(circle at 80% 70%, rgba(245, 184, 32, .25), transparent 40%),\r\n        linear-gradient(135deg, #9a2204 0%, #d93830 45%, #e04a42 100%);\r\n    color: #fff;\r\n    box-shadow: var(--ytx-glow-coral);\r\n    border: 1px solid rgba(255, 255, 255, .12);\r\n}\r\n\r\n.index-page .ytx-unlimited-hero__badge {\r\n    display: inline-block;\r\n    margin-bottom: 10px;\r\n    padding: 5px 14px;\r\n    border-radius: 999px;\r\n    background: rgba(255, 255, 255, .18);\r\n    border: 1px solid rgba(255, 255, 255, .25);\r\n    font-size: 11px;\r\n    font-weight: 800;\r\n    letter-spacing: .1em;\r\n    text-transform: uppercase;\r\n}\r\n\r\n.index-page .ytx-unlimited-hero h3 {\r\n    margin: 0 0 10px;\r\n    font-size: clamp(1.35rem, 3vw, 1.85rem);\r\n    font-weight: 800;\r\n    line-height: 1.2;\r\n}\r\n\r\n.index-page .ytx-unlimited-hero p {\r\n    margin: 0 auto 18px;\r\n    max-width: 620px;\r\n    font-size: 15px;\r\n    line-height: 1.55;\r\n    opacity: .95;\r\n}\r\n\r\n.index-page .ytx-unlimited-prices {\r\n    display: grid;\r\n    grid-template-columns: repeat(4, 1fr);\r\n    gap: 12px;\r\n    margin-bottom: 24px;\r\n}\r\n\r\n.index-page .ytx-unlimited-price {\r\n    padding: 16px 12px;\r\n    text-align: center;\r\n    border-radius: var(--ytx-radius-sm);\r\n    background: var(--ytx-card);\r\n    border: 1px solid var(--ytx-line);\r\n    box-shadow: var(--ytx-shadow-sm);\r\n    transition: transform .2s, box-shadow .2s, border-color .2s;\r\n}\r\n\r\n.index-page .ytx-unlimited-price:hover {\r\n    transform: translateY(-3px);\r\n    box-shadow: var(--ytx-shadow);\r\n    border-color: rgba(245, 184, 32, .45);\r\n}\r\n\r\n.index-page .ytx-unlimited-price--hot {\r\n    border-color: rgba(224, 74, 66, .45);\r\n    box-shadow: var(--ytx-glow-coral);\r\n}\r\n\r\n.index-page .ytx-unlimited-price