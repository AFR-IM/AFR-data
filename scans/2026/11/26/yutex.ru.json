l?article=82\" class=\"classic-blue\">��� ����� � ���� ������ ����� 10 ���?</a>\r\n            <a target=\"_blank\" href=\"knowledgebase.html?article=83\" class=\"classic-blue\">����� �� ����� ������ �� �������� �����?</a>\r\n        </div>\r\n    </div>\r\n    </div>\r\n</div>\r\n</section>\r\n</main>\r\n\r\n<script>\r\n(function () {\r\n    window.ytxHideSheet = function () {\r\n        var s = document.querySelector('.index-page .sheet');\r\n        if (s) s.style.display = 'none';\r\n    };\r\n    window.ytxShowSheet = function () {\r\n        var s = document.querySelector('.index-page .sheet');\r\n        if (s) s.style.display = 'block';\r\n    };\r\n\r\n    function els() {\n        return {\n            widget: document.getElementById('ytxMsgWidget'),\n            btn: document.getElementById('ytxMsgBtn'),\n            panel: document.getElementById('ytxMsgPanel')\n        };\n    }\n\n    function setOpen(open) {\n        var e = els();\n        if (!e.widget || !e.btn || !e.panel) return;\n        if (open) {\n            e.widget.classList.add('is-open');\n            e.panel.removeAttribute('hidden');\n            e.btn.setAttribute('aria-expanded', 'true');\n        } else {\n            e.widget.classList.remove('is-open');\n            e.panel.setAttribute('hidden', 'hidden');\n            e.btn.setAttribute('aria-expanded', 'false');\n        }\n    }\n\n    window.ytxOpenChat = function () { setOpen(true); };\n    window.ytxCloseChat = function () { setOpen(false); };\n    window.ytxToggleChat = function () {\n        var e = els();\n        setOpen(!(e.widget && e.widget.classList.contains('is-open')));\n    };\n\n    function bindWidget() {\n        var e = els();\n        if (!e.btn || e.btn.getAttribute('data-bound') === '1') return;\n        e.btn.setAttribute('data-bound', '1');\n        e.btn.addEventListener('click', function (ev) {\n            ev.stopPropagation();\n            window.ytxToggleChat();\n        });\n        document.addEventListener('click', function (ev) {\n            var w = els().widget;\n            if (w && !w.contains(ev.target)) setOpen(false);\n        });\n        document.addEventListener('keydown', function (ev) {\n            if (ev.key === 'Escape') setOpen(false);\n        });\n    }\n    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindWidget);\n    else bindWidget();\r\n\r\n    window.Tawk_API = window.Tawk_API || {};\r\n    window.Tawk_API.toggle = function () { window.ytxToggleChat(); };\r\n    window.Tawk_API.maximize = function () { window.ytxOpenChat(); };\r\n    window.Tawk_API.minimize = function () { window.ytxCloseChat(); };\r\n\r\n    if (location.hash === '#open-chat') {\r\n        window.addEventListener('load', function () { setTimeout(window.ytxOpenChat, 200); });\r\n    }\r\n})();\r\n</script>\r\n\r\n<div class=\"centered\" style=\"margin-top:20px;\">\r\n    <div class=\"footer\">\r\n        <table>\r\n            <tr>\r\n                <td>\r\n                    Yutex, 2005 - 2026 (�������� �����) <br />\r\n                    �������� ����� ��� ������ �����.\r\n                </td>\r\n                <td style=\"padding-left:50px;\">\r\n                    info@yutex.ru <br />\r\n                    support@yutex.ru\r\n                </td>\r\n                <td style=\"padding-left:50px;\">\r\n                    <a href=\"javascript:void(ytxOpenChat())\" class=\"big\">OnLine ���</a> <br />\r\n                    +7 3412 644220\r\n                </td>\r\n                <td style=\"padding-left:50px;\">\r\n                    �� ��������� � ������: <br />\r\n                    <img src=\"i/visa.png\" style=\"margin-left:5px;\" title=\"Visa\" alt=\"Visa\" />\r\n                    <img src=\"i/mc.png\" style=\"margin-left:5px;\" title=\"MasterCard\" alt=\"MasterCard\" />\r\n                    <img src=\"i/webmoney.png\" style=\"margin-left:5px;\" title=\"Webmoney\" alt=\"Webmoney\" />\r\n                    <img src=\"i/yandex.png\" style=\"margin-left:5px;\" title=\"������ ������\" alt=\"������\" />\r\n                    <img src=\"i/sberbank.png\" style=\"margin-left:5px;\" title=\"��������\" alt=\"��������\" />\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n</div>\r\n\r\n<script>\r\n  (function () {\r\n    function syncContactsPanel() {\r\n      var panel = document.querySelector('.index-header-contacts');\r\n      if (!panel) return;\r\n      if (window.innerWidth <= 768) panel.classList.add('is-collapsed');\r\n      else panel.classList.remove('is-collapsed');\r\n    }\r\n    syncContactsPanel();\r\n    window.addEventListener('resize', syncContactsPanel);\r\n  })();\r\n  (function () {\r\n    var els = document.querySelectorAll('.index-page .ytx-reveal');\r\n    if (!('IntersectionObserver' in window)) {\r\n      for (var i = 0; i < els.length; i++) els[i].classList.add('is-visible');\r\n      return;\r\n    }\r\n    var io = new IntersectionObserver(function (entries) {\r\n      entries.forEach(function (e) {\r\n        if (e.isIntersecting) {\r\n          e.target.classList.add('is-visible');\r\n          io.unobserve(e.target);\r\n        }\r\n      });\r\n    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });\r\n    for (var j = 0; j < els.length; j++) io.observe(els[j]);\r\n  })();\r\n</script>\r\n\r\n<div class=\"ytx-msg-widget\" id=\"ytxMsgWidget\">\r\n    <div class=\"ytx-msg-widget__panel\" id=\"ytxMsgPanel\" hidden>\r\n        <div class=\"ytx-msg-widget__head\">&#1053;&#1072;&#1087;&#1080;&#1096;&#1080;&#1090;&#1077; &#1085;&#1072;&#1084;</div>\r\n        <a class=\"ytx-msg-widget__item\" href=\"https://max.ru/u/f9LHodD0cOI6p9_Ns1TDicBZxnpBmG988x4RxD-ZqGSIzAGFo6lAsV_mnoM\" target=\"_blank\" rel=\"noopener noreferrer\">\r\n            <span class=\"ytx-msg-widget__icon ytx-msg-widget__icon--max\" aria-hidden=\"true\">\r\n                <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4.5 7.2c0-1.5 1.2-