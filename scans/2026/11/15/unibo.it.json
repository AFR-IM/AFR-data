label for=\"form-widgets-sender_fullname\" class=\"horizontal\">\n        Inserisci il tuo nome\n\n        \n\n        \n    </label>\n\n    <div class=\"fieldErrorBox\"></div>\n\n    \n    <input id=\"form-widgets-sender_fullname\" name=\"form.widgets.sender_fullname\" class=\"text-widget textline-field\" value=\"\" type=\"text\" />\n\n\n</div>\n\n                                          \n                                      \n                                  \n                                  \n                                      \n                                          \n                                              <div data-fieldname=\"form.widgets.sender_from_address\" class=\"field z3cformInlineValidation kssattr-fieldname-form.widgets.sender_from_address empty\" id=\"formfield-form-widgets-sender_from_address\">\n    <label for=\"form-widgets-sender_from_address\" class=\"horizontal\">\n        Indica la tua e-mail\n\n        \n\n        \n    </label>\n\n    <div class=\"fieldErrorBox\"></div>\n\n    \n    <input id=\"form-widgets-sender_from_address\" name=\"form.widgets.sender_from_address\" class=\"text-widget textline-field\" value=\"\" type=\"text\" />\n\n\n</div>\n\n                                          \n                                      \n                                  \n                                  \n                                      \n                                          \n                                              <div data-fieldname=\"form.widgets.message\" class=\"field z3cformInlineValidation kssattr-fieldname-form.widgets.message empty\" id=\"formfield-form-widgets-message\">\n    <label for=\"form-widgets-message\" class=\"horizontal\">\n        Vuoi aggiungere una nota per descrivere l'errore?\n\n        \n\n        \n    </label>\n\n    <div class=\"fieldErrorBox\"></div>\n\n    \n<textarea id=\"form-widgets-message\" name=\"form.widgets.message\" class=\"textarea-widget text-field\"></textarea>\n\n\n</div>\n\n                                          \n                                      \n                                  \n                                  \n                                      \n                                          \n                                              <div data-fieldname=\"form.widgets.captcha\" class=\"field z3cformInlineValidation kssattr-fieldname-form.widgets.captcha empty\" id=\"formfield-form-widgets-captcha\">\n    <label for=\"form-widgets-captcha\" class=\"horizontal\">\n        Captcha\n\n        \n\n        \n    </label>\n\n    <div class=\"fieldErrorBox\"></div>\n\n    \n<script src=\"https://js.hcaptcha.com/1/api.js\" async=\"async\" defer=\"defer\"></script>\n<div class=\"h-captcha\" data-sitekey=\"bd4eaf3e-b592-4e2c-86da-c0bc3064366a\" data-lang=\"it\"></div>\n\n</div>\n\n                                          \n                                      \n                                  \n                              \n                                      \n\n                              </fieldset>\n                          \n\n                      \n                    \n\n                    \n                        \n                            <div class=\"formControls\">\n                                \n                                    \n<input id=\"form-buttons-send\" name=\"form.buttons.send\" class=\"submit-widget button-field\" value=\"Invia\" type=\"submit\" />\n\n\n                                \n                            </div>\n                        \n                    \n\n                    \n                    \n\n                </form>\n            \n            </div>\n        </div>\n    \n            </div>\n            \n        \n        \n        <footer class=\"bottom-footer\">\n            <div class=\"site-info\">\n               <p>\n                ©Copyright 2026 - ALMA MATER STUDIORUM - Università di Bologna - Via Zamboni, 33 - 40126 Bologna - PI: 01131710376 - CF: 80007010376 -\n                    <a href=\"https://www.unibo.it/it/ateneo/privacy-e-note-legali/privacy/informative-sul-trattamento-dei-dati-personali\" target=\"_blank\" rel=\"noopener\">Privacy</a>\n                    e\n                    <a href=\"https://www.unibo.it/it/ateneo/privacy-e-note-legali/note-legali\" tpi:=\"\" cf:=\"\" rel=\"noopener\">Note legali</a>\n                </p>\n            </div>\n            <div class=\"reset-float\"></div>\n        </footer>\n    \n    </div>\n</div>\n<script src=\"https://www.unibo.it/++resource++unibo.cookiebanner/unibo-cookies.min.js?v=20\"></script></body>\n</html>",
