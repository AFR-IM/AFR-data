      "body": "<!DOCTYPE html>\n<html xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"it\" xml:lang=\"it\">\n<head><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n        <title>Impossibile trovare la pagina richiesta</title>\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\n        <meta content=\"noindex, nofollow\" name=\"robots\" />\n        <link type=\"text/css\" rel=\"stylesheet\" href=\"https://www.unibo.it/++theme++unibo.errorpages/css/errorpage.css\" />\n        <script type=\"text/javascript\" src=\"https://www.unibo.it/++theme++unibo.errorpages/js/jquery.js\"></script>\n        <script type=\"text/javascript\" src=\"https://www.unibo.it/++theme++unibo.errorpages/js/modernizr.js\"></script>\n        <script type=\"text/javascript\" src=\"https://www.unibo.it/++theme++unibo.errorpages/js/similar.js\"></script>\n\n</head>\n<body class=\"template-default_error_message\">\n<div id=\"u-content-foremost\" class=\"container-bordered errorpage\">\n    \n        <a class=\"logo\" href=\"https://www.unibo.it\">\n            <img src=\"https://www.unibo.it/++theme++unibo.errorpages/img/logo.png\" alt=\"Logo dell'Università di Bologna - link alla home page del Portale\" class=\"logo\" />\n        </a>\n    \n    <div id=\"u-content-core\" class=\"content-core\">\n        <!-- 404 -->\n        \n            \n            <div>\n                <h1 class=\"documentFirstHeading\">Impossibile trovare la pagina richiesta</h1>\n\n                <p>\n                    <a href=\"https://www.unibo.it\">Home </a>\n                    &gt; <span>Pagina non trovata</span>\n                </p>\n\n                <div>\n                    <span>Ci dispiace ma la pagina che stai cercando non è stata trovata:</span>\n                    <span>https://www.unibo.it/llms.txt</span>\n                    <ul>\n                        <li>Potresti aver digitato male l'indirizzo della pagina.</li>\n                        <li>La pagina da cui provieni potrebbe contenere un link errato o non più valido.</li>\n                    </ul>\n                </div>\n\n                <div id=\"u-notfound-similar\" style=\"display:none\">\n                    <h2>Forse stavi cercando...</h2>\n                    <dl></dl>\n\n                    \n                </div>\n                \n        <div class=\"errorform\">\n            <h2>Se vuoi segnalare l'errore scrivi al supporto tecnico</h2>\n\n            \n\n            <div>\n                \n\n                \n\n                \n\n                \n                  \n                \n\n                <form class=\"rowlike enableUnloadProtection enableFormTabbing  kssattr-formname-index.html\" action=\"https://www.unibo.it/llms.txt\" method=\"post\" id=\"form\" enctype=\"multipart/form-data\">\n\n                    \n\n                    \n                      \n\n                      <!-- Default fieldset -->\n                      \n\n                          \n\n                              \n\n                              \n                              \n                          \n\n                          <!-- Secondary fieldsets -->\n                          \n                              <fieldset data-fieldset=\"contactfieldset\" id=\"fieldset-contactfieldset\" class=\"kssattr-fieldset-contactfieldset\">\n\n                                      <legend id=\"fieldsetlegend-contactfieldset\">Riempi questo form per contattare il supporto</legend>\n\n                                      \n\n\n                                      \n                                          \n                                  \n                                      \n                                          \n                                              <div data-fieldname=\"form.widgets.sender_fullname\" class=\"field z3cformInlineValidation kssattr-fieldname-form.widgets.sender_fullname empty\" id=\"formfield-form-widgets-sender_fullname\">\n    <label for=\"form-widgets-sender_fullname\" class=\"horizontal\">\n        Inserisci il tuo nome\n\n        \n\n        \n    </label>\n\n    <div class=\"fieldErrorBox\"></div>\n\n    \n    <input id=\"form-widgets-sender_fullname\" name=\"form.widgets.sender_fullname\" class=\"text-widget textline-field\" value=\"\" type=\"text\" />\n\n\n</div>\n\n                                          \n                                      \n                                  \n                                  \n                                      \n                                          \n                                              <div data-fieldname=\"form.widgets.sender_from_address\" class=\"field z3cformInlineValidation kssattr-fieldname-form.widgets.sender_from_address empty\" id=\"formfield-form-widgets-sender_from_address\">\n    <label for=\"form-widgets-sender_from_address\" class=\"horizontal\">\n        Indica la tua e-mail\n\n        \n\n        \n    </label>\n\n    <div class=\"fieldErrorBox\"></div>\n\n    \n    <input id=\"form-widgets-sender_from_address\" name=\"form.widgets.sender_from_address\" class=\"text-widget textline-field\" value=\"\" type=\"text\" />\n\n\n</div>\n\n                                          \n                                      \n                                  \n                                  \n                                      \n                                          \n                                              <div data-fieldname=\"form.widgets.message\" class=\"field z3cformInlineValidation kssattr-fieldname-form.widgets.message empty\" id=\"formfield-form-widgets-message\">\n    <label for=\"form-widgets-message\" class=\"horizontal\">\n        Vuoi aggiungere una nota per descrivere l'errore?\n\n        \n\n        \n    </label>\n\n    <div class=\"fieldErrorBox\"></div>\n\n    \n<textarea id=\"form-widgets-message\" name=\"form.widgets.message\" class=\"textarea-widget text-field\"></textarea>\n\n\n</div>\n\n                                          \n                                      \n                                  \n                                  \n                                      \n                                          \n                                              <div data-fieldname=\"form.widgets.captcha\" class=\"field z3cformInlineValidation kssattr-fieldname-form.widgets.captcha empty\" id=\"formfield-form-widgets-captcha\">\n    <label for=\"form-widgets-captcha\" class=\"horizontal\">\n        Captcha\n\n        \n\n        \n    </label>\n\n    <div class=\"fieldErrorBox\"></div>\n\n    \n<script src=\"https://js.hcaptcha.com/1/api.js\" async=\"async\" defer=\"defer\"></script>\n<div class=\"h-captcha\" data-sitekey=\"bd4eaf3e-b592-4e2c-86da-c0bc3064366a\" data-lang=\"it\"></div>\n\n</div>\n\n                                          \n                                      \n                                  \n                              \n                                      \n\n                              </fieldset>\n                          \n\n                      \n                    \n\n                    \n                        \n                            <div class=\"formControls\">\n                                \n                                    \n<input id=\"form-buttons-send\" name=\"form.buttons.send\" class=\"submit-widget button-field\" value=\"Invia\" type=\"submit\" />\n\n\n                                \n                            </div>\n                        \n                    \n\n                    \n                    \n\n                </form>\n            \n            </div>\n        </div>\n    \n            </div>\n            \n        \n        \n        <footer class=\"bottom-footer\">\n            <div class=\"site-info\">\n               <p>\n                ©Copyright 2026 - ALMA MATER STUDIORUM - Università di Bologna - Via Zamboni, 33 - 40126 Bologna - PI: 0113