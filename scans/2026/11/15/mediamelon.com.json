    "homepage": {
      "status": 200,
      "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>MediaMelon | Real-time analytics for streaming video</title>\n<meta name=\"description\" content=\"See every viewing session in real time, find the cause of playback and ad problems in your logs, and run it as a service or in your own cloud. Trusted by Warner Bros. Discovery.\">\n<link rel=\"canonical\" href=\"https://mediamelon.com/\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:site_name\" content=\"MediaMelon\">\n<meta property=\"og:title\" content=\"MediaMelon | Real-time analytics for streaming video\">\n<meta property=\"og:description\" content=\"See every viewing session in real time, find the cause of playback and ad problems in your logs, and run it as a service or in your own cloud. Trusted by Warner Bros. Discovery.\">\n<meta property=\"og:url\" content=\"https://mediamelon.com/\">\n<meta property=\"og:image\" content=\"https://mediamelon.com/assets/og-default.png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"theme-color\" content=\"#0A1830\">\n<link rel=\"icon\" href=\"/favicon.ico\" sizes=\"any\">\n<link rel=\"icon\" type=\"image/png\" href=\"/assets/favicon-32.png\">\n<link rel=\"apple-touch-icon\" href=\"/assets/apple-touch-icon.png\">\n<link rel=\"preload\" href=\"/assets/fonts/roboto-latin-700-normal.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n<link rel=\"preload\" href=\"/assets/fonts/roboto-latin-400-normal.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n<link rel=\"stylesheet\" href=\"/assets/site.css\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Organization\", \"name\": \"MediaMelon\", \"legalName\": \"MediaMelon, Inc.\", \"url\": \"https://mediamelon.com\", \"logo\": \"https://mediamelon.com/assets/logos/mediamelon-logo.png\", \"foundingDate\": \"2012\", \"address\": {\"@type\": \"PostalAddress\", \"addressLocality\": \"San Francisco\", \"addressRegion\": \"CA\", \"addressCountry\": \"US\"}, \"sameAs\": [\"https://www.linkedin.com/company/mediamelon/\"]}</script>\n<script defer src=\"/__l5e/events.270c78a44fc53e7b.js\" data-artifact-kind=\"dwl_content_hash\" data-artifact-id=\"8b09b81a8adf0bbdaf464048205f2b59eddc45d3095e3720e9aef8c3e5022ece\" data-commit-sha=\"d100810bfde0f6d4fa745a7c25c3bb8f3f8b1386\" data-context-token=\"v1..c49hSkcrFVZli8gS5Gwfxv472T641vxPIn5_MpIse0k\" data-autocapture=\"1\" data-consent=\"1\"></script><meta name=\"twitter:title\" content=\"MediaMelon | Real-time analytics for streaming video\"><meta name=\"twitter:description\" content=\"See every viewing session in real time, find the cause of playback and ad problems in your logs, and run it as a service or in your own cloud. Trusted by Warner Bros. Discovery.\"><meta name=\"twitter:image\" content=\"https://mediamelon.com/assets/og-default.png\"></head>\n<body>\n<a class=\"skip\" href=\"#main\">Skip to content</a>\n\n<div class=\"band\">\n  <header class=\"top\">\n    <div class=\"wrap\">\n      <a class=\"brand\" href=\"/\" aria-label=\"MediaMelon home\"><picture><img src=\"/assets/logos/mediamelon-logo.svg\" alt=\"MediaMelon\" width=\"695\" height=\"130\"></picture></a>\n      <nav class=\"links\" id=\"site-nav\" aria-label=\"Main\"><a href=\"/prisma\">Prisma</a><a href=\"/use-cases\">Use cases</a><a href=\"/#deploy\">Deployment</a><a href=\"/customers\">Customers</a><a href=\"/news\">News</a><a class=\"login\" href=\"https://smartsight.mediamelon.com\" rel=\"noopener\">Log in</a></nav>\n      <a class=\"btn primary\" href=\"/demo\">Book a demo</a>\n      <button class=\"menu-btn\" type=\"button\" aria-label=\"Menu\" aria-expanded=\"false\" aria-controls=\"site-nav\"><svg viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M3 6h14M3 10h14M3 14h14\"/></svg></button>\n    </div>\n  </header>\n\n  <div class=\"hero\" id=\"top\">\n    <div class=\"wrap hero-head\"><h1 class=\"statement\">Observability for the world's largest streaming services</h1></div>\n    <div class=\"wrap\">\n      <div>\n        <p class=\"hook\">Not just what and where. Now you <em>know why.</em></p>\n        <p class=\"lede\">We measure every viewing session, as it happens, on every screen. <b>Prisma, our AI agent, finds the cause of any problem in your logs, with the evidence to prove it.</b></p>\n        <div class=\"cta\">\n          <a class=\"btn primary\" href=\"/demo\">Book a demo</a>\n          <button class=\"btn ghost\" type=\"button\" id=\"withsound\"><svg viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\" class=\"play\"><path d=\"M4 2.5v11l9-5.5z\"/></svg>Watch full screen · 2 min</button>\n        </div>\n      </div>\n      <div class=\"hero-vid\">\n        <video id=\"vid\" muted loop playsinline preload=\"metadata\" poster=\"assets/demo-poster.jpg\" data-hd=\"/__l5e/assets-v1/69c08a28-0d69-4cd6-af27-72838a852d52/demo-hd.mp4\" aria-label=\"Product walkthrough: from an alert to the root cause\">\n          <source src=\"/assets/demo.mp4\" type=\"video/mp4\">\n          <track kind=\"captions\" src=\"/assets/demo-captions.vtt\" srclang=\"en\" label=\"English\" default>\n        </video>\n        <button class=\"vid-cc\" type=\"button\" aria-pressed=\"true\" aria-label=\"Captions\">CC</button>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"glance\" aria-label=\"At a glance\">\n    <div class=\"wrap\">\n      <a class=\"tile\" href=\"/use-cases/live\"><span class=\"k\">Proven at scale</span><b>40M+ concurrent viewers</b><p>Data in under 15 s from every player, with zero data loss through live-event traffic bursts.</p></a>\n      <a class=\"tile\" href=\"#deploy\"><span class=\"k\">Deploy your way</span><b>SaaS or your own cloud</b><p>We operate it either way, with the same SLAs.</p></a>\n      <a class=\"tile\" href=\"#partners\"><span class=\"k\">Root cause from logs</span><b>Correlated with your logs</b><p>Impacted sessions matched to the logs that explain them. <span class=\"oob\">Out of the box with <picture><img src=\"/assets/logos/hydrolix-dark.png\" alt=\"Hydrolix\" width=\"548\" height=\"156\"></picture></span></p></a>\n      <a class=\"tile\" href=\"#open\"><span class=\"k\">Open by design</span><b>APIs, MCP, live feeds</b><p>Everything we compute, powering your own agents and applications.</p></a>\n    </div>\n  </div>\n</div>\n\n<div class=\"logos\" aria-label=\"Customers\">\n  <div class=\"wrap\"><span class=\"eyebrow\">Trusted by streaming leaders</span><img src=\"/assets/logos/wbd-logo.svg\" alt=\"Warner Bros. Discovery\" style=\"height:30px\"><img src=\"/assets/logos/brands/hbo-max.svg\" alt=\"HBO Max\" style=\"height:20px\"><img src=\"/assets/logos/brands/cnn.svg\" alt=\"CNN\" style=\"height:22px\"><img src=\"/assets/logos/brands/aplus-e-global-media.svg\" alt=\"A+E Global Media\" style=\"height:34px\"><img src=\"/assets/logos/brands/grupo-mvs.png\" alt=\"Dish MVS (Grupo MVS)\" style=\"height:30px\"><img src=\"/assets/logos/brands/tata-play.svg\" alt=\"Tata Play\" style=\"height:17px\"><img src=\"/assets/logos/brands/ses.svg\" alt=\"SES\" style=\"height:28px\"><img src=\"/assets/logos/brands/deutsche-telekom.svg\" alt=\"Deutsche Telekom\" style=\"height:32px\"></div>\n</div>\n\n<main id=\"main\">\n<section class=\"gap\" id=\"gap\">\n  <div class=\"wrap gap-grid\">\n    <div class=\"gap-txt\"><span class=\"eyebrow\">The problem</span>\n      <h2>An alert says something broke. Then the bridge call starts.</h2>\n      <p>CDN, origin, DRM and app teams search their logs by time and IP, while viewers leave.</p>\n      <p class=\"gap-out\">With MediaMelon: one finding, one owner, with the proof attached. No bridge call.</p></div>\n    <div class=\"answer\" aria-label=\"Example finding\">\n      <span class=\"eyebrow\">One finding</span>\n      <dl>\n        <div><dt>Impact</dt><dd>Startup failures on <i>The Bell of Ardmore</i> on iPhone and Apple TV: <b class=\"bad\">28.9%</b> of plays, against 0.7% overall</dd></div>\n        <div><dt>Root cause</dt><dd>FairPlay refuses 78% of license requests for this title: key_id_not_in_policy</dd></div>\n        <div><dt>Ruled out</dt><dd>The CDN and the app. Segments deliver normally, and other titles play on the same devices.</dd></div>\n        <div class=\"act\"><dt>Action</dt><dd>Fix the title's DRM key policy. Sent to content operations.</dd></div>\n      </dl>\n    </div>\n  </div>\n</section>\n\n\n<div class=\"proof\" aria-label=\"What customers and partners say\">\n  <div class=\"wrap\">\n    <figure class=\"pc\">\n      <p class=\"pc-out\">Root cause of experience issues, found automatically.</p>\n      <span class=\"pc-logo hx\" role=\"img\" aria-label=\"Hydrolix\"></span>\n      <blockquote>Finally, you can bring your high-volume CDN logs together with your player-side analytics. See what logs lead to what outcome, without sampling or compromise.</blockquote>\n      <figcaption><b>Simon Ouderkirk</b>, VP of Product, Hydrolix</figcaption>\n    </figure>\n    <figure class=\"pc\">\n      <p class=\"pc-out\">Every CDN a better CDN, sent where it performs.</p>\n      <span class=\"pc-logo agile\" role=\"img\" aria-label=\"AgileTV CDN Director\"><i></i><small>CDN Director</small></span>\n      <blockquote>MediaMelon brings real viewer experience into CDN Director, so business policies and QoE improve together.</blockquote>\n      <figcaption><b>José Madrona Mojarro</b>, Senior Product Manager, AgileTV</figcaption>\n    </figure>\n  </div>\n</div>\n\n<section id=\"how\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <div><span class=\"eyebrow\">Use cases</span><h2>One product. Every team.</h2>\n        <p>Pick a team and follow a case through the product, from the first signal to the answer.</p></div>\n      <a class=\"go\" href=\"/use-cases\">All use cases →</a>\n    </div>\n    <div class=\"ucs\" role=\"group\" aria-label=\"Use case\"><button type=\"button\" data-aud=\"streaming\" aria-pressed=\"true\"><span class=\"uk\">Playback teams</span><span class=\"ut\">Better video and ad experience, on every device</span></button><button type=\"button\" data-aud=\"operator\" aria-pressed=\"false\"><span class=\"uk\">Operators</span><span class=\"ut\">Every viewer's app becomes a probe of your network</span></button><button type=\"button\" data-aud=\"multicdn\" aria-pressed=\"false\"><span class=\"uk\">CDN teams</span><span class=\"ut\">Real-time multi-CDN steering, automated</span></button><button type=\"button\" data-aud=\"live\" aria-pressed=\"false\"><span class=\"uk\">Live ops</span><span class=\"ut\">Every live event, watched as it happens</span></button><button type=\"button\" data-aud=\"ads\" aria-pressed=\"false\"><span class=\"uk\">Ad teams</span><span class=\"ut\">More revenue from every impression</span></button><button type=\"button\" data-aud=\"engagement\" aria-pressed=\"false\"><span class=\"uk\">Content teams</span><span class=\"ut\">More engagement from every title</span></button></div>\n    <div data-for=\"streaming\">\n      <div class=\"summary\">\n        <div class=\"sum-txt\"><span class=\"eyebrow\">The case</span><h3>Fire TV playback keeps failing</h3>\n          <ol class=\"picks\"><li class=\"on\" data-src=\"/assets/img/pub-1-detect.jpg\" data-alt=\"Triage: playback failures alert on app 9.6.0 for Fire TV, open\" data-w=\"2000\" data-h=\"866\"><button type=\"button\" aria-pressed=\"true\"><span class=\"sn\">01</span><span><span class=\"sk\">Detect</span><b>The alert finds you</b></span></button></li><li data-src=\"/assets/img/pub-2-verify.jpg\" data-alt=\"Fire TV scoped, every app version overlaid: only 9.6.0 fails and rebuffers\" data-w=\"2000\" data-h=\"1516\"><button type=\"button\" aria-pressed=\"false\"><span class=\"sn\">02</span><span><span class=\"sk\">Verify</span><b>Confirm it's this cohort</b></span></button></li><li data-src=\"/assets/img/pub-3-sessions.jpg\" data-alt=\"A 9.6.0 Fire TV session that played, rebuffered four times and failed on a segment 404\" data-w=\"2000\" data-h=\"1450\"><button type=\"button\" aria-pressed=\"false\"><span class=\"sn\">03</span><span><span class=\"sk\">Inspect</span><b>Look at the viewers it hit</b></span></button></li><li data-src=\"/assets/img/pub-4-verdict.jpg\" data-alt=\"Prisma verdict panel\" data-w=\"1194\" data-h=\"610\"><button type=\"button\" aria-pressed=\"false\"><span class=\"sn\">04</span><span><span class=\"sk\">Root cause</span><b>Prisma reads the logs</b></span></button></li><li data-src=\"/assets/img/pub-5-evidence.jpg\" data-alt=\"Sessions joined to raw CDN request log lines\" data-w=\"1470\" data-h=\"440\"><button type=\"button\" aria-pressed=\"false\"><span class=\"sn\">05</span><span><span class=\"sk\">Evidence</span><b>Every claim, down to the request</b></span></button></li></ol>\n          <p class=\"sum-out\">Answer: a client build, not the CDN</p>\n          <a class=\"case-link\" href=\"/use-cases/playback\">Read the full case →</a></div>\n        <div class=\"shot\"><img src=\"/assets/img/pub-1-detect.jpg\" alt=\"Triage: playback failures alert on app 9.6.0 for Fire TV, open\" width=\"2000\" height=\"866\"></div>\n      </div>\n    </div>\n    <div data-for=\"operator\" hidden>\n      <div class=\"summary\">\n        <div class=\"sum-txt\"><span class=\"eyebrow\">The case</span><h3>Rebuffering spikes in one neighborhood</h3>\n          <ol class=\"picks\"><li class=\"on\" data-src=\"/assets/img/isp-1-detect.jpg\" data-alt=\"Triage with OLT-MAI-03 at the top\" data-w=\"2000\" data-h=\"866\"><button type=\"button\" aria-pressed=\"true\"><span class=\"sn\">01</span><span><span class=\"sk\">Detect</span><b>The node raises its hand</b></span></button></li><li data-src=\"/assets/img/isp-2-neighbors.jpg\" data-alt=\"Access nodes overlaid on one chart\" data-w=\"2000\" data-h=\"1576\"><button type=\"button\" aria-pressed=\"false\"><span class=\"sn\">02</span><span><span class=\"sk\">Rule out the network</span><b>Compare it with its neighbors</b></span></button></li><li data-src=\"/assets/img/isp-3-node.jpg\" data-alt=\"OLT-MAI-03 broken down by plan, BNG and CPE\" data-w=\"2000\" data-h=\"1339\"><button type=\"button\" aria-pressed=\"false\"><span class=\"sn\">03</span><span><span class=\"sk\">Rule out the home</span><b>Every plan, every router, wired too</b></span></button></li><li data-src=\"/assets/img/isp-4-care.jpg\" data-alt=\"Customer care lookup showing the known issue on the line\" data-w=\"2080\" data-h=\"1008\"><button type=\"button\" aria-pressed=\"false\"><span class=\"sn\">04</span><span><span class=\"sk\">Customer care</span><b>The agent already knows</b></span></button></li></ol>\n          <p class=\"sum-out\">Answer: the OLT. Dispatch to OLT-MAI-03.</p>\n          <a class=\"case-link\" href=\"/use-cases/operators\">Read the full case →</a></div>\n        <div class=\"shot\"><img src=\"/assets/img/isp-1-detect.jpg\" alt=\"Triage with OLT-MAI-03 at the top\" width=\"2000\" height=\"866\"></div>\n      </div>\n    </div>\n    <div data-for=\"multicdn\" hidden>\n      <div class=\"summary\">\n        <div class=\"sum-txt\"><span class=\"eyebrow\">The case</span><h3>CDN choice, driven by viewer experience</h3>\n          <ol class=\"picks\"><li class=\"on\" data-src=\"/assets/img/agiletv-selection.jpg\" data-alt=\"CDN monitoring: steered and random-control traffic overlaid on StreamScore, rebuffering and playback failures\" data-w=\"2000\" data-h=\"1492\"><button type=\"button\" aria-pressed=\"true\"><span class=\"sn\">01</span><span><span class=\"sk\">Automate</span><b>Every session steered to the CDN that performs</b></span></button></li><li data-src=\"/assets/img/mcdn-steer.jpg\" data-alt=\"Comcast in California: steered sessions avoid the failing CDN, the random control group does not\" data-w=\"2000\" data-h=\"1516\"><button type=\"button\" aria-pressed=\"false\"><span class=\"sn\">02</span><span><span class=\"sk\">Evidence</span><b>Steered against control, where a CDN breaks</b></span></button></li></ol>\n          <p class=\"sum-out\">Answer: steered sessions beat the control group, measured on your own traffic.</p>\n          <a class=\"case-link\" href=\"/use-cases/multi-cdn\">Read the full case →</a></div>\n        <div class=\"shot\"><img src=\"/assets/img/agiletv-selection.jpg\" alt=\"CDN monitoring: steered and random-control traffic overlaid on StreamScore, rebuffering and playback failures\" width=\"2000\" height=\"1492\"></div>\n      </div>\n    </div>\n    <div data-for=\"live\" hidden>\n      <div class=\"summary\">\n        <div class=\"sum-txt\"><span class=\"eyebrow\">The case</span><h3>The semifinal kicks off</h3>\n          <ol class=\"picks\"><li class=\"on\" data-src=\"/assets/img/live-dark.jpg\" data-alt=\"Live mode, dark theme: the semifinal kicks off, unique viewers and concurrency climb, StreamScore for every device × country × CDN combination\" data-w=\"2000\" data-h=\"1525\"><button type=\"button\" aria-pressed=\"true\"><span class=\"sn\">01</span><span><span class=\"sk\">Live</span><b>Audience and StreamScore for every device, country and CDN combination, every 30 seconds</b></span></button></li></ol>\n          <p class=\"sum-out\">Answer: who is watching, where, and how it plays, live.</p>\n          <a class=\"case-link\" href=\"/use-cases/live\">Read the full case →</a></div>\n        <div class=\"shot\"><img src=\"/assets/img/live-dark.jpg\" alt=\"Live mode, dark theme: the semifinal kicks off, unique viewers and concurrency climb, StreamScore for every device × country × CDN combination\" width=\"2000\" height=\"1525\"></div>\n      </div>\n    </div>\n    <div data-for=\"ads\" hidden>\n      <div class=\"summary\">\n        <div class=\"sum-txt\"><span class=\"eyebrow\">The case</span><h3>How every campaign is delivered</h3><p class=\"sum-tags\"><span>Viewability</span><span>Quartile completion</span><span>CSAI &amp; SSAI</span><span>IAB &amp; OM compliant</span></p>\n          <ol class=\"picks\"><li class=\"on\" data-src=\"/assets/img/report-ads.jpg\" data-alt=\"Weekly campaign delivery report built with Prisma or your own agent via MCP: pacing, reach, frequency, viewability\" data-w=\"2000\" data-h=\"1538\"><button type=\"button\" aria-pressed=\"true\"><span class=\"sn\">01</span><span><span class=\"sk\">Report</span><b>Your weekly delivery report, on demand</b><span class=\"via2\">Built with Prisma or your own agent via MCP</span></span></button></li><li data-src=\"/assets/img/ads-delivery.jpg\" data-alt=\"Every campaign overlaid on impressions, reach and frequency\" data-w=\"2000\" data-h=\"1552\"><button type=\"button\" aria-pressed=\"false\"><span class=\"sn\">02</span><span><span class=\"sk\">Reach &amp; frequency</span><b>Every campaign, over time</b></span></button></li><li data-src=\"/assets/img/ads-devices.jpg\" data-alt=\"One campaign by device: reach, frequency and ad completion\" data-w=\"2000\" data-h=\"1516\"><button type=\"button\" aria-pressed=\"false\"><span class=\"sn\">03</span><span><span class=\"sk\">Breakdown</span><b>By device, insertion or anything else</b></span></button></li><li data-src=\"/assets/img/ads-session.jpg\" data-alt=\"Session timeline with its pre-roll and mid-roll ad breaks, each ad named\" data-w=\"1996\" data-h=\"1522\"><button type=\"button\" aria-pressed=\"false\"><span class=\"sn\">04</span><span><span class=\"sk\">Sessions</span><b>Every ad, in the viewer's session</b></span></button></li></ol>\n          <p class=\"sum-out\">Answer: the report your ad sales team asks for, on demand</p>\n          <a class=\"case-link\" href=\"/use-cases/ads\">Read the full case →</a></div>\n        <div class=\"shot\"><img src=\"/assets/img/report-ads.jpg\" alt=\"Weekly campaign delivery report built with Prisma or your own agent via MCP: pacing, reach, frequency, viewability\" width=\"2000\" height=\"1538\"></div>\n      </div>\n    </div>\n    <div data-for=\"engagement\" hidden>\n      <div class=\"summary\">\n        <div class=\"sum-txt\"><span class=\"eyebrow\">The case</span><h3>Who watches what, where and when</h3>\n          <ol class=\"picks\"><li class=\"on\" data-src=\"/assets/img/report-eng.jpg\" data-alt=\"Weekly audience report built with Prisma or your own agent via MCP: top titles, genre by daypart, where viewers stop\" data-w=\"2000\" data-h=\"1532\"><button type=\"button\" aria-pressed=\"true\"><span class=\"sn\">01</span><span><span class=\"sk\">Report</span><b>Your weekly audience report, on demand</b><span class=\"via2\">Built with Prisma or your own agent via MCP</span></span></button></li><li data-src=\"/assets/img/eng-genre.jpg\" data-alt=\"Plays, unique viewers and playtime with each genre overlaid\" data-w=\"2000\" data-h=\"1492\"><button type=\"button\" aria-pressed=\"false\"><span class=\"sn\">02</span><span><span class=\"sk\">Audience</span><b>What your audience watches</b></span></button></li><li data-src=\"/assets/img/eng-titles.jpg\" data-alt=\"VOD titles by unique viewers, playtime and completion\" data-w=\"2000\" data-h=\"1456\"><button type=\"button\" aria-pressed=\"false\"><span class=\"sn\">03</span><span><span class=\"sk\">Titles</span><b>Which titles hold attention</b></span></button></li><li data-src=\"/assets/img/eng-devices.jpg\" data-alt=\"Movies by device: completion on smart TV, desktop and iPhone overlaid\" data-w=\"2000\" data-h=\"1516\"><button type=\"button\" aria-pressed=\"false\"><span class=\"sn\">04</span><span><span class=\"sk\">Devices</span><b>Where they finish</b></span></button></li></ol>\n          <p class=\"sum-out\">Answer: the programming report, from the same data as quality</p>\n          <a class=\"case-link\" href=\"/use-cases/content\">Read the full case →</a></div>\n        <div class=\"shot\"><img src=\"/assets/img/report-eng.jpg\" alt=\"Weekly audience report built with Prisma or your own agent via MCP: top titles, genre by daypart, where viewers stop\" width=\"2000\" height=\"1532\"></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"why\" id=\"why\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\"><div><span class=\"eyebrow\">Why MediaMelon</span><h2>Built for media and entertainment.</h2>\n      <p>MediaMelon measures every viewing session, content and ads, and turns it into answers. The teams who run your service and the leaders accountable for it work from the same view of what viewers actually experience.</p></div></div>\n    <div class=\"pillars\">\n      <div class=\"pillar\"><span class=\"eyebrow\">Live events</span><h3>Protect your biggest moments</h3>\n        <p>Sports, premieres and breaking news bring your largest audiences at once, with the least time to react. See every session in real time and fix problems while the event is still on.</p>\n        <a class=\"go\" href=\"/use-cases/live\">Live operations →</a></div>\n      <div class=\"pillar\"><span class=\"eyebrow\">Revenue</span><h3>Quality is revenue</h3>\n        <p>Playback and ad delivery are one experience. Stalled streams and failed ads cost viewing time and impressions. See both in one place, by device, region, title and campaign.</p>\n        <a class=\"go\" href=\"/use-cases/ads\">Ad delivery →</a></div>\n      <div class=\"pillar\"><span class=\"eyebrow\">Ownership</span><h3>Own your viewer data</h3>\n        <p>We run MediaMelon for you, in our cloud or inside yours. In yours, your data stays under your governance, at a cloud cost you control. One platform serves your operations, ad and content teams.</p>\n        <a class=\"go\" href=\"#deploy\">Deployment options →</a></div>\n    </div>\n  </div>\n</section>\n\n<section id=\"deploy\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\"><div><span class=\"eyebrow\">Deployment</span><h2>Your cloud or ours. Same product.</h2>\n      <p>Same features, support and SLAs either way.</p></div></div>\n    <div class=\"grid2\">\n      <div class=\"card\"><span class=\"tag\">SaaS</span><h3>Run by MediaMelon</h3>\n        <p>We run, scale and upgrade it.</p>\n        <ul><li>Live in days</li><li>Scales to the biggest live events</li><li>Single sign-on, roles, per-team data scopes</li></ul></div>\n      <div class=\"card\"><span class=\"tag\">BYOC</span><h3>Inside your own cloud</h3>\n        <p>Your data never leaves your cloud. We still run it for you.</p>\n        <ul><li>We operate, scale and upgrade it in your account, under the same SLAs</li><li>Your account, your region, your governance</li><li>Works with your data platform and lake</li></ul></div>\n    </div>\n\n    <h3 class=\"sub-h\" id=\"open\">Open by design</h3>\n    <div class=\"grid3 open\">\n      <div class=\"card\"><div class=\"ic\"><svg viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M3 10h4l2-5 2 10 2-5h4\"/></svg></div>\n        <h3>Real-time data feeds</h3><p>Every session, streamed to your systems live.</p></div>\n      <div class=\"card\"><div class=\"ic\"><svg viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M7 6l-4 4 4 4M13 6l4 4-4 4\"/></svg></div>\n        <h3>REST APIs</h3><p>Everything on screen, as an API.</p></div>\n      <div class=\"card\"><div class=\"ic\"><svg viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"10\" cy=\"10\" r=\"3\"/><path d=\"M10 2v3M10 15v3M2 10h3M15 10h3\"/></svg></div>\n        <h3>MCP server</h3><p>Your AI agents query the same data as Prisma.</p></div>\n    </div>\n    <dl class=\"players connects\"><dt>Connects to</dt><dd><span>Kafka</span><span>Kinesis</span><span>Snowflake</span><span>BigQuery</span><span>Slack</span><span>PagerDuty</span><span>Webhooks</span></dd></dl>\n\n    <h3 class=\"sub-h\">Every screen your viewers use</h3>\n    <dl class=\"players\">\n      <dt>Web</dt><dd><span>Shaka</span><span>Video.js</span><span>hls.js</span><span>dash.js</span><span>Bitmovin</span><span>THEOplayer</span><span>JW Player</span><span>Kaltura</span><span>Brightcove</span><span>CastLabs</span><span>Flowplayer</span><span>Radiant Media Player</span><span>HTML5</span></dd>\n      <dt>Mobile</dt><dd><span>Android Media3 / ExoPlayer</span><span>Apple AVPlayer</span><span>Bitmovin</span><span>THEOplayer</span><span>Kaltura</span><span>Viaccess-Orca</span><span>React Native</span></dd>\n      <dt>TV</dt><dd><span>Samsung Tizen</span><span>LG webOS</span><span>Vizio</span><span>HbbTV</span><span>Roku</span><span>Fire TV</span><span>Apple TV</span><span>Android TV</span><span>Chromecast</span><span>C++ SDK</span></dd>\n      <dt>Ads</dt><dd><span>Google IMA</span><span>FreeWheel</span><span>Equativ</span><span>Client-side insertion (CSAI)</span><span>Server-side insertion (SSAI)</span></dd>\n    </dl>\n  </div>\n</section>\n\n<section id=\"partners\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\"><div><span class=\"eyebrow\">Partners</span><h2>Built to work with your stack</h2></div></div>\n    <div class=\"grid2 partners4\">\n      <div class=\"card\">\n        <div class=\"logo-row\"><span class=\"hx\" role=\"img\" aria-label=\"Hydrolix\"></span></div>\n        <h3>Root cause from your logs</h3>\n        <p>MediaMelon finds the broken sessions. Hydrolix holds their logs. Prisma joins them and names the cause.</p>\n        <ul><li>Nothing bulk-ingested: Prisma reads only the lines it needs</li><li>Every verdict links to the raw requests</li></ul>\n      </div>\n      <div class=\"card\">\n        <div class=\"logo-row\"><span class=\"agile big\" role=\"img\" aria-label=\"AgileTV\"><i></i></span><span class=\"cdnd\">CDN Director</span></div>\n        <h3>CDN selection, steered by experience</h3>\n        <p>Every steering decision is tagged and compared with a random control group, so you see what it is worth on your own traffic.</p>\n        <div class=\"cmp\" role=\"img\" aria-label=\"Playback failures: 1.15% with random CDN choice, 0.37% when steered by experience\">\n          <div class=\"cmp-h\">Playback failures, same traffic, same hours</div>\n          <div class=\"cmp-row bad\"><span>Random CDN choice</span><span class=\"cmp-bar\"><i style=\"width:100%\"></i></span><b>1.15%</b></div>\n          <div class=\"cmp-row good\"><span>Steered by experience</span><span class=\"cmp-bar\"><i style=\"width:32%\"></i></span><b>0.37%</b></div>\n          <p class=\"cmp-out\">3x fewer playback failures</p>\n          <p class=\"cmp-note\">\n        </div>\n      </div>\n      <div class=\"card\">\n        <div class=\"logo-row\"><img src=\"/assets/logos/brands/akamai.svg\" alt=\"Akamai\" style=\"height:38px;width:auto\"><small>Qualified Compute Partner</small></div>\n        <h3>Run it on Akamai Cloud</h3>\n        <p>MediaMelon is an Akamai Qualified Compute Partner. Deploy it on Akamai Cloud, close to your viewers and alongside your Akamai delivery.</p>\n        <ul><li>Run in the regions where your audiences are</li><li>Managed by MediaMelon, under the same SLAs</li></ul>\n      </div>\n      <div class=\"card\">\n        <div class=\"logo-row\"><img src=\"/assets/logos/brands/aws.svg\" alt=\"AWS\" class=\"aws-logo\" style=\"height:34px;width:auto\"></div>\n        <h3>Proven at 40M+ concurrent viewers</h3>\n        <p>Run MediaMelon in your own AWS account or ours, on the same architecture proven at 40M+ concurrent viewers.</p>\n        <ul><li>In your account, the infrastructure counts toward your AWS commitments</li><li>Your region, your governance, your data</li></ul>\n      </div>\n    </div>\n  </div>\n</section>\n</main>\n\n<section class=\"final\" id=\"contact\">\n  <div class=\"wrap\">\n    <h2>See it on your own traffic.</h2>\n    <p>Thirty minutes, on a problem you're chasing.</p>\n    <div class=\"cta\"><a class=\"btn primary\" href=\"/demo\">Book a demo</a></div>\n  </div>\n</section>\n<footer>\n  <div class=\"wrap foot\">\n    <div>\n      <img src=\"/assets/logos/mediamelon-logo-white.svg\" alt=\"MediaMelon\" width=\"695\" height=\"130\">\n      <p>Observability for the world's largest streaming services.<br>MediaMelon, Inc. · San Francisco, California</p>\n      <a class=\"social\" href=\"https://www.linkedin.com/company/mediamelon/\" rel=\"noopener\" aria-label=\"MediaMelon on LinkedIn\" title=\"MediaMelon on LinkedIn\"><svg viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M3.6 5.6H1V15h2.6V5.6zM2.3 1.2a1.5 1.5 0 100 3 1.5 1.5 0 000-3zM15 9.8c0-2.5-.5-4.4-3.4-4.4-1.4 0-2.3.8-2.7 1.5V5.6H6.4V15H9v-4.7c0-1.2.2-2.4 1.8-2.4 1.5 0 1.5 1.4 1.5 2.5V15H15V9.8z\"/></svg></a>\n    </div>\n    <div><h4>Product</h4><ul>\n      <li><a href=\"/prisma\">Prisma</a></li>\n      <li><a href=\"/use-cases\">Use cases</a></li>\n      <li><a href=\"/#deploy\">Deployment</a></li>\n      <li><a href=\"/#open\">APIs and integrations</a></li>\n      <li><a href=\"https://docs.mediamelon.com\" rel=\"noopener\">Documentation</a></li></ul></div>\n    <div><h4>Company</h4><ul>\n      <li><a href=\"/customers\">Customers</a></li>\n      <li><a href=\"/news\">News</a></li>\n      <li><a href=\"/demo\">Book a demo</a></li>\n      <li><a href=\"https://smartsight.mediamelon.com\" rel=\"noopener\">Customer login</a></li></ul></div>\n    <div><h4>Legal</h4><ul>\n      <li><a href=\"/privacy\">Privacy policy</a></li>\n      <li><button class=\"linkish\" type=\"button\" data-cookie-settings>Cookie settings</button></li></ul></div>\n  </div>\n  <div class=\"wrap foot-base\"><span>© 2026 MediaMelon, Inc.</span><span>Product screens use demo data.</span></div>\n</footer>\n<div class=\"consent\" id=\"consent\" role=\"dialog\" aria-label=\"Cookie notice\" hidden>\n  <p><b>Cookies.</b> We use analytics cookies to understand how the site is used. They load only if you accept. See our <a href=\"/privacy\">privacy policy</a>.</p>\n  <div class=\"row\"><button class=\"btn primary\" type=\"button\" data-consent=\"accept\">Accept</button><button class=\"btn quiet\" type=\"button\" data-consent=\"decline\">Decline</button></div>\n</div>\n<script src=\"/assets/site.js\" defer></script>\n</body>\n</html>\n",
