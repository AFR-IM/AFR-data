bility: hidden\"\n      ></iframe\n    ></noscript>\n    <!-- End Google Tag Manager (noscript) -->\n\n    <header class=\"header-large\">\n      <div class=\"inner\">\n        <div class=\"header-wrap\">\n          <a href=\"index.html\"\n            ><img id=\"dotmetrics-logo\" src=\"images/dotmetrics-logo.svg\" alt=\"dotmetrics logo\"\n          /></a>\n          <img id=\"menu-open\" class=\"mobile-menu-control\" src=\"images/ic_menu.svg\" />\n          <nav class=\"navigation-text\">\n            <ol>\n              <li><a href=\"about.html\">About us</a></li>\n              <li><a href=\"https://ui.dotmetrics.net/\">Login</a></li>\n            </ol>\n            <img id=\"menu-close\" class=\"mobile-menu-control\" src=\"images/ic-close.svg\" />\n          </nav>\n        </div>\n        <div class=\"b-wrap\">\n          <h1>Big Audience Data</h1>\n          <h3 class=\"subtitle-1\">Daily fresh big audience for everyone!</h3>\n          <a href=\"contact.html\"><button class=\"secondary\">Contact Us</button></a>\n        </div>\n      </div>\n    </header>\n\n    <main>\n      <section id=\"s-customers\">\n        <h4>OUR HAPPY CUSTOMERS IN THE BIG DATA MEASUREMENT</h4>\n        <div class=\"list-holder\">\n          <ul>\n            <li>Croatia</li>\n            <li>Slovenia</li>\n            <li>Bosnia and Herzegovina</li>\n            <li>Serbia</li>\n            <li>North Macedonia</li>\n            <li>United Kingdom</li>\n          </ul>\n        </div>\n      </section>\n      <section id=\"s-technology\">\n        <div class=\"technology-bg\"> </div>\n        <h2>Technology</h2>\n        <div class=\"cards-holder\">\n          <div class=\"card\">\n            <img src=\"images/ic-database.svg\" />\n            <h5>Big Data</h5>\n            <p\n              >Thousands of events are stored from 25+ million devices each day in granular form to\n              create detailed overview of audience data.</p\n            >\n          </div>\n          <div class=\"card\">\n            <img src=\"images/ic-gathering-data.svg\" />\n            <h5>Data analysis</h5>\n            <p\n              >Terabytes of data are analyzed each day to filter non-human traffic and create valid\n              audience per-device data with demographics.</p\n            >\n          </div>\n          <div class=\"card\">\n            <img src=\"images/ic-queries.svg\" />\n            <h5>Audience measurement</h5>\n            <p\n              >Dotmetrics collects over 500 mil. events daily from millions of devices visiting\n              measured websites or using mobile apps.</p\n            >\n          </div>\n          <div class=\"card\">\n            <img src=\"images/ic-output.svg\" />\n            <h5>Reporting</h5>\n            <p\n              >AdHoc queries are made on per device big data dataset holding billions of device\n              events.</p\n            >\n          </div>\n        </div>\n      </section>\n      <section id=\"s-inforgaphics\">\n        <h2>Latest data from</h2>\n        <select id=\"infographics-select\" class=\"hidden\"> </select>\n        <div class=\"graphs\"> </div>\n        <div class=\"b-small\" id=\"graphs-info\"\n          >Displayed data for <span id=\"ig-month\"></span> <span id=\"ig-year\"></span\n        ></div>\n      </section>\n\n      <section id=\"s-learn-more\">\n        <h2>Ready to learn more?</h2>\n        <p class=\"subtitle-2\"\n          >Contact us to learn how Dotmetrics can help you to grow your business</p\n        >\n        <a href=\"contact.html\"><button class=\"secondary\">Let's talk</button></a>\n      </section>\n      <div id=\"cookie-snackbar-container\">\n        <div class=\"inner\">\n          <div id=\"cookie-snackbar\">\n            <img id=\"cookie-icon\" alt=\"cookie icon\" src=\"images/ic_cookie.svg\" />\n            <p class=\"b-small\">\n              We are using cookies to provide the best experience of our site. <br />By clicking on \"Got\n        