      "body": "<!DOCTYPE html>\n<html>\n    <head>\n        <title>BuddyNS: World's fastest-to-synchronize Secondary DNS service</title>\n\n        \n        <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n\n        <meta name=\"author\" content=\"BuddyNS.com\" />\n        <meta name=\"keywords\" content=\"DNS security, DNS availability, backup DNS, free, DNS replication, DNS reliability\" />\n        <meta name=\"robots\" content=\"follow, all\" />\n        <meta name=\"description\" content=\"Stress-free DNS security and reliability. Immediate updates. 100% uptime. Blazing fast resolution. Free or paid.\" />\n\n        \n        <script src=\"/static/buddyns/contrib/jquery/3.6.0/jquery-3.6.0.min.js\"></script>\n        \n\n        \n        <link rel=\"stylesheet\" type=\"text/css\" href=\"/static/buddyns/style/base_new.css\" />\n        <link rel=\"shortcut icon\" href=\"/static/buddyns/images/favicon.ico\" />\n\n        \n        <link rel=\"stylesheet\" href=\"/static/buddyns/contrib/bootstrap/4.2.1/css/bootstrap.min.css\">\n        <script src=\"/static/buddyns/contrib/popper.js/1.14.3/umd/popper.min.js\"></script>\n        <script src=\"/static/buddyns/contrib/bootstrap/4.2.1/js/bootstrap.min.js\"></script>\n        \n\n        \n        <!-- font-icons from FontAwesome.com -->\n        <link rel=\"stylesheet\" href=\"/static/buddyns/fontawesome/css/all.min.css\">\n        \n\n        \n        <script type=\"text/javascript\" src=\"/static/buddyns/scripts/jqid.js\"></script>\n\n        <!-- Google Tag Manager -->\n        <script nonce=\"24859e229b4737dfd3c691a12f459b2b\">try {\n            (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-NM38W44');\n        } catch (err) {\n            console.log(\"Google Tag Manager failed to load => gets disabled. Error was:\" + err);\n        }</script>\n        <!-- End Google Tag Manager -->\n\n        \n\n        \n<link href=\"/static/buddyns/style/index.css\" rel=\"stylesheet\" />\n<script type=\"text/javascript\" src=\"/static/buddyns/scripts/popup.js\"></script>\n<script type=\"text/javascript\" src=\"/static/buddyns/scripts/rotate-testimonial.js\"></script>\n<script type=\"text/javascript\">\n    $(document).ready(function () {\n        ['reliability-icon', 'easeofuse-icon', 'innovation-icon'].forEach(function(el) {\n            BuddyPopUp(el, 'top');\n        });\n    // show random usp\n    let usp_chosen = Math.floor(Math.random() * $(\".usp\").length);\n    $(\".usp\").hide();\n    $(\".usp:eq(\" + usp_chosen + \")\").show();\n    change_testimonial();\n    restart_testimonials();\n    });\n</script>\n\n    </head>\n    <body>\n        <!-- Google Tag Manager (noscript) -->\n        <noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-NM38W44\"\n        height=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\n        <!-- End Google Tag Manager (noscript) -->\n        \n        <section id=\"header-content\">\n            \n            <header id=\"base-menu\">\n                <a href=\"/\"><img src=\"/static/buddyns/images/logo.png\" alt=\"BuddyNS logo\" /></a>\n                <nav id=\"top-nav\">\n                    <ul>\n                        <li><a href=\"/\">HOME</a></li>\n                        <li><a href=\"/services/\">SERVICES</a></li>\n                        <li><a href=\"/faq/\">FAQ</a></li>\n                        \n                        <li><a href=\"/support/\">SUPPORT</a></li>\n                        <li><a href=\"/delegation-lab/\">DELEGLAB</a></li>\n                        <li><a href=\"/buddyboard/\">LOGIN</a></li>\n                    </ul>\n                </nav>\n            </header>\n            \n        </section>\n\n        <main id=\"base-content\" role=\"main\">\n            \n            \n            <div class=\"container\">\n                <div class=\"alert alert-warning\" role=\"alert\" id=\"badbrowser\" style=\"display: none\">\n                    <h4><i class=\"fas fa-exclamation-triangle\"></i> Warning <i class=\"fas fa-exclamation-triangle\"></i></h4>\n                \n                    <p>The browser you are using is outdated and lacks support for basic, ubiquitous web technologies.\n                        On this site and others, some pages will lack content, layout, or functionality. Consider\n                        switching to a modern browser, such as\n                    <a target=\"_blank\" href=\"https://www.mozilla.org/en-US/firefox/new/\">Firefox</a>,\n                    <a target=\"_blank\" href=\"https://www.google.com/chrome/\">Chrome</a>, or\n                    <a target=\"_blank\" href=\"https://www.opera.com/\">Opera</a>.</p>\n                </div>\n\n            \n<article id=\"banner\">\n    <header>Welcome to BuddyNS!</header>\n\n    <section class=\"usp\">BuddyNS makes your DNS Reliable. Fast. Secure.</section>\n    <section class=\"usp\">Imagine the Web without HTTPS. How would that be for your DNS?</section>\n    <section class=\"usp\">DNS is a sensitive asset and a hacker's favorite. Run it with DNS professionals.</section>\n</article>\n\n<article id=quicklinks>\n    <a href=\"/services/\" class=\"find-out\">Find out more</a> or <a href=\"/activation/\" class=\"activate-now\">Join now</a>!\n</article>\n\n<article id=\"values\" class=\"row\">\n    <a href=\"/services/\" class=\"shadow-circle col-sm\"><img src=\"/static/buddyns/images/reliability.svg\" alt=\"Reliability\" id=\"reliability-icon\" /></a>\n    <article id=\"popup-reliability-icon\" class=\"popup\">\n        <header>#1 - Reliability</header>\n\n        \n        <ul>\n            <li>100% uptime since inception</li>\n            <li>Multiserver global infrastructure</li>\n            <li>Security-focused design</li>\n        </ul>\n    </article>\n\n    <a href=\"/services/\" class=\"shadow-circle col-sm\"><img src=\"/static/buddyns/images/easeofuse.svg\" alt=\"Ease of use\" id=\"easeofuse-icon\" /></a>\n    <article class=\"popup\" id=\"popup-easeofuse-icon\">\n        <header>#2 - Ease of use</header>\n\n        \n        <ul>\n            <li>1-click activation</li>\n            <li>Troubleshooting assistant</li>\n            <li>Responsive support service</li>\n        </ul>\n    </article>\n\n    <a href=\"/services/\" class=\"shadow-circle col-sm\"><img src=\"/static/buddyns/images/innovation.svg\" alt=\"Innovation\" id=\"innovation-icon\" /></a>\n    <article class=\"popup\" id=\"popup-innovation-icon\">\n        <header>#3 - Innovation</header>\n\n        \n        <ul>\n            <li>Immediate zone synchronization</li>\n            <li>Full IDN (北京大学.中国) support</li>\n            <li>Geographical DNS traffic analysis</li>\n        </ul>\n    </article>\n</article>\n\n<article id=\"testimonials\" onclick=\"change_testimonial(); restart_testimonials()\">\n    <dl class=\"testimonial\">\n        <dt class=\"statement\">We needed a DNS backup solution and BuddyNS accompanied us at every single step of the process.  Their responsiveness and technical knowledge is simply astounding.  We now have their solid infrastructure and support team protecting our DNS.</dt>\n        <dd class=\"name-organization\">&mdash; Alain Azzam, <a href=\"http://www.tektonik.com\">Tektonik inc.</a></dd>\n\n        <dt class=\"statement\">BuddyNS is an incredible DNS mirroring utility, offering us four additional fast and very quickly updated name servers for redundancy. How this service remains free when most premium ones offer much less, I have no idea.</dt>\n        <dd class=\"name-organization\">&mdash; Kage, <a href=\"http://hackthissite.org\">HackThisSite.org</a></dd>\n\n        <dt class=\"statement\">These guys only do one thing but they do it very well! This is fastest-to-synchronize secondary DNS service on the Internet!</dt>\n        <dd class=\"name-organization\">&mdash; Samuel Land, <a href=\"http://www.dyndnsservices.com/tech.htm\">MintDNS</a></dd>\n\n        <dt class=\"statement\">BuddyNS has managed the triple challenge of providing a reliable and high quality service, at no expense, and with streamlined and enjoyable user experience. One can sense a good combination of competence and empathy intertwined together in this great service. Thank you BuddyNS!</dt>\n        <dd class=\"name-organization\">&mdash; Jacques Deguest, VC, <a href=\"http://www.deguest.asia\">DEGUEST Limited</a></dd>\n\n        <dt class=\"statement\">Very nice and simple. I was able to setup a world-distributed remote secondary DNS in couple of hours, including reading helpful docs and testing, and monthly costs are very democratic. I recommend.</dt>\n        <dd class=\"name-organization\">&mdash; Janis Viklis, CEO, <a href=\"http://www.files.fm\">files.fm</a></dd>\n\n        <dt class=\"statement\">Secondary DNS is something you only realize you should have when you need it. Don't be caught with your pants down! I found BuddyNS to be the best of breed, hands down. Thank you!</dt>\n        <dd class=\"name-organization\">&mdash; Eddie Barcellos, CEO, <a href=\"http://www.mattermedia.com\">MATTERMedia</a></dd>\n\n        <dt class=\"statement\">Same here, I can't actually recall when I have switched to BuddyNS been a while, but I'm glad I have done it</dt>\n        <dd class=\"name-organization\">&mdash; <a href=\"https://twitter.com/o1ramsky/status/433588724505387008\">@o1ramsky</a> via Twitter</dd>\n\n        <dt class=\"statement\">I have been using @BuddyNS for like 6 months. All I can say is that it's the best secondary DNS out there! Not a single failure #awesome</dt>\n        <dd class=\"name-organization\">&mdash; <a href=\"https://twitter.com/bruceblacklaws/status/421521464429649920\">@BruceBacklaws</a> via Twitter</dd>\n\n        <dt class=\"statement\">Just discovered @BuddyNS integration with @cPanel #awesome</dt>\n        <dd class=\"name-organization\">&mdash; <a href=\"https://twitter.com/alenguavo/status/415196928289144832\">@aleguavo</a> via Twitter</dd>\n\n        <dt class=\"statement\">I rarely promo sites &amp; services, but I've been looking for you all of my life. Price + simplicity = perfection.</dt>\n        <dd class=\"name-organization\">&mdash; <a href=\"https://twitter.com/cfxmusic/status/381378663637200896\">@cfxmusic</a> via Twitter</dd>\n\n        <dt class=\"statement\">@BuddyNS fantastic service. Migrating all my domains to you.</dt>\n        <dd class=\"name-organization\">&mdash; <a href=\"https://twitter.com/vman1/status/286868190737334273\">@vman1</a> via Twitter</dd>\n\n        <dt class=\"statement\">@BuddyNS Thanks for this Service! I'm searching for something like that a very long time :)</dt>\n        <dd class=\"name-organization\">&mdash; <a href=\"https://twitter.com/schindlerf/status/254613286786592768\">@schindlerf</a> via Twitter</dd>\n\n        <dt class=\"statement\">@BuddyNS just discovered you last night.  Some quick configs later and I am using you while managing my zone with my hidden master! #loveit</dt>\n        <dd class=\"name-organization\">&mdash; <a href=\"https://twitter.com/erebusbat/status/249243055704657921\">@ErebusBat</a> via Twitter</dd>\n\n        <dt class=\"statement\">Discovered awesome secondary DNS service from @BuddyNS and integrated.  Updates are instantaneous with notifications enabled. Awesome</dt>\n        <dd class=\"name-organization\">&mdash; <a href=\"https://twitter.com/ssrini_vasan/status/161772711763378176\">@ssrini_vasan</a> via Twitter</dd>\n\n        <dt class=\"statement\">Thank you @BuddyNS and @ktorn for making abis.io work well for the 'Cryptocurrencies for Good' project!</dt>\n        <dd class=\"name-organization\">&mdash; <a href=\"https://twitter.com/anonyodinn/status/440565311817805824\">@AnonyOdinn</a> via Twitter</dd>\n\n        <dt class=\"statement\">Just set up @BuddyNS for our website. Great secondary #DNS services with great integration at the backend.</dt>\n        <dd class=\"name-organization\">&mdash; <a href=\"https://twitter.com/mcgallen/status/450243941799956480\">@McGallen &amp; Bolden</a> via Twitter</dd>\n\n        <dt class=\"statement\">@BuddyNS Thanks for the free secondary DNS! Great service so far (your docs and contextual tips are super helpful).</dt>\n        <dd class=\"name-organization\">&mdash; <a href=\"https://twitter.com/mholt6/status/715757094155190278\">@mholt6</a> via Twitter</dd>\n\n        <dt class=\"statement\">I'm pretty impressed at how easy it was to setup @BuddyNS as a secondary DNS Service.  Kudos.</dt>\n        <dd class=\"name-organization\">&mdash; <a href=\"https://twitter.com/marclandry/status/776621943839600640\">@MarcLandry</a> via Twitter</dd>\n    </dl>\n\n\n</article>\n\n<hr class=\"trustedbysplit\" />\n\n<article id=\"trustedby\">\n  <header>&diams; Trusted By &diams;</header>\n\n  <ul id=\"references\">\n    <li><img src=\"/static/buddyns/images/logos/apec-logo.png\" alt=\"Asia-Pacific Economic Cooperation\" class=\"logo\" /></li>\n    <li><img src=\"/static/buddyns/images/logos/carletonuniversity-logo.png\" alt=\"Carleton University\" class=\"logo\" /></li>\n    <li><img src=\"/static/buddyns/images/logos/codk-logo.png\" alt=\"Co.Dk ccTLD\" class=\"logo\" /></li>\n    <li><img src=\"/static/buddyns/images/logos/postfix-logo.png\" alt=\"Postfix MTA\" class=\"logo\" /></li>\n    <li><img src=\"/static/buddyns/images/logos/sendgrid-logo.png\" alt=\"Sendgrid\" class=\"logo\" /></li>\n    <li><img src=\"/static/buddyns/images/logos/moschino-logo.png\" alt=\"Moschino\" class=\"logo\" /></li>\n  </ul>\n\n  <script>\n      const available_references = [\n          [\"/static/buddyns/images/logos/apec-logo.png\", \"Asia-Pacific Economic Cooperation\"],\n          [\"/static/buddyns/images/logos/carletonuniversity-logo.png\", \"Carleton University\"],\n          [\"/static/buddyns/images/logos/codk-logo.png\", \"Co.Dk ccTLD\"],\n          [\"/static/buddyns/images/logos/postfix-logo.png\", \"Postfix MTA\"],\n          [\"/static/buddyns/images/logos/sendgrid-logo.png\", \"Sendgrid\"],\n          [\"/static/buddyns/images/logos/moschino-logo.png\", \"Moschino\"],\n      ]\n\n        function getRandomSubarray(arr, size) {\n            var shuffled = arr.slice(0), i = arr.length, temp, index;\n            while (i--) {\n                index = Math.floor((i + 1) * Math.random());\n                temp = shuffled[index];\n                shuffled[index] = shuffled[i];\n                shuffled[i] = temp;\n            }\n            return shuffled.slice(0, size);\n        }\n\n\n      function clear_references() {\n        let refs = document.querySelector('#references');\n        while (refs.hasChildNodes()) {\n              refs.removeChild(refs.firstChild);\n          }\n      }\n\n      function add_references(selected_references) {\n        let refs = document.querySelector('#references');\n          for (let idx = 0; idx < selected_references.length; idx++) {\n              const ref = selected_references[idx];\n              let img_el = document.createElement(\"img\");\n              img_el.classList.add('logo');\n              img_el.src = ref[0];\n              img_el.alt = ref[1];\n              let li = document.createElement(\"li\");\n              li.innerHTML = img_el.outerHTML;\n              refs.appendChild(li);\n          }\n      }\n      \n      document.addEventListener(\"DOMContentLoaded\", (ev) => {\n          clear_references();\n\n          let selected_references = getRandomSubarray(available_references, 4);\n\n          add_references(selected_references);\n      });\n  </script>\n</article>\n\n            </div>\n        </main>\n\n        \n        <footer class=\"footer fixed-bottom bg-dark\">\n          <nav class=\"nav float-right\">\n            <a class=\"nav-link text-white\" href=\"https://securityheaders.com/?q=buddyns.com&followRedirects=on\" target=\"_blank\"><i class=\"fas fa-shield-alt fa-lg\"></i></a>\n            <a class=\"nav-link text-white\" href=\"https://http2.pro/check?url=https%3A//www.buddyns.com/\" target=\"_blank\"><i class=\"fas fa-bolt fa-lg\"></i></a>\n            <a class=\"nav-link text-white\" href=\"http://html5test.com\" target=\"_blank\"><i class=\"fab fa-html5 fa-lg\"></i></a>\n            <a class=\"nav-link text-white\" href='http://ipv6-test.com/validate.php?url=http%3A%2F%2Fwww.buddyns.com' id=\"badges-ipv6\" target='_blank'><i class=\"fas fa-network-wired fa-lg\"></i></a>\n          </nav>\n\n          <nav class=\"nav\">\n            <a class=\"nav-link text-white\" href=\"/about/\">About us</a>\n            <a class=\"nav-link text-white\" href=\"/terms-of-use/\">Terms of Use</a>\n            <a class=\"nav-link text-white\" href=\"/infrastructure/\">Backbone</a>\n            <a class=\"nav-link text-white\" href=\"/support/api/\">API</a>\n            <a class=\"nav-link text-white\" href=\"http://blog.buddyns.com/\">Blog</a>\n            <a class=\"nav-link text-white\" href=\"http://twitter.com/BuddyNS\">Twitter</a>\n          </nav>\n        </footer>\n        \n\n        \n        <script nonce=\"2b2eefcd548e6729171e4ed3cd7d8232\" type=\"text/javascript\">\n            /* Find the current link from the navigator and make it class=\"active-item\" */\n\n            function setActive() {\n                aObj = document.getElementById('top-nav').getElementsByTagName('a');\n                /* convert topnav 'a' element list from NodeList to Array, so as to have .sort() */\n                var ar = Array();\n                for (i=0;i<aObj.length;i++) {\n                    ar[i] = aObj[i];\n                }\n                /* sort links by (desc) pathname length, to implement most-specific matching policy */\n                ar.sort(function (a,b) { return b.pathname.length - a.pathname.length })\n                for (i=0;i<ar.length;i++) {\n                    // consider home only as default\n                    if (document.location.pathname.indexOf(ar[i].pathname) == 0) {\n                        ar[i].id='active-item';\n                        break;\n                    }\n                }\n            }\n\n            document.addEventListener(\"DOMContentLoaded\", function(ev) {\n                if (navigator.userAgent.indexOf('MSIE') !== -1 || navigator.appVersion.indexOf('Trident/') > -1) {\n                    if (window.location.pathname != '/') {\n                        document.querySelector('#badbrowser').style.display = 'block';\n                    }\n                }\n                setActive();\n            });\n        </script>\n    </body>\n</html>\n",
