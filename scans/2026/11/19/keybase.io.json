    "homepage": {
      "status": 200,
      "body": "<!DOCTYPE html>\n<html id=\"\">\n\n  <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n\n                              K E Y   B A S E\n\n                            crypto for everyone\n\n                        because no one we know ever\n                      seems to have a public key. :-(\n\n     No Google Analytics or other 3rd party hosted script tags on Keybase.\n\n     And this has the added bonus that we'll never be able to serve ad code.\n\n                                    \\o/  \\o/\n                                  keybase team\n\n  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->\n\n  <head>\n    <title>Keybase</title>\n    <meta       name=\"viewport\"    content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <link       href=\"/_/brew/_/e8237edb/sitewide-css.css\"      rel=\"stylesheet\">\n    \n    <script type=\"text/javascript\" nonce=\"62f5bdd1-b469-4bad-ab97-4d8cc47a0b37\" src=\"/_/brew/_/900570a0/sitewide-js.js\"></script>\n\n    <meta    charset=\"UTF-8\" />\n    \n\n<meta name=\"Description\" content=\"Keybase is for keeping everyone's chats and files safe, from families to communities to companies. MacOS, Windows, Linux, iPhone, and Android.\"><meta property=\"og:description\" content=\"Keybase is for keeping everyone's chats and files safe, from families to communities to companies. MacOS, Windows, Linux, iPhone, and Android.\"><meta name=\"twitter:description\" content=\"Keybase is for keeping everyone's chats and files safe, from families to communities to companies. MacOS, Windows, Linux, iPhone, and Android.\"><meta name=\"zoom-domain-verification\" content=\"ZOOM_verify_d239ce46e7d942fc89e0542a8194eb36\">\n\n    <script type=\"text/javascript\" nonce=\"62f5bdd1-b469-4bad-ab97-4d8cc47a0b37\">\n    window.csrf_token=\"lgHZIGRmNjc0YzI2NmVmNTZiYThiMDhkNjY0NzkwMmIzODA4zmr+bgXOAxcEAMDEIMA9dPUWcqpIdcmdPGV6SpJCucuFQZzK4Yom/9XYu9sE\";\n    </script>\n  </head>\n\n  \n  <body id=\"splash\">\n  <div class=\"run-mode run-mode-prod\">\n    <div class=\"grid-monitor\"> \n      <input id=\"url_base\" type=\"hidden\" value=\"https://keybase.io/\"/>\n\n        <div id=\"navbar-top\">\n          <div class=\"navbar navbar-fixed-top navbar-default\" role=\"navigation\" data-active-tab=\"\">\n\n            <div class=\"container navbar-container\">\n              <div class=\"row\">\n\n                <div class=\"col-xs-2 col-sm-1\">\n                  <div class=\"navbar-header\">\n                    <div class=\"navbar-brand\">\n                      <a href=\"/\" aria-label=\"home\">\n                        <img src=\"/images/icons/icon-keybase-logo-48.png\" srcset=\"/images/icons/icon-keybase-logo-48@2x.png 2x\" width=\"48\" height=\"48\" />\n                      </a>\n                    </div>\n                    <div class=\"staging-notice\">Keybase Staging Server</div>\n                  </div>\n                </div>\n\n                <div class=\"col-xs-10 col-sm-5\">\n                  <div class=\"nav-search-wrapper\">\n                    <div class=\"input-group form-group\">\n                      <input type=\"text\" class=\"form-control auto-focus nav-search-input  \" data-focus-priority=\"0\" placeholder=\"Search Keybase\"\n                      autocapitalize=\"off\" autocorrect=\"off\" autocomplete=\"off\" spellcheck=\"false\">\n                      <span class=\"input-group-addon\"><i class=\"fas fa-search\"></i></span>\n                    </div>\n                  </div>\n                </div>\n\n                <div class=\"col-xs-12 col-sm-6\">    \n\n      <table class=\"nav navbar-right navbar-buttons pull-right\">\n        <tr>\n        \n            <td>\n              \n              <a href=\"/download\" class=\"btn btn-secondary\">Install</a>\n            </td>\n            <td><a onclick=\"return false;\" href=\"#_\" class=\"navbar-link link-login \">Login</a></td>\n            <td class=\"nav-btn \"><div class=\"auto-tooltip\" title=\"Encrypt\"><a href=\"/encrypt\" aria-label=\"encrypt\"><i class=\"fas fa-lock\"></i></a></div></td>\n            <td class=\"nav-btn \" ><div class=\"auto-tooltip\" title=\"Verify\"><a href=\"/verify\" aria-label=\"verify\"><i class=\"fas fa-check\"></i></a></div></td>\n            <td class=\"hidden-xs nav-btn \"   ><div class=\"auto-tooltip\" title=\"Docs\"><a href=\"http://book.keybase.io\" aria-label=\"docs\"><i class=\"fas fa-question\"></i></a></div></td>\n          \n        </tr>\n      </table>\n</div>\n\n              </div>\n            </div>\n          </div>\n        </div>\n\n\n\n      \n    \n\n<div id=\"autoreset-event-error\" class=\"container alert alert-warning\" style=\"text-align:center; display:none;\">\n  <span id=\"autoreset-event-error-msg\">  </span>\n  <button type=\"button\" class=\"close\"><span id=\"autoreset-event-error-close\">×</span></button>\n</div>\n<div id=\"autoreset-event-success\" class=\"container alert alert-success\" style=\"text-align:center; display:none;\">\n  <span id=\"autoreset-event-success-msg\">  </span>\n  <button type=\"button\" class=\"close\"><span id=\"autoreset-event-success-close\">×</span></button>\n</div>\n\n\n\n\n      \n      <div class=\"modal modal-primary\" id=\"shared-modal\" data-backdrop=\"static\">\n      </div>\n\n      \n      <div class=\"content\">\n        <div id=\"page-splash\">\n  <header>\n    <div class=\"wrapper\">\n      \n    <div class=\"install-badge\">\n      <a\n        href=\"#_\"\n        data-use-direct=\"false\"\n        data-target=\"/download\"\n        data-platform=\"computer\"\n        data-context=\"unknown\"\n        class=\"install-link\"\n      >\n        <img\n          srcset=\"/images/badges/install-badge-unknown-168-56.png, /images/badges/install-badge-unknown-168-56@2x.png 2x, /images/badges/install-badge-unknown-168-56@3x.png 3x\"\n          src=\"/images/badges/install-badge-unknown-168-56@3x.png\"\n          width=\"168\"\n          height=\"56\"\n        >\n      </a>\n\n      \n    </div>\n  \n\n      <h1>End-to-end encryption for things that matter.</h1>\n      <h2>Keybase is secure messaging and file-sharing.</h2>\n    </div>\n  </header>\n\n  <section id=\"chat\">\n    <div class=\"wrapper\">\n      <div class=\"text\">\n        <h3>A place for work (or&nbsp;not)</h3>\n        <p>We use public key cryptography to ensure your messages stay private. Even we can’t read your chats.</p>\n        <p>\n    <a\n      href=\"#_\"\n      data-use-direct=\"false\"\n      data-target=\"/download\"\n      data-platform=\"computer\"\n      data-context=\"unknown\"\n      class=\"install-link\"\n    >Send secure messages</a>\n  \n</p>\n      </div>\n      <div class=\"app\">\n        <div class=\"input\">\n          <div class=\"text\" data-text=\"His LinkedIn got hacked :-/\"></div>\n          <div class=\"button\">Send</div>\n        </div>\n        <img srcset=\"/images/splash/chat/1.png,\n                     /images/splash/chat/1@2x.png 2x,\n                     /images/splash/chat/1@3x.png 3x\"\n          src=\"/images/splash/chat/1@3x.png\" alt=\"Keybase chat\">\n      </div>\n    </div>\n  </section>\n\n  <section id=\"teams\">\n    <div class=\"wrapper\">\n      <div class=\"text\">\n        <h3>A place that’s safe, even for&nbsp;family</h3>\n        <p>Keybase works for families, roommates, clubs, and groups of friends, too.</p>\n        <p>\n    <a\n      href=\"#_\"\n      data-use-direct=\"false\"\n      data-target=\"/download\"\n      data-platform=\"computer\"\n      data-context=\"unknown\"\n      class=\"install-link\"\n    >Create teams with anyone</a>\n  \n</p>\n      </div>\n      <div class=\"app\">\n        <img srcset=\"/images/splash/teams/1.png,\n                     /images/splash/teams/1@2x.png 2x,\n                     /images/splash/teams/1@3x.png 3x\"\n          src=\"/images/splash/teams/1@3x.png\" alt=\"Keybase teams\">\n        <div class=\"conversation\">\n          <img class=\"animated\" srcset=\"/images/splash/teams/rows/2.png,\n                        /images/splash/teams/rows/2@2x.png 2x,\n                        /images/splash/teams/rows/2@3x.png 3x\"\n            src=\"/images/splash/teams/rows/2@3x.png\" alt=\"Keybase file row\">\n          <img class=\"animated\" srcset=\"/images/splash/teams/rows/3.png,\n                        /images/splash/teams/rows/3@2x.png 2x,\n                        /images/splash/teams/rows/3@3x.png 3x\"\n            src=\"/images/splash/teams/rows/3@3x.png\" alt=\"Keybase file row\">\n          <img class=\"animated\" srcset=\"/images/splash/teams/rows/4.png,\n                        /images/splash/teams/rows/4@2x.png 2x,\n                        /images/splash/teams/rows/4@3x.png 3x\"\n            src=\"/images/splash/teams/rows/4@3x.png\" alt=\"Keybase file row\">\n          <img class=\"animated\" srcset=\"/images/splash/teams/rows/5.png,\n                        /images/splash/teams/rows/5@2x.png 2x,\n                        /images/splash/teams/rows/5@3x.png 3x\"\n            src=\"/images/splash/teams/rows/5@3x.png\" alt=\"Keybase file row\">\n          <img class=\"animated\" srcset=\"/images/splash/teams/rows/6.png,\n                        /images/splash/teams/rows/6@2x.png 2x,\n                        /images/splash/teams/rows/6@3x.png 3x\"\n            src=\"/images/splash/teams/rows/6@3x.png\" alt=\"Keybase file row\">\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"club\">\n    <div class=\"wrapper\">\n      <div class=\"text\">\n        <h3>A place to form your supper&nbsp;club</h3>\n        <p>Keybase connects to public identities, too. You can connect with communities from Twitter, Reddit, and elsewhere.</p>\n        <p>\n    <a\n      href=\"#_\"\n      data-use-direct=\"false\"\n      data-target=\"/download\"\n      data-platform=\"computer\"\n      data-context=\"unknown\"\n      class=\"install-link\"\n    >Connect with an open community</a>\n  \n</p>\n      </div>\n      <div class=\"app\">\n        <img class=\"animated\" srcset=\"/images/splash/club/header.png,\n                     /images/splash/club/header@2x.png 2x,\n                     /images/splash/club/header@3x.png 3x\"\n          src=\"/images/splash/club/header@3x.png\" alt=\"Keybase chat header: @supperclub#mondays\">\n        <img class=\"animated\" srcset=\"/images/splash/club/message.png,\n                      /images/splash/club/message@2x.png 2x,\n                      /images/splash/club/message@3x.png 3x\"\n          src=\"/images/splash/club/message@3x.png\" alt=\"Keybase chat message: We’re meeting at my place tonight. See you all soon!\">\n\n        <div class=\"user-cards\">\n          <div class=\"dots one animated\"></div>\n          <div class=\"card animated\">\n            <img srcset=\"/images/splash/club/revolt.png,\n                     /images/splash/club/revolt@2x.png 2x,\n                     /images/splash/club/revolt@3x.png 3x\"\n            src=\"/images/splash/club/revolt@3x.png\" alt=\"Keybase user card\">\n            <dl>\n              <dt>revolt</dt>\n              <dd>Richard Evolt</dd>\n            </dl>\n          </div>\n          <div class=\"dots two animated\"></div>\n          <div class=\"card animated\">\n            <img srcset=\"/images/splash/club/we3feet.png,\n                     /images/splash/club/we3feet@2x.png 2x,\n                     /images/splash/club/we3feet@3x.png 3x\"\n            src=\"/images/splash/club/we3feet@3x.png\" alt=\"Keybase user card\">\n            <dl>\n              <dt>we3feet</dt>\n              <dd>Sarah Waters</dd>\n            </dl>\n          </div>\n          <div class=\"dots three animated\"></div>\n          <div class=\"card animated\">\n            <img srcset=\"/images/splash/club/shipit.png,\n                     /images/splash/club/shipit@2x.png 2x,\n                     /images/splash/club/shipit@3x.png 3x\"\n            src=\"/images/splash/club/shipit@3x.png\" alt=\"Keybase user card\">\n            <dl>\n              <dt>shipit</dt>\n              <dd>Samantha Kelly</dd>\n            </dl>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"files\">\n    <div class=\"wrapper\">\n      <div class=\"text\">\n        <h3>A place to share what’s most important</h3>\n        <p>Don’t live dangerously when it comes to documents. Keybase can store your group’s photos, videos, and documents with end-to-end encryption.</p>\n        <p>\n    <a\n      href=\"#_\"\n      data-use-direct=\"false\"\n      data-target=\"/download\"\n      data-platform=\"computer\"\n      data-context=\"unknown\"\n      class=\"install-link\"\n    >Share files securely</a>\n  \n</p>\n      </div>\n      <div class=\"app\">\n        <img srcset=\"/images/splash/files/1.png,\n                     /images/splash/files/1@2x.png 2x,\n                     /images/splash/files/1@3x.png 3x\"\n          src=\"/images/splash/files/1@3x.png\" alt=\"Keybase files\">\n        <div class=\"rows\">\n          <img class=\"animated\" srcset=\"/images/splash/files/rows/2.png,\n                        /images/splash/files/rows/2@2x.png 2x,\n                        /images/splash/files/rows/2@3x.png 3x\"\n            src=\"/images/splash/files/rows/2@3x.png\" alt=\"Keybase file row\">\n          <img class=\"animated\" srcset=\"/images/splash/files/rows/4.png,\n                        /images/splash/files/rows/4@2x.png 2x,\n                        /images/splash/files/rows/4@3x.png 3x\"\n            src=\"/images/splash/files/rows/4@3x.png\" alt=\"Keybase file row\">\n          <img class=\"animated\" srcset=\"/images/splash/files/rows/3.png,\n                        /images/splash/files/rows/3@2x.png 2x,\n                        /images/splash/files/rows/3@3x.png 3x\"\n            src=\"/images/splash/files/rows/3@3x.png\" alt=\"Keybase file row\">\n          <img class=\"animated\" srcset=\"/images/splash/files/rows/5.png,\n                        /images/splash/files/rows/5@2x.png 2x,\n                        /images/splash/files/rows/5@3x.png 3x\"\n            src=\"/images/splash/files/rows/5@3x.png\" alt=\"Keybase file row\">\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"boom\">\n    <div class=\"wrapper\">\n      <div class=\"text\">\n        <h3>A place for secrets</h3>\n        <p>You can set a timer on your most sensitive messages.</p>\n        <p>\n    <a\n      href=\"#_\"\n      data-use-direct=\"false\"\n      data-target=\"/download\"\n      data-platform=\"computer\"\n      data-context=\"unknown\"\n      class=\"install-link\"\n    >Send exploding messages</a>\n  \n</p>\n      </div>\n      <div class=\"app\">\n        <img srcset=\"/images/splash/boom/a.png,\n                     /images/splash/boom/a@2x.png 2x,\n                     /images/splash/boom/a@3x.png 3x\"\n          src=\"/images/splash/boom/a@3x.png\" alt=\"Keybase chat message: !password email\">\n        <div class=\"exploding\">\n          <img srcset=\"/images/splash/boom/b.png,\n                        /images/splash/boom/b@2x.png 2x,\n                        /images/splash/boom/b@3x.png 3x\"\n            src=\"/images/splash/boom/b@3x.png\" alt=\"Keybase chat message: email password\">\n          <img srcset=\"/images/splash/boom/c.png,\n                        /images/splash/boom/c@2x.png 2x,\n                        /images/splash/boom/c@3x.png 3x\"\n            src=\"/images/splash/boom/c@3x.png\" alt=\"Keybase chat message: email password\">\n          <img srcset=\"/images/splash/boom/d.png,\n                        /images/splash/boom/d@2x.png 2x,\n                        /images/splash/boom/d@3x.png 3x\"\n            src=\"/images/splash/boom/d@3x.png\" alt=\"Keybase chat message: email password\">\n          <img srcset=\"/images/splash/boom/e.png,\n                        /images/splash/boom/e@2x.png 2x,\n     